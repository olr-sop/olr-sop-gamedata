{
	"folders": [
		{
			"path": "./config",
			"name": "configs"
		},
		{
			"path": "./scripts"
		},
		{
			"path": "./shaders"
		}
	],
	"settings": {
		"files.associations": {
			//			"*.ltx": "ini",
			"*.s": "lua",
			"*.script": "lua",
			"*.h": "hlsl",
			"*.ps": "hlsl",
			"*.vs": "hlsl"
		},
		"[ini]": {
			"files.eol": "\r\n",
			"files.encoding": "windows1251"
		},
		"[hlsl]": {
			"files.eol": "\n",
			"files.encoding": "utf8"
		},
		"[lua]": {
			"files.eol": "\r\n",
			"files.encoding": "windows1251"
		},
		"[xml]": {
			"files.eol": "\r\n",
			"files.encoding": "windows1251"
		},
		"[ltx]": {
			"files.eol": "\r\n",
			"files.encoding": "windows1251"
		},
		"editor.formatOnSave": true,
		"editor.formatOnPaste": true,
		"editor.tabFocusMode": true,
		"editor.tabSize": 4,
		"editor.formatOnSaveMode": "file"
	}
}