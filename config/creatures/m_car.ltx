
[m_car]
GroupControlSection	= spawn_group
discovery_dependency = 
$spawn 			= "vehicles\car"
cform                   = skeleton
class                   = SCRPTCAR
visual = physics\vehicles\niva\veh_niva_u_01

;remove_time = 120


inv_weight				= 1000
cost					= 100000
inv_grid_width			= 1
inv_grid_height			= 1

script_binding  		= bind_car.bind

hud = niva_hud

[niva_hud]
visual = car_hands\niva_hands
position = -0.40, 1.45, -0.20
anim_idle = idle
anim_idle_right = idle_r
anim_idle_left = idle_l
anim_return_left = return_l
anim_return_right = return_r
anim_rotate_left = rotate_l
anim_rotate_right = rotate_r

