[zone_acid_fog]
GroupControlSection	= spawn_group_zone
$spawn 			= "zones\zone_acid_fog"
$prefetch 		= 16
class			= Z_ACIDF		; ZS_FOG - olr   Z_ACIDF -- orig
hit_impulse_scale	= .01

effective_radius	= 1.00 ;размер радиуса в процентах от оригинального, где действует зона


sound			= zone_mosquito_bald
postprocess		= postprocess_new

throw_impulse		= 0.1

script_binding  		= bind_anomaly.Init

ef_anomaly_type			= 3
ef_weapon_type			= 15

artefacts		= af_blood,0.7, af_mincer_meat, 0.25,af_soul, 0.05
BirthProbability = 0.9

idle_sound			= ambient\fx2; ambient\fx2		;постоянный звук
blowout_sound		= anomaly\anomaly_gravy_blast01; anomaly_gravy_blast01	;во время выброса(удара) в центре аномалии	
hit_sound			= anomaly\anomaly_gravy_hit1								;на персонаже, когда тот получает хит
entrance_sound		= anomaly\anomaly_gravy_blast								;при попадании объекта в аномалию

idle_particles		= anomaly\galantine_old00
blowout_particles	= anomaly2\anotests\anomaly_4

min_start_power		= 0.99
max_start_power		= 1.00
attenuation			= 0.1
period				= 1
min_artefact_count	= 0
max_artefact_count	= 0

disable_time		= -1	;время игнорирования неживого объекта в зоне (-1 если не нужно)
disable_time_small	= -1		;время игнорирования маленького неживого объекта в зоне (-1 если не нужно)
disable_idle_time	= -1	;время отключения idle партиклов

hit_type		= burn

disable_time		= 5000	;время игнорирования неживого объекта в зоне (-1 если не нужно)
disable_idle_time	= 10000	;время отключения idle партиклов

awaking_time		= 1000
blowout_time		= 300	
accamulate_time		= 1000

ignore_nonalive		= false
ignore_small		= true
ignore_artefacts	= true

blowout_light		= off
idle_light			= off

visible_by_detector = on

blowout_wind		= off

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;рождение артефактов во время срабатывания
spawn_blowout_artefacts = off