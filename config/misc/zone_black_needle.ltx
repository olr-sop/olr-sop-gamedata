;----------- Аномалия чёрная колючка -----------------------

[zone_black_needle]
GroupControlSection			= spawn_group_zone
$spawn 						= "zones\zone_black_needle"
$prefetch 					= 16
class						= ZS_MBALD

hit_impulse_scale			= 0.15
effective_radius			= 1.0 ;размер радиуса в процентах от оригинального, где действует зона
actor_blowout_radius_percent		= 0.9

ef_anomaly_type				= 3
ef_weapon_type				= 13

script_binding  		= bind_anomaly.Init

throw_impulse		= 70.1
sound						= 
	
artefacts					= af_ameba_slime, 0.8, af_ameba_slug, 0.2, af_ameba_mica, 0.0
BirthProbability 			= 0.2

hit_type		= chemical_burn

;----------- Anomaly settings -----------------------
min_start_power		= 2.0
max_start_power		= 3.0
attenuation			= 1
period				= 1
min_artefact_count	= 0
max_artefact_count	= 0


idle_particles				= ghoul\anomal-06-black-holes
blowout_particles			= anomaly\a-03-expl-sparks_00

hit_small_particles			= damage_fx\body_smoke_kisl
hit_big_particles			= damage_fx\body_smoke_kisl
idle_small_particles		        = damage_fx\body_smoke_kisl
idle_big_particles			= damage_fx\body_smoke_kisl

idle_sound				= anomaly\bfuzz_hit		
blowout_sound				= anomaly\bfuzz_hit		
hit_sound				= anomaly\bfuzz_hit		
entrance_sound				= anomaly\bfuzz_hit	

hit_type					= chemical_burn
							  
disable_time				= 10000	;время игнорирования неживого объекта в зоне (-1 если не нужно)
disable_time_small			= -1	;время игнорирования маленького неживого объекта в зоне (-1 если не нужно)
disable_idle_time			= 50000	;время отключения idle партиклов

ignore_nonalive				= true
ignore_small				= true
ignore_artefacts			= true

blowout_light				= off

idle_light					= off

awaking_time				= 50
blowout_time				= 200 ;100	
accamulate_time				= 500

visible_by_detector 		= off

blowout_wind				= off

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;рождение артефактов во время срабатывания
spawn_blowout_artefacts = off
