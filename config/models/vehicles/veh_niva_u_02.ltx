seat_dist		= 2.0 ; дистанция с которой можно сесть в машину
doors_dist		= 7.0 ; дистанция с которой можно открывать двери

left_door_bone		= phy_door_left ; имя кости левой открываемой двери
right_door_bone		= phy_door_right ; имя кости правой открываемой двери 

left_door_out_bone		= pos_door_1 ; 	имя кости левой двери  для выхода
right_door_out_bone		= pos_door_2 ; 	имя кости правой двери  для выхода

seat_bone_left		= phy_body_roof ; 	имя кости правой двери  для выхода
seat_bone_right		= phy_body_roof ; 	имя кости левой двери  для выхода



;-------------------------------------------------------------------------------
;------ Factory parameters of Engine -------------------------------------------

fuel_tank         		= 42         	; L
fuel_consumption  		= 4		    ; L / (100k R); liters per 100 000 rotations
engine_power      		= 100	        ; horse_power (kW=hp*0.808) max power
max_power_rpm     		= 4900       	; (nominal rpm ) on this rpm value engine power reaches maximum
max_torque_rpm    		= 4000       	; on this rpm engine torque reaches maximum

power_increment_factor		= 0.1
power_decrement_factor		= 0.01
rpm_increment_factor		= 0.1
rpm_decrement_factor		= 0.01
m_power_neutral_factor		= 0.75

; additional engine parameters
max_engine_rpm    		= 5000			; rpm (5000) rpm will never be more
idling_engine_rpm		= 750       	; rpm (750) min rpm - starts from this rpm value

;-------------------------------------------------------------------------------
;------ Adjustment a wheel -----------------------------------------------------

reference_radius  		= 0.4			; Радиус колеса, используемый при просчёте двигателя
axle_friction     		= 0.002	      	; Ослабление скорости в неетральной позиции. (N*m)
steering_speed    		= 0.9;0.8        	; Скорость поворота рулевого колеса, в максимум. rps (1)
steering_torque   		= 3000; 900000		; Сила гидроусилителя руля. (N*m)
break_torque      		= 0.052        	; Сила тормозных колодок. (N*m)
break_time        		= 1.0         	; Время нарастания силы торможения до максимума, при подтормаживании (стрелка назад)
hand_break_torque 		= 0.072        	; Сила торможения пробелом (по умолчанию = break_torque)

;-------------------------------------------------------------------------------
;------ Gearbox ----------------------------------------------------------------

main_gear_ratio    		= 4.5       	; Передаточное отношение
auto_transmission  		= off           ; Автоматическая коробка (on/off)


