[alife]
	schedule_min				= 1			; milliseconds
	schedule_max				= 1			; milliseconds
	process_time				= 900		; microseconds
	update_monster_factor		= 0.1
	time_factor					= 10 ;5 ;1	; скорость для демонстрации смены дня и ночи		
	normal_time_factor			= 2		; животные в оффлайне перемещаются со скоростью, делённой на этот фактор (чтобы не бегали очень быстро)
	max_combat_iteration_count	= 5 ;7 ;5 ;10				; maximum combat iteration count
	switch_distance				= 150; 250 - 3.0
	switch_factor				= 0.1 
	start_time					= 09:00:00 ;20:00:00
	start_date					= 19.05.2012

	autosave_interval			= 01:05:00
	delay_autosave_interval		= 00:00:30
	objects_per_update			= 10
	start_game_callback			= _G.start_game_callback	; on starting new game or loading saved one
	
[online_offline_group]
	class						= ON_OFF_G	; Class identifier
	script_binding				= 
	time_factor+ = +
	time_factor+ = -