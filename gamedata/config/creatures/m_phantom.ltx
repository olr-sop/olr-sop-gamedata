[m_phantom]:monster_base
GroupControlSection	= spawn_group
$spawn                  = "monsters\phantom" ; option for Level Editor
spawn 	                = on	;
cform                   = skeleton
class                   = AI_PHANT
rank			= 0

visuals = monsters\phantom\controller, monsters\phantom\zombie, monsters\phantom\pseudogigant, monsters\phantom\bloodsucker, monsters\phantom\mutant_boar, monsters\phantom\pseudodog

speed                   = 2.4
angular_speed           = 4.2	
contact_hit		= 0.5
ef_creature_type	= -1

script_binding  		= phantom_manager.bind

; state BIRTH
particles_birth 		= monsters\phantom_birth
sound_birth 			= monsters\poltergeist\idle_1

; state FLY
particles_fly	 		= monsters\phantom_fly
sound_fly	 		= monsters\poltergeist\die_1

; state CONTACT
particles_contact 		= monsters\phantom_death
sound_contact 			= monsters\poltergeist\idle_0

; state SHOOT
particles_shoot 		= monsters\phantom_death
sound_shoot			= monsters\biting\def_0

material			= creatures\phantom



[m_phantom_swamp]:monster_base
GroupControlSection	= spawn_group
$spawn                  = "monsters\m_phantom_swamp" ; option for Level Editor
spawn 	                = on	;
cform                   = skeleton
class                   = AI_PHANT
rank			= 0

visuals = monsters\phantom\dark_stalker, monsters\phantom\dark_stalker, monsters\phantom\dark_stalker, monsters\phantom\dark_stalker, monsters\phantom\dark_stalker


speed                   = 1.2
angular_speed           = 2.	
contact_hit		= 0.25
ef_creature_type	= -1

script_binding  		= phantom_manager_ds.bind

; state BIRTH
particles_birth 		= monsters\phantom_birth
sound_birth 			= monsters\poltergeist\tele_get_0

; state FLY
particles_fly	 		= monsters\phantom_fly
sound_fly	 		= monsters\poltergeist\die_0

; state CONTACT
particles_contact 		= monsters\phantom_death
sound_contact 			= monsters\poltergeist\idle_3

; state SHOOT
particles_shoot 		= monsters\phantom_death
sound_shoot			= monsters\poltergeist\die_3

material			= creatures\phantom