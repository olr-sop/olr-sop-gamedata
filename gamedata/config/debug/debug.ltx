[options]
;--/ --------------------------------------------
debug         = true  ;--/ (false|true) debug mode and output in a log of optional messages
dbg_fix       = true  ;--/ (false|true) the output in a log of messages is fixed in real time
dbg_bad_sav   = false ;--/ (false|true) to ignore "beaten" saving game
check_scripts = true  ;--/ (false|true) mode of check script-files
count_scripts = 700   ;--/ quantity of the checked script-files (~300)
