[sect_identity_immunities]
burn_immunity			= 1.0
strike_immunity			= 1.0
shock_immunity			= 1.0
wound_immunity			= 1.0		
wound_2_immunity		= 1.0
radiation_immunity		= 1.0
telepatic_immunity		= 1.0
chemical_burn_immunity	= 1.0
explosion_immunity		= 1.0
fire_wound_immunity		= 1.0

[identity_immunities]
immunities_sect				= sect_identity_immunities
use_aim_bullet				= false
misfire_condition_k			= 0.05

;hit_probability - вероятность попадания пули в шейп. 
;Из-за отсутствия умения вести упреждающий огонь, % вероятности попадания завышен, 
;иначе нпц очень легко абузить обыкновенным стрейфом
 
hit_probability_gd_novice	= 0.5
hit_probability_gd_stalker	= 0.72
hit_probability_gd_veteran	= 0.98
hit_probability_gd_master	= 1.25
water_power = 0 
eat_sleep = 0 

[common_ph_friction_params_on_npc_death] ;Параметры для задания изменения трения в момент смерти персонажа
;сопротивление воздуха (линейное и угловое)
ph_skeleton_airr_lin_factor			= -0.32		;линейное сопротивление
ph_skeleton_airr_ang_factor			= -0.16		;угловое сопротивление

;суставы
ph_skeleton_hinger_factor1			= 1.16		;сопротивление в суставах после смерти
ph_skeleton_ddelay					= 20		;(сек) в течении которых суставы постепенно теряют сопротивление

;импульсы и скорость после смерти
ph_skel_fatal_impulse_factor		= 0.25		;множитель импулься (???)
ph_after_death_velocity_factor		= 0.24	;множитель скорости (?) для отлетания после смерти
ph_skel_shot_up_factor				= 0.16		;подбрасывание (?) после смерти

;трение суставов об поверхности
ph_skeleton_skin_friction_start		= 1.4		;Стартовое значение трения для оболочки
ph_skeleton_skin_friction_end		= 0.6		;Финальное значение трения для оболочки
ph_skeleton_skin_ddelay				= 2.4		;(сек) время в течении которого трение изменяется после смерти
ph_skeleton_skin_ddelay_after_wound	= 1.6		;аналог для раненых


ph_pelvis_factor_low_pose_detect	= 0.3		;длина луча на коллизию с землёй из центра пелвиса (определеие позы для проверки столкновения с коллизией)
												;если коллизиться, то персонаж находиться в нижней позе(или ранен)(в этом случае для него задаются другие параметры 
												;трения и отсутствует домножение импульса для первого хита)
ph_character_have_wounded_state		= true		; имеет ли персонаж состояние раненый

[monster_base]:common_ph_friction_params_on_npc_death
actor_hit_effect = effector_monster_hit
