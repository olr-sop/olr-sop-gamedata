; Настройки для спавна артефактов в капсулах у непесей
; chance - задаётся от 0 до 1
; max_artefacts - задаётся от 0 до 5 (или скока у нас там в капсуле места)
; если шанс 0.5 и max_artefacts 2 то делаем два прохода с 50% шансом заспавнить артефакт
; артефакты случайные и берутся непосредственно из конфига капсулы
[capsule_novice]
chance = 0.1
max_artefacts = 2

[capsule_experienced]
chance = 0.15
max_artefacts = 2

[capsule_veteran]
chance = 0.18
max_artefacts = 3

[capsule_master]
chance = 0.33
max_artefacts = 5

