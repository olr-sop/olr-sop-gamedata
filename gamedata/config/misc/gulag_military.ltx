; Sin Duel
[logic@mil_sin_duel]
active = remark@mil_sin_duel
combat_ignore = combat_ignore@sin

[remark@mil_sin_duel]
path_walk = sin_duel_walk
meet = no_meet
target = actor
anim = wait
danger = danger_condition@mil_sin_duel
meet = meet@baser2
on_info = {+dialog_grez_zaruba_gg_talked} nil

[meet@baser2]
meet_dialog = dialog_grez_zaruba_gg
use			= true
use_wpn		= true
 
[danger_condition@mil_sin_duel]
