;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Главная секция
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Тут перечисляются все сануд эвенты которые игра прочитает во время инициализации скрипта и подзагрузит их,
; если тут не окажется эвента то при его вызове вы ничего не получите (в лог напишет об этом), эвенты перечисляются через запятую
[olr_sound_events]
events = test_event, test_event_1

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Звуковые эвенты
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[test_event]
object = escape_trader_0000													; числовой story_id или name объекта из спавна (Жаба например имеет name = escape_trader_0000)
sound_path = characters_voice\scenario\escape\trader\trader_bad_trade_4		; путь к звуку без расширения, с обратными слешами.
sound_delay = 0																; задержка перед началом воспроизведения в миллисекундах.

[test_event_1]
object = escape_trader_0000
sound_path = characters_voice\scenario\escape\trader\trader_bad_trade_4
sound_delay = 2500