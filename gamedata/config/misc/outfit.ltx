[novice_outfit]:outfit_base
GroupControlSection	= spawn_group
discovery_dependency = 
$spawn 			= "outfit\novice_outfit"
;$prefetch 		= 32
class			= E_STLK
cform           = skeleton
visual          = items\outfit\novice_outfit
actor_visual	= actors\hero\hero_novice.ogf
item_amount = 4
item_amount_add = 8
ef_equipment_type	= 3

3d_static_rotate_x	= -90

inv_name			= outfit_novice_name
inv_name_short		= outfit_novice_name
description			= outfit_novice_description

inv_weight			= 3.7

inv_grid_width		= 2
inv_grid_height		= 2
inv_grid_x			= 7
inv_grid_y			= 14

