[settings]
;инфопоршень который разрешает запускаться выбросам
condlist = {-start_olr_mod} false, true
;инфопоршни которые отключат сто процентное убийство актера на финальной стадии выброса (anabiotic_in_process дается от юза анабиотика, а skip_surge можем выдать после н-го кол-ва пережитых выбросов как в ЗП)
