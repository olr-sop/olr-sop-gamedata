;----------- Аномалия кислотный туман -----------------------
[zone_acid_fog]
GroupControlSection		= spawn_group_zone
$spawn					= "zones\zone_acid_fog"
$prefetch				= 16
$def_sphere 		    = 4
class					= ZS_MBALD
ef_anomaly_type			= 3
ef_weapon_type			= 15
script_binding			= bind_anomaly.Init

hit_type				= burn
hit_impulse_scale		= .01
effective_radius		= 1.00	;размер радиуса в процентах от оригинального, где действует зона
postprocess				= anomaly_acidfog
enable_effector			= true
throw_impulse			= 0.1

shape_transp_color		= 150, 0, 170, 60
shape_edge_color		= 32, 32, 32, 255

;----------- Anomaly settings -----------------------
min_start_power			= 0.99
max_start_power			= 1.00
attenuation				= 0.1
period					= 1
min_artefact_count		= 0
max_artefact_count		= 0

idle_sound				= anomaly\witches_jelly_idle;				;постоянный звук
blowout_sound			= anomaly\witches_jelly_hit;	;во время выброса(удара) в центре аномалии	
hit_sound				= anomaly\witches_jelly_hit			;на персонаже, когда тот получает хит
entrance_sound			= anomaly\witches_jelly_hit			;при попадании объекта в аномалию

idle_particles			= anomaly_new\acid_fog\idle
blowout_particles		= anomaly_new\acid_fog\blow

disable_time			= 5000	;время игнорирования неживого объекта в зоне (-1 если не нужно)
disable_time_small		= -1	;время игнорирования маленького неживого объекта в зоне (-1 если не нужно)
disable_idle_time		= 10000	;время отключения idle партиклов

awaking_time			= 1000
blowout_time			= 300
accamulate_time			= 1000

ignore_nonalive			= false
ignore_small			= true
ignore_artefacts		= true

blowout_light			= off
idle_light				= off
blowout_wind			= off
visible_by_detector		= on

;рождение артефактов 
artefacts						= af_mercury_ball, 1.0, af_deadhead, 0.03

;во время срабатывания в online
spawn_blowout_artefacts			= on					; рождение артефактов во время срабатывания, для true принимаются on/yes/true/1, иначе значение будет false

artefact_spawn_probability		= 0.09					;вероятность, что во время срабатывания аномалии будет рожден артефакт
artefact_spawn_particles		= anomaly2\pux_blast	;партиклы, которые отыграются на месте рождения артефакта (опционально)
artefact_born_sound				= anomaly\pux_blast		;звук, который отыграются на месте рождения артефакта (опционально)

throw_out_power					= 50					;импульс с которым артефакт будет выброшен из зоны в произвольном направлении
artefact_spawn_height			= 3						;(м) высота на центром зоны где будет рожден артефакт