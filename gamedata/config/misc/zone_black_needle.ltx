[zone_black_needle]
GroupControlSection				= spawn_group_zone
$spawn							= "zones\zone_black_needle"
$prefetch						= 16
class							= ZS_MBALD
ef_anomaly_type					= 3
ef_weapon_type					= 13
script_binding					= bind_anomaly.Init

hit_type						= chemical_burn
hit_impulse_scale				= 0.15
effective_radius				= 1.0	;размер радиуса в процентах от оригинального, где действует зона
actor_blowout_radius_percent	= 0.9
throw_impulse					= 70.1

shape_transp_color				= 50, 50, 50, 60
shape_edge_color				= 32, 32, 32, 255

;----------- Anomaly settings -----------------------
min_start_power					= 2.0
max_start_power					= 3.0
attenuation						= 1
period							= 1
min_artefact_count				= 0
max_artefact_count				= 0

;idle_sound						= anomaly\burning_fuzz_hit
blowout_sound					= anomaly\burning_fuzz_blowout
hit_sound						= anomaly\burning_fuzz_hit
;entrance_sound					= anomaly\burning_fuzz_hit

idle_particles					= anomaly_new\black_thorns\idle
blowout_particles				= anomaly_new\black_thorns\blowout

hit_small_particles				= damage_fx\effects\body_smoke_kisl
hit_big_particles				= damage_fx\effects\body_smoke_kisl

idle_small_particles			= damage_fx\effects\body_smoke_kisl
idle_big_particles				= damage_fx\effects\body_smoke_kisl

disable_time					= 10000	;время игнорирования неживого объекта в зоне (-1 если не нужно)
disable_time_small				= -1	;время игнорирования маленького неживого объекта в зоне (-1 если не нужно)
disable_idle_time				= 50000	;время отключения idle партиклов

awaking_time					= 50
blowout_time					= 200 ;100
accamulate_time					= 500

ignore_nonalive					= false
ignore_small					= false
ignore_artefacts				= true

blowout_light					= off
idle_light						= off
blowout_wind					= off
visible_by_detector				= off

;рождение артефактов 
artefacts						= af_needle, 0.6, af_needle_heavy, 0.3, af_deadhead, 0.03

;во время срабатывания в online
spawn_blowout_artefacts			= on					; рождение артефактов во время срабатывания, для true принимаются on/yes/true/1, иначе значение будет false

artefact_spawn_probability		= 0.09					;вероятность, что во время срабатывания аномалии будет рожден артефакт
artefact_spawn_particles		= anomaly2\pux_blast	;партиклы, которые отыграются на месте рождения артефакта (опционально)
artefact_born_sound				= anomaly\pux_blast		;звук, который отыграются на месте рождения артефакта (опционально)

throw_out_power					= 50					;импульс с которым артефакт будет выброшен из зоны в произвольном направлении
artefact_spawn_height			= 3						;(м) высота на центром зоны где будет рожден артефакт