[zone_burning_fuzz]
GroupControlSection		= spawn_group_zone
$spawn					= "zones\burning fuzz"
;$prefetch				= 16
class					= ZS_BFUZZ
visual					= physics\anomaly\fuzz 
ef_anomaly_type			= 6
ef_weapon_type			= 18
script_binding			= bind_anomaly.Init
min_speed_to_react      = 1.50 ;7.01

hit_type                = chemical_burn
hit_impulse_scale		= 0.0
effective_radius		= 1 ;размер радиуса в процентах от оригинального, где действует зона
postprocess				= anomaly_fuzz

shape_transp_color		= 255, 0, 0, 60
shape_edge_color        = 32, 32, 32, 255

;----------- Anomaly settings -----------------------
min_start_power         = 1.9
max_start_power         = 2.0
attenuation             = 1
period                  = 1

;idle_sound             = anomaly\mosquito_bald_idle    ; Постоянный звук
blowout_sound           = anomaly\burning_fuzz_blowout  ; Во время выброса(удара) в центре аномалии
hit_sound               = anomaly\burning_fuzz_hit      ; На персонаже, когда тот получает хит
;entrance_sound         = anomaly\electra_hit           ; При попадании объекта в аномалию

hit_effect              = anomaly2\hit_metal_02

idle_particles          = anomaly_new\fuzz\idle
blowout_particles       = anomaly_new\fuzz\blow

idle_small_particles    = anomaly_new\fuzz\idle_small
idle_big_particles      = anomaly_new\fuzz\idle_big

disable_time            = 500	; Время игнорирования неживого объекта в зоне (-1 если не нужно)
disable_time_small      = 500	; Время игнорирования маленького неживого объекта в зоне (-1 если не нужно)
disable_idle_time       = 1000	; Время отключения idle партиклов

awaking_time            = 50
blowout_time            = 1000	
accamulate_time         = 5000

attack_animation_start  = 10
attack_animation_end    = 1000

ignore_nonalive			= false;
ignore_small			= false;
ignore_artefacts		= true

blowout_light			= off
idle_light				= off
blowout_wind			= off
visible_by_detector		= off ;on

;-------------------------------------------------------------------------------
;------ Рождение артефактов ----------------------------------------------------

artefacts						        = af_cotton, 1.0, af_deadhead, 0.03
artefacts_after_surge			        = af_cotton, 1.0, af_deadhead, 0.03
artefact_spawn_probability_after_surge	= 0.01

spawn_blowout_artefacts			        = on					; Рождение артефакта после смерти живого существа, или объекта (это главный рубильник, если отключить то всё что ниже перестанет использоваться)
birth_on_object 				        = false					; Рождение артефакта при попадание объекта в аномалию (не живого существа, а например болта)
birth_on_alive 					        = true					; Рождение артефакта при смерти живого существа внутри аномалии (не объекта)
birth_on_corpse 				        = false					; Рождение артефакта при попадании мёртвого существа в аномалию (если закинем труп то она родит артефакт)
artefact_spawn_probability		        = 0.7					; Базовая вероятность рождения при входе объекта в зону (для объекта/трупа/живого)
birth_on_death_probability 		        = -1					; Опционально. Отдельная вероятность, если существо умерло ВНУТРИ аномалии. -1 = не используется (берётся artefact_spawn_probability). 0.0 = никогда не рождать от смерти
artefact_spawn_particles		        = anomaly2\pux_blast	; Партиклы, которые отыграются на месте рождения артефакта (опционально)
artefact_born_sound				        = anomaly\pux_blast		; Звук, который отыграются на месте рождения артефакта (опционально)
throw_out_power					        = 3						; Импульс с которым артефакт будет выброшен из зоны в произвольном направлении
artefact_spawn_height			        = 5						; Высота в метрах над центром зоны где будет рожден артефакт

[zone_burning_fuzz_weak]:zone_burning_fuzz
$spawn					= "zones\burning fuzz weak"
min_speed_to_react		= 1.50 ;4.00

;----------- Anomaly settings -----------------------
min_start_power			= 0.59
max_start_power			= 0.60
attenuation				= 1
period					= 1


[zone_burning_fuzz_average]:zone_burning_fuzz
$spawn					= "zones\burning fuzz average"
min_speed_to_react		= 1.50 ;3.00

;----------- Anomaly settings -----------------------
min_start_power			= 0.9
max_start_power			= 1.0
attenuation				= 1
period					= 1


[zone_burning_fuzz_strong]:zone_burning_fuzz
$spawn					= "zones\burning fuzz strong"
min_speed_to_react		= 1.50	;1.00 < 2.00

;----------- Anomaly settings -----------------------
min_start_power			= 1.9
max_start_power			= 2.0
attenuation				= 1
period					= 1
