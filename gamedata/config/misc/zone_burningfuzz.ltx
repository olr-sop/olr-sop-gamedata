[zone_burning_fuzz]
GroupControlSection	= spawn_group_zone
$spawn 			= "zones\burning fuzz"
;$prefetch 		= 16
class			= Z_MBALD ;ZS_BFUZZ
hit_impulse_scale	= 0
effective_radius	= 1 ;0.75 ;размер радиуса в процентах от оригинального, где действует зона
sound			= zone_mosquito_bald
postprocess		= postprocess_fuzz
min_speed_to_react = 1.50 ;7.01

ef_anomaly_type			= 1
ef_weapon_type			= 13

throw_impulse		= 0.1
script_binding  		= bind_anomaly.Init

artefacts		=
BirthProbability = 0.0

;----------- Anomaly settings -----------------------
min_start_power		= 1.9
max_start_power		= 2.0
attenuation			= 1
period				= 1
min_artefact_count	= 0
max_artefact_count	= 0




hit_type		= burn ;chemical_burn
hit_effect		= anomaly2\hit_metal_02

idle_particles		= anomaly2\pux_idle
blowout_particles	= anomaly2\pux_blast

;hit_small_particles		= hit_fx\hit_metal_02
;hit_big_particles			= anomaly2\
idle_small_particles		= anomaly2\pux_damage_smoke_01
idle_big_particles			= anomaly2\pux_damage_smoke_02
;entrance_small_particles	= anomaly2\electra_entrance_small
;entrance_big_particles		= anomaly2\electra_entrance_big

;idle_sound					= anomaly\mosquito_bald_idle
blowout_sound				= anomaly\pux_blast
hit_sound					= anomaly\electra_hit
;entrance_sound				= anomaly\electra_hit

disable_time				= 500	;время игнорирования неживого объекта в зоне (-1 если не нужно)
disable_time_small			= 500	;время игнорирования маленького неживого объекта в зоне (-1 если не нужно)
disable_idle_time			= 1000	;время отключения idle партиклов

awaking_time				= 1000
blowout_time				= 300	
accamulate_time				= 1000

;attack_animation_start		= 10
;attack_animation_end		= 100

ignore_nonalive		= false;
ignore_small		= false;
ignore_artefacts	= true

blowout_light		= off
idle_light			= off
actor_blowout_radius_percent	= 0.9

visible_by_detector = on

blowout_wind		= off

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;рождение артефактов во время срабатывания
spawn_blowout_artefacts = off



[zone_burning_fuzz1]
GroupControlSection	= spawn_group_zone
$spawn 			= "zones\burning fuzz1"
;$prefetch 		= 16
class			= ZS_BFUZZ
visual			= physics\anomaly\fuzz 
min_speed_to_react = 1.50 ;7.01
ef_anomaly_type			= 6
ef_weapon_type			= 18

script_binding  		= bind_anomaly.Init

hit_impulse_scale	= 0.0
effective_radius	= 1 ;0.75 ;размер радиуса в процентах от оригинального, где действует зона
sound			= zone_mosquito_bald
postprocess		= postprocess_fuzz


artefacts		= af_rusty_thorn,0.7, af_rusty_kristall, 0.3
BirthProbability = 0.2 ;0.0

;----------- Anomaly settings -----------------------
min_start_power		= 1.9
max_start_power		= 2.0
attenuation			= 1
period				= 1
min_artefact_count	= 0
max_artefact_count	= 0


hit_type		= chemical_burn
hit_effect		= anomaly2\hit_metal_02

idle_particles		= anomaly2\pux_idle
blowout_particles	= anomaly2\pux_blast

;hit_small_particles		= hit_fx\hit_metal_02
;hit_big_particles			= anomaly2\
idle_small_particles		= anomaly2\pux_damage_smoke_01
idle_big_particles			= anomaly2\pux_damage_smoke_02
;entrance_small_particles	= anomaly2\electra_entrance_small
;entrance_big_particles		= anomaly2\electra_entrance_big

;idle_sound			= anomaly\mosquito_bald_idle
blowout_sound		= anomaly\burning_fuzz_blowout
hit_sound			= anomaly\burning_fuzz_hit
;entrance_sound		= anomaly\electra_hit

disable_time		= 500	;время игнорирования неживого объекта в зоне (-1 если не нужно)
disable_time_small	= 500		;время игнорирования маленького неживого объекта в зоне (-1 если не нужно)
disable_idle_time	= 1000	;время отключения idle партиклов

awaking_time				= 50
blowout_time				= 1000	
accamulate_time				= 5000

attack_animation_start		= 10
attack_animation_end		= 1000

ignore_nonalive		= false;
ignore_small		= false;
ignore_artefacts	= true

blowout_light		= off
idle_light			= off

visible_by_detector = off ;on

blowout_wind		= off

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;рождение артефактов во время срабатывания
spawn_blowout_artefacts = off ;on
artefact_spawn_probability = 0.7
throw_out_power = 3			;импульс с которым артефакт будет выброшен из зоны в произвольном направлении
artefact_spawn_height = 5		;(м) высота на центром зоны где будет рожден артефакт



