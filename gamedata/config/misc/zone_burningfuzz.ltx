[zone_burning_fuzz]
GroupControlSection		= spawn_group_zone
$spawn					= "zones\burning fuzz"
;$prefetch				= 16
class					= ZS_BFUZZ
ef_anomaly_type			= 1
ef_weapon_type			= 13
script_binding			= bind_anomaly.Init

hit_type				= chemical_burn
hit_impulse_scale		= 0
effective_radius		= 1		;������ ������� � ��������� �� �������������, ��� ��������� ����
actor_blowout_radius_percent= 0.9
postprocess				= anomaly_fuzz
min_speed_to_react		= 1.50 ;7.01
throw_impulse			= 0.1

shape_transp_color		= 255, 0, 0, 60
shape_edge_color		= 32, 32, 32, 255

;----------- Anomaly settings -----------------------
min_start_power			= 1.9
max_start_power			= 2.0
attenuation				= 1
period					= 1
min_artefact_count		= 0
max_artefact_count		= 0

;idle_sound				= anomaly\mosquito_bald_idle
blowout_sound			= anomaly\pux_blast
hit_sound				= anomaly\electra_hit
;entrance_sound			= anomaly\electra_hit

hit_effect				= anomaly2\hit_metal_02

idle_particles			= anomaly_new\fuzz\idle
blowout_particles		= anomaly_new\fuzz\blow

;hit_small_particles	= hit_fx\hit_metal_02
;hit_big_particles		= anomaly2\

idle_small_particles	= anomaly_new\fuzz\idle_small
idle_big_particles		= anomaly_new\fuzz\idle_big

;entrance_small_particles= anomaly2\electra_entrance_small
;entrance_big_particles	= anomaly2\electra_entrance_big

disable_time			= 500	;����� ������������� �������� ������� � ���� (-1 ���� �� �����)
disable_time_small		= 500	;����� ������������� ���������� �������� ������� � ���� (-1 ���� �� �����)
disable_idle_time		= 1000	;����� ���������� idle ���������

awaking_time			= 1000
blowout_time			= 300	
accamulate_time			= 1000

;attack_animation_start	= 10
;attack_animation_end	= 100

ignore_nonalive			= false;
ignore_small			= false;
ignore_artefacts		= true

blowout_light			= off
idle_light				= off
visible_by_detector		= on
blowout_wind			= off

;рождение артефактов 
artefacts						= af_cotton, 1.0, af_deadhead, 0.03

;во время срабатывания в online
spawn_blowout_artefacts			= on					; рождение артефактов во время срабатывания, для true принимаются on/yes/true/1, иначе значение будет false

artefact_spawn_probability		= 0.7					;вероятность, что во время срабатывания аномалии будет рожден артефакт
artefact_spawn_cycles			= 2						; кол-во проходов при смерти сущности в аномалии, 2 по умолчанию
artefact_spawn_particles		= anomaly2\pux_blast	;партиклы, которые отыграются на месте рождения артефакта (опционально)
artefact_born_sound				= anomaly\pux_blast		;звук, который отыграются на месте рождения артефакта (опционально)

throw_out_power					= 3					;импульс с которым артефакт будет выброшен из зоны в произвольном направлении
artefact_spawn_height			= 5						;(м) высота на центром зоны где будет рожден артефакт

