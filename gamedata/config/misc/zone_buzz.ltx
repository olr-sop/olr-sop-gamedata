[zone_buzz]
GroupControlSection			= spawn_group_zone
$spawn 						= "zones\buzz"
$prefetch 					= 16
class						= ZS_MBALD

hit_impulse_scale			= 0.1
effective_radius			= 1.0 ;размер радиуса в процентах от оригинального, где действует зона
actor_blowout_radius_percent		= 0.9

ef_anomaly_type				= 1
ef_weapon_type				= 13

postprocess					= postprocess_flame

throw_impulse		= 0.1
script_binding  		= bind_anomaly.Init
	
artefacts					= af_ameba_slime, 0.8, af_ameba_slug, 0.2, af_ameba_mica, 0.0
BirthProbability 			= 0.2


;----------- Anomaly settings -----------------------
min_start_power		= 1.9
max_start_power		= 2.0
attenuation			= 1
period				= 1
min_artefact_count	= 0
max_artefact_count	= 0


idle_particles				= anomaly2\studen_idle_bottom
blowout_particles			= anomaly2\studen_blowout

hit_small_particles			= anomaly2\gravity_smoke_02
hit_big_particles			= anomaly2\gravi_damage_smoke00
idle_small_particles		= anomaly2\studen_idle_bottom
idle_big_particles			= anomaly2\studen_idle_bottom

idle_sound					= anomaly\witches_jelly_idle; burning_fuzz_blowout		;постоянный звук
blowout_sound				= anomaly\witches_jelly_hit; burning_fuzz_hit		;во время выброса(удара) в центре аномалии	
hit_sound					= anomaly\witches_jelly_hit; burning_fuzz_hit		;на персонаже, когда тот получает хит
entrance_sound				= anomaly\witches_jelly_hit; burning_fuzz_hit		;при попадании объекта в аномалию

hit_type					= chemical_burn
							  
disable_time				= 10000	;время игнорирования неживого объекта в зоне (-1 если не нужно)
disable_time_small			= -1	;время игнорирования маленького неживого объекта в зоне (-1 если не нужно)
disable_idle_time			= 50000	;время отключения idle партиклов

ignore_nonalive				= false
ignore_small				= true
ignore_artefacts			= true

blowout_light				= on
light_color		    		= 0.6,0.8,0.4 ;0.2 ;1.1,1.7,1.4
light_animation             		= light_green_02 ;_01
light_range		    		= 5 ;5
light_time 		    		= 4 ;0.35
light_height				= 0.75			;подъем источника света на высоту


idle_light					= on
idle_light_range			= 3 ;3.0
idle_light_range_delta 		= 0.25
idle_light_anim				= light_green_02 ;_02
idle_light_height			= 0.70			;подъем источника света на высоту

awaking_time				= 50
blowout_time				= 200 ;100	
accamulate_time				= 500

visible_by_detector 		= off

blowout_wind				= off

blowout_wind_time_start 	= 0
blowout_wind_time_peak  	= 600
blowout_wind_time_end		= 899
blowout_wind_power			= 0.5			;сила поднимаего ветра (от 0 до 1), в момент blowout_wind_time_peak 

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;рождение артефактов во время срабатывания
spawn_blowout_artefacts = on
throw_out_power = 0 ;20
artefact_spawn_height = 3
artefact_spawn_probability = 0.7




