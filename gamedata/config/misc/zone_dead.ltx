[zone_dead]
GroupControlSection		= spawn_group_zone
$spawn 					= "zones\dead"
$def_sphere 			= 130
$prefetch 				= 16
class					= ZS_MBALD
ef_anomaly_type			= 1
ef_weapon_type			= 13
script_binding			= bind_anomaly.Init

hit_impulse_scale		= 0.0
effective_radius		= 1.0 ; Размер радиуса в процентах от оригинального, где действует зона

throw_impulse			= 0.1

shape_transp_color		= 5, 5, 5, 60
shape_edge_color		= 32, 32, 32, 255

;----------- Anomaly settings -----------------------
min_start_power		    = 0.000001
max_start_power		    = 0.000002
attenuation			    = 1
period				    = 1

entrance_sound		    = anomaly\blackout

hit_type				= radiation

disable_time			= 10000	; Время игнорирования неживого объекта в зоне (-1 если не нужно)
disable_time_small		= -1	; Время игнорирования маленького неживого объекта в зоне (-1 если не нужно)
disable_idle_time		= 50000	; Время отключения idle партиклов

ignore_nonalive			= true
ignore_small			= true
ignore_artefacts		= true

blowout_light		    = off

idle_light				= off

idle_light_range		= 1
idle_light_range_delta 	= 0.25
idle_light_anim			= light_green_02
idle_light_height		= 0.30			

awaking_time			= 50
blowout_time			= 200
accamulate_time			= 500
blowout_wind			= off
visible_by_detector 	= off

;-------------------------------------------------------------------------------
;------ Рождение артефактов ----------------------------------------------------

artefacts					            = af_dummy_simple, 0.0
artefacts_after_surge			        = af_dummy_simple, 1.0
artefact_spawn_probability_after_surge	= 0.001

spawn_blowout_artefacts                 = off   ; Рождение артефакта после смерти живого существа, или объекта (это главный рубильник, если отключить то всё что ниже перестанет использоваться)