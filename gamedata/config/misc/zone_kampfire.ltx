[zone_flame_small]
GroupControlSection			= spawn_group_zone
$spawn 						= "zones\campfire"
$def_sphere 				= 0.6
$prefetch 					= 16
class						= Z_MBALD

hit_impulse_scale			= 0.0
effective_radius			= 1.3 ; Размер радиуса в процентах от оригинального, где действует зона

ef_anomaly_type			    = 1
ef_weapon_type			    = 13

throw_impulse		        = 0.1
postprocess				    = effector_flame

script_binding  		    = bind_kampfire.init

;----------- Anomaly settings -----------------------
min_start_power		        = 0.39
max_start_power		        = 0.40
attenuation			        = 1
period				        = 1

idle_particles				= 
blowout_particles			= 

hit_small_particles			= damage_fx\burn_creatures00
hit_big_particles			= damage_fx\burn_creatures00
idle_small_particles		= damage_fx\burn_creatures00
idle_big_particles			= damage_fx\burn_creatures00

idle_particles_dont_stop	= true

idle_sound					= anomaly\fire		; Постоянный звук
blowout_sound				= anomaly\fire		; Во время выброса(удара) в центре аномалии
hit_sound					= anomaly\fire		; На персонаже, когда тот получает хит
entrance_sound				= anomaly\fire		; При попадании объекта в аномалию

hit_type					= burn

disable_time				= 10000	            ; Время игнорирования неживого объекта в зоне (-1 если не нужно)
disable_time_small			= -1	            ; Время игнорирования маленького неживого объекта в зоне (-1 если не нужно)
disable_idle_time			= 50000	            ; Время отключения idle партиклов

ignore_nonalive				= false
ignore_small				= true
ignore_artefacts			= true

blowout_light				= on
light_color					= 1.855,1.337,1
light_animation				= light\fireplace\fireplace_a
light_range					= 24
light_time 					= 0.35
light_height				= 1.5	            ; Подъём источника света на высоту

idle_light					= on
idle_light_r2_only			= on
idle_light_range			= 16
idle_light_range_delta		= 0.25
idle_light_anim				= light\fireplace\fireplace_b
idle_light_height			= 1.5	            ; Подъём источника света на высоту

awaking_time				= 0
blowout_time				= 1000	
accamulate_time				= 0
visible_by_detector 		= off
blowout_wind				= off

;-------------------------------------------------------------------------------
;------ Рождение артефактов ----------------------------------------------------

artefacts					            = 
artefacts_after_surge			        =
artefact_spawn_probability_after_surge	= 0

spawn_blowout_artefacts			        = off	; Рождение артефакта после смерти живого существа, или объекта (это главный рубильник, если отключить то всё что ниже перестанет использоваться)