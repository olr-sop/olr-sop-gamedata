entrance_sound		= anomaly\fire									;��� ��������� ������� � ��������

hit_type			= burn

disable_time		= 10000		;����� ������������� �������� ������� � ���� (-1 ���� �� �����)
disable_time_small	= -1		;����� ������������� ���������� �������� ������� � ���� (-1 ���� �� �����)
disable_idle_time	= 50000		;����� ���������� idle ���������

ignore_nonalive		= false
ignore_small		= true
ignore_artefacts	= true

blowout_light		= off
