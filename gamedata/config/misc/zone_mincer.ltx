[zone_mincer]
GroupControlSection			= spawn_group_zone
$spawn 						= "zones\mincer"
$prefetch 					= 16
$def_sphere 				= 2
class						= ZS_MINCE
ef_anomaly_type				= 5
ef_weapon_type				= 17
script_binding				= bind_anomaly.Init

throw_impulse				= 24000
postprocess					= anomaly_mincer
enable_effector				= true

shape_transp_color			= 0, 160, 160, 60
shape_edge_color			= 32, 32, 32, 255

;----------- Anomaly settings -----------------------
min_start_power				= 4.9
max_start_power				= 5.0
attenuation					= 1
period						= 1


idle_particles				= anomaly_new\mincer\idle		;anomaly\a-03-sparks-03
blowout_particles			= anomaly_new\mincer\blow		;anomaly\a-03-flash-sparks_old00
tearing_particles			= anomaly2\body_tear_00
torn_particles				= anomaly2\body_tear_01

hit_small_particles			= anomaly_new\mincer\hit		;anomaly\a-03-growing-sparks
hit_big_particles			= anomaly_new\mincer\hit		;anomaly2\group_items\gravity_flash_02

entrance_small_particles	= anomaly_new\mincer\entrance	;anomaly\a-03-flash-sparks_old00
entrance_big_particles		= anomaly_new\mincer\entrance	;anomaly\a-03-flash-sparks

tele_particles_small		= anomaly2\gravity_damage_01_smoke	;anomaly2\gravity_damage_01_smoke
tele_particles_big			= anomaly2\gravity_damage_02_smoke	


idle_sound					= anomaly\mincer_idle		; Постоянный звук
blowout_sound				= anomaly\mincer_blowout    ; Во время выброса(удара) в центре аномалии
hit_sound					= anomaly\mincer_hit		; На персонаже, когда тот получает хит
body_tearing_sound			= anomaly\body_tearing		; Звук разрывания трупа
entrance_sound				= anomaly\gravity_entrance	; При попадании объекта в аномалию

hit_type					= shock
hit_impulse_scale			= 100		                ; Соотношение физического импульса и силы хита
effective_radius			= 1                         ; Размер радиуса в процентах от оригинального, где действует зона

disable_time				= -1 ;50 ;5000	            ; Время игнорирования неживого объекта в зоне (-1 если не нужно)
disable_time_small			= -1 ;5 ;500		        ; Время игнорирования маленького неживого объекта в зоне (-1 если не нужно)
disable_idle_time			= 100;-1	                ; Время отключения idle партиклов

ignore_nonalive				= true
ignore_small				= false
ignore_artefacts			= true

blowout_light				= on
light_color					= 1.21, 1.09, 0.93
light_range					= 24.0
light_time					= 0.15
light_height				= 1.5			; Подъём источника света на высоту

idle_light					= off

awaking_time				= 200
blowout_time				= 200
accamulate_time				= 30


blowout_light_time			= 100
blowout_explosion_time		= 100

;параметры телекинеза для зоны
throw_in_impulse			= 1	    ; Сила импульса втягивания (для тела 100кг)
throw_out_impulse			= 100	; Сила выбрасывания взрывом
throw_in_impulse_alive		= 10	; Сила импульса втягивания для живых
throw_in_atten				= 2		; Коэфф. затягивания (чем меньше, тем плавнее затягивает)
blowout_radius_percent		= 1.2	; Радиус (в процентах от всего радиуса) непосредственно выброса
actor_blowout_radius_percent= 0.88

tele_height					= 0	    ; Высота подъема телекинеза 
time_to_tele				= 7000	; Время деражания объекта в воздухе
tele_pause					= 4000	; Пауза перед тем как снова поднять упавший объект

visible_by_detector			= on


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; ветер
blowout_wind				= on

blowout_wind_time_start		= 0
blowout_wind_time_peak		= 600
blowout_wind_time_end		= 1200; 2499
blowout_wind_power			= 0.5			; Сила поднимаего ветра (от 0 до 1), в момент blowout_wind_time_peak

;-------------------------------------------------------------------------------
;------ Рождение артефактов ----------------------------------------------------

artefacts					            = af_toadeye, 1.0
artefacts_after_surge			        = af_toadeye, 1.0
artefact_spawn_probability_after_surge	= 0.01

spawn_blowout_artefacts			        = on					            ; Рождение артефакта после смерти живого существа, или объекта (это главный рубильник, если отключить то всё что ниже перестанет использоваться)
birth_on_object 				        = false					            ; Рождение артефакта при попадание объекта в аномалию (не живого существа, а например болта)
birth_on_alive 					        = true					            ; Рождение артефакта при смерти живого существа внутри аномалии (не объекта)
birth_on_corpse 				        = false					            ; Рождение артефакта при попадании мёртвого существа в аномалию (если закинем труп то она родит артефакт)
artefact_spawn_probability		        = 0.2					            ; Базовая вероятность рождения при входе объекта в зону (для объекта/трупа/живого)
birth_on_death_probability 		        = -1					            ; Опционально. Отдельная вероятность, если существо умерло ВНУТРИ аномалии. -1 = не используется (берётся artefact_spawn_probability). 0.0 = никогда не рождать от смерти
birth_on_torn_probability 		        = 0.25					            ; Только у Mincer (Мясорубка). Вероятность рождения при разрыве объекта (когда аномалия его разрывает/уничтожает)
artefact_spawn_particles		        = anomaly2\gravi_anomaly_shield_00	; Партиклы, которые отыграются на месте рождения артефакта (опционально)
artefact_born_sound				        = anomaly\mosquito_bald_hit		    ; Звук, который отыграются на месте рождения артефакта (опционально)
throw_out_power					        = 15					            ; Импульс с которым артефакт будет выброшен из зоны в произвольном направлении
artefact_spawn_height			        = 3						            ; Высота в метрах над центром зоны где будет рожден артефакт


[zone_mincer_weak]:zone_mincer
$spawn 						= "zones\mincer_weak"
detector_buzzer_radius 		= 2.8
hit_impulse_scale			= 1;0.1
effective_radius			= 0.7

;----------- Anomaly settings -----------------------
min_start_power				= 1.15
max_start_power				= 1.4
attenuation					= 1
period						= 1


throw_in_impulse			= 0	    ; Сила импульса втягивания (для тела 100кг)
throw_out_impulse			= 0	    ; Сила выбрасывания взрывом
throw_in_impulse_alive		= 0	    ; Сила импульса втягивания для живых
throw_in_atten				= 2		; Коэфф. затягивания (чем меньше, тем плавнее затягивает)
blowout_radius_percent		= 1	    ; Радиус (в процентах от всего радиуса) непосредственно выброса
actor_blowout_radius_percent= 0.68

artefacts					            = af_toadeye, 0.4, af_deadhead, 0.03
artefacts_after_surge			        = af_toadeye, 0.4, af_deadhead, 0.03
artefact_spawn_probability_after_surge	= 0.01


; Не производящая артефактов слабая аномалия
[zone_mincer_weak_noart]:zone_mincer_weak
$spawn 						            = "zones\mincer_weak_noart"

;-------------------------------------------------------------------------------
;------ Рождение артефактов ----------------------------------------------------

spawn_blowout_artefacts		            = off
artefact_spawn_probability_after_surge	= 0

[zone_mincer_average]:zone_mincer
shape_transp_color			= 0, 145, 160, 60
$spawn 						= "zones\mincer_average"
hit_impulse_scale			= 1;0.3
effective_radius			= 0.9 
detector_buzzer_radius 		= 3

;----------- Anomaly settings -----------------------
min_start_power				= 1.4
max_start_power				= 1.8
attenuation					= 1
period						= 1

actor_blowout_radius_percent= 0.75

;-------------------------------------------------------------------------------
;------ Рождение артефактов ----------------------------------------------------

artefacts					            = af_toadeye, 0.5, af_deadhead, 0.03
artefacts_after_surge			        = af_toadeye, 0.5, af_deadhead, 0.03
artefact_spawn_probability_after_surge	= 0.05
birth_on_torn_probability 		        = 0.3

[zone_mincer_average_noart]:zone_mincer_average
$spawn 						            = "zones\mincer_average_noart"

;-------------------------------------------------------------------------------
;------ Рождение артефактов ----------------------------------------------------

spawn_blowout_artefacts		            = off
artefact_spawn_probability_after_surge	= 0

[zone_mincer_strong]:zone_mincer
shape_transp_color			= 0, 70, 160, 60
$spawn 						= "zones\mincer_strong"
postprocess					= anomaly_mincer_strong
detector_buzzer_radius 		= 3
hit_impulse_scale			= 1;0.3
effective_radius			= 0.9 

;----------- Anomaly settings -----------------------
min_start_power				= 2.0
max_start_power				= 2.5
attenuation					= 1
period						= 1

idle_particles				= anomaly2\electra_idle ;anomaly\galantine_old00
blowout_particles			= anomaly2\electra2_blast
tearing_particles			= anomaly2\body_tear_00
torn_particles				= anomaly2\body_tear_01

hit_small_particles			= anomaly2\artefact\anomaly_electra_idle_00 ;electra_entrance_small
hit_big_particles			= anomaly2\artefact\anomaly_electra_idle_00 ;anomaly_electra_is_killing_me
idle_small_particles		= anomaly2\electra_damage_01_smoke 
idle_big_particles			= anomaly2\artefact\anomaly_electra_is_killing_me ;anomaly2\electra_damage_02_smoke 
entrance_small_particles	= anomaly2\artefact_electra_blast_finished
entrance_big_particles		= anomaly2\artefact_electra_blast_start_00 ;anomaly2\emi_entrance_big_00

idle_sound					= anomaly\electra_idle
blowout_sound				= anomaly\electra_blowout
hit_sound					= anomaly\electra_hit
entrance_sound				= anomaly\electra_hit
body_tearing_sound			= anomaly\body_tearing

blowout_light				= on
light_color					= 0.75, 0.82, 1.0
light_range					= 16.0
light_time 					= 0.4
light_height				= 1.5

idle_light					= on
idle_light_range			= 2.5
idle_light_range_delta 		= 0.25
idle_light_anim				= electra_01
idle_light_height			= 0.70

;-------------------------------------------------------------------------------
;------ Рождение артефактов ----------------------------------------------------

artefacts					            = af_toadeye, 0.6, af_electrosphere, 0.4, af_deadhead, 0.03
artefacts_after_surge			        = af_toadeye, 0.6, af_electrosphere, 0.4, af_deadhead, 0.03
artefact_spawn_probability_after_surge	= 0.1

birth_on_torn_probability 		        = 0.35

[zone_mincer_strong_noart]:zone_mincer_strong
$spawn 						            = "zones\mincer_strong_noart"

;-------------------------------------------------------------------------------
;------ Рождение артефактов ----------------------------------------------------

spawn_blowout_artefacts		            = off
artefact_spawn_probability_after_surge	= 0
