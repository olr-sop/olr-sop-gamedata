[zone_mine_field]
GroupControlSection	    = spawn_group_zone
$spawn 			        = "zones\mine_field"
$prefetch 		        = 16
class			        = Z_MBALD
hit_impulse_scale	    = 25 ;1;0.15;0.5 ;0.1
effective_radius	    = 3 ; Размер радиуса в процентах от оригинального, где действует зона
ef_anomaly_type		    = 1
ef_weapon_type		    = 13
script_binding		    = bind_anomaly.Init

throw_impulse		    = 0.1

hit_type			    = explosion

shape_transp_color	    = 255, 0, 0, 60
shape_edge_color	    = 32, 32, 32, 255

;----------- Anomaly settings -----------------------
min_start_power		    = 0.9
max_start_power		    = 1.0
attenuation			    = 1
period				    = 1

idle_particles		    = static\mine
blowout_particles	    = explosions\explosion_mine

blowout_sound		    = weapons\f1\explode	    ; Во время выброса(удара) в центре аномалии
hit_sound			    = anomaly\mosquito_bald_hit	; На персонаже, когда тот получает хит
entrance_sound		    = weapons\general\mine_on	; При попадании объекта в аномалию


awaking_time		    = 50
blowout_time		    = 1000	
accamulate_time		    = 100000 ;200

blowout_light_time		= 150
blowout_explosion_time	= 150
blowout_particles_time	= 150
blowout_sound_time  	= 150

disable_time		    = -1        ; Время игнорирования неживого объекта в зоне (-1 если не нужно)
disable_time_small	    = -1		; Время игнорирования маленького неживого объекта в зоне (-1 если не нужно)
disable_idle_time	    = -1		; Время отключения idle партиклов

ignore_nonalive		    = false
ignore_small		    = false
ignore_artefacts	    = true

blowout_light		    = on
light_color		        = 0.9,0.9,0.8
light_range		        = 30.0
light_time 		        = 0.3;0.35
light_height		    = 1.5			; Подъём источника света на высоту


idle_light			    = off

visible_by_detector     = off

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; ветер
blowout_wind		        = on

blowout_wind_time_start     = 150
blowout_wind_time_peak      = 200
blowout_wind_time_end		= 1001;999
blowout_wind_power			= 0.5			; Сила поднимаего ветра (от 0 до 1), в момент blowout_wind_time_peak 


;-------------------------------------------------------------------------------
;------ Рождение артефактов ----------------------------------------------------

artefacts					            = 
artefacts_after_surge			        =
artefact_spawn_probability_after_surge	= 0

;во время срабатывания в online
spawn_blowout_artefacts			        = off	; Рождение артефакта после смерти живого существа, или объекта (это главный рубильник, если отключить то всё что ниже перестанет использоваться)