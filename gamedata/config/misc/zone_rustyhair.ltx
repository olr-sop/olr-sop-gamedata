[zone_rusty_hair]
GroupControlSection		= spawn_group_zone
$spawn 					= "zones\rusty hair"
;$prefetch 				= 16
class					= ZS_BFUZZ
visual					= physics\anomaly\liana_01
ef_anomaly_type			= 7
ef_weapon_type			= 19
script_binding			= bind_anomaly.Init
min_speed_to_react		= 1.5

throw_impulse			= 0.1
hit_impulse_scale		= 0.05 ;0.5
effective_radius		= 1 ;размер радиуса в процентах от оригинального, где действует зона
postprocess				= anomaly_rustyhair

shape_transp_color		= 255, 0, 0, 60
shape_edge_color		= 32, 32, 32, 255

;----------- Anomaly settings -----------------------
min_start_power		= 0.9
max_start_power		= 1.0
attenuation			= 1
period				= 1
min_artefact_count	= 1
max_artefact_count	= 2

hit_big_particles			= anomaly2\gravity_damage_02_blood3

blowout_sound			= anomaly\burning_fuzz_blowout
hit_sound				= anomaly\burning_fuzz_hit

hit_type		    = burn

disable_time		= -1	;время игнорирования неживого объекта в зоне (-1 если не нужно)
disable_time_small	= 500		;время игнорирования маленького неживого объекта в зоне (-1 если не нужно)
disable_idle_time	= -1	;время отключения idle партиклов

awaking_time			= 50
blowout_time			= 1000	
accamulate_time			= 5000

attack_animation_start	= 10
attack_animation_end	= 1000

ignore_nonalive			= true;
ignore_small			= false;
ignore_artefacts		= true

blowout_light			= off
idle_light				= off
blowout_wind			= off
visible_by_detector		= on

artefacts						= af_rusty_hair, 1.0
spawn_blowout_artefacts			= on
artefact_spawn_probability		= 0.7					;вероятность, что во время срабатывания аномалии будет рожден артефакт
artefact_spawn_cycles			= 2						; кол-во проходов при смерти сущности в аномалии, 2 по умолчанию
artefact_spawn_particles		= anomaly2\pux_blast	;партиклы, которые отыграются на месте рождения артефакта (опционально)
artefact_born_sound				= anomaly\pux_blast		;звук, который отыграются на месте рождения артефакта (опционально)

throw_out_power					= 3						;импульс с которым артефакт будет выброшен из зоны в произвольном направлении
artefact_spawn_height			= 5						;(м) высота на центром зоны где будет рожден артефакт