[zone_witches_galantine]
GroupControlSection			= spawn_group_zone
$spawn						= "zones\witches galantine"
$prefetch					= 16
$def_sphere 				= 2
class						= ZS_MBALD
ef_anomaly_type				= 1
ef_weapon_type				= 13
script_binding				= bind_anomaly.Init

hit_type					= chemical_burn
hit_impulse_scale			= 0.1
effective_radius			= 1.0 ;������ ������� � ��������� �� �������������, ��� ��������� ����
actor_blowout_radius_percent= 0.9
postprocess					= anomaly_acidfog
enable_effector				= true

throw_impulse				= 0.1

shape_transp_color		= 255, 0, 0, 60
shape_edge_color		= 32, 32, 32, 255

;----------- Anomaly settings -----------------------
min_start_power		= 0.99
max_start_power		= 1.00
attenuation			= 1
period				= 1
min_artefact_count	= 0
max_artefact_count	= 0


idle_particles				= anomaly2\studen_idle_bottom
blowout_particles			= anomaly2\studen_blowout

hit_small_particles			= anomaly2\gravity_smoke_02
hit_big_particles			= anomaly2\gravi_damage_smoke00
idle_small_particles		= anomaly2\studen_idle_bottom
idle_big_particles			= anomaly2\studen_idle_bottom

idle_sound					= anomaly\witches_jelly_idle; burning_fuzz_blowout		;���������� ����
blowout_sound				= anomaly\witches_jelly_hit; burning_fuzz_hit		;�� ����� �������(�����) � ������ ��������	
hit_sound					= anomaly\witches_jelly_hit; burning_fuzz_hit		;�� ���������, ����� ��� �������� ���
entrance_sound				= anomaly\witches_jelly_hit; burning_fuzz_hit		;��� ��������� ������� � ��������
							  
disable_time				= 10000	;����� ������������� �������� ������� � ���� (-1 ���� �� �����)
disable_time_small			= -1	;����� ������������� ���������� �������� ������� � ���� (-1 ���� �� �����)
disable_idle_time			= 50000	;����� ���������� idle ���������

ignore_nonalive				= false
ignore_small				= true
ignore_artefacts			= true

blowout_light				= on
light_color					= 0.6,0.8,0.4 ;0.2 ;1.1,1.7,1.4
light_animation				= light_green_02
light_range					= 5 ;5
light_time					= 4 ;0.35
light_height				= 0.75			;������ ��������� ����� �� ������


idle_light					= on
idle_light_range			= 3 ;3.0
idle_light_range_delta		= 0.25
idle_light_anim				= light_green_02 ;_02
idle_light_height			= 0.70			;������ ��������� ����� �� ������

awaking_time				= 50
blowout_time				= 200 ;100	
accamulate_time				= 500

visible_by_detector			= off

blowout_wind				= off

blowout_wind_time_start		= 0
blowout_wind_time_peak		= 600
blowout_wind_time_end		= 899
blowout_wind_power			= 0.5			;���� ���������� ����� (�� 0 �� 1), � ������ blowout_wind_time_peak 

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;рождение артефактов 
artefacts						= af_galantine, 1.0, af_deadhead, 0.03 ; артефакт, его шанс, артефакт, его шанс

;во время срабатывания в online
spawn_blowout_artefacts			= on					; Рождение артефакта после смерти живого существа, или объекта (это главный рубильник, если отключить то всё что ниже перестанет использоваться)
birth_on_object 				= false					; Рождение артефакта при попадание объекта в аномалию (не живого существа, а например болта)
birth_on_alive 					= true					; Рождение артефакта при смерти живого существа внутри аномалии (не объекта)
birth_on_corpse 				= true					; Рождение артефакта при попадании мёртвого существа в аномалию (если закинем труп то она родит артефакт)
artefact_spawn_probability		= 0.7					; Базовая вероятность рождения при входе объекта в зону (для объекта/трупа/живого)
birth_on_death_probability 		= -1					; Опционально. Отдельная вероятность, если существо умерло ВНУТРИ аномалии. -1 = не используется (берётся artefact_spawn_probability). 0.0 = никогда не рождать от смерти
birth_on_torn_probability 		= 0.5					; Только у Mincer (Мясорубка). Вероятность рождения при разрыве объекта (когда аномалия его разрывает/уничтожает)
artefact_spawn_particles		= anomaly2\pux_blast	; Партиклы, которые отыграются на месте рождения артефакта (опционально)
artefact_born_sound				= anomaly\pux_blast		; Звук, который отыграются на месте рождения артефакта (опционально)
throw_out_power					= 3						; Импульс с которым артефакт будет выброшен из зоны в произвольном направлении
artefact_spawn_height			= 5						; Высота в метрах над центром зоны где будет рожден артефакт


