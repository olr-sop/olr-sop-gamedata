[zone_witches_galantine]
GroupControlSection	= spawn_group_zone
$spawn 			= "zones\witches galantine"
$prefetch 		= 16
class			= ZS_MBALD
hit_impulse_scale	= 0.3 ;.03
effective_radius	= 0.85 ;размер радиуса в процентах от оригинального, где действует зона
actor_blowout_radius_percent = 0.65
postprocess		= postprocess_electra

ef_anomaly_type			= 1
ef_weapon_type			= 13

throw_impulse		= 550.1
artefacts		= af_electra_sparkler,0.07, af_electra_flash, 0.025, af_electra_moonlight, 0.005
BirthProbability = 0.05

script_binding  		= bind_anomaly.Init
;----------- Anomaly settings -----------------------
min_start_power		= 1.9
max_start_power		= 2.0
attenuation			= 1
period				= 1
min_artefact_count	= 0
max_artefact_count	= 0
artefact_spawn_idle	= 24  ;насколько часто спонить артефакты в офлайне, в часах
artefact_spawn_rnd	= 20  ;вероятность заспавнить артефакт в процентах.


idle_particles				= anomaly2\electra_idle ;anomaly\galantine_old00
blowout_particles			= anomaly2\electra2_blast

hit_small_particles			= anomaly2\artefact\anomaly_electra_idle_00 ;electra_entrance_small
hit_big_particles			= anomaly2\artefact\anomaly_electra_idle_00 ;anomaly_electra_is_killing_me
idle_small_particles			= anomaly2\electra_damage_01_smoke 
idle_big_particles			= anomaly2\artefact\anomaly_electra_is_killing_me ;anomaly2\electra_damage_02_smoke 
entrance_small_particles		= anomaly2\artefact_electra_blast_finished
entrance_big_particles			= anomaly2\artefact_electra_blast_start_00 ;anomaly2\emi_entrance_big_00

idle_sound				= anomaly\electra_idle; mosquito_bald_idle
blowout_sound				= anomaly\electra_blowout
hit_sound				= anomaly\electra_blowout ;anomaly\electra_hit
entrance_sound				= anomaly\electra_hit1

blowout_light		= on
light_color		    = 0.8,0.9,1
light_range		    = 30.0
light_time 		    = 1;0.35
light_height		= 1.5			;подъем источника света на высоту

idle_light					= on
idle_light_range			= 2.5
idle_light_range_delta 		= 0.25
idle_light_anim				= electra_01
idle_light_height			= 0.70

hit_type		= shock

disable_time		= 1000 ;-1 ;50	;время игнорирования неживого объекта в зоне (-1 если не нужно)
disable_time_small	= 500		;время игнорирования маленького неживого объекта в зоне (-1 если не нужно)
disable_idle_time	= 1000 ;100	;время отключения idle партиклов

awaking_time		= 1000 ;10 ;100
blowout_time		= 1000	
accamulate_time		= 500

ignore_nonalive		= true
ignore_small		= true
ignore_artefacts	= true

visible_by_detector = on

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; ветер
blowout_wind		= off

blowout_wind_time_start     = 0
blowout_wind_time_peak      = 150
blowout_wind_time_end		= 299
blowout_wind_power			= 0.2			;сила поднимаего ветра (от 0 до 1), в момент blowout_wind_time_peak 

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;рождение артефактов во время срабатывания
spawn_blowout_artefacts = on
artefact_spawn_probability = 0.7
throw_out_power = 0 ;50			;импульс с которым артефакт будет выброшен из зоны в произвольном направлении
artefact_spawn_height = 3		;(м) высота на центром зоны где будет рожден артефакт


[zone_witches_galantine_weak]:zone_witches_galantine
$spawn 			= "zones\witches galantine weak"
script_binding  		= bind_anomaly.Init
artefacts		= af_electra_sparkler,0.08, af_electra_flash, 0.02, af_electra_moonlight, 0.01
BirthProbability = 0.1

;----------- Anomaly settings -----------------------
min_start_power		= 1.9
max_start_power		= 2.0
attenuation			= 1
period				= 1
min_artefact_count	= 0
max_artefact_count	= 0
artefact_spawn_idle	= 24  ;насколько часто спонить артефакты в офлайне, в часах
artefact_spawn_rnd	= 20  ;вероятность заспавнить артефакт в процентах.


