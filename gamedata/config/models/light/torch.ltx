[torch_definition]
range			= 15				; range					<in meters>
range_r2		= 15				; range					<in meters>

color			= 1,1,1,1			; four color components	<r,g,b,a> 0.f<X<3.f
color_r2		= 1,1,1,1		; four color components	<r,g,b,a> 0.f<X<3.f

omni_range		= 0.01 ; 1.5		; range					<in meters>
omni_range_r2	= 0.01				; range					<in meters>

omni_color		= 1.0,1.0,1.0,1.0	; four color components	<r,g,b,a> 0.f<X<3.f
omni_color_r2	= 1.0,1.0,1.0,0.0	; four color components	<r,g,b,a> 0.f<X<3.f

color_animator	= light\torch		; color animator name	(empty - not using animator)

max_range		= 30				; range max				<in meters> (increase this when range_curve is low to compensate, see formula below)
max_range_r2	= 25				; range max				<in meters>
curve_range		= 30 				; range curvature, the formula is: range = range_max * atan(range_curve * condition) / (pi/2)

spot_texture	= fx\light\torch	; spot texture name		(using only in Second Render)
spot_angle		= 65 ;60 ;50		; spot angle			<in gradus>

glow_texture	= fx\flares\torch
glow_radius		= 0.15 ;0.1			; glow radius			<in meters>

guide_bone		= lights_bone		; guid bone name		(required)