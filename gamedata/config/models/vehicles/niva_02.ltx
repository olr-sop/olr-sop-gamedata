;Двигатель: используется гауссово распределение, 
;центрированное вокруг m_b (max_torque_rpm). Ширина распределения определяется m_c.
;m_c = _sqrt(2.f * m_power_rpm * (m_power_rpm - m_torque_rpm))
engine_power			= 65.4					; удельная мощность (кВт = л.с.*0,808)
max_power_rpm			= 5200					; (RPM) обороты максимальной мощности.
max_torque_rpm			= 3800					; обороты максимального крутящего момента.
max_engine_rpm			= 6800					; максимально допустимые обороты двигателя.
idling_engine_rpm		= 900					; обороты холостого хода.

;Динамика двигателя
power_increment_factor	= 0.5					; насколько быстро мощность двигателя увеличивается при увеличении оборотов.
power_decrement_factor	= 0.6					; насколько быстро мощность двигателя уменьшается при уменьшении оборотов.
rpm_increment_factor	= 0.4					; насколько быстро обороты двигателя увеличиваются при нажатии на педаль газа.
rpm_decrement_factor	= 0.45					; насколько быстро обороты двигателя уменьшаются при отпускании педали газа.
m_power_neutral_factor	= 0.15					; какая часть мощности передается на колеса при нейтральной передаче

;Ходовая часть
reference_radius		= 0.35					; Эталонный радиус колеса, используемый при просчёте двигателя
axle_friction			= 15.1					; Трение в осях (применяется при нейтральной передаче) (N*m)

;Рулевое управление
steering_speed			= 1.75					; Скорость поворота рулевых колес. rps (1)
steering_torque			= 2500					; Сила гидроусилителя руля. (N*m)

;Тормозная система
break_torque			= 1.2					; Сила тормозных колодок. (N*m)
