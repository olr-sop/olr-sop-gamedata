[save_manager_settings]
use_device_pause = true ; Ставит игру на паузу в момент быстрого сохранения, сохранения по квестам и т.д, 
						 ; это нужно что бы у нас точно ничего не менялось в течении времени пока пишется сейв
time_to_autosave = 21600 ; Задаёт время между автосохранениями в секундах
max_quicksaves = 100 ; Максимальное количество быстрых сохранений, после сбрасывается на 0
max_autosaves = 50 ; Максимальное количество автосохранений, после сбрасывается на 0

[news_manager_settings]
use_depricated_debug = false ; Подключает небольшой дебаг при вызове старых типсов через news_manager.send_tip записывая в лог откуда был вызван

[olr_timers_settings]
use_depricated_debug = false ; Подключает небольшой дебаг при вызове старых типсов через news_manager.send_tip записывая в лог откуда был вызван

; Оч странная хуйня тут происходит, если max_time_checknews задать между 1900 и 2000, то будет вылет, типа 1980 это гарантировано вылет
; После еще дрочи, можно где угодно указать значение межде 1900 и 2000 и будет вылет
[news_main_settings]
; Периодические фейковые сообщения (болталка), интервал в игровых минутах
enable_fakenews = true
min_time_fakenews = 40
max_time_fakenews = 80
; Периодические реальные сообщения, интервал в игровых секундах
min_time_checknews = 180
max_time_checknews = 2000
; Настройка рандомайзера
news_delay_bias = 2 ; Смещение рандома промежутков к коротким: 1 = обычный рандом, 2 = уклон в короткие, 3 = сильный уклон в короткие промежутки

[olr_ai_anomaly]
; Секции аномалий, которые НЕ считаем опасными для лута (радиация).
; Совпадение по префиксу с '_': zone_radioactive => zone_radioactive_weak и т.д.
ignore_sections = zone_radioactive

[olr_ai_corpse_detection]
enable = true
; период скана (мс) и случайный разброс, чтобы NPC не сканили в один кадр
scan_period = 3500
scan_rand = 2500
; дистанция обнаружения трупа (м). Обыск идет "в радиусе онлайна", без мелких лимитов
detect_dist = 50
; страховка: принудительно забрать вещи, если анимация обыска не доиграла (мс)
search_time = 15000
; ближе этого расстояния к игроку NPC отменяет обыск
actor_stop_dist = 3
arrive_dist = 1.3
; обыскивать ли трупы мутантов
enable_mutant_looting = true

[olr_ai_gather_items]
enable = true
scan_period = 5000
scan_rand = 5000
; максимальная дистанция поиска предметов (м)
max_detect_dist = 35
actor_stop_dist = 3
arrive_dist = 1.3
; ближе этого расстояния (м) идём шагом, дальше бегом (как в CoC)
run_dist = 3
; предмет ближе этого расстояния к шейпу аномалии не берем (м)
anomaly_margin = 2.0
; разрешать подбор артефактов из аномалий (с разрешением входа в зону)
loot_artifacts_in_anomaly = true
; минимальное здоровье NPC (0..1), чтобы лезть за артефактом В аномалию.
; 0 = без ограничения. Смысл: не отправлять полуживого NPC на верную смерть.
anomaly_loot_min_health = 0.6
; не используется: артефакты подбираются тем же состоянием pickup_crouch
artefact_pickup_time = 3000
; страховка: принудительный трансфер, если анимация подбора не доиграла (мс)
item_pickup_time = 15000

[olr_ai_trade_settings]
; максимум NPC в схеме у торговца одновременно (1-3): первый у торговца, остальные ждут рядом
max_at_point = 3
; abstract - деньги "от торговца", real - реальные кошельки NPC и торговца
economy_mode = abstract
; платит ли торговец из своего кошелька в real-режиме
trader_pays = true
; доля цены, которую NPC получает при продаже
sell_k = 0.4
; тратим не более этой доли от денег NPC на одну закупку
buy_reserve_k = 0.7
; повторный поход: NPC должен стать богаче на столько денег...
gain_money = 500
; ...или на столько предметов в рюкзаке
gain_ruck = 5
; дистанция прибытия на место ожидания (м)
arrive_dist = 2.0
; предыдущий торговец отошёл от точки на столько метров - следующий идёт
clear_dist = 3.0
; смещения позиций ожидания от торговой точки (м)
queue_wait1_m = 1.5
queue_wait2_m = 3.0
; шанс согласия (yes): min + (стоимость хабара)/scale, ограничен max
success_chance_min = 0.15
success_chance_max = 0.90
success_scale = 1000
; пауза после отмены похода, мс
retry_pause_ms = 60000

; ===== Схема укрытия NPC от выброса (olr_ai_hideout.script) =====
; ВНИМАНИЕ: правки этого раздела применяются только после перезапуска игры
; (ini_sys кэшируется на boot).
[olr_ai_hideout]
; Схема включена. Зональные ключи (npc_list, entrance, max_npc,
; allowed/disallowed_community) — в misc\surge_manager.ltx.
enable = true
; Добивать NPC, не успевших укрыться, при появлении olr_blowout_phase_3
; (финал выброса, удар последней волны, ~t4+3). Смерть мгновенная (npc:kill).
; Актора в этот же момент убивает surge_manager.kill_all_unhided().
; Монолитовцы неуязвимы — они стоят в trans_1 и переживают выброс.
kill_unhided = false
; Радиус поиска зоны укрытия от позиции NPC, м.
search_radius = 150.0
; Допуск zone:inside для места сидения: 0 = СТРОГО внутри зоны.
seat_tol = 0.0
; Допуск zone:inside для проверки "NPC в укрытии": 0 = СТРОГО внутри.
cover_tol = 0.0
; МС между перепроверками доступности зоны/вершины укрытия.
recheck = 3000
; МС между попытками найти НОВОЕ укрытие после провала.
cover_retry = 10000
; Лимит NPC на зону по умолчанию, если в surge_manager.ltx нет max_npc
; (0 = без лимита).
default_max_npc = 0
; Сколько попыток найти зону со свободным местом до переполненной, шт.
cover_attempts = 3
; true: если все зоны заняты — занять переполненную (пусть лучше толпа,
; чем NPC под выбросом).
allow_overfill = true
; Нет прогресса по дистанции до места дольше этого — место недостижимо, мс.
progress_timeout = 8000
; Дистанция, с которой NPC считается "добежал" до своего места, м.
arrive_near = 2.0
; Шаг сетки сканирования вершин зон без get_shapes, м.
zone_scan_min_step = 2.0
; Шаг сетки по форме небольшой зоны (zone:get_shapes), м.
zone_shape_step = 1.0
; Шаг сетки по форме крупной зоны (> 30 м), м.
zone_shape_step_big = 2.0
; Максимальный радиус сканирования зоны без формы, м.
zone_scan_max_half = 25.0
; Глубина проверки "место не у края зоны" (clearance), м.
zone_clear_max = 8.0
; Шаг проверки clearance, м.
zone_clear_step = 0.5
; Минимальное улучшение дистанции до места (прогресс), м.
seat_progress_eps = 1.0
; Бюджет разогрева кэша вершин укрытий за один тик (кадр), мс.
zone_pre_budget = 2
; Случайные позы NPC внутри укрытия (через запятую).
; Монолитовцы всегда trans_0 (зашито в коде схемы).
; Убрал анимации хайд и курение стоя-сидя, проблемые, оставил как в ЧН набор
hold_states = wait, sit, sit_ass, sit_knee
; Сколько игровых секунд держать позу (мин / макс): 600 = 10 игровых минут.
hold_sec_min = 600
hold_sec_max = 900
; Период проверки смены позы, мс.
hold_check_ms = 10000
; Стили бега в укрытие (случайный выбор раз на действие, через запятую):
; run — оружие за спиной, rush — оружие в руках, sprint — в руках + паника.
run_states = run, rush, sprint
; Дистанция, дальше которой NPC забывает врага во время выброса, м.
; На NPC из olr_protected не действует — они выброс "не замечают".
forget_dist = 130.0

[xr_wounded]
; Глушить движковое кровотечение от ран, пока NPC находится в состоянии
; ранения по схеме: раны мгновенно "затягиваются" (heal_wounds), а жизнь
; и смерть управляются только скриптовыми таймерами (5-40 мин самолечение
; с аптечкой, 2 игровых часа до смерти).
; false = оставить ванильное кровотечение (раненые вытекут за минуты).
stop_bleeding = true
