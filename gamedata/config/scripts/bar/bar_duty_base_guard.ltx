combat_ignore_cond = always
meet = meet@baser
target = actor
on_info = {+bar_dolh_ohr_stoper_talk_done} walker@suicide

[walker@suicide]
path_walk = hodun
meet = no_meet

[meet@baser]
meet_dialog = bar_dolh_ohr_stoper_talk
use		= true
use_wpn		= true