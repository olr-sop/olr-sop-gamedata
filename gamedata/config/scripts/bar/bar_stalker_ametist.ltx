[logic]
active = walker
combat_ignore = combat_ignore
danger = danger_condition

[walker]
path_walk = amwtist_walk
path_look = amwtist_look
def_state_standing = sit_stul
meet = meet
combat_ignore_cond = always
combat_ignore_keep_when_attacked = true 
on_info = {+ametist_go_to_stanok_info} walker2

[walker2]
path_walk = ametist_remont_walk
path_look = ametist_remont_look
combat_ignore_cond = always
combat_ignore_keep_when_attacked = true
def_state_standing = probe

[meet]
use = true
use_wpn = true
meet_talk_enabled = true
meet_state = 4|sit_stul@talk_hello|2|sit_stul
meet_state_wpn = 4|sit_stul@talk_hello|2|sit_stul

[combat_ignore]
combat_ignore_cond = always
 
[danger_condition]
ignore_distance = 10
ignore_distance_corpse = 10