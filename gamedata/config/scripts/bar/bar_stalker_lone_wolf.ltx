[logic]
active = walker
combat_ignore = combat_ignore
danger = danger_condition

[walker]
path_walk = lonewolf_bar_walk
path_look = lonewolf_bar_look
def_state_standing = search
combat_ignore_cond = always
on_info = {+lonewolf_bar_spawn_have -bar_actor_teleport_school} walker@combat_2
on_info2 = {+lonewolf_bar_spawn_have +bar_actor_teleport_school} remark@hold3

[walker@combat_2]
path_walk = wolkrush_to_shkola_way
def_state_moving1 = run
def_state_moving2 = run
def_state_moving3 = run
meet = no_meet
danger = danger_condition
combat_ignore_cond = always 
on_signal = prissneo | %+lonewolf_bar_spawn_have_shkola% remark@hold3

[remark@hold3]
anim = guard
danger = danger_condition 
combat_ignore_cond = always
on_info = {+sleeped_in_shlkola_done} walker3

[walker3]
