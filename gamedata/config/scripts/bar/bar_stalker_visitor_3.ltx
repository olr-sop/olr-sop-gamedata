path_look = nico_bellic_look
combat_ignore_cond = always
on_info = {+olr_traders_night} sleeper
meet = meet 

[meet]
use = true
use_wpn = true
meet_talk_enabled = true
meet_state = 10|ward@talk_hello_friend|2|ward
meet_state_wpn = 10|ward@talk_hello_friend|2|ward
 
[combat_ignore]
combat_ignore_cond = always
 
[danger_condition]
ignore_distance = 10
ignore_distance_corpse = 10

[sleeper]
path_main = bar_plosadka_sleep
wakeable = false
on_info = {+olr_traders_day} walker