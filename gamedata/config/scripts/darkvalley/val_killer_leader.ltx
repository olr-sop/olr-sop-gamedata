[logic]
active = walker
combat_ignore = combat_ignore
danger = danger_condition
on_hit = on_hit@agr_factory_hold_fake

[on_hit@agr_factory_hold_fake]
on_info = {=hit_by_actor} %=kill_actor_killers%

[walker]
path_walk = killer_leader_walk
path_look = killer_leader_look
combat_ignore_cond = always
meet = meet 
on_info = {+olr_traders_night} sleeper

[sleeper]
path_main = killer_leader_sleep
wakeable = true
on_info = {+olr_traders_day} walker

[meet]
use = true
use_wpn = true
meet_talk_enabled = true
meet_state = 10|ward@talk_hello_friend|2|ward
meet_state_wpn = 10|ward@talk_hello_friend|2|ward
 
[combat_ignore]
combat_ignore_cond = always
 
[danger_condition]
ignore_distance = 10
ignore_distance_corpse = 10