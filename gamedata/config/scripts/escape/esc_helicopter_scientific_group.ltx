[logic]
active = heli_move@idle

[heli_move@idle]
path_move = sescnt_heli_equipment_idle
engine_sound = false
on_info = {+yan_tri_raidgruppa_start} heli_move@fly

[heli_move@fly]
path_move = esx_scin_way
engine_sound = true
default_velocity = 4
on_signal = arrived | heli_move@idle2

[heli_move@idle2]
path_move = sescnt_heli_equipment_idle2
engine_sound = true
on_info = {+esc_ecolog_waiting} %+esc_ecolog_invertuha% heli_move@retreatderevna

[heli_move@retreatderevna]
path_move = esx_scin_way_away
engine_sound = true
default_velocity = 4