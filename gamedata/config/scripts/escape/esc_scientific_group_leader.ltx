[logic]
on_death = death
active = remark
danger = danger_condition

[remark]
anim = wait
no_move = true
no_rotate = true
combat_ignore_cond = always
combat_ignore_keep_when_attacked = true
on_info = {+yan_tri_raidgruppa_talk_done -esc_actor_teleport_scientists} walker
on_info2 = {+yan_tri_raidgruppa_talk_done +esc_actor_teleport_scientists} walker2
meet = meet@baser

[walker]
meet = no_meet
danger = danger_condition
path_walk = sosoviy_to_escexit
def_state_moving1 = rush
def_state_moving2 = rush
def_state_moving3 = rush
combat_ignore_cond = always
combat_ignore_keep_when_attacked = true
on_signal = priseldsneo | %+esc_ecolog_waiting% walker2

[walker2]
meet = no_meet
danger = danger_condition
path_walk = esc_scientist_waiting_helicopter_walk
combat_ignore_cond = always
combat_ignore_keep_when_attacked = true

[meet@baser]
meet_dialog = yan_tri_raidgruppa_talk
use			= true
use_wpn		= true
 
[danger_condition]
ignore_distance = 1
ignore_distance_corpse = 1

[death]
on_info = %+esc_group_yan_dead%