no_move = true
no_rotate = true
combat_ignore_cond = always
combat_ignore_keep_when_attacked = true
on_info = {+yan_tri_raidgruppa_talk_done} walker3
meet = meet@baser

[walker3]
meet = no_meet
danger = danger_condition
