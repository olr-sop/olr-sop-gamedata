[logic]
active = walker@1
on_hit = hit
on_death = death
combat_ignore = combat_ignore

[combat_ignore]

[walker@1]
path_walk = val_ambush_t2_walk
path_look = val_ambush_t2_look
def_state_standing = sit_ass
combat_ignore_cond = {=fighting_actor}
on_actor_dist_le = 25 | remark@hello %+val_garbage_attack_olr_jab_sms%
on_actor_in_zone = val_ambush_t1_kill_zone | walker@2 

[remark@hello]
target = actor
no_move = true
anim = guard_fire
combat_ignore_cond = {=fighting_actor}
on_actor_in_zone = val_ambush_t1_kill_zone | walker@2

[walker@2]
path_walk = val_ambush_t2_walk
path_look = val_ambush_t2_look
def_state_standing = sit_ass

[hit]
on_info = walker@2 %+val_garbage_attack_olr_jab%

[death]
on_info = walker@2 %+val_garbage_attack_olr_jab%