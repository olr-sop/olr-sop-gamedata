[logic]
active = ph_door@locked
 
[ph_door@locked]
locked = true
snd_open_start = trader_door_locked
on_info = {+on_lab_swithc_dok_fin_spawn_two_talk} ph_door@open
 
[ph_door@closed]
closed = true
locked = false
on_use = ph_door@open 
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
 
[ph_door@open]
closed = false
locked = false
on_use = ph_door@closed
on_info = {+start_boss_podval_battle} ph_door@locked2
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop

[ph_door@locked2]
locked = true
closed = true
snd_open_start = trader_door_locked
on_info = {+oso_killed} ph_door@open2

[ph_door@closed2]
closed = true
locked = false
on_use = ph_door@open2
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
 
[ph_door@open2]
closed = false
locked = false
on_use = ph_door@closed2
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop