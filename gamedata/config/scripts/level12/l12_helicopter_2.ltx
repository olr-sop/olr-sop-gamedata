[logic]
active = heli_move@idle

[heli_move@idle]
path_move = atack_heli_waitlevel
engine_sound = false
on_info = {+lev_heli_atackmosk} heli_move@fly
combat_safe_altitude = -50

[heli_move@fly]
path_move = hhuiqlevltw
engine_sound = true
combat_enemy = actor
combat_use_rocket = true
combat_use_mgun = false
rocket_delay = 3000
combat_safe_altitude = -10
on_timer = 120000 | heli_move@retreat

[heli_move@retreat]
path_move = atack_heli_waitlevel
engine_sound = true
combat_use_rocket = false
combat_use_mgun = false
combat_safe_altitude = -10
on_timer = 120000 | heli_move@stop

[heli_move@stop]
path_move = atack_heli_waitlevel
engine_sound = false
