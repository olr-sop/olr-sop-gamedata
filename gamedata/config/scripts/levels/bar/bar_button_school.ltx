[logic]
active = ph_button@locked

[ph_button@locked]
anim = button_false
on_info = {+open_bar_spalna_door} ph_button@unlocked
on_press = ph_button@unlocked %+open_bar_spalna_door%

[ph_button@unlocked]
anim = button_true
on_info = {-open_bar_spalna_door} ph_button@locked
on_press = ph_button@locked %-open_bar_spalna_door%