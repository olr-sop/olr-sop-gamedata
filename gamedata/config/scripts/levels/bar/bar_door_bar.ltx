[logic]
active = ph_door@locked
 
[ph_door@locked]
closed = false
locked = true
snd_open_start = trader_door_unlock
on_info = {+open_bar_door_start_krisa} ph_door@open
 
[ph_door@closed]
closed = true
locked = false
on_use = ph_door@open
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
on_info = {+sleeped_in_shlkola_done} ph_door@open2
 
[ph_door@open]
closed = false
locked = false
on_use = ph_door@closed
on_info = {+sleeped_in_shlkola_done} ph_door@open2
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop

[ph_door@open2]
closed = true
locked = true
snd_open_start = trader_door_unlock