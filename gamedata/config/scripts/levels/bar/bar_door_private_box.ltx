[logic]
active = ph_door@locked

[ph_door@locked]
locked = true
closed = true
snd_init = wood_large_close_stop
snd_open_start = wood_large_open
snd_close_start = wood_large_close_start
snd_close_stop = wood_large_close_stop
on_info = {+bar_barman_habar_door_open} ph_door@unlocked

[ph_door@unlocked]
locked = true
closed = false
snd_init = wood_large_close_stop
snd_open_start = wood_large_open
snd_close_start = wood_large_close_start
snd_close_stop = wood_large_close_stop
on_info = {-bar_barman_habar_door_open} ph_door@locked