[logic]
active = sr_idle@task

[sr_idle@task]
on_info = {+bar_actor_teleport_rostok} sr_idle@teleport %=disable_ui() =run_postprocess(fade_in_out)% 

[sr_idle@teleport]
on_game_timer = 30 | sr_idle@out %+bar_progulka_prisli_plos_lead +bar_progulka_prisli_plos_lead_done =teleport_actor(bar_actor_teleport_to_rostok_walk:lead_ohotik_pl_look)%

[sr_idle@out]
on_game_timer = 30 | sr_idle@nil %=enable_ui()%

[sr_idle@nil]