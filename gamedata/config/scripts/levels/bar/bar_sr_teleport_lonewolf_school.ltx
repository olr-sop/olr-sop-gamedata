[logic]
active = sr_idle@task

[sr_idle@task]
on_info = {+bar_actor_teleport_school} sr_idle@teleport %=disable_ui() =run_postprocess(fade_in_out)% 

[sr_idle@teleport]
on_game_timer = 30 | sr_idle@out %=teleport_npc_by_story_id(20011:wolkrush_to_shkola_way:14) =teleport_actor(bar_actor_teleport_school_walk:bar_actor_teleport_school_look)%

[sr_idle@out]
on_game_timer = 30 | sr_idle@nil %+lonewolf_bar_spawn_have_shkola =enable_ui()% 

[sr_idle@nil]