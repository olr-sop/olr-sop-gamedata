[logic]
active = walker@start
on_death = death

[walker@start]
path_walk = bar_bar_psih_walk
path_look = bar_bar_psih_look
def_state_standing = trans_0
combat_ignore_cond = always
on_info = {+bar_psih_nopain} walker@nopain


[walker@nopain]
path_walk = bar_bar_psih_walk
path_look = bar_bar_psih_look
def_state_standing = trans_1
combat_ignore_cond = always
meet = meet@nopain
on_info = {+bar_psih_suicide} remark@suicide


[meet@nopain]
use = true
use_wpn = true
meet_dialog = bar_bar_psih_talk_gorbun


[remark@suicide]
anim = suicide
no_move = true
no_rotate = true
combat_ignore_cond = always
meet = no_meet
on_signal = action_end | %+raboy_zdoh_nahui%


[death]
on_info = %+raboy_zdoh_nahui%