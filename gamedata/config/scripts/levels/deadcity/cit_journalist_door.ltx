[logic]
active = ph_door@locked
 
[ph_door@locked]
locked = true
snd_open_start = wood_large_close_stop
on_info = {+spawn_jourlalist_door} ph_door@open %=play_snd(device\door\door_servomotor)%
 
[ph_door@closed]
closed = true
locked = false
on_use = ph_door@open
snd_open_start = wood_large_open
snd_close_start = wood_large_close_start
snd_close_stop = wood_large_close_stop
 
[ph_door@open]
closed = false
locked = false
on_use = ph_door@closed
snd_open_start = wood_large_open
snd_close_start = wood_large_close_start
snd_close_stop = wood_large_close_stop