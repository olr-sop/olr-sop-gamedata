[logic]
active = heli_move@idle
on_hit = hit

[hit]
on_info = {=hit_by_actor} heli_move@fly

[heli_move@idle]
path_move = heli_idle_move
engine_sound = false
on_info = {+esc_chekpoint_actor_butcher} heli_move@fly
on_timer = 250000 | heli_move@patrol
combat_safe_altitude = -50

[heli_move@patrol]
path_move = heli_patrol_move
on_info = {+esc_chekpoint_actor_butcher} heli_move@fly
on_signal = path_end | heli_move@idle
combat_safe_altitude = -50

[heli_move@fly]
path_move = hhuiq
engine_sound = true
combat_enemy = actor
combat_use_rocket = false
combat_use_mgun = true
rocket_delay = 3000
combat_safe_altitude = -50
on_timer = 120000 | %-esc_chekpoint_actor_butcher% heli_move@retreat

[heli_move@retreat]
path_move = heli_idle_move
engine_sound = true
combat_use_rocket = false
combat_use_mgun = false
combat_safe_altitude = -50
on_timer = 120000 | heli_move@idle