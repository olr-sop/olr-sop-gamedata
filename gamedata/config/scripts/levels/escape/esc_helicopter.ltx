[logic]
active = heli_move@idle

[heli_move@idle]
path_move = heli_blockpost_idle_move_olr
engine_sound = false
on_info = {+esc_actor_atak_militarys} heli_move@fly
combat_safe_altitude = -50

[heli_move@fly]
path_move = hhuiq
engine_sound = true
combat_enemy = actor
combat_use_rocket = false
combat_use_mgun = true
rocket_delay = 3000
combat_safe_altitude = -90
on_timer = 120000 | heli_move@retreat

[heli_move@retreat]
path_move = heli_blockpost_idle_move_2_olr
engine_sound = true
combat_use_rocket = false
combat_use_mgun = false
combat_safe_altitude = -50
on_timer = 120000 | heli_move@stop

[heli_move@stop]
path_move = heli_blockpost_idle_move_olr
engine_sound = false