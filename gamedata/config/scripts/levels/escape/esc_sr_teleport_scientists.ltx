[logic]
active = sr_idle@task

[sr_idle@task]
on_info = {+esc_actor_teleport_scientists} sr_idle@teleport % =disable_ui() =run_postprocess(fade_in_out)% 

[sr_idle@teleport]
on_game_timer = 30 | sr_idle@out %=teleport_npc_by_story_id(10010:sosoviy_to_escexit:77) =teleport_npc_by_story_id(10011:sosoviy_to_escexit:76) =teleport_npc_by_story_id(10012:sosoviy_to_escexit:75) =teleport_actor(esc_actor_teleport_scientists_walk:esc_actor_teleport_scientists_look)%

[sr_idle@out]
on_game_timer = 30 | sr_idle@nil %=enable_ui()% 

[sr_idle@nil]