[logic]
active = walker@1
on_hit = hit
on_death = death
combat_ignore = combat_ignore

[combat_ignore]

[walker@1]
path_walk = val_ambush_t3_walk
path_look = val_ambush_t3_look
def_state_standing = sit_ass
combat_ignore_cond = {=fighting_actor}
on_actor_dist_le = 25 | follower@actor
on_actor_in_zone = val_ambush_t1_kill_zone | walker@2
show_spot = false 

[follower@actor]
leader = actor
formation_line = false
distance = 1
state_if_leader_in_meet = wait
anim_walk = sprint
anim_run = sprint
anim_sprint = sprint
meet = meet@lider
show_spot = false
on_timer = 25000 | walker@2

[remark@hello]
target = actor
no_move = true
anim = hello
combat_ignore_cond = {=fighting_actor}
on_actor_in_zone = val_ambush_t1_kill_zone | walker@2

[walker@2]
path_walk = val_ambush_t3_walk
path_look = val_ambush_t3_look
def_state_standing = sit_ass

[hit]
on_info = walker@2 %+val_garbage_attack_olr_jab%

[death]
on_info = walker@2 %+val_garbage_attack_olr_jab%

[meet@lider]
meet_state = 3| guard
victim = 3|actor   
victim_wpn = 3|actor
use_wpn = false
meet_dialog = gop_stop_garbage