[logic]
active = ph_door@locked
 
[ph_door@locked]
locked = true
snd_open_start = trader_door_locked
on_info = {+warlab_main_open_door} ph_door@open
 
[ph_door@closed]
closed = true
locked = false
on_use = ph_door@open 
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
 
[ph_door@open]
closed = false
locked = false
on_use = ph_door@closed
on_info = {+gen_boss_firts_talk} ph_door@locked2
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop

[ph_door@locked2]
locked = true
closed = true