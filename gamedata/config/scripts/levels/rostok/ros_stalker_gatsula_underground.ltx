[logic]
active = walker
on_death = death

[walker]
path_walk = rostok_undtunnel_go_walk
def_state_moving1 = sneak_fire
def_state_moving2 = sneak_fire
def_state_moving3 = sneak_fire
meet = no_meet
on_info = {+gvozf_net_nihrena_info5} walker@walk6

[walker@walk6]
path_walk = rostok_undtunne2l2_go_walk
meet = no_meet
def_state_moving1 = run
def_state_moving2 = run
def_state_moving3 = run
on_signal = pr445iselfgdhg | %+gvozf_net_nihrena_info6% remark6

[remark6]
anim = search
no_move = true
no_rotate = true
meet = no_meet

[danger_condition]
ignore_distance = 5
ignore_distance_corpse = 5

[death]
on_info = %+ros_dead_done%