[logic]
active = ph_door@locked
 
[ph_door@locked]
locked = true
snd_open_start = trader_door_locked
on_info = {+olr_lab_2_door_unlocked} ph_door@open %=play_snd(device\door\door_servomotor)%

[ph_door@locked2]
locked = true
snd_open_start = trader_door_locked
on_info = {+on_lab_swithc_donebloom} ph_door@open2 %=play_snd(device\door\door_servomotor)%
 
[ph_door@closed]
closed = true
locked = false
on_use = ph_door@open
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
 
[ph_door@open]
closed = false
locked = false
on_use = ph_door@closed
on_info = {+del_sosaka_lab} ph_door@locked2
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop


[ph_door@closed2]
closed = true
locked = false
on_use = ph_door@open2
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
 
[ph_door@open2]
closed = false
locked = false
on_use = ph_door@closed2
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop