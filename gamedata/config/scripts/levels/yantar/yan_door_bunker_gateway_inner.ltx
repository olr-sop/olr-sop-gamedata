[logic]
active = ph_door@locked
 
[ph_door@locked]
locked = true
snd_open_start = trader_door_locked
on_info = {+otdal_kulon_open_door} ph_door@open
 
[ph_door@closed]
closed = true
locked = false
on_use = ph_door@open
on_info = {+actor_killed_phantasm_profesor_done} ph_door@locked2
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
 
[ph_door@open]
closed = false
locked = false
on_use = ph_door@closed
on_info = {+actor_killed_phantasm_profesor_done} ph_door@locked2
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop

[ph_door@locked2]
locked = true
snd_open_start = trader_door_unlock
on_info = {+laborant_otpravlaet_spat_gg_final_done} ph_door@open2

[ph_door@closed2]
closed = true
locked = false
on_use = ph_door@open2
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
 
[ph_door@open2]
closed = false
locked = false
on_use = ph_door@closed2
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop