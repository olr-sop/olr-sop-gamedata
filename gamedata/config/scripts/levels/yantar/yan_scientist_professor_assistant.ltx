[logic]
active = walker
combat_ignore = combat_ignore
danger = danger_condition
on_death = death

[walker]
path_walk = angy_assistent_walk
path_look = angy_assistent_look
combat_ignore_cond = always
combat_ignore_keep_when_attacked = true
on_info = {+olr_traders_night} sleeper
meet = meet 
on_info2 = {+otdal_kulon_open_door} nil

[walker@walk2]
path_walk = angy_assistent_walk
path_look = angy_assistent_look
combat_ignore_cond = always
combat_ignore_keep_when_attacked = true
on_info = {+olr_traders_night} sleeper2
meet = no_meet

[meet]
use = true
use_wpn = true
meet_talk_enabled = true
meet_state = 10|ward@threat_back|2|ward
meet_state_wpn = 10|ward@threat_back|2|ward
 
[combat_ignore]
combat_ignore_cond = always
 
[danger_condition]
ignore_distance = 10
ignore_distance_corpse = 10

[sleeper]
path_main = angy_assistent_sleep
wakeable = true
on_info = {+olr_traders_day} walker
on_info2 = {+otdal_kulon_open_door} walker@walk2

[sleeper2]
path_main = angy_assistent_sleep
wakeable = false
on_info = {+olr_traders_day} walker@walk2

[death]
on_info = %+otdal_kulon_open_door%