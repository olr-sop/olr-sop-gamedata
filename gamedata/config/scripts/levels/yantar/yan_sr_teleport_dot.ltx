[logic]
active = sr_idle@task

[sr_idle@task]
on_info = {+yan_actor_teleport_dot} sr_idle@teleport % =disable_ui() =run_postprocess(fade_in_out)% 

[sr_idle@teleport]
on_game_timer = 30 | sr_idle@out %+prof_uletel_gde_laborant_start_talked_gonow =teleport_npc_by_story_id(20014:yan_pomosnik_way:31) =teleport_actor(yan_pomosnik_walk:yan_pomosnik_look)%

[sr_idle@out]
on_game_timer = 30 | sr_idle@nil %=enable_ui()% 

[sr_idle@nil]