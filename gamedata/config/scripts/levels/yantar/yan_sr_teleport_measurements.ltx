[logic]
active = sr_idle@task

[sr_idle@task]
on_info = {+yan_actor_teleport_measurements} sr_idle@teleport %=disable_ui() =run_postprocess(fade_in_out)% 

[sr_idle@teleport]
on_game_timer = 30 | sr_idle@out %=teleport_npc_by_story_id(20015:zamer_anom_st_dat:20) =teleport_actor(yan_actor_teleport_measurements_walk:yan_actor_teleport_measurements_look)%

[sr_idle@out]
on_game_timer = 30 | sr_idle@nil %=enable_ui()% 

[sr_idle@nil]