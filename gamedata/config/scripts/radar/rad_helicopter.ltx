[logic]
active = heli_move@idle

[heli_move@idle]
path_move = heli_radar_idle_move_olr
engine_sound = false
on_info = {+rad_car_start} heli_move@fly
combat_safe_altitude = -50

[heli_move@fly]
path_move = mr_zalupasa
engine_sound = true
combat_enemy = actor
combat_use_rocket = true
combat_use_mgun = false
rocket_delay = 3000
combat_safe_altitude = -70
on_timer = 120000 | heli_move@retreat

[heli_move@retreat]
path_move = heli_radar_idle_move_olr
engine_sound = true
combat_use_rocket = false
combat_use_mgun = false
combat_safe_altitude = -50
on_timer = 120000 | heli_move@stop

[heli_move@stop]
path_move = heli_radar_idle_move_olr
engine_sound = false
