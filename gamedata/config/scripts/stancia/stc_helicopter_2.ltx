[logic]
active = heli_move@idle

[heli_move@idle]
path_move = atack_heli_waitlevelcha
engine_sound = false
on_info = {+chaes_actor_on_roof} heli_move@fly
combat_safe_altitude = -50

[heli_move@fly]
path_move = hhuiqlevltwcha
engine_sound = true
combat_use_rocket = false
combat_use_mgun = false
combat_safe_altitude = -10
on_timer = 60000 | heli_move@retreat

[heli_move@retreat]
path_move = atack_heli_waitlevelcha
engine_sound = true
combat_enemy = actor
combat_use_rocket = true
combat_use_mgun = false
rocket_delay = 3000
combat_safe_altitude = -10
on_timer = 120000 | heli_move@stop

[heli_move@stop]
path_move = atack_heli_waitlevelcha
engine_sound = false