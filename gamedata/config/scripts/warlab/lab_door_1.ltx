[logic]
active = ph_door@locked

[ph_door@locked]
tip_close = loced_from_other_side_olr
locked = true
closed = true
snd_init = trader_door_unlock
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
on_info = {+olab_bunker_door_1_open} ph_door@unlocked

[ph_door@unlocked]
locked = true
closed = false
snd_init = trader_door_unlock
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
on_info = {-olab_bunker_door_1_open} ph_door@locked