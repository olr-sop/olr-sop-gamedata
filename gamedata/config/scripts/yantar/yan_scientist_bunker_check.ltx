[logic]
on_death = death
active = remark
danger = danger_condition

[remark]
anim = wait
no_move = true
no_rotate = true
target = actor
combat_ignore_cond = always
combat_ignore_keep_when_attacked = true
on_info = {+yan_tobunk_done} walker3
meet = meet@baser

[walker3]
meet = no_meet
danger = danger_condition
path_walk = tobunk_st_dat
def_state_moving1 = run
def_state_moving2 = run
def_state_moving3 = run
combat_ignore_cond = always
combat_ignore_keep_when_attacked = true
on_signal = prieof| remark@raciya3

[remark@raciya3]
anim = search
no_move = true
meet = no_meet
combat_ignore_cond = always
combat_ignore_keep_when_attacked = true
danger = danger_condition
on_signal = action_end | remark2

[remark2]
anim = wait
no_move = true
no_rotate = true
combat_ignore_cond = always
combat_ignore_keep_when_attacked = true
meet = meet@baserbun


[meet@baserbun]
meet_dialog = tobunk_anom_st_bunker
use			= true
use_wpn		= true


[meet@baser]
meet_dialog = tobunk_anom_st
use			= true
use_wpn		= true
 
[danger_condition]
ignore_distance = 1
ignore_distance_corpse = 1

[death]
on_info = %+sos_zamtwo_dead%