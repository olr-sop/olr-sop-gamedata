[logic]
active = sr_idle@task

[sr_idle@task]
on_info = {+yan_actor_teleport_zyablikov} sr_idle@teleport %=disable_ui() =run_postprocess(fade_in_out)% 

[sr_idle@teleport]
on_game_timer = 30 | sr_idle@out %=teleport_npc_by_story_id(803:zablikov_rush_way:23) =teleport_actor(yan_actor_teleport_bunker_walk:yan_actor_teleport_bunker_look)%

[sr_idle@out]
on_game_timer = 30 | sr_idle@nil %=enable_ui()% 

[sr_idle@nil]