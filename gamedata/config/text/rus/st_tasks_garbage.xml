	</string>
	<string id="st_gar_phil_eye_1_text">
		<text>Найти сталкера на блокпосте "Долга"</text>
	</string>
	<string id="st_gar_phil_eye_2_text">
		<text>Найти стеклянный глаз</text>
	</string>
	<string id="st_gar_phil_eye_3_text">
		<text>Вернуть глаз Филу</text>
	</string>
