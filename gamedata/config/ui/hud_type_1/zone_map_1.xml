<?xml version='1.0' encoding="UTF-8"?>
<window>
	<minimap top_offset="0" right_offset="0">
		
		<level_frame x="0" y="0" width="162" height="155">
			<map_color a="255"/>
		</level_frame>

		<background x="9" y="5" width="157" height="155" stretch="0"> 
			<texture>ui_hud_1_wnd_map</texture>
			
			<!-- 
				Основная нода маски мини-карты, использует КРАСНЫЙ канал Ч/Б текстуры (оптимально сохранять в L8, но можно и в DXT1).
			    маска рисуется под бэкграундом, соотвественно для упрощения работы надо нарисовать маску и задать такие же размеры что и у основого бэкграуда.
			    Подгонка маски: src (x/y/width/height) — область внутри текстуры, dst  (dx/dy/dw/dh от level_frame) — позиция; по умолчанию dst = прямоугольник background.
			-->
			<mask>ui_hud_map_mask_1</mask>
			<!-- 
				Опционально, 1-битная (Ч/Б) маска для спотов: споты не меняют своей альфы, данная маска нужна для подгонки места отрисовки спотов.
				Без неё используя базовая маска из ноды mask. 
			-->
			<!-- <spots_mask>ui\ui_hud_mask_spots</spots_mask> -->

			<dist_text x="0" y="134" width="154" height="20">
				<text align="c" font="letterica14" r="255" g="255" b="255" a="130" text_shadow="1"/>
			</dist_text>
		</background>

		<compass x="125" y="118" width="32" height="32" heading="1">
			<texture>ui_hud_compass_rb</texture>
		</compass>

		<center width="4" height="4" alignment="c" stretch="1"> 
			<texture r="0" b="0">ui_minimap_point</texture>
		</center>
		
		<!-- 
			Отсуствие ноды noise отключает фичу с шумом вместо отключения мини-карты
			<noise/> - процедурный шум ПДА, 
			<noise>ui\ui_noise</noise> - текстура, без ноды шум отключён 
		-->
		<noise/>

	</minimap>

	<static_map_zoom x="-82" y="114" width="120" height="65">
		<text complex_mode="1" x="90" y="20" font="letterica14" r="255" g="255" b="255" a="130" text_shadow="1"/>
	</static_map_zoom>


</window>