<?xml version='1.0' encoding="UTF-8"?>
<window>
	<minimap top_offset="0" right_offset="0">
		<!-- <noise>ui\ui_noise</noise> -->
		<level_frame x="11" y="12" width="150" height="142">
			<map_color a="255"/>
		</level_frame>

		<background x="9" y="5" width="157" height="155" stretch="0"> 
			<texture>ui_hud_1_wnd_map</texture>
			<!-- mask: red channel, 255 = fully visible, 0 = hidden, midtones = smooth transparency.
			    Mask is drawn in the coordinates of this background frame (its real drawn rect), NOT of level_frame.
			    x/y/width/height - optional sub-rect inside the mask texture; dx/dy/dw/dh - optional destination offset from level_frame -->
			<mask>ui\ui_hud_mask</mask>
			<!-- optional 1-bit (black/white) mask for spots: spots keep their own alpha, black = not drawn.
			    Without it the main <mask> above is used for spots too. -->
			<!-- <spots_mask>ui\ui_hud_mask_spots</spots_mask> -->

			<dist_text x="0" y="134" width="154" height="20">
				<text align="c" font="letterica14" r="255" g="255" b="255" a="130" text_shadow="1"/>
			</dist_text>
		</background>

		<compass x="125" y="118" width="32" height="32" heading="1">
			<texture>ui_hud_compass_rb</texture>
		</compass>

		<center width="4" height="4" alignment="c" stretch="1"> 
			<texture r="0" b="0">ui_minimap_point</texture>
		</center>

	</minimap>

	<static_map_zoom x="-82" y="114" width="120" height="65">
		<text complex_mode="1" x="90" y="20" font="letterica14" r="255" g="255" b="255" a="130" text_shadow="1"/>
	</static_map_zoom>


</window>