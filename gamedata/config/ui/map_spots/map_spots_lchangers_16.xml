
<!-- default lchanger-->
	<level_changer>
		<level_map spot="level_changer_spot" pointer="quest_pointer"/>
		<mini_map  spot="level_changer_spot_mini"/>
	</level_changer>

	<level_changer_spot  x="0" y="0" width="5" height="5" alignment="c" stretch="1" scale="1">
		<texture x="384" y="0" width="32" height="32">ui\icons\map_icons</texture>
	</level_changer_spot>
	<level_changer_spot_mini  x="0" y="0" width="15" height="15" alignment="c" stretch="1" scale="1" fixed_rotation="1">
		<texture x="320" y="32" width="16" height="16">ui\icons\map_icons</texture>
	</level_changer_spot_mini>

