<?xml version='1.0' encoding="UTF-8"?>
<window>
	<main_wnd x="110" y="90" width="761" height="475">
		<left_auto>
		<!-- тут всё ещё можно использовать автостатики-->
		</left_auto>
		<left_auto_above_frame>
			<auto_static x="8" y="48" width="8" height="457" stretch="0">
				<texture>ui_pda_vertical_line_m_l</texture>
			</auto_static>
			<auto_static x="265" y="48" width="8" height="457" stretch="0">
				<texture>ui_pda_vertical_line_m_r</texture>
			</auto_static>
			<auto_static x="15" y="48" width="245" height="4" stretch="1">
				<texture>ui\pda\pda_horizontal_line</texture>
			</auto_static>
		</left_auto_above_frame>

		<right_auto_above_frame>
		<!-- для правого тоже можно-->
		</right_auto_above_frame>
		<right_auto>
			<auto_static x="325" y="44" width="8" height="457" stretch="0">
				<texture>ui_pda_vertical_line_l_l</texture>
			</auto_static>
			<auto_static x="725" y="44" width="8" height="457" stretch="0">
				<texture>ui_pda_vertical_line_l_r</texture>
			</auto_static>
		</right_auto>	
		<left_frame x="0" y="0" width="298" height="475" a="90">
			<texture>ui_pda_frame_sub</texture>

			<left_frame_header x="8" y="17" width="283" height="27">
				<texture>ui_string_02</texture>
				
				<anim_static x="250" y="-3" width="32" height="32" frames="16" duration="1000" columns="8" frame_width="32" frame_height="32" cyclic="1" autoplay="1">
					<texture>ui\pda\pda_anims_01</texture>
				</anim_static>
								
				<filter_tab x="0" y="6" width = "252" height="12">
					<button x="10" y="0" width="70" height="12" hint="pda_btn_journal_hint" id="eptJournal">
						<text  align="l" x="0" y="2" font="letterica16" r="255" g="255" b="255" complex_mode="0">pda_btn_journal</text>
						<text_color>
							<t r="255" g="255" b="255"/> <d r="181" g="170" b="148"/> <e r="190" g="187" b="230"/> <h r="255" g="255" b="255"/>
						</text_color>
					</button>

					<button x="90" y="0" width="120" height="12" hint="pda_btn_news_hint" id="eptNews">
						<text  align="l" x="0" y="2" font="letterica16" r="255" g="255" b="255" complex_mode="0">pda_btn_news</text>
						<text_color>
							<t r="255" g="255" b="255"/> <d r="181" g="170" b="148"/> <e r="190" g="187" b="230"/> <h r="255" g="255" b="255"/>
						</text_color>
					</button>
					<button x="120" y="0" width="40" height="12" hint="pda_btn_talk_news_hint" id="eptTalkNews">
						<text align="l" x="0" y="2" font="letterica16" r="255" g="255" b="255" complex_mode="0">pda_btn_talk_news</text>
						<text_color>
							<t r="255" g="255" b="255"/> <d r="181" g="170" b="148"/> <e r="190" g="187" b="230"/> <h r="255" g="255" b="255"/>
						</text_color>
					</button>
				</filter_tab>					
			</left_frame_header>
			
			<work_area x="8" y="44" width="290" height="475">
				<src_list x="20" y="10" width="263" height="416" right_ident="15" item_height="20" always_show_scroll="1" scroll_profile="pda">
					<font font="letterica18" r="225" g="225" b="250"/>
					<tree_root_font font="letterica18" r="225" g="225" b="250">Encyclopedia</tree_root_font>
					<tree_item_font font="letterica16" r="255" g="255" b="255">Encyclopedia</tree_item_font>
				</src_list>
			</work_area>
		</left_frame>
	
		<right_frame x="313" y="0" width="448" height="475">
			<texture>ui_pda_frame_sub</texture>

			<right_frame_header x="8" y="17" width="434" height="21">
				<texture>ui_string_03</texture>
				<title x="11" y="0" width="434" height="18">
					<text font="letterica16" cut_words="1" color="ui_1" complex_mode="0"/>
				</title>
			</right_frame_header>
			
			<work_area x="8" y="33" width="445" height="485">
				<scroll_view  x="0" y="10" width="433" height="427" right_ident="10" scroll_profile="pda"/>
			</work_area>
		</right_frame>
	</main_wnd>

	<updated_section_static x="0" y="0" width="9" height="11" stretch="1">
		<texture a="0">ui_pda_m_noupdate</texture>
	</updated_section_static>
	
	<old_section_static x="0" y="0" width="9" height="11" stretch="1">
		<texture a="0">ui_pda_m_update</texture>
	</old_section_static>
</window>

