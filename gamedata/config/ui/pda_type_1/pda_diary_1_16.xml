		<right_frame x="245" y="0" width="354" height="459">
			<texture>ui_pda_frame_sub</texture>

			<right_frame_header x="8" y="17" width="340" height="21">
				<texture>ui_string_03</texture>
				
			</right_frame_header>
			
			<work_area x="8" y="44" width="380" height="425">
