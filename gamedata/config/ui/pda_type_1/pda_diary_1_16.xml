		</left_auto>
		<left_auto_above_frame>
			<auto_static x="8" y="48" width="8" height="417" stretch="0">
				<texture>ui_pda_vertical_line_s_l</texture>
			</auto_static>
			<auto_static x="205" y="48" width="8" height="417`" stretch="0">
				<texture>ui_pda_vertical_line_s_r</texture>
			</auto_static>
			<auto_static x="15" y="412" width="185" height="4" stretch="1">
				<texture>ui\pda\pda_horizontal_line</texture>
			</auto_static>
		</left_auto_above_frame>

		<right_auto_above_frame>
