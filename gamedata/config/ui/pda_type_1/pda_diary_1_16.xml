							<t r="255" g="255" b="255"/> <d r="181" g="170" b="148"/> <e r="190" g="187" b="230"/> <h r="255" g="255" b="255"/>
						</text_color>
					</button>						
				</filter_tab>					
			</left_frame_header>
			
			<work_area x="10" y="44" width="390" height="475">
				<src_list x="20" y="8" width="200" height="400" right_ident="15" item_height="20" always_show_scroll="1" scroll_profile="pda">
					<font font="letterica18" r="225" g="225" b="250"/>
					<tree_root_font font="letterica18" r="225" g="225" b="250">Encyclopedia</tree_root_font>
					<tree_item_font font="letterica16" r="255" g="255" b="255">Encyclopedia</tree_item_font>
				</src_list>
			</work_area>
