				<t r="255" g="255" b="255"/> <d r="190" g="187" b="230"/> <e r="190" g="187" b="230"/> <h r="255" g="255" b="255"/>
			</text_color>
		</button> 
		<button x="113" y="2" width="60" height="20" hint="pda_btn_diary_hint">
			<text align="l" x="-1" y="-4" font="letterica18" r="255" g="255" b="255">pda_btn_diary</text>
			<text_color>
				<t r="255" g="255" b="255"/> <d r="190" g="187" b="230"/> <e r="190" g="187" b="230"/> <h r="255" g="255" b="255"/>
			</text_color>
		</button>
		<button x="188" y="2" width="60" height="20" hint="pda_btn_contacts_hint">
			<text align="l" x="-1" y="-4" font="letterica18" r="255" g="255" b="255">pda_btn_contacts</text>
			<text_color>
				<t r="255" g="255" b="255"/> <d r="190" g="187" b="230"/> <e r="190" g="187" b="230"/> <h r="255" g="255" b="255"/>
			</text_color>
		</button>
		<button x="338" y="2" width="78" height="20" hint="pda_btn_statistics_hint">
			<text align="l" x="-1" y="-4" font="letterica18" r="255" g="255" b="255">pda_btn_statistics</text>
			<text_color>
				<t r="255" g="255" b="255"/> <d r="190" g="187" b="230"/> <e r="190" g="187" b="230"/> <h r="255" g="255" b="255"/>
			</text_color>
		</button>
		<button x="433" y="2" width="100" height="20" hint="pda_btn_encyclopedia_hint">
			<text align="l" x="-1" y="-4" font="letterica18" r="255" g="255" b="255">pda_btn_encyclopedia</text>
			<text_color>
				<t r="255" g="255" b="255"/> <d r="190" g="187" b="230"/> <e r="190" g="187" b="230"/> <h r="255" g="255" b="255"/>
