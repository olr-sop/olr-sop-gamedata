<?xml version='1.0' encoding="UTF-8"?>
<window>
	<!-- PDA OFF BUTTON -->
	<off_button x="0" y="0" width="1" height="1">
		<texture>ui\pda\pda_button</texture>
		<text x="0" y="0" font="letterica18" r="255" g="255" b="255"/>
	</off_button>


	<main x="0" y="0" width="1024" height="768"/>
	<background_static x="100" y="75" width="770" height="562" stretch="1">
		<texture>ui_pda</texture>
		<texture_offset x="38" y="43"/>
	</background_static>


	<!-- Main buttons background -->
	<mbbackground_frame_line x="95" y="525" width="555" height="32">
		<texture>ui_string_01</texture>		
	</mbbackground_frame_line>
	<pda_charge x="890" y="392" width="20" height="13" stretch="1">
		<texture>ui_new_pda_charge_lamp</texture> 
	</pda_charge>
    <close_button x="760" y="116" width="65" height="30" stretch="1" check_mode="0" hint="pda_btn_close">
        <texture a="100">ui\pda\pda_button</texture>
    </close_button>
	<!-- TIME DISPLAY BACKGROUND -->
	<timer_frame_line x="665" y="525" width="96" height="32">
		<texture>ui_string_01</texture>		
		<title x="10" y="10" width="140" height="18">
			<text font="letterica18" r="190" g="187" b="230" complex_mode="0"/>
		</title>
	</timer_frame_line>
	<time_static x="665" y="525" width="20" height="13" stretch="1">
			<text font="letterica18" r="190" g="187" b="230" complex_mode="0"/>
	</time_static>
                   
	<!-- TAB CONTROL -->
	<tab x="101" y="532" width="550" height="30">
		<!-- BUTTONS -->
		<button x="0" y="2" width="72" height="20" hint="pda_btn_quests_hint">
			<text align="l" x="0" y="-4" font="letterica18" r="255" g="255" b="255">pda_btn_quests</text>
			<text_color>
				<t r="255" g="255" b="255"/> <d r="190" g="187" b="230"/> <e r="190" g="187" b="230"/> <h r="255" g="255" b="255"/>
			</text_color>
		</button>
		<button x="50" y="2" width="40" height="20" hint="pda_btn_map_hint">
			<text align="l" x="-1" y="-4" font="letterica18" r="255" g="255" b="255">pda_btn_map</text>
