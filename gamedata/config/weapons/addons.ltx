[wpn_addon_binoc]:identity_immunities
GroupControlSection	= spawn_group
discovery_dependency = 
$spawn			= "weapons\addons\wpn_addon_binoc" ; option for Level Editor
class			= WP_SCOPE
cform           = skeleton
visual          = weapons\addons\scope_pso.ogf
$prefetch 		= 32
description		= enc_weapons1_wpn-addon-scope
