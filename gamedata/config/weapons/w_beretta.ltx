[wpn_beretta]:identity_immunities
GroupControlSection			= spawn_group
discovery_dependency 		= 
$spawn                   	= "weapons\beretta"					; option for Level Editor
$npc			 			= on				; option for Level Editor
$prefetch 					= 8
scheduled            		= off              ; option for ALife Simulator
cform                    	= skeleton
class                    	= WP_PM
min_radius               	= 5
max_radius               	= 30
description					= wpn_beretta_desc

ef_weapon_type				= 5

;script_binding  		= bind_weapon.Init

;-----------------------------------------------------------------------------------
holder_range_modifier	= 1.0               ; во сколько раз увеличивается eye_range 
holder_fov_modifier		= 1.0            ; во сколько раз увеличивается eye_fov
;-----------------------------------------------------------------------------------
item_amount = 1.2

3d_static_scale = 1.1

cost					 	= 250

ammo_limit		 			= 120
ammo_current		 		= 90
ammo_elapsed		 		= 12

ammo_mag_size		 		= 17
ammo_class		 			= ammo_9x19_fmj, ammo_9x19_pbp

min_ammo_try_jammed                        = 4

un_jammed_on_show			= true

hand_dependence		 		= 1
single_handed				= 1

slot 				 		= 1		; // primary
animation_slot		 		= 1		; type of the animation that will be used


inv_name					= wpn_beretta_name
inv_name_short				= wpn_beretta_name_short
inv_weight					= 0.8

inv_grid_width				= 2
inv_grid_height				= 1
inv_grid_x					= 0
inv_grid_y					= 23

kill_msg_x			= 104
kill_msg_y			= 178
kill_msg_width		= 28
kill_msg_height		= 21

;-----------------------------------------------------------------------------------
;базовая дисперсия
fire_dispersion_base			= 0.16		;угол (в градусах) базовой дисперсии оружия (оружия зажатого в тисках)
fire_dispersion_condition_factor= 5			;увеличение дисперсии в процентах при максимальном износе 
condition_shot_dec				= 0.0001	;увеличение износа при каждом выстреле

;отдача
cam_dispersion					= 0.23		;увеличения угла (в градусах) с каждым выстрелом
cam_dispersion_inc				= 0.33		;увеличениe cam_dispersion с каждым выстрелом
cam_dispersion_frac				= 0.85		;ствол будет подниматься на cam_dispersion*cam_dispersion_frac +- cam_dispersion*(1-cam_dispersion_frac)
cam_max_angle					= 57.0		;максимальный угол отдачи
cam_max_angle_horz				= 5.5		;(degree) maximum shot horizontal degree 
cam_step_angle_horz				= 0.5		;(degree) size of step camera moved in horizontal position while shooting
cam_relax_speed					= 8			;скорость возврата в исходное положение

control_inertion_factor			= 1.05
misfire_probability				= 0.003		;вероятность осечки при максимальном износе 

PDM_disp_crouch					= 0.9
PDM_disp_crouch_no_acc			= 0.85
PDM_disp_accel_factor			= 1.2
PDM_disp_base					= 0.9
PDM_disp_vel_factor				= 1.2
;-----------------------------------------------------------------------------------

direction                	= 0, 0, 1
fire_point               	= 0.0, 0.148, 0.157

flame_particles		   		= weapons\generic_weapon03
smoke_particles		   		= weapons\generic_shoot_00
rpm_empty_click 	 		= 200

shell_point		 			= 0.05, 0.148, 0.053
shell_dir		 			= 0.0, 0.0, 0.4
shell_particles	 			= weapons\generic_shells

; ttc
hit_power			= 0.393
hit_impulse			= 39.5
hit_type 			= fire_wound

fire_distance		= 100
bullet_speed		= 360	;начальная скорость пули
rpm					= 250
; end ttc

use_aim_bullet				= true		;Поддерживается ли первая суппер пуля
time_to_aim					= 1.0	

silencer_hit_power       	= 0.27
silencer_hit_impulse	 	= 11
silencer_fire_distance   	= 40
silencer_bullet_speed	 	= 220

hud                      	= wpn_beretta_hud
normal                   	= 0, 1, 0
position                 	= -0.021000,-0.090000,0.000000
orientation              	= 0, 0, 0

