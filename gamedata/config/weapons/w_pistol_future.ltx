cam_max_angle_horz				= 12.0		;(degree) maximum shot horizontal degree 
cam_step_angle_horz				= 1.2		;(degree) size of step camera moved in horizontal position while shooting
cam_relax_speed					= 9			;скорость возврата в исходное положение

control_inertion_factor			= 1.1
misfire_probability				= 0.003		;вероятность осечки при максимальном износе 

PDM_disp_crouch					= 0.9
PDM_disp_crouch_no_acc			= 0.85
PDM_disp_accel_factor			= 1.2
PDM_disp_base					= 0.9
