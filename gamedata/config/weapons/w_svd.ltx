[wpn_svd]:identity_immunities
GroupControlSection	= spawn_group
discovery_dependency = 
$spawn                  = "weapons\svd"		; option for Level Editor
$npc			 		= on				; option for Level Editor
$prefetch 		 		= 8
scheduled               = off              	; option for ALife Simulator
cform                   = skeleton
class                   = WP_SVD
min_radius              = 0
max_radius              = 50
description				= wpn_svd_desc

ef_main_weapon_type		 = 3
ef_weapon_type			 = 8

;--- scope weapons -----------------------------------------------------------------
holder_range_modifier	= 2.15               ; во сколько раз увеличивается eye_range 
holder_fov_modifier		= 1.3              ; во сколько раз увеличивается eye_fov
;-----------------------------------------------------------------------------------
item_amount = 15
cost					= 2400
weapon_class			= sniper_rifle

3d_static_scale = 0.95

ammo_limit				= 60
ammo_current			= 10
ammo_elapsed			= 0

ammo_mag_size			= 10
ammo_class				= ammo_7.62x54_7h1, ammo_7.62x54_7h14, ammo_7.62x54_ap, ammo_7.62x54_7h14_anom

sprint_allowed			= false
;-----------------------------------------------------------------------------------
;базовая дисперсия
fire_dispersion_base			= 0.07		;угол (в градусах) базовой дисперсии оружия (оружия зажатого в тисках)
fire_dispersion_condition_factor= 4			;увеличение дисперсии в процентах при максимальном износе 
condition_shot_dec				= 0.0001	;увеличение износа при каждом выстреле

;отдача
cam_dispersion					= 2		;увеличения угла (в градусах) с каждым выстрелом
cam_dispersion_inc				= 0.5		;увеличениe cam_dispersion с каждым выстрелом
cam_dispersion_frac				= 0.9		;ствол будет подниматься на cam_dispersion*cam_dispersion_frac +- cam_dispersion*(1-cam_dispersion_frac)
cam_max_angle					= 14.0		;максимальный угол отдачи
cam_max_angle_horz				= 3.0		;(degree) maximum shot horizontal degree 
cam_step_angle_horz				= 0.8		;(degree) size of step camera moved in horizontal position while shooting
cam_relax_speed					= 4.5			;скорость возврата в исходное положение
cam_relax_speed_ai				= 600

control_inertion_factor			= 1.7
misfire_probability				= 0.05		;вероятность осечки при максимальном износе 

PDM_disp_crouch					= 1.05
PDM_disp_crouch_no_acc			= 0.95
PDM_disp_accel_factor			= 1.3
PDM_disp_base					= 1.0
PDM_disp_vel_factor				= 1.3
;-----------------------------------------------------------------------------------

hand_dependence 		= 1
single_handed			= 0

slot 					= 2		; // secondary
animation_slot			= 2		; type of the animation that will be used


inv_name				= wpn_svd_name
inv_name_short			= wpn_svd_name
inv_weight				= 4.5

inv_grid_width			= 6
inv_grid_height			= 2
inv_grid_x				= 0
inv_grid_y				= 0

kill_msg_x			= 0
kill_msg_y			= 0
kill_msg_width		= 98
kill_msg_height		= 23

direction               = 0, 0, 1

fire_point              = 0.0, 0.129, 0.942

flame_particles		    = weapons\generic_weapon06
smoke_particles		   	= weapons\generic_shoot_00
rpm_empty_click 		= 120

shell_point				= 0.0, 0.129, 0.192	
shell_dir				= 0.0, 0.0, 0.4
shell_particles			= weapons\generic_shells

; ttc
hit_power			= 1.5
hit_impulse			= 109.4
hit_type 			= fire_wound

fire_distance		= 1000
bullet_speed		= 830	;начальная скорость пули
rpm					= 120
; end ttc

use_aim_bullet				= true		;Поддерживается ли первая суппер пуля
time_to_aim					= 1.0	

hud                     = wpn_svd_hud
normal                  = 0, 1, 0
position                = -0.026, -0.077, 0.00
orientation             = 0, 0, 0

;--STRAP PARAMETERS-----------------------------------------------------------------
;под мишкой
strap_position         		= -0.15,-0.15,0.45			; position (offset) and orientation of the weapon when it is strapped
strap_orientation      		= -25,-189,65				; (3rd person view in degrees)
;strap_position         		= -0.26,-0.11,0.15			; position (offset) and orientation of the weapon when it is strapped
;strap_orientation      		= -15,-9,110				; (3rd person view in degrees)
strap_bone0					= bip01_spine2
strap_bone1					= bip01_spine1

startup_ammo            = 10
visual                  = weapons\svd\svd.ogf

light_color		 		= 0.6,0.5,0.3
light_range		 		= 4.0
light_var_color		 	= 0.05
light_var_range		 	= 0.5
light_time 		 		= 0.2

ph_mass			 		= 3

;addons
scope_status				= 1
silencer_status				= 0
grenade_launcher_status		= 0

zoom_enabled				= true

scope_zoom_factor	    = 8		;ПСО-1 4X

scope_texture			= wpn_crosshair

;звуки
snd_draw		= weapons\svd\draw
snd_holster		= weapons\general\holster
snd_shoot		= weapons\svd\shoot
snd_empty		= weapons\general\empty, 0.5
snd_reload		= weapons\svd\reload

 
[wpn_svd_hud]

allow_inertion = true

shell_point			= -0.140000,-0.030000,0.080000
shell_dir		 		= 0.0, 1.0, 0.0

fire_point               = 0.7,0.01,0.05
fire_bone               = wpn_body
orientation                     = -1.15,0,0
position                        = -0.025,0,-0.02
visual                  = weapons\svd\svd_hud.ogf

anim_holster	= holster
anim_idle		= idle
anim_idle_aim	= idle
anim_reload		= reload
anim_draw		= draw
anim_shoot		= shoot1

;смещения HUD для режима приближения
zoom_offset			= -0.19,0.032,-0.09
zoom_rotate_x		= 0
zoom_rotate_y		= 0.06