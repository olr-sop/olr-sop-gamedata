[wpn_svu]:identity_immunities
GroupControlSection	= spawn_group
discovery_dependency = 
$spawn                  = "weapons\svu"		; option for Level Editor
$npc			 		= on				; option for Level Editor
$prefetch 		 		= 8
scheduled               = off              	; option for ALife Simulator
cform                   = skeleton
class                   = WP_SVU
min_radius              = 0
max_radius              = 50
description				= wpn_svu_desc

ef_main_weapon_type		 = 3
ef_weapon_type			 = 8

;--- scope weapons -----------------------------------------------------------------
holder_range_modifier	= 2.15               ; во сколько раз увеличивается eye_range 
holder_fov_modifier		= 1.3              ; во сколько раз увеличивается eye_fov
;-----------------------------------------------------------------------------------

item_amount = 10

cost					= 3000
weapon_class			= sniper_rifle

ammo_limit		 		= 60
ammo_current			= 10
ammo_elapsed		 	= 0

ammo_mag_size		 	= 10
ammo_class		 		= ammo_7.62x54_7h1, ammo_7.62x54_7h14, ammo_7.62x54_ap, ammo_7.62x54_7h14_anom 

sprint_allowed			= true; false
;-----------------------------------------------------------------------------------
;базовая дисперсия
fire_dispersion_base			= 0.08		;угол (в градусах) базовой дисперсии оружия (оружия зажатого в тисках)
fire_dispersion_condition_factor=5			;увеличение дисперсии в процентах при максимальном износе 
condition_shot_dec				= 0.0001	;увеличение износа при каждом выстреле

;отдача
cam_dispersion					= 2.25		;увеличения угла (в градусах) с каждым выстрелом
cam_dispersion_inc				= 0.35		;увеличениe cam_dispersion с каждым выстрелом
cam_dispersion_frac				= 0.9		;ствол будет подниматься на cam_dispersion*cam_dispersion_frac +- cam_dispersion*(1-cam_dispersion_frac)
cam_max_angle					= 10.5		;максимальный угол отдачи
cam_max_angle_horz				= 10.0		;(degree) maximum shot horizontal degree 
cam_step_angle_horz				= 0.9		;(degree) size of step camera moved in horizontal position while shooting
cam_relax_speed					= 4			;скорость возврата в исходное положение
cam_relax_speed_ai				= 600

control_inertion_factor			= 1.5
misfire_probability				= 0.05		;вероятность осечки при максимальном износе 

PDM_disp_crouch					= 1.05
PDM_disp_crouch_no_acc			= 0.95
PDM_disp_accel_factor			= 1.3
PDM_disp_base					= 1.0
PDM_disp_vel_factor				= 1.3
;-----------------------------------------------------------------------------------


hand_dependence 		= 1
single_handed			= 0

slot 			 		= 2		; // secondary
animation_slot			= 2		; type of the animation that will be used

inv_name		 		= wpn_svu_name
inv_name_short		 	= wpn_svu_name_short
inv_weight		 		= 4.4

inv_grid_width			= 5
inv_grid_height			= 2
inv_grid_x				= 6
inv_grid_y				= 0

kill_msg_x			= 0
kill_msg_y			= 59
kill_msg_width		= 80
kill_msg_height		= 26

direction               = 0, 0, 1
fire_point              = 0.0, 0.128, 0.522
fire_point2             = 0.0, 0.128, 0.522

flame_particles		   	= weapons\generic_weapon05
smoke_particles		   	= weapons\generic_shoot_00
rpm_empty_click 	 	= 100

shell_point		 		= 0.0, 0.128, 0.0
shell_dir		 		= 0.0, 0.0, 0.4
shell_particles	 		= weapons\generic_shells

; ttc
hit_power			= 1.3
hit_impulse			= 105.4
hit_type 			= fire_wound

fire_distance		= 1000
bullet_speed		= 800	;начальная скорость пули
rpm					= 180
; end ttc

use_aim_bullet				= true		;Поддерживается ли первая суппер пуля
time_to_aim					= 1.0	

hud                     = wpn_svu_hud
normal                  = 0, 1, 0
position                = -0.026, -0.084, 0.0
orientation             = 0, 0, 0

;--STRAP PARAMETERS-----------------------------------------------------------------
;под мишкой
strap_position         		= -0.26,-0.11,0.25			; position (offset) and orientation of the weapon when it is strapped
strap_orientation      		= -15,-9,110				; (3rd person view in degrees)
strap_bone0					= bip01_spine2
strap_bone1					= bip01_spine1

startup_ammo            = 10
visual                  = weapons\svu\svu.ogf

light_disabled					= true

ph_mass			 		= 3

;addons
scope_status			= 1
silencer_status			= 0
grenade_launcher_status	= 0

scope_texture			= wpn_crosshair
zoom_enabled			= true
scope_zoom_factor	    = 8		;ПСО-1 4X

;звуки
snd_draw				= weapons\svu\draw
snd_holster				= weapons\general\holster
snd_shoot				= weapons\svu\shoot
snd_empty				= weapons\general\empty, 0.5
snd_reload				= weapons\svu\reload
snd_close				= weapons\general\close
snd_reload_jammed       = weapons\svu\draw
 
[wpn_svu_hud]

allow_inertion = true

shell_point          	= -0.15, -0.02, 0.05
shell_dir		 		= 0.0, 1.0, 0.0

fire_point               = 0.3, 0.0, 0.05
fire_bone               = wpn_body
orientation             = -1.5,-0.5,0
position                = -0.07,0.02,-0.07
visual                  = weapons\svu\svu_hud.ogf

anim_holster			= holster
anim_idle				= idle
anim_idle_aim			= idle
anim_reload				= reload
anim_draw				= draw
anim_shoot				= shoot
anim_idle_sprint		= idle_sprint

;смещения HUD для режима приближения
zoom_offset			= -0.2,0.05,-0.2
zoom_rotate_x		= 0.02
zoom_rotate_y		= 0.08

