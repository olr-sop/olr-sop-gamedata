[wpn_usp]:identity_immunities
GroupControlSection			= spawn_group
discovery_dependency 		= 
$spawn                   	= "weapons\usp"					; option for Level Editor
$npc			 			= on		; option for Level Editor
$prefetch 					= 8
scheduled            		= off              ; option for ALife Simulator
cform                    	= skeleton
class                    	= WP_PM
min_radius               	= 0
max_radius               	= 30
description					= enc_weapons1_wpn-usp

ef_weapon_type				= 5

;-----------------------------------------------------------------------------------
holder_range_modifier	= 1.0               ; во сколько раз увеличивается eye_range 
holder_fov_modifier		= 1.0              ; во сколько раз увеличивается eye_fov
;-----------------------------------------------------------------------------------

item_amount = 1

3d_static_scale = 1.25
cost					 	= 800

ammo_limit		 			= 120
ammo_current		 		= 96
ammo_elapsed		 		= 8

ammo_mag_size		 		= 12
ammo_class		 			= ammo_11.43x23_fmj, ammo_11.43x23_hydro 


hand_dependence			 	= 1

slot 				 		= 1
animation_slot		 		= 1		; type of the animation that will be used
single_handed				= 1

inv_name					= wpn_usp
inv_name_short				= wpn_usp
inv_weight					= 0.75

inv_grid_width				= 2
inv_grid_height				= 1
inv_grid_x					= 10
inv_grid_y					= 8

kill_msg_x			= 227
kill_msg_y			= 82
kill_msg_width		= 27
kill_msg_height		= 23

;-----------------------------------------------------------------------------------
;базовая дисперсия
control_inertion_factor		= 1.2
fire_dispersion_base		= 0.155 	;угол (в градусах) базовой дисперсии оружия (оружия зажатого в тисках)

;отдача
cam_relax_speed         	= 5	;скорость возврата в исходное положение
cam_dispersion          	= 0.18	;увеличения угла (в градусах) с каждым выстрелом
cam_dispersion_inc		= 0.2	;увеличениe cam_dispersion с каждым выстрелом
cam_dispersion_frac		= 0.75	;ствол будет подыматься на cam_dispersion*cam_dispersion_frac +- cam_dispersion*(1-cam_dispersion_frac)
cam_max_angle			= 10.0	;максимальный угол отдачи
cam_max_angle_horz		= 12.0	;(degree) maximum shot horizontal degree 
cam_step_angle_horz		= 1.0	;(degree) size of step camera moved in horizontal position while shooting

fire_dispersion_condition_factor= 3	;увеличение дисперсии в процентах при максимальном износе 
misfire_probability 		= 0.003	;вероятность осечки при максимальном износе 
misfire_condition_k			= 0.05
condition_shot_dec 			= 0.0007 ;увеличение износа при каждом выстреле
;-----------------------------------------------------------------------------------

direction                	= 0, 0, 1
fire_point               	= 0.0, 0.127, 0.117

flame_particles				= weapons\generic_weapon03
smoke_particles				= weapons\generic_shoot_00

shell_point		 			= 0.00, 0.127, 0.03
shell_dir		 			= 0.0, 0.0, 0.4
shell_particles	 			= weapons\generic_shells

rpm_empty_click 	 		= 200

PDM_disp_base 			= 1.0
PDM_disp_vel_factor 		= 0.7
PDM_disp_accel_factor 		= 0.7
PDM_crouch	 		= 1.0
PDM_crouch_no_acc 		= 1.0

; ttc
hit_power               = 0.55
hit_impulse		 		= 45
hit_type = fire_wound

fire_distance           = 60
bullet_speed			= 285	;начальная скорость пули
rpm                     = 400
; end ttc

use_aim_bullet				= true		;Поддерживается ли первая суппер пуля
time_to_aim					= 1.0	

silencer_hit_power       	= 0.30
silencer_hit_impulse	 	= 80
silencer_fire_distance   	= 100`
silencer_bullet_speed	 	= 220

hud                      	= wpn_usp_hud
