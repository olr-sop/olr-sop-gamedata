[wpn_usp]:identity_immunities
GroupControlSection			= spawn_group
discovery_dependency 		= 
$spawn                   	= "weapons\usp"					; option for Level Editor
$npc			 			= on		; option for Level Editor
$prefetch 					= 8
scheduled            		= off              ; option for ALife Simulator
cform                    	= skeleton
class                    	= WP_PM
min_radius               	= 0
max_radius               	= 30
description					= wpn_usp_desc

ef_weapon_type				= 5

;-----------------------------------------------------------------------------------
holder_range_modifier	= 1.0               ; во сколько раз увеличивается eye_range 
holder_fov_modifier		= 1.0              ; во сколько раз увеличивается eye_fov
;-----------------------------------------------------------------------------------

item_amount = 1

3d_static_scale = 1.1
cost					 	= 400

ammo_limit		 			= 120
ammo_current		 		= 96
ammo_elapsed		 		= 8

ammo_mag_size		 		= 12
ammo_class		 			= ammo_11.43x23_fmj, ammo_11.43x23_hydro 


hand_dependence			 	= 1

slot 				 		= 1
animation_slot		 		= 1		; type of the animation that will be used
single_handed				= 1

inv_name					= wpn_usp_name
inv_name_short				= wpn_usp_name_short
inv_weight					= 0.75

inv_grid_width				= 2
inv_grid_height				= 1
inv_grid_x					= 12
inv_grid_y					= 11

kill_msg_x			= 227
kill_msg_y			= 82
kill_msg_width		= 27
kill_msg_height		= 23

;-----------------------------------------------------------------------------------
;базовая дисперсия
fire_dispersion_base			= 0.155		;угол (в градусах) базовой дисперсии оружия (оружия зажатого в тисках)
fire_dispersion_condition_factor= 3			;увеличение дисперсии в процентах при максимальном износе 
condition_shot_dec				= 0.00008	;увеличение износа при каждом выстреле

;отдача
cam_dispersion					= 0.27		;увеличения угла (в градусах) с каждым выстрелом
cam_dispersion_inc				= 0.37		;увеличениe cam_dispersion с каждым выстрелом
cam_dispersion_frac				= 0.85		;ствол будет подниматься на cam_dispersion*cam_dispersion_frac +- cam_dispersion*(1-cam_dispersion_frac)
cam_max_angle					= 48.0		;максимальный угол отдачи
cam_max_angle_horz				= 6.0		;(degree) maximum shot horizontal degree 
cam_step_angle_horz				= 0.6		;(degree) size of step camera moved in horizontal position while shooting
cam_relax_speed					= 7.5			;скорость возврата в исходное положение

control_inertion_factor			= 1.05
misfire_probability				= 0.003		;вероятность осечки при максимальном износе 

PDM_disp_crouch					= 0.9
PDM_disp_crouch_no_acc			= 0.85
PDM_disp_accel_factor			= 1.2
PDM_disp_base					= 0.9
PDM_disp_vel_factor				= 1.2
;-----------------------------------------------------------------------------------

direction                	= 0, 0, 1
fire_point               	= 0.0, 0.127, 0.117

flame_particles				= weapons\generic_weapon03
smoke_particles				= weapons\generic_shoot_00

shell_point		 			= 0.00, 0.127, 0.03
shell_dir		 			= 0.0, 0.0, 0.4
shell_particles	 			= weapons\generic_shells

rpm_empty_click 	 		= 200

; ttc
hit_power				= 0.47
hit_impulse				= 57.3
hit_type				= fire_wound

fire_distance			= 100
bullet_speed			= 270	;начальная скорость пули
rpm						= 400
; end ttc

use_aim_bullet				= true		;Поддерживается ли первая суппер пуля
time_to_aim					= 1.0	

silencer_hit_power       	= 0.30
silencer_hit_impulse	 	= 80
silencer_fire_distance   	= 100`
silencer_bullet_speed	 	= 220

hud                      	= wpn_usp_hud
normal                   	= 0, 1, 0
position                 	= -0.021, -0.09, 0.0
orientation              	= 0, 0, 1

;--STRAP PARAMETERS-----------------------------------------------------------------
;strap_position         		= -0.1,-0.45,0.2			; position (offset) and orientation of the weapon when it is strapped
;strap_orientation      		= 1.57,0,0						; (3rd person view)
;strap_bone0					= bip01_spine2
;strap_bone1					= bip01_spine1

;startup_ammo             	= 90
visual                   	= weapons\usp\usp.ogf

light_color		 			= 0.6,0.5,0.3
light_range		 			= 3.0
light_var_color		 		= 0.05
light_var_range		 		= 0.5
light_time 		 			= 0.2

ph_mass			 			= 1
;cost			 			= 350

;addons
scope_status				= 0
silencer_status				= 2;2
grenade_launcher_status		= 0

zoom_enabled				= true
scope_zoom_factor	    	= 55

;звуки
snd_draw					= weapons\usp\draw
snd_holster					= weapons\general\holster
snd_shoot					= weapons\usp\shoot
snd_empty					= weapons\general\pistol_empty
snd_reload					= weapons\usp\reload, 0.8
snd_close					= weapons\general\close
snd_reload_jammed           = weapons\usp\draw

weapon_remove_time			= 5000
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; silencer
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

silencer_name  				= wpn_addon_silencer		; section name for the attachable silencer
silencer_x 					= 46						; offset in inventory icon
silencer_y 					= -16					

;silencer_flame_particles 	= weapons\generic_weapon01
silencer_smoke_particles 	= weapons\generic_shoot_00
snd_silncer_shot			= weapons\general\silencer_shoot 
silencer_light_color		= 0.6,0.5,0.3
silencer_light_range		= 0.01
silencer_light_var_color	= 0.05
silencer_light_var_range	= 0.5
silencer_light_time 		= 0.2

 
[wpn_usp_hud]
allow_inertion = true

shell_point		         = -0.0, -0.0, 0.0
fire_point               = -0.100000,0.000000,0.060000
fire_bone                = wpn_body

;позиция и направление оружия с руками
orientation              = 0,0,0
position                 = 0.000000,-0.010000,-0.030000

;смещения HUD для режима приближения
zoom_offset			= -0.371200,0.116900,0.000000
zoom_rotate_x		= 0.106700
zoom_rotate_y		= 0.272400

;модель оружия с руками
visual                   = weapons\usp\usp_hud.ogf

;анимации оружия
anim_holster				= holster
anim_idle					= idle
anim_empty					= empty
anim_reload					= reload_full
anim_reload_empty			= reload
anim_draw					= draw
anim_draw_empty				= draw_empty
anim_shoot					= shoot1
anim_shot_last				= shoot_last
anim_close					= close
anim_idle_aim				= idle_aim
anim_idle_sprint			= idle_sprint





