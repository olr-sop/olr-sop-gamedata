rpm_empty_click 	 		= 270

; ttc
hit_power			= 0.403
hit_impulse			= 41.2
hit_type			= fire_wound	

fire_distance			= 100
bullet_speed			= 375
rpm						= 300
; end ttc

use_aim_bullet				= true		;Поддерживается ли первая суппер пуля
