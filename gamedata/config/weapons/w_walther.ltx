slot 			 			= 1
animation_slot				= 1									; type of the animation that will be used

inv_name					= wpn_walther_name
inv_name_short				= wpn_walther_name_short
inv_weight					= 0.7

inv_grid_width				= 2
inv_grid_height				= 1
inv_grid_x					= 10
inv_grid_y					= 11

kill_msg_x			= 168
kill_msg_y			= 178
kill_msg_width		= 27
kill_msg_height		= 23

;-----------------------------------------------------------------------------------
;базовая дисперсия
fire_dispersion_base			= 0.15		;угол (в градусах) базовой дисперсии оружия (оружия зажатого в тисках)
fire_dispersion_condition_factor= 4			;увеличение дисперсии в процентах при максимальном износе 
condition_shot_dec				= 0.0001	;увеличение износа при каждом выстреле

;отдача
cam_dispersion					= 0.22		;увеличения угла (в градусах) с каждым выстрелом
cam_dispersion_inc				= 0.32		;увеличениe cam_dispersion с каждым выстрелом
cam_dispersion_frac				= 0.85		;ствол будет подниматься на cam_dispersion*cam_dispersion_frac +- cam_dispersion*(1-cam_dispersion_frac)
cam_max_angle					= 68.0		;максимальный угол отдачи
cam_max_angle_horz				= 5.3		;(degree) maximum shot horizontal degree 
cam_step_angle_horz				= 0.5		;(degree) size of step camera moved in horizontal position while shooting
cam_relax_speed					= 8			;скорость возврата в исходное положение

control_inertion_factor			= 0.95
misfire_probability				= 0.005		;вероятность осечки при максимальном износе 

PDM_disp_crouch					= 0.85
PDM_disp_crouch_no_acc			= 0.8
PDM_disp_accel_factor			= 1.15
PDM_disp_base					= 0.85
PDM_disp_vel_factor				= 1.15
;-----------------------------------------------------------------------------------

direction           	    = 0, 0, 1
fire_point               	= 0.0, 0.136, 0.133
