[wpn_walther]:identity_immunities
GroupControlSection			= spawn_group
discovery_dependency 		= 
$spawn                   	= "weapons\walther"					; option for Level Editor
$npc			 			= on		; option for Level Editor
$prefetch 					= 8
scheduled         		   	= off              ; option for ALife Simulator
cform             		    = skeleton
class                    	= WP_WALTH
min_radius               	= 0
max_radius               	= 50
description					= wpn_walther_desc

ef_weapon_type				= 5

;script_binding  		= bind_weapon.Init

