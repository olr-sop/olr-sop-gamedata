if not editor() then

SIMPLE_LUA_DEBUG					= false	-- подрубает использование printf и кучи производных. Не трогает log1
WRITE_SCRIPT_NAME_TO_LOG			= true	-- пишет имя скрипта в лог который вызвал printf, тяжелая функция, использует трейсбэк
WIRTE_PRINTF_TO_LOG					= false	-- пишет printf в лог (медленно)
WRITE_PRINTF_TO_FILE				= true	-- пишет printf в отдельный txt файл olr_debug_log.txt находящийся в папке с игрой
WRITE_PRINTF_TO_FILE_USE_TRACEBACK	= false	-- при записи в отдельный файл использовать функцию traceback для большей отладки
FATAL_ABORT							= false	-- при abort игра закрывается принудительно

-- Данные переменные работают только если SIMPLE_LUA_DEBUG равен true, либо тут либо через ключ -simple_script_lua_debug
LOGGING_ONLY_SCRIPTNAME_ENABLE		= true	-- включает обработку printf только для определенный скриптов (список скриптов для переключения идут ниже)
LOGGING_ONLY_SCRIPTNAME				= ""	-- список скриптов через запятую
LOGGING_ONLY_SCRIPTNAME_EXCLUSION	= ""	-- исключения через запятую (игнорируются всегда)

function lua_traceback(caption, depth)
 return ( debug.traceback(caption, depth or 2 + 1) or 'nil' )
end

-- Получение имени скрипта из трассировки
function get_script_name(depth)
    local tb = lua_traceback('', depth or 4)
    for sub in string.gmatch(tb, "([^\\]+)%.script:") do
        if sub ~= "_g" then
            return sub
        end
    end
    
    -- Если не нашли других скриптов, проверяем, вызывается ли из _g
    if string.find(tb, "_g%.script:") or string.find(tb, "in main chunk") then
        return "_g"
    end
    
    return "???? or _G"
end

if string.find(command_line(), "-simple_script_lua_debug") then
	SIMPLE_LUA_DEBUG = true
end

-- Проверяет, соответствует ли строка шаблону
local function match_pattern(str, pattern)
    str = str:lower() -- приводим к нижнему регистру
    pattern = pattern:lower()
    
    if pattern:sub(-1) == "*" then -- шаблон с * в конце
        local prefix = pattern:sub(1, -2)
        return str:sub(1, #prefix) == prefix
    else -- точное совпадение
        return str == pattern
    end
end

function logging_script_by_name()
    if not LOGGING_ONLY_SCRIPTNAME_ENABLE then 
        return true -- если фильтрация выключена, пропускаем всё
    end
    
    local scriptname = get_script_name(5) -- получаем имя текущего скрипта
    
    -- ИСКЛЮЧЕНИЕ: если вызов происходит из _g, всегда разрешаем логирование
    if scriptname == "_g" or scriptname == "???? or _G" then
        return true
    end
    
    -- 1. Проверяем ИСКЛЮЧЕНИЯ (если скрипт в чёрном списке — сразу false)
    for exclusion_pattern in string.gmatch(LOGGING_ONLY_SCRIPTNAME_EXCLUSION, "([^,]+)") do
        exclusion_pattern = exclusion_pattern:match("^%s*(.-)%s*$") -- убираем пробелы
        if match_pattern(scriptname, exclusion_pattern) then
            return false -- совпало с исключением > false
        end
    end
    
    -- 2. Проверяем РАЗРЕШЁННЫЕ скрипты (если скрипт в белом списке > true)
    for allowed_pattern in string.gmatch(LOGGING_ONLY_SCRIPTNAME, "([^,]+)") do
        allowed_pattern = allowed_pattern:match("^%s*(.-)%s*$") -- убираем пробелы
        if match_pattern(scriptname, allowed_pattern) then
            return true -- совпало с разрешённым > true
        end
    end
    
    -- 3. Если скрипт не в белом списке > false
    return false
end

local last_script_name = "" -- забыл объявить

function printf(msg,...)
	local log_only_script = logging_script_by_name()
	if SIMPLE_LUA_DEBUG and log_only_script then
        local current_script_name = get_script_name(4)

        if WRITE_SCRIPT_NAME_TO_LOG and current_script_name ~= last_script_name then
            local separator = string.rep("-", 40)
            local script_info = separator.."\n".."printf was called from: "..current_script_name.."\n"..separator
            if WIRTE_PRINTF_TO_LOG then
                log1(script_info)
            end
            if WRITE_PRINTF_TO_FILE then
                debug_write(script_info, false)
            end
            last_script_name = current_script_name
        end
		
		if not (msg) then return end
		
		local fmt = format_to_string(msg,...) or "<nil>"
		if WIRTE_PRINTF_TO_LOG then
			log1(fmt)
		end
		if WRITE_PRINTF_TO_FILE then
			debug_write(fmt,WRITE_PRINTF_TO_FILE_USE_TRACEBACK)
		end
	end
end

local need_paste_timedate = true

function debug_write(output, trace)

    if (trace and debug and type(debug.traceback) == 'function') then
        output = output .. debug.traceback('\n', 2)
    end

    -- Всегда открываем файл в режиме добавления
    local file = io.open("olr_script_log.txt", "a+")
    
    if need_paste_timedate then
        local timestamp = os.date("%H:%M:%S %d.%m.%Y", os.time())
        local separator = string.rep("-", 40)
		file:write("\n")
        file:write(separator .. "\n")
		file:write("-- Особо внимания не обращайте если эта хуйня будет слишком часто, после каждой перезагрузки и т.д --\n")
        file:write("-- Реальное время создания : " .. timestamp .. " --\n")
        file:write(separator .. "\n")
		need_paste_timedate = false
    end
    
    -- Записываем вывод
    file:write(output .. "\n")
    file:close()
end

-- Крешнуть игру (после вывода сообщения об ошибке в лог)
function abort(fmt, ...)

    -- Сообщение об ошибке
    local reason = format_to_string(fmt, ...) or "<nil>"
	
	-- Выводим предупреждение о вылете
    local console = get_console()
    local msg_crit_error = "ВНИМАНИЕ! Игра принудительно прерывается! Отправьте лог разработчку!\n" .. "ОШИБКА: " .. reason
    log1(msg_crit_error)
    if level.present() then
        if db and (db.actor ~= nil) then
            if olr and olr.hud_tip_fatal then
                olr.hud_tip_fatal(msg_crit_error)
            end
        end
    end
	
	console:execute("flush")

    -- ==================== ФУНКЦИЯ ДЛЯ СБОРА СТЕКА ====================
    local function get_stacktrace(start_level)
        local frames = {}
        local level = start_level or 2  -- начиная с уровня, который вызвал abort
        while true do
            local info = debug.getinfo(level, "Sln")  -- получаем имя, строку, файл
            if not info then break end
            local name = info.name or "<anonymous>"
            local src = info.short_src or "?"
            local line = info.currentline or 0
            table.insert(frames, string.format("  %s:%d: in function '%s'", src, line, name))
            level = level + 1
        end
        if #frames == 0 then
            return "Call stack is empty (no additional frames)"
        end
        return "stack traceback:\n" .. table.concat(frames, "\n")
    end

    -- Собираем стек начиная с уровня 2 (вызывающий abort)
    local traceback_str = get_stacktrace(2)
    
    -- Информация о вызывающем коде (уровень 2)
    local caller = debug.getinfo(2, "Sln")
    local caller_info = ""
    if caller then
        caller_info = string.format("Call from: %s:%d (function '%s')",
            caller.short_src or "?",
            caller.currentline or 0,
            caller.name or "<anonymous>")
    else
        caller_info = "Call from: <неизвестно>"
    end
    
    -- Сообщение об ошибке
    local reason = format_to_string(fmt, ...) or "<nil>"
    
    -- Формируем диагностическое сообщение
    local diagnostic_msg = string.format(
        "==================== ABORT ====================\n" ..
        "Error: %s\n" ..
        "%s\n" ..
		"Call stack (full chain):\n%s\n" ..
        "=====================================================================",
        tostring(reason),
        tostring(caller_info),
        tostring(traceback_str)
    )
    
    -- Пишем в лог
	console:execute("flush")
    log1(diagnostic_msg)
	console:execute("flush")
    error(diagnostic_msg)
	
	--[[
    local console = get_console()
    local msg_crit_error = "ВНИМАНИЕ! Игра принудительно прерывается! Строка ниже является информацией об ошибке!\n" .. "ОШИБКА: " .. reason
    log1(msg_crit_error)
    error(msg_crit_error)
    if level.present() then
        if db and (db.actor ~= nil) then
            if olr and olr.hud_tip_fatal then
                olr.hud_tip_fatal(msg_crit_error)
            end
        end
    end
    
    if not FATAL_ABORT then
        log1("FATAL_ABORT отключён!")
        local msg_saves_corrupted = "Продолженная игра может привести к проблемам в игре и <битым> сохранениям!"
        log1(msg_saves_corrupted)
        if level.present() then
            if db and (db.actor ~= nil) then
                if olr and olr.hud_tip_fatal then
                    olr.hud_tip_fatal(msg_saves_corrupted)
                end
            end
        end
        console:execute("flush")
    else
        log1("FATAL_ABORT включён!")
        console:execute("flush")
        error(msg_crit_error)
    end
	--]]
end

function format_to_string(fmt, ...)
    if fmt == nil then return "" end
    
    local args = {...}
    local result = tostring(fmt)
    
    -- Сначала попробуем стандартный string.format
    local success, formatted = pcall(string.format, fmt, unpack(args))
    if success then
        return formatted
    end
    
    -- Если не получилось, реализуем свою логику
    local i = 1
    for spec in result:gmatch("%%[.0-9]*[dfi]") do
        if args[i] then
            if type(args[i]) == "number" then
                local num_format = spec:gsub("%%([.0-9]*)([dfi])", "%%%1f")
                local num_str = string.format(num_format, args[i])
                result = result:gsub(spec, num_str, 1)
            else
                result = result:gsub(spec, tostring(args[i]), 1)
            end
            i = i + 1
        end
    end
    
    -- Обрабатываем оставшиеся %s
    for _, arg in ipairs(args) do
        result = result:gsub("%%s", tostring(arg), 1)
    end
    
    -- Заменяем оставшиеся спецификаторы
    result = result:gsub("%%[.0-9]*[dfis]", "<Warning!><~NOT_arg!")
    
    return result
end

else

function printf(fmt,...)
end

function abort(fmt, ...)
end

end

