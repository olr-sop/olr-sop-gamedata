end

-- Глобальная функция для безопасного выполнения
function run_safely(func, error_message)
    local success, error_msg = pcall(func)
    if not success then
        log1(error_message .. " - " .. tostring(error_msg))
        return false, error_msg
    end
    return true
end

-- Взято из ЗП
local save_markers = {}

-- Функции для проверки корректности сейв лоад
function set_save_marker(p, mode, check, prefix)

	-- определяем ключ маркера.
	local result = (prefix or "")

	if check == true then
		if save_markers[result] == nil then
			abort("Trying to check without marker %s", result)
		end

		if mode == "save" then
			local dif = p:w_tell() - save_markers[result]
			if dif >= 8000 then
				log1("~ WARNING! may be this is problem save point: " .. result)
			end
			if dif >= 65535 then
				abort("Marker dif too large for u16 [%s]: %d", result, dif)
			end
			p:w_u16(dif)
			--log1(string.format("[SAVE_MARKER] %s: pos=%d dif=%d", result, p:w_tell(), dif))
		else
			local c_dif = p:r_tell() - save_markers[result]

			if p:r_eof() then
				abort("SAVE BROKEN [%s]: reader at eof before marker check (pos=%d, elapsed=%d, expected_dif=%d)", result, p:r_tell(), p:r_elapsed(), c_dif)
			end

			if p:r_elapsed() < 2 then
				abort("SAVE BROKEN [%s]: not enough bytes for marker check (elapsed=%d, need=2, expected_dif=%d)", result, p:r_elapsed(), c_dif)
			end

			local dif = p:r_u16()
			 if dif ~= c_dif then
				abort("INCORRECT LOAD [%s]: saved_dif=%d expected_dif=%d (pos=%d, marker_pos=%d)", result, dif, c_dif, p:r_tell(), save_markers[result])
			 else
				--log1(string.format("[LOAD_MARKER] %s: pos=%d dif=%d OK", result, p:r_tell(), dif))
			 end
		end
		return
	end

	if mode == "save" then
		save_markers[result] = p:w_tell()
		if p:w_tell() > 16000 then
			abort("You are saving too much in marker %s: %d bytes", result, p:w_tell())
		end
	else
		if p:r_eof() then
			abort("SAVE BROKEN [%s]: reader at eof when setting load marker (pos=%d, elapsed=%d)", result, p:r_tell(), p:r_elapsed())
		end
		save_markers[result] = p:r_tell()
	end

end

-- Безопасное чтение с проверкой перед каждым чтением
function safe_r(reader, method_name, bytes_needed, context)
	if reader:r_eof() then
		abort("SAVE BROKEN [%s]: trying to read %s (%d bytes) but at eof (pos=%d, elapsed=%d)", context or "?", method_name, bytes_needed or 0, reader:r_tell(), reader:r_elapsed())
	end
	if reader:r_elapsed() < (bytes_needed or 1) then
		abort("SAVE BROKEN [%s]: not enough bytes for %s (have=%d, need=%d, pos=%d)", context or "?", method_name, reader:r_elapsed(), bytes_needed, reader:r_tell())
	end
end

-- Новая функция string.truncate
-- "Обрезает" текст по кол-ву символов, заменяя последние три символа на троеточие (либо то что указано будет в аргументе ellipsis)
-- Аргументы
-- text - сам текст
-- max_length - длина текста в кол-ве символов
-- ellipsis - что подставить если текст длинее max_length
string.truncate = function(text, max_length, ellipsis)
    ellipsis = ellipsis or "..."
    
    if #text <= max_length then
        return text
    end
    
    local truncateLength = max_length - #ellipsis
    
    if truncateLength <= 0 then
        return ellipsis:sub(1, max_length)
    end
    
    -- Обрезаем текст
    local truncated = text:sub(1, truncateLength)
    
    -- Убираем пробелы и дефисы в конце
    truncated = truncated:gsub("[%s%-]+$", "")
    
    return truncated .. ellipsis
end

