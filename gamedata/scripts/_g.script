	end
end

function get_texture_info(id_name, id_default)
	if id_default == nil then id_default = id_name end

	local task_info = GetTextureInfo(id_name, id_default)
	local r = task_info:get_rect()

	r.x2 = r.x2 - r.x1
	r.y2 = r.y2 - r.y1
	return task_info:get_file_name(), r
end

-- SRP функции времени
local time_table =
{
	isdst = false,
	year  = 0,
	month = 0,
	day   = 0,
	hour  = 0,
	min   = 0,
	sec   = 0,
}

function get_game_seconds_srp()

	local Y, M, D, h, m, s, ms = 0, 0, 0, 0, 0, 0, 0
	      Y, M, D, h, m, s, ms = game.get_game_time():get(Y, M, D, h, m, s, ms)

	time_table.year  = Y
	time_table.month = M
	time_table.day   = D
	time_table.hour  = h
	time_table.min   = m
	time_table.sec   = s

	return os.time(time_table)
end

-- Инициализация базового игрового времени
function init_game_time_base()
	local t = amk.str_explode(":", system_ini():r_string("alife", "start_time"), true)
	local d = amk.str_explode(".", system_ini():r_string("alife", "start_date"), true)
	
	--log1("=== INIT GAME TIME BASE ===")
	--log1("Config start_time: " .. system_ini():r_string("alife", "start_time"))
	--log1("Config start_date: " .. system_ini():r_string("alife", "start_date"))
	--log1("Parsed time parts: t[1]="..t[1]..", t[2]="..t[2]..", t[3]="..t[3])
	--log1("Parsed date parts: d[1]="..d[1]..", d[2]="..d[2]..", d[3]="..d[3])
	
	db.game_start_time = game.CTime()
	-- Правильный порядок: year, month, day, hour, min, sec, ms
	db.game_start_time:set(
		tonumber(d[3]),	 -- year
		tonumber(d[2]),	 -- month
		tonumber(d[1]),	 -- day
		tonumber(t[1]),	 -- hour
		tonumber(t[2]),	 -- min
		tonumber(t[3]),	 -- sec
		0				 -- ms
	)
	
	--local y,m,d_,h,min,s,ms = db.game_start_time:get()
	--log1(string.format("db.game_start_time set to: %04d-%02d-%02d %02d:%02d:%02d.%03d", y, m, d_, h, min, s, ms))
	--log1("============================")
end

-- Получение текущего игрового времени в минутах
function get_game_minutes()
	return math.floor(game.get_game_time():diffSec(db.game_start_time) / 60) -- Артос округлял, тоже буду
end

-- Получение текущего игрового времени в секундах
function get_game_seconds()
	return game.get_game_time():diffSec(db.game_start_time)
end

-- Получение текущего игрового времени в миллисекундах
function get_game_mseconds()
	return game.get_game_time():diffSec(db.game_start_time) * 1000
end

function start_game_callback()
	log1("### [INFO] start_game_callback called")
	
	xr_sound.clear_all_sound_object()
	dialog_manager.fill_phrase_table()	

	-- init core
	core.core_init()
	m_netpk.attach()
	
	init_game_time_base() -- инит для таймера, пишет в db.чётототам время начала игры
end

