function set_inactivate_input_time(delta)
	db.storage[db.actor:id()].disable_input_time = game.get_game_time()
	db.storage[db.actor:id()].disable_input_idle = delta
	level.disable_input()
end
-- Принимает: позицию положения, позицию куда смотреть, время сна в минутах.
function set_sleep_relocate(point, look, timeout)
	local db_actor_id = db.actor:id()
	db.storage[db_actor_id].sleep_relocate_time = game.get_game_time()
	db.storage[db_actor_id].sleep_relocate_idle = timeout*60
	db.storage[db_actor_id].sleep_relocate_point = point
	db.storage[db_actor_id].sleep_relocate_look = look
end

-- проверяет целую часть числа на нечётность
function odd( x )
	return math.floor( x * 0.5 ) * 2 == math.floor( x )
end

