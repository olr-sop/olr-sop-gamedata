-- anomaly_holder.script
-- Хранилище аномалий для NPC

-- Радиусы аномалий по секциям (если не заданы в спавне)
local radius = {
    zone_buzz = 1,
    zone_buzz_weak = 1,
    zone_buzz_average = 1,
    zone_buzz_strong = 2,
    zone_gravi_zone = 7,
    zone_gravi_zone_weak = 6,
    zone_gravi_zone_weak_noart = 6,
    zone_gravi_zone_average = 6,
    zone_gravi_zone_strong = 6,
    zone_gravi_zone_killing = 7,
    zone_mincer = 7,
    zone_mincer_weak = 7,
    zone_mincer_weak_noart = 7,
    zone_mincer_average = 7,
    zone_mincer_strong = 7,
    zone_mosquito_bald = 7,
    zone_mosquito_bald_weak = 6,
    zone_mosquito_bald_weak_noart = 7,
    zone_mosquito_bald_average = 7,
    zone_mosquito_bald_strong = 7,
    zone_mosquito_bald_strong_noart = 7,
    zone_sarcofag = 5,
    zone_witches_galantine = 6,
    zone_witches_galantine_weak = 6,
    zone_witches_galantine_average = 6,
    zone_witches_galantine_strong = 7,
    zone_zharka_static = 5,
    zone_zharka_static_weak = 5,
    zone_zharka_static_average = 5,
    zone_zharka_static_strong = 5,
    zone_mine_field = 2,
    zone_death = 2
}

local function load_radius_from_config()
    local cfg = ini_file("olr_script_configs.ltx")
    local section_name = "anomaly_holder_radius"
    if not cfg or not cfg:section_exist(section_name) then
        return
    end

    local n = cfg:line_count(section_name)
    local id, value = "", ""
    for i = 0, n - 1 do
        local result
        result, id, value = cfg:r_line(section_name, i, "", "")
        if result and id ~= "" then
            local num = tonumber(value)
            if num ~= nil then
                radius[id] = num
            end
        end
    end
end

load_radius_from_config()

function get_radius_for_section(sect)
    if radius[sect] then
        return radius[sect]
    else
        log1("[ANOM_HOLDER] WARNING: cannot find radius for " .. sect .. ", using default 4")
        return 4
    end
end

local function get_online_anomaly_desc(id)
    if not db or not db.anoms_online then
        return nil
    end

    local obj = db.anoms_online[id]
    if not obj then
        obj = level.object_by_id(id)
    end
    if not obj then
        return nil
    end

    local sect = nil
    if obj.section then
        sect = obj:section()
    end

    local anom_radius = 0
    if obj.get_shape_radius then
        anom_radius = obj:get_shape_radius()
    end

    if not anom_radius or anom_radius <= 0 then
        anom_radius = sect and get_radius_for_section(sect) or 4
    end

    return {
        object = obj,
        pos = obj:position(),
        clsid = obj:clsid(),
        radius = anom_radius,
        section = sect
    }
end

function get_nearest_anomaly(npc, dirp)
    --log1("[ANOM_HOLDER] STEP9: get_nearest_anomaly called for " .. npc:name())
    local posn = npc:position()
    local dir
    local anomid = nil
    local mindist = 10000000
    local pos1 = nil
    local cls = 0
    local cnt = 0
    local anomdesc = nil

    if dirp then
        dir = dirp
    else
        dir = npc:direction()
    end

    if not db or not db.anoms_online then
        return false
    end

    for id, _ in pairs(db.anoms_online) do
        local o = get_online_anomaly_desc(id)
        if o then
            cnt = cnt + 1
            local delta = vector():set(o.pos):sub(posn)
            local planar_len = math.sqrt(delta.x * delta.x + delta.z * delta.z)
            if planar_len > 0.001 then
                local scalarmul = (delta.x * dir.x + delta.z * dir.z) / planar_len
                -- Если NPC движется от аномалии (scalarmul < -0.4), игнорируем её
                if scalarmul > -0.4 then
                    local dist = posn:distance_to(o.pos) - o.radius
                    if dist < mindist then
                        mindist = dist
                        anomid = id
                        pos1 = o.pos
                        cls = o.clsid
                        anomdesc = o
                    end
                end
            end
        end
    end

    --log1(string.format("[ANOM_HOLDER] STEP12: checked %d anomalies, mindist=%.2f", cnt, mindist))
    if anomid then
        --log1(string.format("[ANOM_HOLDER] STEP13: nearest anomaly id=%d, dist=%.2f, radius=%.2f", anomid, mindist + anomdesc.radius, anomdesc.radius))
        return true, anomid, pos1, cls, mindist + anomdesc.radius, anomdesc.radius, anomdesc.section
    else
        --log1("[ANOM_HOLDER] STEP14: no anomaly found")
        return false
    end
end

function get_nearest_anomaly_by_point(point)
    if not db or not db.anoms_online then
        return false
    end

    local anomid = nil
    local mindist = 20
    local pos1 = nil
    local cls = 0
    local anomdesc = nil

    for id, _ in pairs(db.anoms_online) do
        local o = get_online_anomaly_desc(id)
        if o then
            local dist = point:distance_to(o.pos) - o.radius
            if dist < mindist then
                mindist = dist
                anomid = id
                pos1 = o.pos
                cls = o.clsid
                anomdesc = o
            end
        end
    end

    if anomid then
        return true, anomid, pos1, cls, mindist, anomdesc.radius, anomdesc.section
    else
        return false
    end
end

