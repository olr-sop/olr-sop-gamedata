-- anomaly_holder.script
-- Хранилище аномалий для NPC

local anom_list = nil
local cur_level = nil

-- Радиусы аномалий по секциям (если не заданы в спавне)
local radius = {
    zone_buzz = 1,
    zone_buzz_weak = 1,
    zone_buzz_average = 1,
    zone_buzz_strong = 2,
    zone_gravi_zone = 7,
    zone_gravi_zone_weak = 6,
    zone_gravi_zone_weak_noart = 6,
    zone_gravi_zone_average = 6,
    zone_gravi_zone_strong = 6,
    zone_gravi_zone_killing = 7,
    zone_mincer = 7,
    zone_mincer_weak = 7,
    zone_mincer_weak_noart = 7,
    zone_mincer_average = 7,
    zone_mincer_strong = 7,
    zone_mosquito_bald = 7,
    zone_mosquito_bald_weak = 6,
    zone_mosquito_bald_weak_noart = 7,
    zone_mosquito_bald_average = 7,
    zone_mosquito_bald_strong = 7,
    zone_mosquito_bald_strong_noart = 7,
    zone_sarcofag = 5,
    zone_witches_galantine = 6,
    zone_witches_galantine_weak = 6,
    zone_witches_galantine_average = 6,
    zone_witches_galantine_strong = 7,
    zone_zharka_static = 5,
    zone_zharka_static_weak = 5,
    zone_zharka_static_average = 5,
    zone_zharka_static_strong = 5,
    zone_mine_field = 2,
    zone_death = 2
}

function get_radius_for_section(sect)
    if radius[sect] then
        return radius[sect]
    else
        printf("[ANOM_HOLDER] WARNING: cannot find radius for " .. sect .. ", using default 4")
        return 4
    end
end

function add_anomaly(id, cls, sect, rad)
    if anom_list == nil then
        anom_list = {}
        --log1("[ANOM_HOLDER] STEP1: initialized anom_list")
    end
    if cur_level ~= level.name() then
        anom_list = {}
        cur_level = level.name()
        --log1("[ANOM_HOLDER] STEP2: switched to level " .. cur_level .. ", cleared anom_list")
    end
    local radius_val = rad or get_radius_for_section(sect)
    anom_list[id] = {pos = 0, clsid = cls, radius = radius_val, section = sect}
    --log1(string.format("[ANOM_HOLDER] STEP3: added anomaly id=%d, cls=%d, sect=%s, radius=%.2f", id, cls, sect, radius_val))
end

function remove_anomaly(id)
    if anom_list then
        anom_list[id] = nil
        --log1("[ANOM_HOLDER] STEP4: removed anomaly id=" .. id)
    end
end

function enumerate_anoms()
    if cur_level ~= level.name() then
        anom_list = nil
        cur_level = level.name()
        --log1("[ANOM_HOLDER] STEP5: level changed, reset anom_list")
    end
    if not anom_list then
        anom_list = {}
        local cnt = 0
        for id = 1, 65535 do
            local obj = level.object_by_id(id)
            if obj then
                if obj:clsid() == clsid.zone_bfuzz_s or
                   obj:clsid() == clsid.zone_galant_s or
                   obj:clsid() == clsid.zone_mbald_s or
                   obj:clsid() == clsid.zone_mincer_s then
                    anom_list[id] = {object = obj, pos = obj:position(), clsid = obj:clsid()}
                    local pos = anom_list[id].pos
                    --log1(string.format("[ANOM_HOLDER] STEP6: found anomaly id=%d, clsid=%d at (%.2f,%.2f,%.2f)", id, obj:clsid(), pos.x, pos.y, pos.z))
                    cnt = cnt + 1
                end
            end
        end
        --log1("[ANOM_HOLDER] STEP7: total anomalies on level = " .. cnt)
        if cnt == 0 then
            anom_list = nil
            --log1("[ANOM_HOLDER] STEP8: no anomalies found, anom_list set to nil")
        end
    end
end

function get_nearest_anomaly(npc, dirp)
    --log1("[ANOM_HOLDER] STEP9: get_nearest_anomaly called for " .. npc:name())
    local posn = npc:position()
    local dir
    local anomid = nil
    local mindist = 10000000
    local pos1 = nil
    local cls = 0
    local cnt = 0
    local anomdesc = nil

    if dirp then
        dir = dirp
    else
        dir = npc:direction()
    end

    -- Если список аномалий пуст, пробуем перечислить
    if not anom_list then
        enumerate_anoms()
    end
    if not anom_list then
        log1("[ANOM_HOLDER] STEP10: anom_list still nil, no anomalies")
        return false
    end

    for id, o in pairs(anom_list) do
        if o then
            if o.pos == 0 then
                local obj = level.object_by_id(id)
                if obj then
                    o.pos = obj:position()
                    --log1("[ANOM_HOLDER] STEP11: updated position for anomaly id=" .. id)
                end
            end
            if o.pos ~= 0 then
                cnt = cnt + 1
                local delta = vector():set(o.pos):sub(posn)
                local scalarmul = (delta.x * dir.x + delta.z * dir.z) / math.sqrt(delta.x * delta.x + delta.z * delta.z)
                -- Если NPC движется от аномалии (scalarmul < -0.4), игнорируем её
                if scalarmul > -0.4 then
                    local dist = posn:distance_to(o.pos) - o.radius
                    if dist < mindist then
                        mindist = dist
                        anomid = id
                        pos1 = o.pos
                        cls = o.clsid
                        anomdesc = o
                    end
                end
            end
        end
    end

    --log1(string.format("[ANOM_HOLDER] STEP12: checked %d anomalies, mindist=%.2f", cnt, mindist))
    if anomid then
        --log1(string.format("[ANOM_HOLDER] STEP13: nearest anomaly id=%d, dist=%.2f, radius=%.2f", anomid, mindist + anomdesc.radius, anomdesc.radius))
        return true, anomid, pos1, cls, mindist + anomdesc.radius, anomdesc.radius, anomdesc.section
    else
        --log1("[ANOM_HOLDER] STEP14: no anomaly found")
        return false
    end
end