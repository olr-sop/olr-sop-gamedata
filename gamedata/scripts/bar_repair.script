local PROFIT_MARGIN = 1.1 -- Наценка на цену
local COST_DIVISOR = 1 -- множитель итоговой цены
local MIN_REPAIR_HOURS = 1 -- Минимальное время ремонта в часах
local COST_PER_HOUR = 500 -- Стоимость одного часа (он же делитель)

local function hours_str(hours)
    local lang = get_console():get_string("language")
    if lang ~= "rus" then
        return hours .. (hours == 1 and " hour" or " hours")
    else -- русский
        if hours >= 11 and hours <= 20 then
            return hours.." часов"
        end
        local last = hours % 10
        if last == 1 then
            return hours.." час"
        elseif last >= 2 and last <= 4 then
            return hours.." часа"
        else
            return hours.." часов"
        end
    end
end

-- Расчёт стоимости ремонта (Исправлена рекурсия + добавлена логика запрета/наценок)
local function calc_repair_cost(item)
    if not item then return 0 end
    
    local section = item:section()
    local current_margin = PROFIT_MARGIN

    -- Проверяем, есть ли особые условия для этого айтема
    if SPECIAL_REPAIR_ITEMS[section] then
        if SPECIAL_REPAIR_ITEMS[section] == 0 then
            return 0 -- Приравниваем стоимость ремонта к 0 (запрет ремонта)
        else
            current_margin = SPECIAL_REPAIR_ITEMS[section] -- Применяем специальную наценку
        end
    end

    -- Формула расчета стоимости
    return math.floor((1 - item:condition()) * item:cost() / COST_DIVISOR) * current_margin
end

-- Прекондишен проверки на необходимость чинить (Добавлена проверка на запрещенные вещи)
function trader_repair_precond(trader, actor)
    local slots = {0, 1, 2, 6}
    for _, slot_id in ipairs(slots) do
        local item = db.actor:item_in_slot(slot_id)
        -- Если предмет в слоте есть и он поврежден хотя бы на 1%
        if item and 1 > item:condition() + 0.01 then 
            return true -- Диалог появится, а внутри repair_costs разберется, что выводить
        end
    end
    return false
end

function trader_check_money_s0(trader, actor)
    local item = db.actor:item_in_slot(0)
    if item then
        local cost = calc_repair_cost(item)
        return cost > 0 and db.actor:money() >= cost and 1 > item:condition()
    end
    return false
end

function trader_check_money_s1(trader, actor)
    local item = db.actor:item_in_slot(1)
    if item then
        local cost = calc_repair_cost(item)
        return cost > 0 and db.actor:money() >= cost and 1 > item:condition()
    end
    return false
end

function trader_check_money_s2(trader, actor)
    local item = db.actor:item_in_slot(2)
