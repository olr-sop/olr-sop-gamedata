function get_inv_name(section)
	return system_ini():r_string(section,"inv_name")
end

function repair_func(slot_id, time_div, is_outfit)
	local item_in_slot = db.actor:item_in_slot(slot_id)
	if item_in_slot ~= nil then
		local item_cost = item_in_slot:cost()
		local item_cond = item_in_slot:condition()
		local sect = item_in_slot:section()
		if slot_id == 1 or slot_id == 2 then
			item_in_slot:unload_magazine(true)
			item_in_slot:detach_addons()
		end
		local item_repair_cost
		local time_to_repair
		if is_outfit then
			item_repair_cost = math.floor((1 - item_cond) * item_cost * armor_profit_margin)
			time_to_repair = math.floor((1 - item_cond) * item_cost * armor_profit_margin) / time_div
		else
			item_repair_cost = math.floor((1 - item_cond) * item_cost * weapon_profit_margin)
			time_to_repair = math.floor((1 - item_cond) * item_cost * weapon_profit_margin) / time_div
		end
		dialogs.relocate_money(actor, item_repair_cost, "out")
		local task_texture, task_rect = get_texture_info("ui_notification_lost_item")
		local news_text = "%c[255,160,181,169]"..game.translate_string("general_out_item").."\\n".."%c[default]"..game.translate_string(get_inv_name(item_in_slot:section()))
		db.actor:give_talk_message(news_text, task_texture, task_rect, "iconed_trade_info")
		olr.del(item_in_slot)
		xvars.cur_rest_wpn = tostring(sect)
		--log1(string.format(" item_cond[%f] time_div [%.2f] item_cost [%.2f]", item_cond, time_div, item_cost))
		--log1(string.format("[%s] time_to_repair [%.2f]", sect, time_to_repair))
		
		if sect == "exo_outfit" and item_cond < 0.5 then
			news_manager.send_tip(db.actor, game.translate_string("trader_repiar_armor_s6_0"), 16, "item", 25000)
		end
		olr_timers.st_timer("item_repair_bar_timer", time_to_repair, "nick.item_repair_bar_timer()")
		db.actor:disable_info_portion("bar_trader_repair_gotov")
		db.actor:give_info_portion("ametist_go_to_stanok_info")
	end
end

function trader_repiar_weapon_s0(trader, actor)
	repair_func(0, 10, false)
end

function trader_repiar_weapon_s1(trader, actor)
	repair_func(1, 1, false)
end

function trader_repiar_weapon_s2(trader, actor)
	repair_func(2, 1, false)
end

function trader_repiar_armor_s6(trader, actor)
	repair_func(6, 1, true)
end

function repair_costs(first_speaker, second_speaker)
	local task_texture, task_rect = get_texture_info("ui_notification_update_money")

	local item_name_and_price = ""
	local item_repair_cost = 0
	if db.actor ~= nil then
		local item_in_slot_0 = db.actor:item_in_slot(0)
		local item_in_slot_1 = db.actor:item_in_slot(1)
		local item_in_slot_2 = db.actor:item_in_slot(2)
		local item_in_slot_6 = db.actor:item_in_slot(6)

		if item_in_slot_0 ~= nil then
			item_repair_cost = math.floor((1 - item_in_slot_0:condition()) * item_in_slot_0:cost() * armor_profit_margin)
			if item_repair_cost > 0 then
				item_name_and_price = game.translate_string("list_trader_repair_3").." %c[255,238,155,23]"..item_repair_cost.."$%c[default]"
				db.actor:give_talk_message(item_name_and_price, task_texture, task_rect, "iconed_trade_info")
			end
		end
		if item_in_slot_1 ~= nil then
			item_repair_cost = math.floor((1 - item_in_slot_1:condition()) * item_in_slot_1:cost() * weapon_profit_margin)
			if item_repair_cost > 0 then
				item_name_and_price = game.translate_string("list_trader_repair_0").." %c[255,238,155,23]"..item_repair_cost.."$%c[default]"
				db.actor:give_talk_message(item_name_and_price, task_texture, task_rect, "iconed_trade_info")
			end
		end
		if item_in_slot_2 ~= nil then
			item_repair_cost = math.floor((1 - item_in_slot_2:condition()) * item_in_slot_2:cost() * weapon_profit_margin)
			if item_repair_cost > 0 then
				item_name_and_price = game.translate_string("list_trader_repair_1").." %c[255,238,155,23]"..item_repair_cost.."$%c[default]"
				db.actor:give_talk_message(item_name_and_price, task_texture, task_rect, "iconed_trade_info")
			end
		end
		if item_in_slot_6 ~= nil then
			item_repair_cost = math.floor((1 - item_in_slot_6:condition()) * item_in_slot_6:cost() * armor_profit_margin)
			if item_repair_cost > 0 then
				item_name_and_price = game.translate_string("list_trader_repair_2").." %c[255,238,155,23]"..item_repair_cost.."$%c[default]"
				db.actor:give_talk_message(item_name_and_price, task_texture, task_rect, "iconed_trade_info")
			end
		end
	end
end

function daem_pochinenyy_item_rem()
	local currep = xvars.cur_rest_wpn
	log1("Get currep - "..currep.."")
	if not system_ini():section_exist(currep) then
		log1("! ERROR: daem_pochinenyy_item_rem have non existing section!")
		olr.hud_tip("", "Произошла ошибка, секции записанной в xvars.cur_rest_wpn не существует.".."\\n".."Для исключения вылета используется эта заглушка!", 5)
		return
	end
	local wpn = alife():create(currep, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
	local cwpn = level.object_by_id(wpn.id)
	local task_texture, task_rect = get_texture_info("ui_notification_found_item")
	if wpn then
		if cwpn and cwpn:is_weapon() then -- похоже, что это не работает, надо как-то иначе кастовать
			cwpn:unload_magazine(false) -- при сдаче мы ранее разрядили
		end
		local news_text = "%c[255,160,181,169]"..game.translate_string("general_in_item").."\\n".."%c[default]"..game.translate_string(get_inv_name(currep))
		db.actor:give_talk_message(news_text, task_texture, task_rect, "iconed_trade_info")
	end
	xvars.cur_rest_wpn = ""
	db.actor:disable_info_portion("ametist_repair_gotovo_done_info")
	db.actor:give_info_portion("bar_trader_repair_gotov")
end