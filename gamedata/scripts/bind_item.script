-- биндер еды и частей мутантов
-- hi_flyer 10/03/15

local time_apdeyta = 0
local timerup = 1000

-- секции торговцев для исключения заражения, хорошего состояния и медленной порчи
-- уточнить торгует ли учённый на болотах в бункере который сидит
local trader_profile = {
	escape_trader_0000 = true, -- Жаба на Кордоне
	bar_barman = true, -- Крыса
	yan_scientist_gorbovsky = true, -- Профессор на Янтаре
	bar_dolg_petrenko = true, -- Торговец долга
	lvl5_bar_stalker_0051 = true, -- Медик долга
	lvl9_military_m_trader = true, -- Жаба на милитари
	lvl11_deadcity_stalker_0001 = true, -- Торговец свободы
}

function Init(obj)
	local oNewBinder = CItemBinder(obj)
	obj:bind_object(oNewBinder)
end

class "CItemBinder"(object_binder)
function CItemBinder:__init(obj)
	super(obj)
	self.raded = false
	self.drop_del = false
end

function CItemBinder:reload(section)
	object_binder.reload(self, section)
end

function CItemBinder:reinit()
	object_binder.reinit(self)
end

function CItemBinder:net_save_relevant()
	return true
end

function CItemBinder:save(packet)
	object_binder.save(self, packet)
end

function CItemBinder:load(reader)
	object_binder.load(self, reader)
end

function CItemBinder:net_spawn(data)
	if not object_binder.net_spawn(self, data) then
		return false
	end
	
	local se_obj = alife():object(self.object:id()) -- Получим сначала серверный объект

	if se_obj and xvars and xvars.foods and g_food_table[self.object:section()] then
		local id_str = tostring(se_obj.id)
		local entry = xvars.foods[id_str]
		if not entry or entry.sec ~= self.object:section() then
			local p_id = se_obj.parent_id
			local p_obj = p_id and alife():object(p_id)
			if p_obj and trader_profile[p_obj:name()] then
				--log1("! Еда у торговца: name = "..self.object:name().." id = "..se_obj.id.."")
				xvars.foods[id_str] = {sec = self.object:section(), rad = false}
			else
				--log1("! Еда не у торговца: name = "..self.object:name().." id = "..se_obj.id.."")
				xvars.foods[id_str] = {sec = self.object:section(), rad = math.random(1, 2) == 1}
			end
		end
	end	
	
	return true
end

function CItemBinder:net_destroy()
	object_binder.net_destroy(self)
end

local food_sections_neportit = { -- еда которая не должна портится (по крайней мере очень быстро)
								 -- не используется на данный момент
	conserva = true
}

function CItemBinder:update(delta)
	object_binder.update(self, delta)
	
	-- состояние еды у торговцев будет всегда от 90 до 99%
	local cond = self.object:condition()
	if cond == 1 and g_food_table[self.object:section()] then
		if self.object:parent() ~= nil and trader_profile[self.object:parent():name()] then
			--log1("! Меняем состояние еды у торговца: name = "..self.object:name().." id = "..self.object:id().."")
			self.object:set_condition((math.random(90, 99) / 100)) -- у торговцев еда всегда почти идеальна
		else
			--log1("! Меняем состояние еды не у торговца: name = "..self.object:name().." id = "..self.object:id().."")
			self.object:set_condition((math.random(45, 95) / 100)) -- у не торгашей как повезёт
		end
	end

	-- тут на апдейте портим еду раз в секунду
	if time_global() > time_apdeyta then
		time_apdeyta = time_global() + timerup
		if ini_sys:line_exist(self.object:section(), "cor_time") and cond > 0.01 then
			if self.object:parent() ~= nil and trader_profile[self.object:parent():name()] then
				self.object:set_condition(cond - (self:TimeCondLost()*0.25)) -- у торговецв еда портится в 4 раза дольше
				--log1("! Меняем состояние еды в апдейте у торговца - ["..self.object:name().."]  -- ["..self.object:condition().."] ")
			else
				if g_monster_parts_cooked_table[self.object:section()] then
					self.object:set_condition(cond - (self:TimeCondLost()*0.5)) -- приготовленная будет в два раза медленее чем сырая
					--log1("! Меняем состояние приготовленной еды в апдейте не у торговца - ["..self.object:name().."]  -- ["..self.object:condition().."] ")
				else
					self.object:set_condition(cond - self:TimeCondLost())
					--log1("! Меняем состояние еды в апдейте не у торговца - ["..self.object:name().."]  -- ["..self.object:condition().."] ")				
				end
			end
		end
	end
end

function CItemBinder:TimeCondLost()
	local skis = ini_sys:r_float(self.object:section(), "cor_time")
	if skis < 0 then
		return 0
	end
	return 100 / skis / 24 / 100 / 60 * 100
end