-- name: bind_kampfire.script
-- desc: Биндер костра, окно готовки, функция проверки нахождения актора у костра
-- author: theysani
-- date: 07.12.2025
-- last edit: 15.12.2025
--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------

local actor_near_kampfire = false
local hud = get_hud()
local kamp_current_id = 0 -- чисто чтоб апдейт не дёргался почём зря

function init(obj)
	local new_binder = kampfire_binder(obj)
	obj:bind_object(new_binder)
end

class "kampfire_binder"(object_binder)

function kampfire_binder:__init(obj)
	super(obj)
end

function kampfire_binder:reinit()
	object_binder.reinit(self)
end

function kampfire_binder:net_spawn(data)
	if not object_binder.net_spawn(self, data) then
		return false
	end
	
	--db.anoms_online[self.object:id()] = self.object
	
	return true
end

function kampfire_binder:net_destroy()
	object_binder.net_destroy(self)
	--db.anoms_online[self.object:id()] = nil
end

function kampfire_binder:update(delta)
	object_binder.update(self, delta)
	if db.actor then
	
		if self.object:position():distance_to(db.actor:position()) <= 4 then
			actor_near_kampfire = true
		else
			actor_near_kampfire = false
		end
		
		if (self.object:position():distance_to_sqr(db.actor:position()) <= 1.5) and kamp_current_id ~= self.object:id() then
			if not db.actor:has_info("cooking_wnd") then
				kamp_current_id = self.object:id()
				db.actor:give_info_portion("cooking_wnd")
				hud:AddCustomStatic("cooking_static", true)
				hud:GetCustomStatic("cooking_static"):wnd():SetTextST("cooking_use")
			end
		elseif (kamp_current_id == self.object:id()) and (self.object:position():distance_to_sqr(db.actor:position()) >= 1.5) then		
			kamp_current_id = 0
			if db.actor:has_info("cooking_wnd") then
				db.actor:disable_info_portion("cooking_wnd")
				hud:RemoveCustomStatic("cooking_static")
			end
		end
		
	end
end

function kampfire_binder:net_save_relevant()
	return true
end

--------------------------------------------------------------------------------------
-- Что бы мутанты не подходили к нам покуда мы у костра
--------------------------------------------------------------------------------------

function check_actor_near_kampfire()
	return actor_near_kampfire
end

--------------------------------------------------------------------------------------

function on_key_press(dik)
	local bind = dik_to_bind(dik)
	local inv_window = level.main_input_receiver()
	
	if bind == key_bindings.kUSE and db.actor:has_info("cooking_wnd") and kamp_current_id == 0 then
		--log1("~ [WARN] Actor has cooking_wnd info away from the kampfire")
		db.actor:disable_info_portion("cooking_wnd")
		hud:RemoveCustomStatic("cooking_static")
	end
	
	if bind == key_bindings.kUSE and db.actor:has_info("cooking_wnd") and kamp_current_id ~= 0 then
		if not (inv_window and inv_window:IsShown()) then					-- Простенькая проверка что если у нас уже открыто какое то окно (наше гуи, там или чёт иное), то не пытаться открывать окно готовки
			level.start_stop_menu(bind_kampfire.ui_cooking_wnd(), true)
		end
	end
end

-- Список частей
class "mutant_part_item" (CUIListItemEx)

function mutant_part_item:__init() super()
	self:SetWndRect		   (0,0,430,22)
	
	local ca = 255
	local cr = 216
	local cg = 186
	local cb = 140
	
	self.fn					= CUIStatic	   ()
	self.fn:SetAutoDelete	 (true)
	self:AttachChild		(self.fn)
	self.fn:SetWndRect	  (0,0,230,22)
	self.fn:SetText			   ("filename")
	self.fn:SetFont			   (GetFontLetterica18())
	self.fn:SetBaseTextColor	(cr,cg,cb,ca)

	self.fage				 = CUIStatic	()
	self.fage:SetAutoDelete	   (true)
	self:AttachChild		(self.fage)
	self.fage:SetWndRect	(230,0,200,22)
	self.fage:SetText		 ("fileage")
	self.fage:SetFont		 (GetFontLetterica16())
	self.fage:SetBaseTextColor	  (cr,cg,cb,ca)
end

-- Основное окно готовки
class "ui_cooking_wnd" (CUIScriptWnd)

function ui_cooking_wnd:__init() super()
	self.item_data = {}	 -- Таблица для хранения данных о предметах: {id, section}
	self.items_by_id = {}  -- Таблица для быстрого поиска предметов по ID
	
	self:InitControls()
	self:InitCallBacks()
end

function ui_cooking_wnd:__finalize()
	self.item_data = nil
	self.items_by_id = nil
end

function ui_cooking_wnd:InitControls()
	log1("~~~ Create new gui wnd")

	self:Init(0, 0, 1024, 768)
	
	local xml = CScriptXmlInit()
	if xml:is_16_9_mode() then
		xml:ParseFile("ui_cooking_wnd_16.xml")
	else
		xml:ParseFile("ui_cooking_wnd.xml")
	end
	
	self.background = xml:InitStatic("background", self)
	
	self.btn_exit = xml:Init3tButton("background:btn_exit",	   self.background)	   
	self:Register(self.btn_exit, "btn_exit")
	
	self.btn_cook = xml:Init3tButton("background:btn_cook",	   self.background)	   
	self:Register(self.btn_cook, "btn_cook")
	self.btn_cook:Enable(false)

	self.btn_cook_all = xml:Init3tButton("background:btn_cook_all",	   self.background)	   
	self:Register(self.btn_cook_all, "btn_cook_all")
	self.btn_cook_all:Enable(false)
	
	self.list_parts = xml:InitList("background:list_parts",	   self.background)	   
	self:Register(self.list_parts, "list_parts")
	self.list_parts:SetSelTextColor(255, 255, 255, 255)
	self:FillListParts()
end

function ui_cooking_wnd:InitCallBacks()
	self:AddCallback("btn_cook", ui_events.BUTTON_CLICKED, self.OnButton_cook_clicked, self)
	self:AddCallback("btn_cook_all", ui_events.BUTTON_CLICKED, self.OnButton_cook_all_clicked, self)
	self:AddCallback("btn_exit", ui_events.BUTTON_CLICKED, self.OnButton_exit_clicked, self)
	self:AddCallback("list_parts", ui_events.LIST_ITEM_CLICKED, self.OnListItemClicked, self)
end

function ui_cooking_wnd:OnListItemClicked()
	local list		  = self:GetListWnd("list_parts")
	if list:GetSize()==0 then return end

	self.btn_cook:Enable(true)

	local item_id		 = list:GetFocusedItem()
	local item			  = list:GetItem(item_id)
	list:ShowSelectedItemText(true)
	log1("Selected item in list")
	
	if item==nil then return end
end

function ui_cooking_wnd:OnButton_cook_clicked()
	local list		  = self:GetListWnd		   ("list_parts")
	list:ShowSelectedItemText(false)
	if list:GetSize()==0 then return end
	local index		   = list:GetSelectedItem	 ()
	
	if index == -1 then return end

	local item_data = self.item_data[index + 1]	 -- +1 потому что Lua индексы с 1, а список с 0
	
	if item_data then
		-- Получаем объект по ID и удаляем его
		local obj = level.object_by_id(item_data.id)
		if obj then
			olr.del(obj)
		end
		
		-- Создаем приготовленный предмет
		local cooked_section = item_data.section .. "_coocked"
		log1("Cooking " .. item_data.section .. " -> " .. cooked_section .. " (ID: " .. tostring(item_data.id) .. ")")
		olr.give_item(cooked_section)
	end
	
	-- Удаляем из внутренних таблиц
	table.remove(self.item_data, index + 1)
	self.items_by_id[item_data.id] = nil
	
	list:RemoveItem(index)
	
	self.btn_cook:Enable(false)
	
	-- Обновляем состояние кнопок
	if list:GetSize() == 0 then
		self.btn_cook_all:Enable(false)
	end
	
	log1("Item cooked successfully")
end

function ui_cooking_wnd:OnButton_cook_all_clicked()
	local list = self:GetListWnd("list_parts")
	if list:GetSize() == 0 then return end

	log1("~~~ Cooking all items: " .. list:GetSize() .. " items in list")

	-- Собираем количество каждого типа приготовленных предметов и сразу удаляем сырые
	local cooked_counts = {}
	for i = 1, list:GetSize() do   -- индексы item_data с 1
		local item_data = self.item_data[i]
		if item_data then
			local cooked_section = item_data.section .. "_coocked"
			cooked_counts[cooked_section] = (cooked_counts[cooked_section] or 0) + 1

			-- Удаляем исходный (сырой) предмет
			local obj = level.object_by_id(item_data.id)
			if obj then
				log1("Deleting raw item: ID=" .. item_data.id .. ", section=" .. item_data.section)
				olr.del(obj)
			end
		end
	end

	-- Одним вызовом на каждый тип переносим/создаём нужное количество приготовленных предметов
	for cooked_section, count in pairs(cooked_counts) do
		log1("Spawning " .. count .. " of " .. cooked_section)
		dialogs.relocate_item_section(nil, cooked_section, "in", count)
	end

	-- Очищаем список UI (индексы 0-based, идём с конца)
	for i = list:GetSize() - 1, 0, -1 do
		list:RemoveItem(i)
	end

	-- Очищаем таблицы данных
	self.item_data = {}
	self.items_by_id = {}
	self.btn_cook:Enable(false)
	self.btn_cook_all:Enable(false)

	log1("All items cooked successfully.")
end

function ui_cooking_wnd:Hide()
	log1("~~~ Close gui wnd")

	self.item_data = {}
	self.items_by_id = {}	
	
	self:GetHolder():start_stop_menu(self, false)
end

function ui_cooking_wnd:OnButton_exit_clicked()
	self:Hide()
end

function ui_cooking_wnd:OnKeyboard(dik, keyboard_action)
	CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
 
	if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
		if dik == DIK_keys.DIK_ESCAPE then
			self:Hide()
		end
	end
 
	return true
end

function ui_cooking_wnd:FillListParts()
	local calc = function(npc, obj)
		if obj ~= nil then
			local section = obj:section()
			if g_monster_parts_table[section] then
				local item_id = obj:id()
				local item_cond = obj:condition()
				if not self.items_by_id[item_id] then
					log1("Add to list - "..tostring(section).." with ID: "..tostring(item_id))
					self:AddItemToList(obj, section, item_cond)
					self.btn_cook_all:Enable(true)
				else
					log1("Item already in list: ID="..tostring(item_id))
				end
			end
		end
	end
	db.actor:iterate_inventory(calc, db.actor)
end

function ui_cooking_wnd:AddItemToList(obj, section, condition)
	local get_short_name = game.translate_string(ini_sys:r_string(section,"inv_name"))
	local cond_in_perc = string.format("%d%%", math.floor(condition * 100 + 0.5))
	
	local _itm			  = mutant_part_item()
	_itm.fn:SetText		   (get_short_name)
	_itm.fage:SetText	 (cond_in_perc)

	local list_box		  = self:GetListWnd("list_parts")
	local index = list_box:AddItem	  (_itm)
	
	-- Сохраняем данные о предмете в таблице по индексу
	local item_id = obj:id()
	local item_data = {
		id = item_id,
		section = section
	}
	
	table.insert(self.item_data, item_data)
	self.items_by_id[item_id] = true
	
	return index
end