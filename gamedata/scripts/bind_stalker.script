----------------------------------------------------------------------------------------------------------------------
class "actor_binder" (object_binder)
----------------------------------------------------------------------------------------------------------------------
function actor_binder:__init (obj) super(obj)
	self.bCheckStart = false
	self.surge_manager = surge_manager.get_surge_manager()
	self.weather_manager = level_weathers.WeatherManager()
	self.actor_detector = xr_detector.actor_detector()
	_G.xvars = get_stored_vars()
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:net_spawn(data)		

	level.show_indicators()

	self.bCheckStart = true
	self.weapon_hide = false -- спрятано или нет оружие при разговоре.
	weapon_hide = false -- устанавливаем глобальный дефолтовый флаг.

	if object_binder.net_spawn(self,data) == false then
		return false
	end

	db.add_actor(self.object)

	if self.st.disable_input_time == nil then
		level.enable_input()
	end

	self.weather_manager:reset()

	if(actor_stats.add_to_ranking~=nil)then
		actor_stats.add_to_ranking(self.object:id())
	end

	-- Загружаем настройки дропа
	death_manager.init_drop_settings()

	core.tc("actor_net_spawn")
	olr.actor_net_spawn()

	if (news_main) then
		news_main.init()
	end
	
	if (amk_offline_alife) then
		amk_offline_alife.init()
	end
	
	if (amk_offline_alife) then
		amk_offline_alife.update_npc_tables()
	end

	if xvars.chang_lev ~= level.name() then
		xvars.chang_lev = level.name()
		olr.change_level()
	end
	
	xvars.cur_fov = device():get_fov() -- заполняем cur_fov на момент нет-спавна актора, если вдруг дадим менять его то надо будет что-то еще придумывать
	
	get_console():execute("ph_timefactor 1") -- на всякий случай если вдруг мы вылезем из схемы sr_water а таймфактор физики не сбросится на единицу. Репорты были по этой кривой схеме. Решение пока такое.

	return true
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:net_destroy()
    if (actor_stats.remove_from_ranking ~= nil) then
        actor_stats.remove_from_ranking(self.object:id())
    end

    db.del_actor(self.object)

    sr_light.clean_up()

    self.object:set_callback(callback.inventory_info, nil)
    self.object:set_callback(callback.article_info, nil)
    self.object:set_callback(callback.on_item_take, nil)
    self.object:set_callback(callback.on_item_drop, nil)
    self.object:set_callback(callback.task_state, nil)
    self.object:set_callback(callback.level_border_enter, nil)
    self.object:set_callback(callback.level_border_exit, nil)
    self.object:set_callback(callback.take_item_from_box, nil)
    self.object:set_callback(callback.use_object, nil)
    self.object:set_callback(callback.on_item_belt, nil)
    self.object:set_callback(callback.on_item_slot, nil)
    self.object:set_callback(callback.on_item_ruck, nil)
    self.object:set_callback(callback.on_inv_item_select, nil)
    self.object:set_callback(callback.on_actor_weapon_fire, nil)
    self.object:set_callback(callback.on_eat_hud_object, nil)
    self.object:set_callback(callback.on_trade_btn_click, nil)
    self.object:set_callback(callback.on_actor_landed, nil)
    self.object:set_callback(callback.on_key_press, nil)
    self.object:set_callback(callback.on_mouse_press, nil)
	self.object:set_callback(callback.on_level_map_click, nil)

	self.object:set_callback(callback.on_item_volume_exceeded, nil)
	self.object:set_callback_bool(callback.on_item_can_take, nil)
	
	--theysani added
	self.object:set_callback(callback.on_drop_item_on_item, nil)
	self.object:set_callback(callback.on_obj_look, nil)
	self.object:set_callback(callback.on_obj_not_look, nil)
	
    ---self.object:set_callback(callback.on_actor_death, nil)

    if sr_psy_antenna.psy_antenna then
        sr_psy_antenna.psy_antenna:destroy()
        sr_psy_antenna.psy_antenna = false
    end

    xr_sound.stop_all_sound_object()

    bind_car.net_destroy(self.object)

    object_binder.net_destroy(self)
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:reinit()
	object_binder.reinit(self)
	
	local npc_id = self.object:id()

	db.storage[npc_id] = { }

	self.st = db.storage[npc_id]

	if alife() then
		self.st.pstor = nil
	end

	self.next_restrictors_update_time = -10000

	self.object:set_callback(callback.inventory_info, self.info_callback, self)
	self.object:set_callback(callback.article_info, self.article_callback, self)
	self.object:set_callback(callback.on_item_take, self.on_item_take, self)
	self.object:set_callback(callback.on_item_drop, self.on_item_drop, self)
	self.object:set_callback(callback.trade_sell_buy_item, self.on_trade, self) -- for game stats
	self.object:set_callback(callback.task_state, self.task_callback, self)
	self.object:set_callback(callback.level_border_enter, self.level_border_enter, self)
	self.object:set_callback(callback.level_border_exit, self.level_border_exit, self)
	self.object:set_callback(callback.take_item_from_box, self.take_item_from_box, self)
    self.object:set_callback(callback.hit, self.on_hit, self)
    self.object:set_callback(callback.use_object, self.use_obj, self)
    self.object:set_callback(callback.on_item_belt, self.obj_to_belt, self)       
	self.object:set_callback(callback.on_item_ruck, self.obj_to_ruck, self)
	self.object:set_callback(callback.on_inv_item_select, self.on_select_item, self)
    self.object:set_callback(callback.on_item_slot, self.obj_to_slot, self) 
    self.object:set_callback(callback.on_eat_hud_object, self.OnEatHudObj, self)
    self.object:set_callback(callback.on_trade_btn_click, self.OnTrdBtnClick, self)
    self.object:set_callback(callback.on_actor_landed, self.actor_landed, self)
    self.object:set_callback(callback.on_actor_weapon_fire, self.on_actor_shoot, self)
    self.object:set_callback(callback.on_key_press, self.OnKey, self)
    self.object:set_callback(callback.on_mouse_press, self.mouse_press, self)
	self.object:set_callback(callback.on_level_map_click, self.on_map_click, self)

	self.object:set_callback(callback.on_item_volume_exceeded, self.on_item_volume_exceeded, self)
	self.object:set_callback_bool(callback.on_item_can_take, self.on_item_can_take, self)
	
	--theysani added
	self.object:set_callback(callback.on_drop_item_on_item, self.on_drop_item_on_item, self)
	self.object:set_callback(callback.on_obj_look, self.on_look, self) 
	self.object:set_callback(callback.on_obj_not_look, self.on_not_look, self)
	
    --self.object:set_callback(callback.on_actor_death, self.OnActorDeath, self)

    bind_car.reinit(self.object)
end

function actor_binder:on_drop_item_on_item(item1, item2)
    --log1("on_drop_item_on_item: item1 = "..item1:name()..", item 2 = "..item2:name().."")
    
    -- Если предметы одинаковые - выходим
    if item1:name() == item2:name() then return end
    
    local section1 = item1:section()
    local section2 = item2:section()

    -- Функции проверки типов предметов
    local function is_detector(section)
        return section == "detector_simple" or 
               section == "detector_advances" or 
               section == "detector_elite" or
			   section == "psivizor_detector"
    end

    local function is_torch(section)
        return section == "device_torch"
    end

    local function is_torch_battery(section)
        return section == "battery_change_headlamp"
    end

    local function is_detector_battery(section)
        return section == "battery_change"
    end

    local function is_medical_combo(s1, s2)
        return (s1 == "med_injector_empty" and s2 == "med_injector_capsule") or
               (s1 == "med_injector_capsule" and s2 == "med_injector_empty")
    end

    -- 1. Обработка медицинских предметов (высший приоритет)
    if is_medical_combo(section1, section2) then
        olr.del(item1)
        olr.del(item2)
		alife():create("med_injector", db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
        olr.snd([[interface\inv_slot]])
        return
    end

    -- 2. Зарядка ФОНАРИКА (только battery_change_headlamp)
    if (is_torch(section1) and is_torch_battery(section2)) or
       (is_torch_battery(section1) and is_torch(section2)) then
        
        local torch = is_torch(section1) and item1 or item2
        local battery = is_torch_battery(section1) and item1 or item2
		
        if torch:condition() < 1 then
			torch:set_condition(1)
			olr.del(battery)
			
			local message = game.translate_string("st_olr_item_efs_charge").." ["..torch:get_name().."] - 100%"
			news_manager.send_tip(db.actor, message, nil, "info", 3000)
			olr.snd([[interface\inv_slot]])
		end
        return
    end

    -- 3. Зарядка ДЕТЕКТОРА (только battery_change)
    if (is_detector(section1) and is_detector_battery(section2)) or
       (is_detector_battery(section1) and is_detector(section2)) then
        
        local detector = is_detector(section1) and item1 or item2
        local battery = is_detector_battery(section1) and item1 or item2
        
        if detector:condition() < 1 then
            detector:set_condition(1)
            olr.del(battery)
            
            local message = game.translate_string("st_olr_item_efs_charge").." ["..detector:get_name().."] - 100%"
            news_manager.send_tip(db.actor, message, nil, "info", 3000)
            olr.snd([[interface\inv_slot]])
        end
        return
    end

    -- 4. Блокировка всех нежелательных комбинаций
    if (is_torch(section1) or is_detector(section1) or
        is_torch(section2) or is_detector(section2)) then
        -- Если один из предметов - устройство, а второй не батарейка - игнорируем
        return
    end
end

----------------------------------------------------------------------------------------------------------------------
function actor_binder:take_item_from_box(box, item)
	local story_id = box:story_id()
	if story_id == nil then
		return
	end
	if box:section() == "box_rukzak_treasure" and box:is_inv_box_empty() then
		level.start_stop_menu(level.main_input_receiver(), true)
		olr.give_item("custom_treasure_rukzak")
		olr.del(box)
	end
end
