-- Проверка по объёму выполняется в движке, если true то можно поднять, если false то подъема не будет
-- Если установили false нужно будет тут же сделать вывод почему, так как превышение объема считается далее и до него не дойдёт вообще
function actor_binder:on_item_can_take(obj)
	return true
end

-- Коллбэк вызывается только когда у нас превышение объема и нужно что-то сделать. Пока что будет только вывод сообщения о том что нет места в рюкзаке
function actor_binder:on_item_volume_exceeded(item, cur_volume, max_volume)
	--log1("Пытаемся поднять предмет - ["..tostring(item:section()).."] скока будет с предметом cur_volume - ["..tostring(cur_volume).."] нынешний макс объем max_volume - ["..tostring(max_volume).."]")
	local item_name = item:get_name()
	local text_all = game.translate_string("st_on_item_volume_exceeded").." "..item_name
	local hud = get_hud()
	local custom_static = hud:GetCustomStatic("custom_sms_text_actor")
	hud:AddCustomStatic("custom_sms_text_actor", true)
	hud:GetCustomStatic("custom_sms_text_actor"):wnd():SetTextST(tostring(text_all))
	hud:GetCustomStatic("custom_sms_text_actor").m_endTime = time_global()/1000 + 5	
end

function actor_binder:update(delta)
	local tostr = tostring
	if db.actor == nil then
		return
	end
	object_binder.update(self, delta)

	local time_ = time_global()
	
	game_stats.update (delta, self.object)

	if (self.surge_manager) then
		if (self.f_surge_manager_loaded ~= true) then
			self.surge_manager:initialize()
			self.f_surge_manager_loaded = true
		end
		self.surge_manager:update()
	end

	-- пораньше запустим проверки на сон
	-- ставить тут проверки на 0.01 не стоит, так как это значение является критическим после которого хп начнёт убывать!
	if olr_sleep.check_actor_sleep() then
		if db.actor.satiety < 0.025 then
			db.actor.satiety = 0.025
		end
		if db.actor.thirst < 0.025 then
			db.actor.thirst = 0.025
		end
	end
	
	-- апдейт погоды
	self.weather_manager:update()
	
	-- апдейт схемы детектора
	self.actor_detector:update()

	-- апдейт звуковой схемы актера
	xr_sound.update_actor()

	-- обновление схемы субтитров
	game_subtitles.update_subtitles()
		
	-- Обновление отключения ввода с клавиатуры.
	if self.st.disable_input_time ~= nil and
	   game.get_game_time():diffSec(self.st.disable_input_time) >= self.st.disable_input_idle 
	then
		level.enable_input()
		self.st.disable_input_time = nil
	end
	-- Обновление сна с переносом чувака в указанную позицию
	if self.st.sleep_relocate_time ~= nil and
	   game.get_game_time():diffSec(self.st.sleep_relocate_time) >= self.st.sleep_relocate_idle 
	then
		self.object:set_actor_position(self.st.sleep_relocate_point)
		local dir = self.st.sleep_relocate_point:sub(self.st.sleep_relocate_look)
		self.object:set_actor_direction(dir:getH())
		self.st.sleep_relocate_time = nil
	end

	-- Апдейт прятание оружия игрока во время диалога
	if weapon_hide == true or self.object:is_talking() and olr_pda.is_not_pda_dialog() then
		if self.weapon_hide == false then
			self.object:hide_weapon()
			self.weapon_hide = true
		end
	else
		if self.weapon_hide == true then
			self.object:restore_weapon()
			self.weapon_hide = false
		end
	end	

	-- обновление рестрикторов, которые под логикой, срабатывает через интервалы времени
	if self.next_restrictors_update_time < time_ then
		bind_restrictor.actor_update(delta)
		self.next_restrictors_update_time = time_ + 200
	end

	-- обновление постпроцессов
	if post_process ~= 0 then
		if post_process:update () == true then
		   post_process = 0
		end
	end

	-- обновление пси-антенны
	if sr_psy_antenna.psy_antenna then
		sr_psy_antenna.psy_antenna:update(delta)
	end

 	if self.bCheckStart then
		
		if not has_alife_info("start_olr_mod") and alife() then
			self.object:give_info_portion("start_olr_mod")
			_G.g_start_avi = true
			olr.start_game_vars()
		end

		if not has_alife_info("global_dialogs") then
			self.object:give_info_portion("global_dialogs")
		end

		if not has_alife_info("level_changer_icons") then
			self.object:give_info_portion("level_changer_icons")
		end
		
		if alife() then -- на всякий случай, я хуй знает чё там компиляторам надо не надо
			-- Один раз запускаем таймер проверки игровых новостей АМК
			-- Далее он будет сам себя запускать
			news_main.init_check_news_timer()
			
			-- Один раз запускаем таймер автосейвов
			-- Далее он будет сам себя запускать
			save_manager.check_autosave_timer()
			
			-- Проверка на мини-карту
			-- Если пда не сдох то включим принудительно на первом апдейте
			if not nick.is_pda_dead() then
				olr.show_minimap(true)
			else
				olr.show_minimap(false)
			end
		end
		
		level_tasks.add_lchanger_location()

		self.bCheckStart = false		
	end	


	amk.on_actor_upade()
	olr_debug.upd()
	core.tc("actor_update", delta)
	
	if dbg_time then
	
		local hud = get_hud()
		local StatCS = hud:GetCustomStatic("debug_time")
		local current_time = game.time()

		-- Получаем time_factor из конфига
		local alife_time_factor = ini_sys:r_float("alife", "time_factor")

		-- Расчет времени из game.time()
		local hours_from_game = math.floor(current_time / 3600000)
		local minutes_from_game = math.floor(current_time / 60000 - hours_from_game * 60)
		local seconds = math.floor((current_time % 60000) / 1000)	
		local formatted_game_time = string.format("%02d:%02d:%02d", hours_from_game, minutes_from_game, seconds)

		-- Получение времени из level
		local time_h = level.get_time_hours()
		local time_m = level.get_time_minutes()
		local formatted_level_time = string.format("%02d:%02d", time_h, time_m)

		-- Расчет delay (время с учетом time_factor)
		local delay = current_time * 1000 * alife_time_factor
		
		-- Получаем текущее время
		local current_time_real = os.time()
		-- Форматируем время в строку ЧЧ:ММ:СС
		local formatted_time_real = os.date("%H:%M:%S", current_time_real)
		
		-- Создание HUD элемента если он не существует
		if StatCS == nil then
			hud:AddCustomStatic("debug_time", true)
			StatCS = hud:GetCustomStatic("debug_time")
		end

		-- Формирование текста для отображения
		if StatCS ~= nil then
			local display_text = 
				--"Реальное время: " .. tostr(formatted_time_real) .. "\\n" ..
				--"Расчетное время из game.time(): " .. tostr(formatted_game_time) .. "\\n" ..
				--"Игровое время (level): " .. tostr(formatted_level_time) .. "\\n" ..
				"time_global(): " .. tostr(time_global()) .. "\\n" ..
				"game.time(): " .. tostr(game.time()) .. "\\n" ..
				"game.time64(): " .. tostr(game.time64()) .. "\\n" ..
				"get_game_seconds_srp(): " .. tostr(get_game_seconds_srp()) .. "\\n" ..
				"get_game_seconds(): " .. tostr(get_game_seconds()) .. "\\n" ..
				"get_game_minutes(): " .. tostr(get_game_minutes()) .. "\\n"
			
			StatCS:wnd():SetTextST(display_text)
		end	
	
	end
end

------------------------------------------------------------------
function actor_binder:save(packet)
	set_save_marker(packet, "save", false, "actor_binder")
	if packet:w_tell() == 0 then
		news_manager.send_tip(db.actor, game.translate_string("actor_bindersave_0"), nil, "freedom", 9000)
	end

	xvars.saves_count = xvars.saves_count + 1

	--printf("actor_binder:save(): self.object:name()='%s'", self.object:name())
	object_binder.save(self, packet)

	core.tc("actor_save",packet)

	--local pos_before

	-- Game difficulty
	--pos_before = packet:w_tell()
	packet:w_u8(level.get_game_difficulty())
	--log1(string.format("[SAVE actor_binder] game_difficulty: %d byte(s)", packet:w_tell() - pos_before))

	-- disable_input_time
	--pos_before = packet:w_tell()
	if self.st.disable_input_time == nil then
		packet:w_bool(false)
	else
		packet:w_bool(true)
		utils.w_CTime(packet, self.st.disable_input_time)
	end
	--log1(string.format("[SAVE actor_binder] disable_input_time: %d byte(s)", packet:w_tell() - pos_before))

	-- pstor
	--pos_before = packet:w_tell()
	xr_logic.pstor_save_all(self.object, packet)
	--log1(string.format("[SAVE actor_binder] pstor: %d byte(s)", packet:w_tell() - pos_before))

	-- weather
	--pos_before = packet:w_tell()
	self.weather_manager:save(packet)
	--log1(string.format("[SAVE actor_binder] weather: %d byte(s)", packet:w_tell() - pos_before))
	
	-- surge manager
	--pos_before = packet:w_tell()
	self.surge_manager:save(packet)
	--log1(string.format("[SAVE actor_binder] surge manager: %d byte(s)", packet:w_tell() - pos_before))
	

	-- psy_antenna
	--pos_before = packet:w_tell()
	sr_psy_antenna.save( packet )
	--log1(string.format("[SAVE actor_binder] psy_antenna: %d byte(s)", packet:w_tell() - pos_before))

	-- actor_detector
	--pos_before = packet:w_tell()
	self.actor_detector:save(packet)
	--log1(string.format("[SAVE actor_binder] detector: %d byte(s)", packet:w_tell() - pos_before))

	set_save_marker(packet, "save", true, "actor_binder")

	--log1(string.format("[SAVE actor_binder] TOTAL: %d bytes", packet:w_tell()))
end

----------------------------------------------------------------------------------------------------------------------
function actor_binder:load(reader)
	set_save_marker(reader, "load", false, "actor_binder")
	--printf("actor_binder:load(): self.object:name()='%s'", self.object:name())
	object_binder.load(self, reader)
	--printf("actor_binder:object_binder.load(): self.object:name()='%s'", self.object:name())

	--safe_r(reader, "r_u8", 1, "actor_binder.game_difficulty")
	local game_difficulty = reader:r_u8()
	--log1(string.format("[LOAD actor_binder] game_difficulty=%s", tostring(game_difficulty)))
	get_console():execute("g_game_difficulty "..game_difficulty_by_num[game_difficulty] or 0)

	--safe_r(reader, "r_u8", 1, "actor_binder.disable_input_time_flag")
	local stored_input_time = reader:r_u8()
	if stored_input_time == true then
		utils.r_CTime(reader)
	end

	--safe_r(reader, "r_u32", 4, "actor_binder.pstor_count")
	xr_logic.pstor_load_all(self.object, reader)

	--safe_r(reader, "r_stringZ", 1, "actor_binder.weather")
	self.weather_manager:load(reader)
	
	--safe_r(reader, "r_stringZ", 1, "actor_binder.surge_manager")
	self.surge_manager:load(reader)
	self.f_surge_manager_loaded = true

	--safe_r(reader, "r_bool", 1, "actor_binder.psy_antenna_flag")
	sr_psy_antenna.load(reader)
	

	--safe_r(reader, "r_u8", 1, "actor_binder.detector")
	self.actor_detector:load(reader)

	set_save_marker(reader, "load", true, "actor_binder")
end
