function actor_binder:article_callback(npc, group, name)

	if device().precache_frame > 1 then return end
	
	if group == "Diary" then
		news_manager.send_tip_new_dlg(name, "st_news_manager_pda_note", "flash", "tips", nil, 10000)
	elseif group == "Mutants" then
		news_manager.send_tip_new_dlg(name, "st_news_manager_information_mutants", "flash", "tips", nil, 10000)
	elseif group == "Social" then
		news_manager.send_tip_new_dlg(name, "st_news_manager_information_faction", "flash", "tips", nil, 10000)
	elseif group == "Artifacts" then
		news_manager.send_tip_new_dlg(name, "st_news_manager_information_artifacts", "flash", "tips", nil, 10000)
	elseif group == "Anomalies" then
		news_manager.send_tip_new_dlg(name, "st_news_manager_information_anomalies", "flash", "tips", nil, 10000)
	elseif group == "Locations" then
		news_manager.send_tip_new_dlg(name, "st_news_manager_information_level", "flash", "tips", nil, 10000)
	elseif group == "memuars" then
		news_manager.send_tip_new_dlg(name, "st_news_manager_notes", "flash", "tips", nil, 10000)
	elseif group == "zone_sevenparts" then
		news_manager.send_tip_new_dlg(name, "st_news_manager_info_received", "flash", "tips", nil, 10000)
	elseif group == "zone_zakazy" then
		news_manager.send_tip_new_dlg(name, "st_news_manager_order_received", "flash", "tips", nil, 10000)
	elseif group == "zone_prosby" then
		news_manager.send_tip_new_dlg(name, "st_news_manager_stalkers_requests", "flash", "tips", nil, 10000)
	elseif group == "Recipes_olr" then
		news_manager.send_tip_new_dlg(name, "st_news_manager_new_recipe", "flash", "tips", nil, 10000)
	else
		news_manager.send_tip_new_dlg(name, "st_news_manager_info_received", "flash", "tips", nil, 10000)
	end

end

