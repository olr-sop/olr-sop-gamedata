	olr.on_use(obj)
	core.tc("on_item_use", obj)
	-- Для анабиотика (надо или нет сами решите, для примера повесил на энергос)
	--[[
	if obj:section() == "energy_drink" then
		xr_effects.disable_ui(db.actor, nil)
		level.add_cam_effector("camera_effects\\surge_02.anm", 10, false, "bind_stalker.anabiotic_callback")
		level.add_pp_effector("surge_fade.ppe", 11, false)
		db.actor:give_info_portion("anabiotic_in_process")
	end
	--]]
end

function anabiotic_callback()
	level.add_cam_effector("camera_effects\\surge_01.anm", 10, false, "bind_stalker.anabiotic_callback_end")
	local rnd = math.random(35, 45)
	local m = surge_manager.get_surge_manager()
	if (m.started) then
		local diff_sec = math.ceil(game.get_game_time():diffSec(m.inited_time) / level.get_time_factor())
		if (rnd > (m.surge_time - diff_sec) * level.get_time_factor() / 60) then
			m.time_forwarded = true
			m.ui_disabled = true
			m:kill_all_unhided()
			m:end_surge()
		end
	end
	level.change_game_time(0, 0, rnd)
	log1("anabiotic_callback: time forwarded on [%d]", rnd)
end

function anabiotic_callback_end()
	xr_effects.enable_ui(db.actor, nil)
	db.actor:disable_info_portion("anabiotic_in_process")
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:on_actor_shoot() 
	olr_on_shoot.actor_shoot()
end
----------------------------------------------------------------------------------------------------------------------

function actor_binder:task_callback(_task, _objective, _state)
	if _objective:get_idx() == 0 then
		if _state == task.fail then
			news_manager.send_task(db.actor, "fail", _task, _objective)
		elseif _state == task.completed then
			news_manager.send_task(db.actor, "complete", _task, _objective)
		else
			news_manager.send_task(db.actor, "new", _task, _objective)
		end
	else
		if _task:get_objective(0):get_state() == task.in_progress then
			news_manager.send_task(db.actor, "update", _task, _objective)
		end
	end
end

