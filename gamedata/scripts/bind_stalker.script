function actor_binder:on_item_drop (obj)

	if quitting_game then return end -- per NatVac: keep game from processing dropped items when quitting game

    level_tasks.proceed(self.object)

	olr_items_drop.drop_item(obj)

	core.tc("on_item_drop", obj)

	--event("actor_item_drop"):trigger({obj = obj})
	
	--if db.actor:has_info("ui_inventory") then
	--	db.actor:invalidate_inventory()	-- Странные костыли флаера
	--end

end
