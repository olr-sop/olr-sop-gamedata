function actor_binder:info_callback(npc, info_id)
	--log1(string.format("*INFO*: npc='%s' id='%s'", npc:name(), info_id)) -- лог полученных инфопорций
	-- Сюжет
	level_tasks.proceed(self.object)

	if info_id == "ui_inventory" then
		olr_ui_inv_acinfo.on_inventory_show()
	elseif info_id == "ui_inventory_hide" then
		olr_ui_inv_acinfo.on_inventory_hide()
	end

	-- Отметки на карте
	level_tasks.process_info_portion(info_id)

	if info_id == "ui_talk_hide" then
		local new = xvars.quest_new_count or 0
		local complete = xvars.quest_complete_count or 0
		
		if new > 0 and complete > 0 then
			save_manager.create_quest_save("both")
		elseif complete > 0 then
			save_manager.create_quest_save("complete", complete)
		elseif new > 0 then
			save_manager.create_quest_save("new", new)
		end
	end
end
