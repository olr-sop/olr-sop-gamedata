-- Ключем является группировка персонажа. Значением является таблица, содержашая имена секций предметов.
local item_by_community = {}


-- Множители и минимаксы для выпадения вещей в зависимости от уровня
local mul_by_level = {}
local count_by_level = {}

-- Чистые количества патронов без множителя уровня: патроны следуют за оружием NPC
local ammo_count_base = {}

-- Предметы, которые нельзя удалять (квестовые например)
local always_keep_item = {}

-- Предметы, относящиеся к патронам. Их надо спаунить другим методом.
local ammo_sections = {}

-- Система приоритетов патронов
local ammo_base_multiplier = {}
local difficulty_multipliers = {}

-- отложенное удаление старых патронов, чтобы не пересечься со спавном лута
local deferred_release = {}

-- настройки дропа патронов
local ammo_drop_settings = {}

-- Кэш для множителей рангов
local rank_multipliers_cache = {}

-- Кэш для артефактов в капсуле
local capsule_suitable_arts = {}
local capsule_spawn_by_rank = {}

-- Путь до конфига
local death_ini = ini_file("misc\\death_generic.ltx")

-- отложенное удаление патронов погибших NPC (вызывается из bind_stalker)
function schedule_release(item)
	if item and item:id() then
		deferred_release[item:id()] = true
	end
end

function release_deferred_ammo()
	if next(deferred_release) == nil then
		return
	end
	for id in pairs(deferred_release) do
		local s_obj = alife():object(id)
		if s_obj then
			alife():release(s_obj, true)
		end
		deferred_release[id] = nil
	end
end

-- Кэшируем все артефакты и прочее в таблицы для быстрого доступа к ним
function load_capsule_settings()

	if ini_sys and ini_sys:section_exist("capsule_rone") then
		local suitable_arts = ini_sys:r_string("capsule_rone", "suitable_arts")
		if suitable_arts and suitable_arts ~= "" then
			local arts = parse_names(suitable_arts)
			for _, art_section in pairs(arts) do
				capsule_suitable_arts[#capsule_suitable_arts + 1] = art_section
			end
		end
	end

	local rank_categories = {"novice", "experienced", "veteran", "master"}
	for _, rank_category in ipairs(rank_categories) do
		local section_name = "capsule_" .. rank_category
		local chance = 0
		local max_artefacts = 0

		if death_ini:section_exist(section_name) then
			if death_ini:line_exist(section_name, "chance") then
				chance = tonumber(death_ini:r_string(section_name, "chance")) or 0
			end

			if death_ini:line_exist(section_name, "max_artefacts") then
				max_artefacts = tonumber(death_ini:r_string(section_name, "max_artefacts")) or 0
			end
		end

		if chance < 0 then
			chance = 0
		elseif chance > 1 then
			chance = 1
		end

		max_artefacts = math.max(0, math.floor(max_artefacts))

		capsule_spawn_by_rank[rank_category] = {
			chance = chance,
			max_artefacts = max_artefacts
		}
	end
end

function init_drop_settings()
	local tonum = tonumber
	local community_list = {
		"stalker",
		"trader",
		"dolg",
		"freedom",
		"bandit",
		"military",
		"zombied",
		"ecolog",
		"killer",
		"monolith",
		"actor_dolg",
		"sky",
		"sin",
		"sliznyaki",
		"lastday",
		"iskateli",
		"neutral",
		"deads",
		"actor_killer",
		"voenstals",
		"stranger"
	}

	for k, v in pairs(community_list) do
		-- Необходимо заполнить таблицу
		item_by_community[v] = {}
		if death_ini:section_exist(v) then
			local n = death_ini:line_count(v)
			local id, value = "", ""
			for i = 0, n - 1 do
				result, id, value = death_ini:r_line(v, i, "", "")
				item_by_community[v][id] = 1000 * tonum(value)
			end
		end
	end

	
	-- Множители и минимаксы для выпадения вещей в зависимости от уровня
	local level_name = level.name()

	if not death_ini:section_exist(level_name) then
		level_name = "default"
	end

	local n = death_ini:line_count(level_name)
	local id, value = "", ""
	for i = 0, n - 1 do
		result, id, value = death_ini:r_line(level_name, i, "", "")
		mul_by_level[id] = tonum(value)
	end

	ammo_count_base = {}
	local item_count_section = "item_count_" .. level.get_game_difficulty()
	local n = death_ini:line_count(item_count_section)
	for i = 0, n - 1 do
		result, id, value = death_ini:r_line(item_count_section, i, "", "")
		-- Нужно распарсить value в два значения
		local t = parse_nums(value)
		if t[1] == nil then
			abort("Error on [death_ini] declaration. Section [%s], line [%s]", item_count_section, tostring(id))
		end
		local min = t[1]
		local max = t[2]
		if max == nil then
			max = min
		end

		-- Патроны: чистое количество для спавна от оружия (без множителя уровня)
		ammo_count_base[id] = {min = tonum(min), max = tonum(max)}

		if mul_by_level[id] == nil then
			mul_by_level[id] = 0
		end

		min = tonum(min) * mul_by_level[id]
		max = tonum(max) * mul_by_level[id]

		count_by_level[id] = {min = min, max = max}
	end

	-- Предметы, которые нельзя удалять (квестовые например)
	local n = death_ini:line_count("keep_items")
	for i = 0, n - 1 do
		result, id, value = death_ini:r_line("keep_items", i, "", "")
		if value == "true" then
			always_keep_item[id] = true
		end
	end

	-- Предметы, относящиеся к патронам. Их надо спаунить другим методом.
	ammo_sections = {}
	local n = death_ini:line_count("ammo_sections")
	local id, value = "", ""
	for i = 0, n - 1 do
		result, id, value = death_ini:r_line("ammo_sections", i, "", "")
		ammo_sections[id] = true
	end
	
	-- Загружаем базовые множители патронов
	ammo_base_multiplier = {}
	if death_ini:section_exist("ammo_base_multiplier") then
		local n = death_ini:line_count("ammo_base_multiplier")
		for i = 0, n - 1 do
			result, id, value = death_ini:r_line("ammo_base_multiplier", i, "", "")
			ammo_base_multiplier[id] = tonum(value) or 0.5
		end
	end
	
	-- настройки дропа патронов
	ammo_drop_settings = {
		second_type_chance = 0.25,
		second_type_count_mult = 0.5,
		inventory_weapon_ammo_chance = 0.2,
		inventory_ammo_count_mult = 0.5
	}
	if death_ini:section_exist("ammo_drop") then
		if death_ini:line_exist("ammo_drop", "second_type_chance") then
			ammo_drop_settings.second_type_chance = tonum(death_ini:r_string("ammo_drop", "second_type_chance")) or 0.25
		end
		if death_ini:line_exist("ammo_drop", "second_type_count_mult") then
			ammo_drop_settings.second_type_count_mult = tonum(death_ini:r_string("ammo_drop", "second_type_count_mult")) or 0.5
		end
		if death_ini:line_exist("ammo_drop", "inventory_weapon_ammo_chance") then
			ammo_drop_settings.inventory_weapon_ammo_chance = tonum(death_ini:r_string("ammo_drop", "inventory_weapon_ammo_chance")) or 0.2
		end
		if death_ini:line_exist("ammo_drop", "inventory_ammo_count_mult") then
			ammo_drop_settings.inventory_ammo_count_mult = tonum(death_ini:r_string("ammo_drop", "inventory_ammo_count_mult")) or 0.5
		end
	end

	-- Загружаем множители сложности
	difficulty_multipliers = {
		novice = 1.00,
		stalker = 0.75,
		veteran = 0.50,
		master = 0.25
	}
	if death_ini:section_exist("difficulty_multiplier") then
		local n = death_ini:line_count("difficulty_multiplier")
		for i = 0, n - 1 do
			result, id, value = death_ini:r_line("difficulty_multiplier", i, "", "")
			difficulty_multipliers[id] = tonum(value) or 1.0
		end
	end
	
	local rank_sections = {"rank_novice", "rank_experienced", "rank_veteran", "rank_master"}
	for _, rs in ipairs(rank_sections) do
		if death_ini:section_exist(rs) then
			local n = death_ini:line_count(rs)
			for i = 0, n - 1 do
				result, id, value = death_ini:r_line(rs, i, "", "")
				if id and id ~= "" and value then
					local key = rs .. "_" .. id
					rank_multipliers_cache[key] = tonum(value) or 1.0
				end
			end
		end
	end
	
	-- Вызываем заполение кэша для капсулы
	load_capsule_settings()
	
	--dump_drop_tables() -- dump table for debugging
end

class "drop_manager"
function drop_manager:__init(npc)
	self.npc = npc
end

function drop_manager:create_release_item()
	local pairs_ = pairs
	-- защита от повторного создания лута
	local se_obj = alife():object(self.npc:id())
	if se_obj.death_droped == true then
		return
	end
	se_obj.death_droped = true

	-- проверка на запрет спавна лута
	local ini = self.npc:spawn_ini()
	local should_spawn_loot = not (ini and ini:section_exist("dont_spawn_loot"))

	-- старые патроны удаляем отложенно (см. schedule_release), чтобы не пересечься со спавном
	self.npc:iterate_inventory(keep_item, self.npc)

	if not should_spawn_loot then
		return
	end

	local spawn_items = item_by_community[self.npc:character_community()]
	if not spawn_items then
		return
	end

	-- оружие в слотах -- основной источник патронов
	local slot_weapons = {}
	local slot_1_item = self.npc:item_in_slot(1)
	local slot_2_item = self.npc:item_in_slot(2)
	if slot_1_item and slot_1_item:is_weapon() then
		slot_weapons[slot_1_item:section()] = true
	end
	if slot_2_item and slot_2_item:is_weapon() then
		slot_weapons[slot_2_item:section()] = true
	end

	-- оружие, лежащее просто в рюкзаке
	local inventory_weapons = {}
	self.npc:iterate_inventory(
		function(_, item)
			if item and item:is_weapon() then
				local ws = item:section()
				if not slot_weapons[ws] then
					inventory_weapons[ws] = true
				end
			end
		end,
		nil
	)

	-- патроны с оружия из слотов
	for weapon_section, _ in pairs_(slot_weapons) do
		spawn_weapon_ammo(self.npc, weapon_section, spawn_items, false)
	end

	-- патроны с оружия в рюкзаке: сильно меньший шанс и меньшее количество
	local inv_chance = ammo_drop_settings.inventory_weapon_ammo_chance or 0.2
	for weapon_section, _ in pairs_(inventory_weapons) do
		if math.random() <= inv_chance then
			spawn_weapon_ammo(self.npc, weapon_section, spawn_items, true)
		end
	end

	-- остальные предметы из таблицы коммунити
	for item_section, chance in pairs_(spawn_items) do
		if not ammo_sections[item_section] then
			local counts = count_by_level[item_section]
			if counts then
				local number = math.random(counts.min, counts.max)
				create_items(self.npc, item_section, number, chance)
			end
		end
	end
end

-- токенайзер строки ammo_class (секции с точками и дефисами)
function parse_ammo_class_names(s)
	local t = {}
	if not s then
		return t
	end
	for name in string.gmatch(s, "([%w_%.%-]+)") do
		t[#t + 1] = name
	end
	return t
end

-- список патронов, подходящих стволу (из его ammo_class)
function get_weapon_ammo_list(weapon_section)
	local raw = utils.cfg_get_string(ini_sys, weapon_section, "ammo_class", weapon_section, false, "", "")
	if not raw or raw == "" then
		return nil
	end
	local list = parse_ammo_class_names(raw)
	if #list == 0 then
		return nil
	end
	return list
end

-- спавн патронов под конкретный ствол
function spawn_weapon_ammo(npc, weapon_section, spawn_items, from_inventory)
	local ammo_list = get_weapon_ammo_list(weapon_section)
	if not ammo_list then
		return
	end

	-- оставляем только патроны, которые есть в таблице коммунити
	local candidates = {}
	for _, ammo_section in ipairs(ammo_list) do
		if ammo_sections[ammo_section] and spawn_items[ammo_section] then
			candidates[#candidates + 1] = ammo_section
		end
	end

	if #candidates == 0 then
		return
	end

	-- основной тип: взвешенный выбор (базовый вес * множитель ранга NPC)
	local chosen_ammo = select_ammo_type_for_weapon(npc, weapon_section, candidates)
	if not chosen_ammo then
		return
	end

	local count_mult = 1.0
	if from_inventory then
		count_mult = ammo_drop_settings.inventory_ammo_count_mult or 0.5
	end

	spawn_ammo_count(npc, chosen_ammo, count_mult)

	-- второй тип патронов -- с шансом из конфига
	local second_chance = ammo_drop_settings.second_type_chance or 0.25
	if #candidates > 1 and math.random() <= second_chance then
		local second_list = {}
		for _, ammo_section in ipairs(candidates) do
			if ammo_section ~= chosen_ammo then
				second_list[#second_list + 1] = ammo_section
			end
		end
		if #second_list > 0 then
			local second_ammo = select_ammo_type_for_weapon(npc, weapon_section, second_list)
			if second_ammo then
				spawn_ammo_count(npc, second_ammo, count_mult * (ammo_drop_settings.second_type_count_mult or 0.5))
			end
		end
	end
end

-- спавн патронов с количеством из таблиц (множитель сложности применяется в create_items)
function spawn_ammo_count(npc, ammo_section, count_mult)
	local counts = ammo_count_base[ammo_section] or count_by_level[ammo_section]
	if not counts or counts.max <= 0 then
		return
	end
	local number = math.floor(math.random(counts.min, counts.max) * (count_mult or 1.0))
	if number < 1 then
		number = 1
	end
	create_items(npc, ammo_section, number, 1000)
end

-- выбор одного типа патронов под ствол (веса: ammo_base_multiplier * rank_*)
function select_ammo_type_for_weapon(npc, weapon_section, available_ammo_types)
	if not available_ammo_types or #available_ammo_types == 0 then
		return nil
	end
	
	-- Если для оружия доступен только один тип патронов
	if #available_ammo_types == 1 then
		return available_ammo_types[1]
	end
	
	-- Получаем ранг NPC
	local npc_rank = npc:rank() or 0
	local rank_category = get_rank_category(npc_rank)
	
	-- Создаем таблицу с весами для каждого типа патронов
	local weights = {}
	local total_weight = 0
	
	for _, ammo_section in ipairs(available_ammo_types) do
		-- Базовый множитель
		local weight = ammo_base_multiplier[ammo_section] or 0.5
		
		-- Множитель ранга NPC
		local rank_mod = get_rank_multiplier(rank_category, ammo_section) or 1.0
		weight = weight * rank_mod
		
		weights[ammo_section] = weight
		total_weight = total_weight + weight
	end
	
	-- Случайный выбор на основе весов
	local random_value = math.random() * total_weight
	local current_weight = 0
	
	for ammo_section, weight in pairs(weights) do
		current_weight = current_weight + weight
		if random_value <= current_weight then
			return ammo_section
		end
	end
	
	return available_ammo_types[1]
end

-- Функция определяет категорию ранга
function get_rank_category(rank)
	if rank >= 900 then
		return "master"
	elseif rank >= 600 then
		return "veteran"
	elseif rank >= 300 then
		return "experienced"
	else
		return "novice"
	end
end

-- Функция получает множитель сложности
function get_difficulty_multiplier(difficulty_name)
	return difficulty_multipliers[difficulty_name] or 1.0
end

-- Функция получает множитель ранга для конкретного патрона
function get_rank_multiplier(rank_category, ammo_section)
	local key = "rank_" .. rank_category .. "_" .. ammo_section
	return rank_multipliers_cache[key] or 1.0
end

-- Функция вызывается для каждого предмета, если вернет false то предмет удалится.
function keep_item(npc, item)
	local mrandom = math.random
  local sim = alife()
	local obj = item and item:id() and sim:object(item:id())
	local section = item:section()
	
	if section == "bolt" then
		return false
	end

	if always_keep_item[section] == true then
		return true
	end

	if ammo_sections[section] and obj then
		schedule_release(item) -- старые патроны удаляем отложенно
		return true
	end

	if obj and (section == "device_pda" or section == "guitar_a" or section == "yad" or section == "hand_radio" or section == "harmonica_a" or section == "kruglov_flash") then
		schedule_release(item)
		return false
	end

	local medrnd = mrandom(1, 5)
	if obj and medrnd ~= 5 and item:is_medkit() then
		schedule_release(item)
		return false
	end

	if npc:character_community() == "trader" and obj then
		schedule_release(item)
		return false
	end	   

	if section == "device_torch" then
		local rndgood = mrandom(1, 40)
		if rndgood == 1 then
			item:set_condition((mrandom(75) + 87) / 100)
		else
			item:set_condition((mrandom(25) + 35) / 100)
		end
		return true
	end

	if section == "detector_simple" or section == "detector_advances" or section == "detector_elite" then
		item:set_condition((mrandom(55) + 5) / 100)
		return true
	end

	if item:is_outfit() then
		if section ~= "exo_outfit" then
			item:set_condition((mrandom(15) + 35) / 100)
		else
			item:set_condition((mrandom(5) + 15) / 100)
		end
		return true
	end

	local item_id = item:id()
	local item_in_slot = npc:item_in_slot(1)
	if item_in_slot ~= nil and item_in_slot:id() == item_id then
		item:unload_magazine(false)
		item:set_condition((mrandom(15) + 35) / 100)
		set_rad_flag(item)
		return true
	end

	item_in_slot = npc:item_in_slot(2)
	if item_in_slot ~= nil and item_in_slot:id() == item_id then
		item:unload_magazine(false)
		item:set_condition((mrandom(15) + 35) / 100)
		set_rad_flag(item)
		return true
	end

	if item:is_weapon() then
		local rndgood = mrandom(1, 50)
		if rndgood == 1 then
			item:set_condition((mrandom(75) + 88) / 100)
		else
			item:set_condition((mrandom(15) + 55) / 100)
		end
		return true
	end
	
	return false
end

-- Функция рандомит параметры артефактов находящихся внутри капсулы
function artefact_rnd_params(section)
	local mrandom = math.random
	local val_weight = ini_sys:r_float(section, "inv_weight")
	local val_weight_fin = val_weight + ((val_weight / 100) * mrandom(-10, 10))
	local val_cost = ini_sys:r_float(section, "cost")
	local val_cost_fin = val_cost + ((val_cost / 100) * mrandom(-10, 10))
	local val_cond = mrandom(10, 80) / 100
	return val_cond, val_cost_fin, val_weight_fin
end

-- Функция заполнения капсулы артефактами
function fill_capsule_with_artefacts(npc, se_cont_item)
	if not se_cont_item then
		return
	end

	if #capsule_suitable_arts == 0 then
		return
	end

	local npc_rank = npc:rank() or 0
	local rank_category = get_rank_category(npc_rank)
	local capsule_settings = capsule_spawn_by_rank[rank_category]

	if not capsule_settings then
		return
	end

	local chance = capsule_settings.chance or 0
	local max_artefacts = capsule_settings.max_artefacts or 0

	if chance <= 0 or max_artefacts <= 0 then
		return
	end

	for i = 1, max_artefacts do
		if math.random() <= chance then
			local art_section = capsule_suitable_arts[math.random(#capsule_suitable_arts)]
			local val_cond, val_cost, val_weight = artefact_rnd_params(art_section)
			se_cont_item:add_artefact(art_section, val_cond, val_cost, val_weight, true)
		end
	end
end

-- Функция спавнит необходимое число предметов
function create_items(npc, section, number, rnd)
	if ammo_sections[section] == true then
		if number > 0 then
			-- Применяем множитель сложности к количеству патронов
			local difficulty_names = {[0] = "novice", [1] = "stalker", [2] = "veteran", [3] = "master"}
			local difficulty = level.get_game_difficulty()
			local difficulty_name = difficulty_names[difficulty] or "novice"
			local multiplier = get_difficulty_multiplier(difficulty_name)
			
			local final_number = math.max(1, math.floor(number * multiplier))
			se_respawn.create_ammo(section, npc:position(), npc:level_vertex_id(), npc:game_vertex_id(), npc:id(), final_number)
		end
	else
		for i = 1, number do
			if math.random(1000) <= rnd then
				if section ~= "capsule_rone" then
					alife():create(section, npc:position(), npc:level_vertex_id(), npc:game_vertex_id(), npc:id())				
				else
					local itm_obj = alife():create(section, npc:position(), npc:level_vertex_id(), npc:game_vertex_id(), npc:id())
					local se_item = alife():object(itm_obj.id)
					local se_cont_item = alife():cast_to_cont(se_item)
					fill_capsule_with_artefacts(npc, se_cont_item)
				end
			end
		end
	end
end


function set_rad_flag(obj)
	if xvars and xvars.weapons and obj then
		local id_str = tostring(obj:id())
		local entry = xvars.weapons[id_str]
		if entry and entry.sec == obj:section() then
			return
		end
		xvars.weapons[id_str] = {sec = obj:section(), rad = math.random(1, 2) == 1}
	end
end

function dump_drop_tables()
	local pairs_ = pairs
	local sformat = string.format
	local output = ""
	
	local function add_line(text)
		output = output .. text .. "\n"
	end

	-- Таблица локализации сложности
	local difficulty_names = {
		[0] = "новичок",
		[1] = "опытный", 
		[2] = "ветеран",
		[3] = "мастер"
	}
	local current_difficulty = level.get_game_difficulty()
	local difficulty_str = difficulty_names[current_difficulty] or ("неизвестно ("..current_difficulty..")")

	--=== Заголовок ===--
	add_line("\n=== ПОЛНАЯ КОНФИГУРАЦИЯ СИСТЕМЫ ДРОПА ===")
	add_line(sformat("Уровень: %s | Сложность: %s", 
		game.translate_string(level.name()), difficulty_str))

	--=== 1. Шансы выпадения ===--
	add_line("\n--- ШАНСЫ ВЫПАДЕНИЯ ПРЕДМЕТОВ ---")
	add_line("Формат: Предмет > Raw/Вероятность/Проценты")
	add_line("-----------------------------------------")
	
	for comm, items in pairs_(item_by_community) do
		add_line(sformat("\n[Группировка: %s]", comm))
		for item, chance in pairs_(items) do
			local prob = chance / 1000
			local percent = prob * 100
			add_line(sformat("	%-25s: %-5d | %-5.3f | %-5.1f%%", 
				item, chance, prob, percent))
		end
	end


	--=== 4. Патроны ===--
	add_line("\n\n--- НАСТРОЙКИ ПАТРОНОВ ---")
	add_line("Секция			| Мин  | Макс | Примечание")
	add_line("-------------------------------------------")
	for item, counts in pairs_(count_by_level) do
		if ammo_sections[item] then
			add_line(sformat("%-18s | %-5d | %-5d | Выпадет если есть оружие для этих патронов", 
				item, counts.min, counts.max))
		end
	end

	--=== 5. Прочие настройки ===--
	add_line("\n\n--- ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ ---")
	add_line("Множители уровня:")
	for item, mul in pairs_(mul_by_level) do
		add_line(sformat("%-20s: x%.2f", item, mul))
	end

	add_line("\nНеудаляемые предметы:")
	for item, _ in pairs_(always_keep_item) do
		add_line("	" .. item)
	end

	--=== Итог ===--
	add_line("\n=== КОНЕЦ КОНФИГУРАЦИИ ===")

	log1(output)
	return output
end