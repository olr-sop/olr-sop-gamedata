-- Predicates ------------------------------------------------------------
function killer_leader_predicate(npc_info) 
    return npc_info.profile_name == "val_killer_leader"
end

-- Jobs ------------------------------------------------------------------
function load_job(sj, gname, type, squad, groups)
    if type == "val_smart_killer_north" then
        -- Лидер наёмников
        t = { section = "logic@val_killer_leader",
            idle = 0,
            prior = 10, state = {0},
            in_rest    = "", out_rest = "",
            predicate = killer_leader_predicate
        }
        table.insert(sj, t)

        -- Рядовые наёмники
        t = { section = "logic@val_killer_1",
            idle = 0,
            prior = 1, state = {0},
            in_rest    = "", out_rest = ""
        }
        table.insert(sj, t)
        t = { section = "logic@val_killer_2",
            idle = 0,
            prior = 1, state = {0},
            in_rest    = "", out_rest = ""
        }
        table.insert(sj, t)
        t = { section = "logic@val_killer_3",
            idle = 0,
            prior = 1, state = {0},
            in_rest    = "", out_rest = ""
        }
        table.insert(sj, t)
        t = { section = "logic@val_killer_4",
            idle = 0,
            prior = 1, state = {0},
            in_rest    = "", out_rest = ""
        }
        table.insert(sj, t)
        t = { section = "logic@val_killer_5",
            idle = 0,
            prior = 1, state = {0},
            in_rest    = "", out_rest = ""
        }
        table.insert(sj, t)
        t = { section = "logic@val_killer_6",
            idle = 0,
            prior = 1, state = {0},
            in_rest    = "", out_rest = ""
        }
        table.insert(sj, t)
        t = { section = "logic@val_killer_7",
            idle = 0,
            prior = 1, state = {0},
            in_rest    = "", out_rest = ""
        }
        table.insert(sj, t)
        t = { section = "logic@val_killer_8",
            idle = 0,
            prior = 1, state = {0},
            in_rest    = "", out_rest = ""
        }
        table.insert(sj, t)
    end
end

function load_states(gname, type)	
    if type == "val_smart_killer_north" then
		return function(gulag)
			return 0
		end
    end
end

