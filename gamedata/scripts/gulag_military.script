--------------------------------------------------------------------------
function load_ltx(gname, type)
	return nil
end

function checkStalker(npc_community, gulag_type, npc_rank, se_obj)
	if gulag_type == "mil_military_base" then
		if has_alife_info("greh_tanzor_leader_dead_habar_finded") then
			return npc_community == "killer"
		else
			return npc_community == "sin"
		end
	end
	
	return false
end

function checkMonster(npc_community, gulag_type, npc_rank, se_obj)
	return false
end
