-- Predicates ------------------------------------------------------------
function sin_leader_predicate(npc_info) 
    return npc_info.profile_name == "sim_sin_leader"
end

function sin_leader_capture_scene_predicate(npc_info) 
    return npc_info.profile_name == "mil_sin_leader_capture_scene"
end

function sin_sci_quest_predicate(npc_info)
	return npc_info.name == "mil_sin_scientist_quest"
end

function sin_duel_predicate(npc_info)
	return npc_info.name == "mil_sin_duel"
end

function sin_trans1_predicate(npc_info)
	return npc_info.name == "mil_sin_trans_1"
end

function sin_trans2_predicate(npc_info)
	return npc_info.name == "mil_sin_trans_2"
end

function sin_trans3_predicate(npc_info)
	return npc_info.name == "mil_sin_trans_3"
end

function sin_trans4_predicate(npc_info)
	return npc_info.name == "mil_sin_trans_4"
end

function sin_trans5_predicate(npc_info)
	return npc_info.name == "mil_sin_trans_5"
end

function sin_watching_predicate(npc_info)
	return npc_info.name == "mil_sin_watching"
end

function load_job(sj, gname, type, squad, groups)

	if type == "mil_military_base" then
		t = { section = "logic@mil_sin_trans_1",
			idle = 0,
			prior = 2, state = {0},
			in_rest = "", out_rest = "",
			predicate = sin_trans1_predicate
		}
