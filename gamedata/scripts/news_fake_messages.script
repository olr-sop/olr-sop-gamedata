-- Периодические фейковые (болталка) сообщения, по мотивам amk_uniq_news_lists

local min_time_fake = utils.cfg_get_float(ini_sys, "news_main_settings", "min_time_fakenews", 40)
local max_time_fake = utils.cfg_get_float(ini_sys, "news_main_settings", "max_time_fakenews", 80)
local fake_enabled = utils.cfg_get_bool(ini_sys, "news_main_settings", "enable_fakenews", nil, false, true)

local fake_messages = {

	"Надо мной только что прошла в северном направлении пара вертолётов. Координаты прилагаю. Не высовываемся, я не знаю, какие у них указания.",
	"Квад\\nИдём по пеленгу к упавшему на болотах вертолёту. Пока - никого.\\n\\n\"Долг\"\\nВ приватный канал, ммать!",
	"Квад\\nНаблюдаем волну мутантов, идёт с северо-запада, см. приложенные координаты.",
	"Квад\\nНаблюдаем волну мутантов, идёт из северного ущелья.",
	"Квад\\nНаблюдаем волну мутантов, идёт с востока, предположительно - из Тёмной долины.",
	"\"Мэй дэй\", стая псов прёт прямо на нас, точные координаты прилагаю!",
	"Мародёры, твари...\\n\\nПотап\\nМы догадываемся.",
	"Псевдособака набросилась, еле пристрелил!\\n\\nПотап\\nМолодец.",
	"\"Мэй дэй\", военные зажали на Агропроме в центральном комплексе!\\n\\n\"Долг\"\\nИ чего вам всё неймётся... предупреждали же, рейд будет.",
	"Лукаш, мерков перестреляли, идём домой.\\n\\n\"Свобода\"\\nВ приватный канал, придурки!",
	"Два-три-семь, идём домой, встречайте.",
	"Мародёры зажали, выручайте!\\n\\nКоординаты-то приложи, умник.",
	"Нужен выход в интернет. В баре есть, или к Сидоровичу плестись?\\n\\nПотап\\nВроде у бармена есть. В принципе, можешь попробовать пойти к связистам \"Долга\", у них точно доступ имеется.",
	"Хе-хе, я подогнал денежного клиента, срочно выйди на связь!",
	"Требуется сталкер, специалист по кодовым замкам, с опытом рейдов на север Зоны.",
	"Я слышал, что американцы к нам какого-то своего супермена заслали. Интересно будет на него посмотреть.",
	"В подвалы не суйтесь, там тварей полно! Обходите поверху!",
	"Хемуль, срочно дуй в бар, дело есть!",
	"Народ! Осторожнее в деревне на складах - там \"Жгучего пуха\" намело на столбы!",
	"Блин! Ё-моё, снова зомби полным-полно на Янтаре! Аккуратней там, народ!\\nПотап\\nУникальная информация...",
	"Сталкеры! Сахаров даёт неплохие деньги за хабар! И всё ищет, кого бы в Х-16 послать... Я что-то не рискую... Фонит там дико, да и зомби...",
	"Внимание! Если в деревне в Тёмной долине вам предложат купить какую-то навороченную винтовку за 800 рублей - не верьте, это кидалово!",
	"Лысый\\nГубка Гоп, спортивные штаны. Увидите - пристрелите.",
	"Нужны сталкеры с опытом рейдов вглубь Зоны. Оплата соответствующая. Заинтересованным - стучать в личку, обговорим место встречи.",
	"Фанат\\nВолк, отзовись, поговорить надо.",
	"Бармен\\nТак... обьясняю раз и навсегда - я не скажу, где находится центр связи."
}

function get_strings()
	return fake_messages[math.random(table.getn(fake_messages))]
end

function init_check_timer()
	if not fake_enabled then return end
	if not olr_timers.has_game_timer("news_fake") then
		olr_timers.st_timer_game("news_fake", math.random(min_time_fake, max_time_fake) * 60, "news_fake_messages.check_show()")
	end
end

function check_show()
	if not fake_enabled then return end

	olr_timers.st_timer_game("news_fake", math.random(min_time_fake, max_time_fake) * 60, "news_fake_messages.check_show()")

	if news_main.isIsolatedLevel(level.name()) then return end
	if (olr_sleep.check_actor_sleep()) then return end
	if (surge_manager.is_surge_active()) then return end

	local text = get_strings()
	local name, sname = news_main.get_strings()
	news_manager.send_tip_new_offline_alife(text, name.." "..sname, "news", "pda_news", 0, 15000)
end