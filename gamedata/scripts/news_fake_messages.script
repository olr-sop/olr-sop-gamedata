-- Периодические фейковые (болталка) сообщения, по мотивам amk_uniq_news_lists

local min_time_fake = utils.cfg_get_float(ini_sys, "news_main_settings", "min_time_fakenews", 40)
local max_time_fake = utils.cfg_get_float(ini_sys, "news_main_settings", "max_time_fakenews", 80)
local fake_enabled = utils.cfg_get_bool(ini_sys, "news_main_settings", "enable_fakenews", nil, false, true)

-- Фейковые сообщения: заголовок и текст идут в паре, выборка одной случайной записи
local table_msg = {

	{header = "Шустрый", text = "Надо мной только что прошла в северном направлении пара вертолётов. Координаты прилагаю. Не высовываемся, я не знаю, какие у них указания."},
	{header = "Квад", text = "Квад\\nИдём по пеленгу к упавшему на болотах вертолёту. Пока - никого.\\n\\n\"Долг\"\\nВ приватный канал, ммать!"},
	{header = "Квад", text = "Квад\\nНаблюдаем волну мутантов, идёт с северо-запада, см. приложенные координаты."},
	{header = "Квад", text = "Квад\\nНаблюдаем волну мутантов, идёт из северного ущелья."},
	{header = "Квад", text = "Квад\\nНаблюдаем волну мутантов, идёт с востока, предположительно - из Тёмной долины."},
	{header = "Петренко", text = "\"Мэй дэй\", стая псов прёт прямо на нас, точные координаты прилагаю!"},
	{header = "Потап", text = "Мародёры, твари...\\n\\nПотап\\nМы догадываемся."},
	{header = "Потап", text = "Псевдособака набросилась, еле пристрелил!\\n\\nПотап\\nМолодец."},
	{header = "Шустрый", text = "\"Мэй дэй\", военные зажали на Агропроме в центральном комплексе!\\n\\n\"Долг\"\\nИ чего вам всё неймётся... предупреждали же, рейд будет."},
	{header = "Лукаш", text = "Лукаш, мерков перестреляли, идём домой.\\n\\n\"Свобода\"\\nВ приватный канал, придурки!"},
	{header = "Волк", text = "Два-три-семь, идём домой, встречайте."},
	{header = "Левша", text = "Мародёры зажали, выручайте!\\n\\nКоординаты-то приложи, умник."},
	{header = "Потап", text = "Нужен выход в интернет. В баре есть, или к Сидоровичу плестись?\\n\\nПотап\\nВроде у бармена есть. В принципе, можешь попробовать пойти к связистам \"Долга\", у них точно доступ имеется."},
	{header = "Сидорович", text = "Хе-хе, я подогнал денежного клиента, срочно выйди на связь!"},
	{header = "Бармен", text = "Требуется сталкер, специалист по кодовым замкам, с опытом рейдов на север Зоны."},
	{header = "Серый", text = "Я слышал, что американцы к нам какого-то своего супермена заслали. Интересно будет на него посмотреть."},
	{header = "Аким", text = "В подвалы не суйтесь, там тварей полно! Обходите поверху!"},
	{header = "Хемуль", text = "Хемуль, срочно дуй в бар, дело есть!"},
	{header = "Борода", text = "Народ! Осторожнее в деревне на складах - там \"Жгучего пуха\" намело на столбы!"},
	{header = "Потап", text = "Блин! Ё-моё, снова зомби полным-полно на Янтаре! Аккуратней там, народ!\\nПотап\\nУникальная информация..."},
	{header = "Крот", text = "Сталкеры! Сахаров даёт неплохие деньги за хабар! И всё ищет, кого бы в Х-16 послать... Я что-то не рискую... Фонит там дико, да и зомби..."},
	{header = "Фанат", text = "Внимание! Если в деревне в Тёмной долине вам предложат купить какую-то навороченную винтовку за 800 рублей - не верьте, это кидалово!"},
	{header = "Лысый", text = "Лысый\\nГубка Гоп, спортивные штаны. Увидите - пристрелите."},
	{header = "Бармен", text = "Нужны сталкеры с опытом рейдов вглубь Зоны. Оплата соответствующая. Заинтересованным - стучать в личку, обговорим место встречи."},
	{header = "Фанат", text = "Фанат\\nВолк, отзовись, поговорить надо."},
	{header = "Бармен", text = "Бармен\\nТак... обьясняю раз и навсегда - я не скажу, где находится центр связи."}
}

function get_message()
	return table_msg[math.random(table.getn(table_msg))]
end

function init_check_timer()
	if not fake_enabled then return end
	if not olr_timers.has_game_timer("news_fake") then
		olr_timers.st_timer_game("news_fake", news_main.get_weighted_delay(min_time_fake, max_time_fake) * 60, "news_fake_messages.check_show()")
	end
end

function check_show()
	if not fake_enabled then return end

	olr_timers.st_timer_game("news_fake", news_main.get_weighted_delay(min_time_fake, max_time_fake) * 60, "news_fake_messages.check_show()")

	if news_main.isIsolatedLevel(level.name()) then return end
	if (olr_sleep.check_actor_sleep()) then return end
	if (surge_manager.is_surge_active()) then return end

	local msg = get_message()
	if (msg == nil) then return end
	news_manager.send_tip_new_offline_alife(msg.text, msg.header, "news", "pda_news", 0, 15000)
end