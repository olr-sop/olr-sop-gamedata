-- Периодические фейковые (болталка) сообщения, по мотивам amk_uniq_news_lists

local min_time_fake = utils.cfg_get_float(ini_sys, "news_main_settings", "min_time_fakenews", 40)
local max_time_fake = utils.cfg_get_float(ini_sys, "news_main_settings", "max_time_fakenews", 80)
local fake_enabled = utils.cfg_get_bool(ini_sys, "news_main_settings", "enable_fakenews", nil, false, true)

-- Группы фейковых сообщений. Каждая группа - список записей {header, text, timeout}.
-- timeout (мс) - задержка перед отправкой именно этого сообщения; задаётся вручную для каждого,
-- поэтому для последовательного вывода нужно самому указывать возрастающие значения (0, 2500, 5000...).

-- шаблон
-- {header = "Заголовок", text = "Текст сообщения", timeout = 0},

local table_msg = {

	fake_msg_1 = {
		{header = "Квад", text = "Наблюдаем волну мутантов, идёт с северо-запада, см. приложенные координаты.", timeout = 0},
	},

	fake_msg_2 = {
		{header = "Тест", text = "Мародёры, твари...", timeout = 0},
		{header = "Потап", text = "Мы догадываемся.", timeout = 1000},
	},
	
	fake_msg_3 = {
		{header = "Тест", text = "Псевдособака набросилась, еле пристрелил!", timeout = 0},
		{header = "Потап", text = "Молодец.", timeout = 250},
	},
	
	fake_msg_4 = {
		{header = "Тест", text = "Блин! Ё-моё, снова зомби полным-полно на Янтаре! Аккуратней там, народ!", timeout = 0},
		{header = "Потап", text = "Уникальная информация...", timeout = 250},
	},
	
	fake_msg_5 = {
		{header = "Тест", text = "Нужен выход в интернет. В баре есть, или к Сидоровичу плестись?", timeout = 0},
		{header = "Потап", text = "Вроде у бармена есть. В принципе, можешь попробовать пойти к связистам \"Долга\", у них точно доступ имеется.", timeout = 1500},
	},
	
	fake_msg_6 = {
		{header = "Лысый", text = "Губка Гоп, спортивные штаны. Увидите - пристрелите.", timeout = 0},
	},
}

-- Индекс групп для случайного выбора (ключи fake_msg_N не годятся для table.getn)
local msg_groups = {}
for k, v in pairs(table_msg) do
	table.insert(msg_groups, v)
end

function get_group()
	return msg_groups[math.random(table.getn(msg_groups))]
end

function init_check_timer()
	if not fake_enabled then return end
	if not olr_timers.has_game_timer("news_fake") then
		olr_timers.st_timer_game("news_fake", news_main.get_weighted_delay(min_time_fake, max_time_fake) * 60, "news_fake_messages.check_show()")
	end
end

function check_show()
	if not fake_enabled then return end

	olr_timers.st_timer_game("news_fake", news_main.get_weighted_delay(min_time_fake, max_time_fake) * 60, "news_fake_messages.check_show()")

	if news_main.isIsolatedLevel(level.name()) then return end
	if (olr_sleep.check_actor_sleep()) then return end
	if (surge_manager.is_surge_active()) then return end

	local group = get_group()
	if (group == nil) then return end

	for i = 1, table.getn(group) do
		local msg = group[i]
		if (msg and msg.text) then
			news_manager.send_tip_new_offline_alife(msg.text, msg.header, "news", "pda_news", tonumber(msg.timeout) or 0, 15000)
		end
	end
end