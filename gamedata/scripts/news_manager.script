	end
	local x = tips_icons[sender_icon][1]
	local y = tips_icons[sender_icon][2]
	
	-- Проигрывание звука сообщения
	local sound_map = {
		pda_news = pda_news,
		pda_tip = pda_tips,
		pda_objective = pda_task,
		pda_sos = pda_sos,
		tips = pda_tips,
		pda_tips = pda_tips
	}
	local sound_to_play = pda_tips
	if sound_name and sound_map[sound_name] then
		sound_to_play = sound_map[sound_name]
	elseif sound_name then
		log1(string.format("В sound_name отправили некорректный звук которого нет в таблице '%s'", tostring(sound_name)))
	end
	sound_to_play:play(db.actor, timeout_sound, sound_object.s2d)
	
	
	-- Задаём цвета сообщений и заголовка а так-же проверяем на наличие заголовка
	tip_text = "%c[255,245,240,218]"..game.translate_string(tip_text)
	
	if not tip_header or tip_header == "" then
		tip_header = "%c[255,160,181,169]"..game.translate_string("st_tip")
	else
		tip_header = "%c[255,160,181,169]"..game.translate_string(tip_header)
	end
	
	db.actor:give_game_news(tip_text, tip_header, "ui\\icons\\icons_notifications", Frect():set(x,y,50,50), timeout, showtime)
	
	return true
end

local news = {} -- тут должны хранится специальные саунды озвучки, в тч это всякие звуковые сообщения.
				-- например сообщение Сидоровича про аномалии или коды от дверей в лабах

function send_tip_nosound(actor, news_id, timeout, sender) -- хоть эта функция и не используется в олр сделаю чтоб всё работало как надо
	if news_id == nil then return end
	timeout = 0
	-- Играем дефолтный звук
	pda_tips:play(db.actor, timeout, sound_object.s2d)
	local news_sound = news[news_id]
	return news_sound
end

--[[
	Пока переделал так, посмотрим что там по итогу будет далее
	Привёл к более ТЧ виду, но посмотрим, возможно что-то изменится
	Думаю упростить немного, убрать обычные типсы, оставить только диалоговые
	А вне диалога звук + кастом статик онли
	ТАК ЧТО ВОООООООООООООТ
--]]

local action_descr_by_type = {
	new = "general_new_task",
	update = "general_update_task", 
	complete = "general_complete_task",
	fail = "general_fail_task"
}

local texture_by_action_type = {
	new = "ui_notification_new_task",
	update = "ui_notification_update_task", 
	complete = "ui_notification_completed_task",
	fail = "ui_notification_failed_task"
}

function send_task(actor, type, task, objective)
	if db.actor == nil then return false end
	
	-- Получаем текстуру для текущего типа действия
	local texture_name = texture_by_action_type[type] or "ui_notification_update_task"
	local task_texture, task_rect = get_texture_info("ui_icon_task_" .. task:get_id(), texture_name)
        
	-- Играем дефолтный звук
	pda_task:play(db.actor, 0, sound_object.s2d)
	
	-- Формируем текст для типса
	local news_text = ""
	if db.actor:is_talking() then
		news_text = "%c[255,160,181,169]"..game.translate_string(action_descr_by_type[type]).."\\n".."%c[255,245,240,218]"..game.translate_string(task:get_title())
	else
		news_text = game.translate_string(task:get_title())
	end
	
	-- Формируем текст для статика
	local news_text_static = game.translate_string(action_descr_by_type[type]) .. " - " .. game.translate_string(task:get_title())
	
	-- Отправляем типс
	if db.actor:is_talking() then	
		db.actor:give_talk_message(news_text, task_texture, task_rect, "iconed_answer_item")
	else
		db.actor:give_game_news("%c[255,245,240,218]"..news_text, "%c[255,160,181,169]"..game.translate_string(action_descr_by_type[type]), task_texture, task_rect, 0, 3000)
	end
	
	-- В диалоге не делаем сейвы, только считаем сколько получили-выполнили заданий
	-- На выходе из диалога будет сделан сейв
	if db.actor:is_talking() then
		if type == "new" then
			xvars.quest_new_count = (xvars.quest_new_count or 0) + 1
		end
		if type == "complete" then
			xvars.quest_complete_count = (xvars.quest_complete_count or 0) + 1
		end
	end
	
	if type == "new" then
		xvars.quests_started = xvars.quests_started + 1
	end
	
	if type == "complete" then
		actor_stats.add_points("quests", task:get_title(), 1, 1)
	end

	if type == "new" or type == "update" then
		-- Выдать новое подзадание
		if task:get_objectives_cnt() == objective:get_idx()+1 then
			return
		end
		news_text_static = game.translate_string(action_descr_by_type[type]) .. " - " .. game.translate_string(task:get_objective(objective:get_idx() + 1):get_description())
	end

	local hud = get_hud()
	hud:AddCustomStatic("job_task", true)
	hud:GetCustomStatic("job_task"):wnd():SetTextST(news_text_static)
	hud:GetCustomStatic("job_task").m_endTime = time_global()/1000 + 8

end

function send_encyclopedy(type, title)
	if type == "Diary" then
		pda_news:play(db.actor, 0, sound_object.s2d)
		-- Берем координаты из текстуры таска
		local task_texture, task_rect = get_texture_info("ui_notification_info")
		local news_text = "%c[255,160,181,169]"..game.translate_string("st_found_another_pda").."\\n".."%c[default]"..game.translate_string(title)
		if db.actor:is_talking() then	
			db.actor:give_talk_message(news_text, task_texture, task_rect,"iconed_answer_item")
		else
			db.actor:give_game_news(news_text, "", task_texture, task_rect, 0, 3000)
		end	
	end
end

function get_inv_name(section)
	if ini_sys:line_exist(section, "known_info") then
		local known_inf = ini_sys:r_string(section, "known_info")
		if not has_alife_info(known_inf) then
			return "ui_st_unknown_art_name"
		end
	end
	return ini_sys:r_string(section,"inv_name")
end

function relocate_item(actor, type, item, amount)
	if db.actor == nil then return false end

	if not amount then
		amount = 1
	end
	
	local news_text = ""
	local news_text_wo_header = ""	
	
	-- Играем дефолтный звук
	if type == "in" then
	
		local task_texture, task_rect = get_texture_info("ui_notification_found_item")
		local news_header = "%c[255,160,181,169]"..game.translate_string("general_in_item")
		
		if amount == 1 then
			news_text_wo_header = game.translate_string(get_inv_name(item))
			news_text = "%c[255,160,181,169]"..game.translate_string("general_in_item").."\\n".."%c[default]"..game.translate_string(get_inv_name(item))
		else
			news_text_wo_header = game.translate_string(get_inv_name(item)).." x"..amount
			news_text = "%c[255,160,181,169]"..game.translate_string("general_in_item").."\\n".."%c[default]"..game.translate_string(get_inv_name(item)).." x"..amount
		end
		
		if db.actor:is_talking() then
			db.actor:give_talk_message(news_text, task_texture, task_rect,"iconed_answer_item")
		else
			db.actor:give_game_news(news_text_wo_header, news_header, task_texture, task_rect, 0, 3000)
		end
		
	elseif type == "out" then
	
		local task_texture, task_rect = get_texture_info("ui_notification_lost_item")
		local news_header = "%c[255,160,181,169]"..game.translate_string("general_out_item")

		if amount == 1 then
			news_text_wo_header = game.translate_string(get_inv_name(item))
			news_text = "%c[255,160,181,169]"..game.translate_string("general_out_item").."\\n".."%c[default]"..game.translate_string(get_inv_name(item))
		else
			news_text_wo_header = game.translate_string(get_inv_name(item)).." x"..amount
			news_text = "%c[255,160,181,169]"..game.translate_string("general_out_item").."\\n".."%c[default]"..game.translate_string(get_inv_name(item)).." x"..amount
		end
		
		if db.actor:is_talking() then
			db.actor:give_talk_message(news_text, task_texture, task_rect,"iconed_answer_item")
		else
			db.actor:give_game_news(news_text_wo_header, news_header, task_texture, task_rect, 0, 3000)
		end		
	end
end

function relocate_money(actor, type, amount)
	local tostr = tostring
	if db.actor == nil then return false end
	-- Играем дефолтный звук
	if type == "in" then
		local task_texture, task_rect = get_texture_info("ui_notification_found_money")
		local news_text = "%c[255,160,181,169]"..game.translate_string("general_in_money").."\\n".."%c[default]"..game.translate_string(tostr(amount))
		
		local news_text_wo_header = game.translate_string(tostr(amount))
		local news_header = "%c[255,160,181,169]"..game.translate_string("general_in_money")			
		
		if db.actor:is_talking() then
			db.actor:give_talk_message(news_text, task_texture, task_rect, "iconed_answer_item")
		else
			db.actor:give_game_news(news_text_wo_header, news_header, task_texture, task_rect, 0, 3000)
		end		
	elseif type == "out" then
		local task_texture, task_rect = get_texture_info("ui_notification_lost_money")
		local news_text = "%c[255,160,181,169]"..game.translate_string("general_out_money").."\\n".."%c[default]"..game.translate_string(tostr(amount))
		
		local news_text_wo_header = game.translate_string(tostr(amount))
		local news_header = "%c[255,160,181,169]"..game.translate_string("general_out_money")
		
		if db.actor:is_talking() then
			db.actor:give_talk_message(news_text, task_texture, task_rect, "iconed_answer_item")
		else
			db.actor:give_game_news(news_text_wo_header, news_header, task_texture, task_rect, 0, 3000)
		end		
	end
	
end