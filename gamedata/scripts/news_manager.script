function send_tip_new_offline_alife(tip_text, tip_header, sender_icon, sound_name, timeout, showtime) -- сильно упрощённый, сугубо для сопа
	if tip_text == nil then return end
	
	if has_alife_info("monolit_na_kordone") and not has_alife_info("aes_antenna_off_jaba_sms") then return end
	if level.name() == "l15_generators" then return end
	if nick.is_pda_dead() then 
		log1("try sms but pda dead - sms - ["..game.translate_string(tip_text).."]")
		return 
	end	
	
	-- Настройка параметров по умолчанию
	timeout = timeout or 0 -- в миллисекундах
	timeout_sound = timeout / 1000 -- в секундах для задержки звука
