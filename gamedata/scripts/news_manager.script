function send_tip(actor, news_id, timeout, sender, showtime, sender_id, kostyl, show_tip_top, sender_name)
	if news_id == nil then return false end

	timeout = timeout or 0
	showtime = showtime or 5000	

	-- Для совместимости с теми сообщениями где таймауты заданы были в секундах
	-- Для showtime сделано НА ВСЯКИЙ СЛУЧАЙ
	local timeout_msg
	local showtime_msg
	if timeout >= 100 then
		timeout_msg = timeout -- Если timeout уже в миллисекундах (>=100), используем как есть
	else
		timeout_msg = timeout * 1000 -- Иначе конвертируем секунды в миллисекунды
	end

	if showtime <= 100 then
		showtime_msg = showtime * 1000 -- Если showtime в секундах переводим в мс
	else
		showtime_msg = showtime -- Если showtime в мс то оставляем как есть
	end
	
	-- Мессага на про деприкатед
	--log1("~~~ WARN: Called news_manager.send_tip, plz replace to news_manager.send_tip_new")
	
	if debug_who_called then
		local caller_info = debug.getinfo(2, "Sl")
		local source = caller_info.source or "unknown"
		local line = caller_info.currentline or "unknown"
		log1("~~~ WARN: Called from: " .. source .. ":" .. tostring(line))
	end
	
	--tip_text, tip_header, sender_icon, sound_name, timeout, showtime
	send_tip_new(news_id, sender_name, sender, kostyl, timeout_msg, showtime_msg)
	
	-- Старый код, закомментирован
	--[[
	printf("try to send tips for [%s]", tostring(sender_id))
	if sender_id ~= nil then
		local sim = alife()
		if sim ~= nil then
			local npc = sim:story_object(sender_id)
			if npc ~= nil then
				if npc.online then
					--в онлайне проверяем на раненность
					if xr_wounded.is_heavy_wounded_by_id(npc.id) then
						printf("[PDA]Cannot send tips [%s], sender is heavy wounded", tostring(news_id))
						return false
					end
				end
				-- в других случаях только на смерть
				if npc:alive() == 1 then
					printf("[PDA]Cannot send tips [%s], sender is dead", tostring(news_id))
					return false
				end
			end
		end
	end

	-- Настройка параметров по умолчанию
	timeout = timeout or 0
	showtime = showtime or 5000
	show_tip_top = (show_tip_top ~= false)
	sender = sender or "default"
	
	-- Проверка существования sender в таблице tips_icons
	if tips_icons[sender] == nil then
		log1(string.format("~~~ В sender '%s' отправили ту иконку которой нет в таблице", tostring(sender)))
		sender = "default"
	end	

	-- Играем дефолтный звук или костыльно другой звук
	local sound_map = {
		pda_news = pda_news,
		pda_tip = pda_tips,
		pda_objective = pda_task,
		pda_sos = pda_sos
	}
	
	-- Определение задержки (в миллисекундах)
	local timeout_msg
	local timeout_snd = timeout
	if timeout >= 100 then
		-- Если timeout уже в миллисекундах (>=100), используем как есть
		timeout_msg = timeout
		timeout_snd = timeout / 1000 -- переводим из мс в сек для звука
	else
		-- Иначе конвертируем секунды в миллисекунды
		timeout_msg = timeout * 1000
	end		

	local sound_to_play = sound_map[kostyl] or pda_tips
	sound_to_play:play(db.actor, timeout_snd, sound_object.s2d)
	
	if sender == nil then
		sender = "default"
	end
	local x = tips_icons[sender][1]
	local y = tips_icons[sender][2]
	
	-- Определение текста сообщения в зависимости от show_tip_top
	-- Переделать нахуй, надо убирать show_tip_top и оставлять только sender_name
	local news_text, sender_text
	if show_tip_top ~= false then
		if sender_name then
			sender_text = "%c[255,160,181,169]"..game.translate_string(sender_name)
			news_text = "%c[255,245,240,218]"..game.translate_string(news_id)
		else
			sender_text = "%c[255,160,181,169]"..game.translate_string("st_tip")
			news_text = "%c[255,245,240,218]"..game.translate_string(news_id)
		end
	else
		sender_text = "%c[255,160,181,169]"..game.translate_string("st_tip")
		news_text = "%c[255,255,255,255]"..game.translate_string(news_id) -- для сообщений где всё сформировано в одну строку
	end
	
	db.actor:give_game_news(news_text, game.translate_string(sender_text), "ui\\icons\\icons_notifications", Frect():set(x,y,50,50), timeout_msg, showtime)
	--]]
	return true
end

--[[
	Сильно упрощенный скрипт сенд типсов
	Нет поддержки отправки сообщений от других сталкеров, де-факто всё в олр отправляется от имени актора
	поэтому всякие проверки на сендер_ид и актор не нужны, все сообщения будут от актора всегда
	заодно прибрал всякую фигню тут лишнюю и более явно теперь собираем всё воедино
	
	Пояснение по аргументам:
	tip_text - Сам текст сообщения (типса) ОБЯЗАТЕЛЬНЫЙ АРГУМЕНТ
	tip_header - Заголовок сообщения (типса), если nil то будет стандартное "Сообщение:" в заголовке
	sender_icon - иконка отправителя, можно nil, будет "default" иконка
	sound_name - звук сообщения, не обязательный, если nil то играем стандартный pda_tips
	timeout - задержка перед отправкой в миллисекундах
	showtime - время показа в миллисекундах
--]]
function send_tip_new(tip_text, tip_header, sender_icon, sound_name, timeout, showtime) -- сильно упрощённый, сугубо для сопа
	if tip_text == nil then return end
	
	-- Настройка параметров по умолчанию
	timeout = timeout or 0 -- в миллисекундах
	timeout_sound = timeout / 1000 -- в секундах для задержки звука
	showtime = showtime or 5000 -- в миллисекундах
	sender_icon = sender_icon or "default"
	
	-- Задаём иконку сообщения
	-- Проверка существования sender_icon в таблице tips_icons
	if tips_icons[sender_icon] == nil then
		log1(string.format("~~~ В sender_icon '%s' отправили ту иконку которой нет в таблице", tostring(sender_icon)))
		sender_icon = "default"
	end
	local x = tips_icons[sender_icon][1]
	local y = tips_icons[sender_icon][2]
	
	-- Проигрывание звука сообщения
	local sound_map = {
		pda_news = pda_news,
		pda_tip = pda_tips,
		pda_objective = pda_task,
		pda_sos = pda_sos,
		tips = pda_tips,
		pda_tips = pda_tips
	}
	local sound_to_play = pda_tips
	if sound_name and sound_map[sound_name] then
		sound_to_play = sound_map[sound_name]
	elseif sound_name then
		log1(string.format("В sound_name отправили некорректный звук которого нет в таблице '%s'", tostring(sound_name)))
	end
	sound_to_play:play(db.actor, timeout_sound, sound_object.s2d)
	
	
	-- Задаём цвета сообщений и заголовка а так-же проверяем на наличие заголовка
	tip_text = "%c[255,245,240,218]"..game.translate_string(tip_text)
	
	if not tip_header or tip_header == "" then
		tip_header = "%c[255,160,181,169]"..game.translate_string("st_tip")
	else
		tip_header = "%c[255,160,181,169]"..game.translate_string(tip_header)
	end
	
	-- Отправляем сообщение
	db.actor:give_game_news(tip_text, tip_header, "ui\\icons\\icons_notifications", Frect():set(x,y,50,50), timeout, showtime)
	
	return true
end

