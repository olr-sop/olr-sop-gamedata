	if level_name == "lvl7_yantar" then
		lm_where = game.translate_string("sim_dialog_aboutlevel_lvl7_yantar")
		db.actor:give_talk_message(""..lm_where.."", "ui\\ui_iconsTotal", Frect():set(0,0,10,10), "simple_answer_item")
