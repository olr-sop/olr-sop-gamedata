function killlll_rabogo()
	olr_timers.st_timer("illlll_rabog", 43, "nick.illlll_rabog()")
	local npc = alife():object("lvl5_bar_stalker_0038")
	if npc then
		local level_obj = level.object_by_id(npc.id)
		if level_obj then
			level_obj:kill(level_obj)
			local snd_obj = xr_sound.get_safe_sound_object([[weapons\pm\shoot]])
			snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 2.0)
		end
	end
end

