function vorglaz_away_from_garbage()
	olr.to_online("garb_zarka_fly_glaz")

	local sobj = olr.spawn_on_obj("sim_respawn_duty_regular", "gar_dolg_blokpost")
	if sobj then
		olr.kill_offline_stalker(sobj)
	end
	local sobj = olr.spawn_on_obj("sim_respawn_duty_veteran", "gar_dolg_blokpost")
	if sobj then
		olr.kill_offline_stalker(sobj)
	end
	local sobj = olr.spawn_on_obj("sim_respawn_duty_veteran", "gar_fake_spot8")
	if sobj then
		olr.kill_offline_stalker(sobj)
	end

	nick.kill_all_dolgs_garbage()
	level.add_pp_effector("black.ppe", 20131, false)
	news_manager.send_tip(db.actor, game.translate_string("vorglaz_away_from_garbage_0"), nil, "dolg", 9000, nil, nil, true, "st_nick_character_name_croweye")
	olr.del_by_name("lvl4_darkdolina_stalker_0036")
end

function kill_all_dolgs_garbage()
	local sim = alife()
	for id = 1, 65534 do
		local kill = sim:object(id)
		if kill then
			if IsStalker(kill) then
				if kill:alive() and kill.level_name == "lvl2_garbage" then
					if kill:community() == "dolg" and kill:name() ~= "lvl2_garbage_staler_undead_olr_0012" then
						xvars.dead_in_offline[kill:name()] = true
						olr.kill_offline_stalker(kill)
					end
				end
			end
		end
	end
end

