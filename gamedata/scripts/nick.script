function coolweather_nap()
	local sim = alife()
	olr.blow_add(150)
	news_manager.send_tip(db.actor, "coolweather_nap", math.random(1000, 3000), "neutral", 15000, nil, "pda_objective", true, xvars.naparnik_name)
	
	for k, v in pairs(db.storage) do
		local npc = level.object_by_id(k)
		if npc and npc:position():distance_to(db.actor:position()) < 100 then
			local should_process = false
			
			-- Проверяем условия для монстров или враждебных сталкеров
			if npc:is_monster() then
				should_process = true
			elseif npc:is_stalker() then
				local community = npc:character_community()
				should_process = (community == "monolith" or community == "killer" or community == "bandit")
			end
			
			-- Обрабатываем подходящие NPC
			if should_process then
				local se_obj = sim:object(npc:id())
				if se_obj then
					sim:set_switch_offline(se_obj.id, true)
					sim:set_switch_online(se_obj.id, false)
					sim:set_interactive(se_obj.id, false)
					olr_timers.st_timer("convert_online", 370, "olr_npc_eqp.convert_online_out("..npc:id()..")")
				end
			end
		end
	end
end

