function chaes_1_sms()
	local sim = alife()
	news_manager.send_tip(db.actor, game.translate_string("chaes_1_sms_0"), nil, "unknown", 10000)

	olr_timers.st_timer("chaes_1_sms_musli", 8, "nick.chaes_1_sms_musli()")

	local bsobj = sim:object("lvl16_generators_staler_undead_olr")
	if bsobj then
		sim:create("wpn_gauss", bsobj.position, bsobj.m_level_vertex_id, bsobj.m_game_vertex_id, bsobj.id)
		sim:create_ammo("ammo_gauss", bsobj.position, bsobj.m_level_vertex_id, bsobj.m_game_vertex_id, bsobj.id, 10)
	end

	-- фил
	if has_alife_info("fil_boloto_dialog_done") then
		local sobj = sim:object("lvl16_generators_staler_undead_olr")
		if sobj then
			--log1("1f")
			local pk = get_netpk(sobj, 1)
			if pk:isOk() then
				local data = pk:get()
				local vis = [[actors\novice\novice_b_03]]
				data.visual_name = vis
				data.character_name = game.translate_string("st_nick_character_name_phil")
				pk:set(data)
			end
		end
		return
	end

	-- тёмный сталкер
	if has_alife_info("mg_ds_now_done") then
		local sobj = sim:object("lvl16_generators_staler_undead_olr")
		if sobj then
			--log1("2f")
			local pk = get_netpk(sobj, 1)
			if pk:isOk() then
				local data = pk:get()
				local vis = [[actors\dark_stalker\dark_stalker_1]]
				data.visual_name = vis
				data.character_name = game.translate_string("st_nick_character_name_darkstalker")
				pk:set(data)
			end
		end
		return
	end

	-- хмырь (дефаулт)
	local sobj = sim:object("lvl16_generators_staler_undead_olr")
	if sobj then
		--log1("1h")
		local pk = get_netpk(sobj, 1)
		if pk:isOk() then
			local data = pk:get()
			local vis = [[actors\neutral\stalker_hood_backpack_02]]
			data.visual_name = vis
			data.character_name = game.translate_string("st_nick_character_name_murky")
			pk:set(data)
		end
	end
end

