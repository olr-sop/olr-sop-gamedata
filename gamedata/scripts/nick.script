function set_prip_mons()
	-- Врядли будет сильно быстрее, скорее всего разницы не будет, либо на уровне погрешности, тут чисто для читаемости
	-- Таблица объектов и их визуалов (nil означает, что visual_name не меняется)
	local objects_to_update = {
		["lvl16_generators_staler_undead_olr_0004"] = [[actors\hero\hero_stalker]],
		["lvl13_prip_staler_undead_olr"] = [[actors\monolith\monolith_hood_balon_antigas]],
		["lvl16_generators_staler_undead_olr_0001"] = [[actors\hero\hero_stalker]],
		["lvl16_generators_staler_undead_olr_0002"] = nil,
		["lvl16_generators_staler_undead_olr_0003"] = nil,
		["lvl16_generators_stalker_0033"] = nil,
		["lvl16_generators_stalker_0032"] = nil
	}

	for section_name, visual_path in pairs(objects_to_update) do
		local sobj = alife():object(section_name)
		if sobj then
			local pk = get_netpk(sobj, 1)
			if pk:isOk() then
				local data = pk:get()
				data.character_name = ""	-- Очищаем character_name для всех объектов
				if visual_path then			-- Обновляем visual_name если указан
					data.visual_name = visual_path
				end
				pk:set(data)
			end
		end
	end
end

