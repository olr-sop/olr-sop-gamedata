function dead_naparnik_sms()
	if has_alife_info("rad_first") then
		return
	end
	if has_alife_info("bar_first") and xvars.naparnik_name ~= "" then
		if level.get_time_hours() >= 2 and level.get_time_hours() < 6 then
			if level.name() ~= "lvl2_garbage" then
				return
			end
			local nap = game.translate_string(xvars.naparnik_name)
			local rnd = math.random(1, 10)
			if rnd == 1 then
				news_manager.send_tip(db.actor, game.translate_string("dead_naparnik_sms_0"), 3, "unknown", 10000, nil, nil, true, nap)
			elseif rnd == 3 then
				news_manager.send_tip(db.actor, game.translate_string("dead_naparnik_sms_1"), 2, "unknown", 10000, nil, nil, true, nap)
			elseif rnd == 4 then
				news_manager.send_tip(db.actor, game.translate_string("dead_naparnik_sms_2"), 3, "unknown", 10000, nil, nil, true, nap)
			elseif rnd == 6 then
				news_manager.send_tip(db.actor, game.translate_string("dead_naparnik_sms_3"), 4, "unknown", 10000, nil, nil, true, nap)
			elseif rnd == 8 then
				news_manager.send_tip(db.actor, game.translate_string("dead_naparnik_sms_4"), 1, "unknown", 10000, nil, nil, true, nap)
			end
		end
	end
end

