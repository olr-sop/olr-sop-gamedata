function set_boss_enemye()
	local source = nil
	local sim = alife()
	if sim then
		local se_obj = alife():object("lvl16_generators_staler_undead_olr_0002")
		if se_obj then
			source = level.object_by_id(se_obj.id)
		end
	end

	if source == nil then
		log1("expl not found")
		return
	end

	local h = hit()
	h.draftsman = db.actor
	h.type = hit.strike
	h:bone("bip01_head")
	h.direction = vector():set(1, -1, 1)
	h.power = 0.1
	h.impulse = 1
	source:hit(h)
end

function teleport_boss_fight()
	olr_timers.st_timer_game("bosstelep_timer", math.random(20, 37), "nick.teleport_boss_fight()")
	olr.spawen_phantoms()
	local car = alife():object("lvl16_generators_staler_undead_olr_0002")
	if car and car:alive() then
		local bez_var = math.random(1, 5)
		local teleport_positions = {
			vector():set(165, -13, -499),
			vector():set(151, -13, -491),
			vector():set(178, -13, -479),
			vector():set(184, -13, -501),
			vector():set(183, -13.36, -492)
		}
		alife():teleport_object(car:id(), db.actor:game_vertex_id(), db.actor:level_vertex_id(), teleport_positions[bez_var])
	end
end

function script_boss_kill_timer()
	local obj = alife():object("lvl16_generators_staler_undead_olr_0002")
	local loh = level.object_by_id(obj.id)
	if loh then
		loh:kill(loh)
	end
end

function hit_boss_atack()
	local car = alife():object("lvl16_generators_staler_undead_olr_0002")
	if car then
		local h = hit()
		h.power = 0.1
		h.direction = vector():set(0, 100, 0)
		h.impulse = 20
		h.draftsman = db.actor
		h.type = hit.strike
		car:hit(h)
		
		local pos = car:position()
		particles_object([[anomaly\a-03-flash-sparks_old00]]):play_at_pos(pos)
		particles_object([[anomaly\a-03-expl-sparks_00]]):play_at_pos(pos)
		particles_object([[anomaly2\monolith_golo_death_olr]]):play_at_pos(pos)
		
		local snd_obj = xr_sound.get_safe_sound_object([[ambient\special\sob]])
		snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
	end
end

function kill_zombies_around()
	for k, v in pairs(db.storage) do
		local npc = level.object_by_id(k)
		if npc and npc:is_stalker() and npc:alive() and npc:character_community() == "zombied" and npc:position():distance_to(db.actor:position()) < 195 then
			npc:kill(npc) -- нафига тут было наносить хит если можно через kill убивать? Тем более в онлайне
		end
	end
end

