function zagon_bandosa2()
	if has_alife_info("start_zagon_bandosa_talked_good") then
		news_manager.send_tip(db.actor, game.translate_string("st_zagon_bandosa2"), math.random(1000, 3000), "bandit", 15000, nil, "pda_objective", false)
		news_manager.send_tip(db.actor, game.translate_string("zagon_bandosa2_0"), 5, "neutral", 25000, nil, nil, true, "gar_hellcar_name")
		db.actor:change_character_reputation(20)
	end
	local sobj = alife():object("lvl2_garbage_stalker_0025")
	if sobj then
		local pk = get_netpk(sobj,1)
		local data = pk:get()
		data.custom_data:setString("[smart_terrains]\n".."lvl3_agroprom_smart_terrain_0020 = true\n")
		pk:set( data )
	end
end

