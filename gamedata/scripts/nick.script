			olr.del_by_name("lvl3_agroprom_agro_case_02")
			--olr.del_by_name("lvl3_agroprom_agro_case_02_0000")
			olr.del_by_name("lvl3_agroprom_agro_case_02_0001")
			olr.del_by_name("lvl3_agroprom_agro_case_02_0002")
		elseif rnd == 3 then
			olr.del_by_name("lvl3_agroprom_agro_case_02")
			olr.del_by_name("lvl3_agroprom_agro_case_02_0000")
			--olr.del_by_name("lvl3_agroprom_agro_case_02_0001")
			olr.del_by_name("lvl3_agroprom_agro_case_02_0002")
		elseif rnd == 4 then
