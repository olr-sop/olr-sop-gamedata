function actor_set_monolit(actor, npc)
	if db.actor then
		db.actor:set_character_community("monolith", 0, 0)
	end
	relation_registry.set_community_goodwill ("monolith", db.actor:id(), -5000)
	return true
end

function Run_Vibros()
	level.set_weather_fx ("surge")
	level.add_pp_effector ("vibros.ppe", 1974228, false)
	local snd_obj = xr_sound.get_safe_sound_object([[ambient\weather\blowout_begin]])
	snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
end

function clear_vibros()
	level.remove_pp_effector(1974228)
end

