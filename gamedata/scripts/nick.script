			local rnd = math.random(160,224)
			olr_timers.st_timer("esc_blockpost_normal_timer_now", rnd, "nick.esc_blockpost_normal_timer_now()")
			local rnd = math.random(1,2)
			if rnd == 1 then
				if not xr_conditions.actor_in_zone(nil,nil,{"lvl1_escape_space_restrictor_0093"})  then
					news_manager.send_tip(db.actor, game.translate_string("esc_blockpost_normal_timer_0"), 2, "trader", 39000, nil, nil, true, "escape_trader_name")
