end

function give_bablo_patnashka_osved(t1,t2)
	local gtime = level.get_time_days()*60*50+level.get_time_hours()*60+level.get_time_minutes() 
	xvars.timer_bablo_patnashka_osved = gtime 
	local npc=t1
