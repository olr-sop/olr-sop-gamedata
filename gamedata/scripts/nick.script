function blowout_time_ret_jaba()
	local task_texture, task_rect = get_texture_info("ui_notification_info")
	local cur = olr_blowout.get_blow_timer()
	if cur <= 2000 and cur >= 1000 or cur > 2000 then
		item_name_and_price = game.translate_string("blowout_time_ret_jaba_0")
		db.actor:give_talk_message(item_name_and_price, task_texture, task_rect, "iconed_answer_item")
		--log1("ещё не скоро")
		return
	end
	if cur <= 1000 and cur >= 570 then
		item_name_and_price = game.translate_string("blowout_time_ret_jaba_1")
		db.actor:give_talk_message(item_name_and_price, task_texture, task_rect, "iconed_answer_item")
		--log1("ещё не скоро")
		return
	end
	if cur <= 570 and cur >= 130 then
		item_name_and_price = game.translate_string("blowout_time_ret_jaba_2")
		db.actor:give_talk_message(item_name_and_price, task_texture, task_rect, "iconed_answer_item")
		--log1("уже где-то на подходе")
		return
	end
	if cur <= 130 and cur >= 60 then
		item_name_and_price = game.translate_string("blowout_time_ret_jaba_3")
		db.actor:give_talk_message(item_name_and_price, task_texture, task_rect, "iconed_answer_item")
		--log1("начнётся с минуты на минуту")
		return
	end
	if cur <= 60 and cur >= 1 then
		item_name_and_price = game.translate_string("blowout_time_ret_jaba_4")
		db.actor:give_talk_message(item_name_and_price, task_texture, task_rect, "iconed_answer_item")
		--log1("нет данных")
		return
	end
end

function kill_bandits()
	for k,v in pairs(db.storage) do
		local npc = level.object_by_id(k)
		if npc and npc:is_stalker() and npc:position():distance_to(db.actor:position()) < 310 and npc:character_community() == "bandit" then	
			npc:kill(npc)
		end
	end
end

