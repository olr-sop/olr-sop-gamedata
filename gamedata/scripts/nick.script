function boss_talk_one_done()

	olr.spawn_on_obj("m_zombie_e", "lvl4u_darklab_physic_object_0398", 3)
	olr.spawn_on_obj("m_zombie_e", "lvl4u_darklab_physic_object_0363", 3)
