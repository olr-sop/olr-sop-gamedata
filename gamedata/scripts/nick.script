function navodka_jurnal_finded_high_1()
	news_manager.send_tip(db.actor, game.translate_string("navodka_jurnal_finded_high_1_0"), nil, "flash", 10000, nil, nil, true, "bar_informer_name")
	olr.info("navodka_jurnal_finded_high_1")
