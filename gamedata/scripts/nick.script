function out_doki_osved_journals()
	local journal_data = {
		{info = "navodka_jurnal_finded_high_1", check = "jornal_1_taken", sect = "jornal_1"},
		{info = "navodka_jurnal_finded_high_2", check = "jornal_2_taken", sect = "jornal_2"},
		{info = "navodka_jurnal_finded_high_3", check = "jornal_3_taken", sect = "jornal_3"},
		{info = "navodka_jurnal_finded_high_4", check = "spawn_doks_yantar", sect = "jornal_4"},
		{info = "navodka_jurnal_finded_high_5", check = "spawn_doks_radar", sect = "jornal_5"},
		{info = "navodka_jurnal_finded_high_6", check = "jornal_6_taken", sect = "jornal_6"}
	}

	for _, data in ipairs(journal_data) do
		if has_alife_info(data.info) and not has_alife_info(data.check) then
			local m_where = game.translate_string("out_doki_osved_journals")
			db.actor:give_talk_message(m_where, "ui\\ui_iconsTotal", Frect():set(0, 0, 10, 10), "simple_answer_item")
			
			local sim = alife()
			for id = 1, 65534 do
				local obj = sim:object(id)
				if obj and obj:section_name() == data.sect then
					alife():release(obj, true)
					break  -- Прерываем цикл
				end
			end
			
			olr.give_item(data.sect)
			return
		end
	end

	local m_where = game.translate_string("out_doki_osved_journals_negative")
	db.actor:give_talk_message(m_where, "ui\\ui_iconsTotal", Frect():set(0, 0, 10, 10), "simple_answer_item")
end

