function rnd_vis_killers()
	-- Таблица с данными для каждого сталкера
	local stalkers_data = {
		["lvl4_darkdolina_staler_undead_olr_0003"] = {
			weapon = "wpn_akms",
			ammo = {"ammo_5.45x39_fmj", 10},
			name = "st_nick_character_name_s207"
		},
		["lvl4_darkdolina_staler_undead_olr_0004"] = {
			weapon = "wpn_fn2000",
			name = "st_nick_character_name_k652"
		},
		["lvl4_darkdolina_staler_undead_olr_0005"] = {
			weapon = "wpn_g36",
			name = "st_nick_character_name_r788"
		},
		["lvl4_darkdolina_staler_undead_olr_0006"] = {
			weapon = "wpn_lr300",
			name = "st_nick_character_name_r358"
		},
		["lvl4_darkdolina_staler_undead_olr_0007"] = {
			weapon = "wpn_mp5",
			name = "st_nick_character_name_s678"
		},
		["lvl4_darkdolina_staler_undead_olr_0008"] = {
			weapon = "wpn_mp5",
			name = "st_nick_character_name_r671"
		},
		["lvl4_darkdolina_staler_undead_olr_0009"] = {
			weapon = "wpn_g36",
			name = "st_nick_character_name_k138"
		},
		["lvl4_darkdolina_staler_undead_olr_0010"] = {
			weapon = "wpn_g36",
			name = "st_nick_character_name_p227"
		}
	}

	-- Возможные визуалы
	local visuals = {
		[[actors\killer\killer_antigas]],
		[[actors\killer\killer_hood_mask]],
		[[actors\killer\killer_hood_01]],
		[[actors\killer\killer_hood_02]],
		[[actors\killer\killer_hood_03]],
		[[actors\killer\killer_hood_04]],
		[[actors\killer\killer_no_hood_mask]]
	}

	local sim = alife()
	
	-- Обрабатываем всех сталкеров на уровне
	for id = 1, 65534 do
		local obj = sim:object(id)
		if obj and IsStalker(obj) then
			local gvid = obj.m_game_vertex_id
			if game_graph():valid_vertex_id(gvid) then
				if sim:level_name(game_graph():vertex(gvid):level_id()) == "lvl4_darkdolina" then
					local stalker_name = obj:name()
					local data = stalkers_data[stalker_name]
					
					if data then
						-- Создаём оружие и патроны
						if data.weapon then
							sim:create(data.weapon, obj.position, obj.m_level_vertex_id, obj.m_game_vertex_id, obj.id)
						end
						if data.ammo then
							sim:create_ammo(data.ammo[1], obj.position, obj.m_level_vertex_id, obj.m_game_vertex_id, obj.id, data.ammo[2])
						end
						
						-- Устанавливаем имя и визуал
						local pk = get_netpk(obj, 1)
						if pk:isOk() then
							local pk_data = pk:get()
							if data.name then
								pk_data.character_name = game.translate_string(data.name)
							end
							pk_data.visual_name = visuals[math.random(#visuals)]
							pk:set(pk_data)
						end
					end
				end
			end
		end
	end
end

