function rnd_zombies_spawn()

	local sectionsa = {
		"zombie_weak",
		"zombie_normal",
		"zombie_strong",
		"zombie_plague"
	}

	for id = 1, math.random(4, 8) do
		local section = sectionsa[math.random(#sectionsa)]
		alife():create(section, db.actor:position():add(db.actor:direction():mul(-19)), db.actor:level_vertex_id(), db.actor:game_vertex_id() )
	end
end

function prof_boloto_spawn_bandosov_smss4()
	news_manager.send_tip(db.actor, "prof_boloto_spawn_bandosov_smss4", math.random(1000, 3000), "ecolog", 15000, nil, "pda_objective", true, "st_yan_general_ecolog_name")
	level.add_pp_effector("vibros_p.ppe", 231, false)
	nick.rnd_zombies_spawn()
	for id = 1, 21 do
		local tmr = math.random(10, 50)
		olr_timers.st_timer("rndppe", tmr, "nick.rnd_ppe_eff()")
	end
end

function rnd_ppe_eff()
	local ppe = {
		"alcohol.ppe",
		"controller_hit.ppe",
		"fire_hit.ppe",
		"psy_antenna.ppe",
		"psy_antenna_indoor.ppe",
		"radar_psi.ppe",
		"radar_stop.ppe",
		"radar_wake.ppe",
		"radiation.ppe",
		"teleport.ppe",
		"vibros.ppe",
		"blink.ppe",
		"dead_zone.ppe"
	}
