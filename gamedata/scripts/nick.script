function posthuman_ending_kill_posthuman()
	for k,v in pairs(db.storage) do
		local npc = level.object_by_id(k)
		if npc and npc:is_monster() and npc:name() == "lvl16_generators_m_posthuman_e" then	
			npc:kill(npc)
		end
	end
end

