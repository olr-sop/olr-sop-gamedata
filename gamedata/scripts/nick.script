-- Функция порчи еды в оффлайне, вызывается при получении
-- инфопоршней olr_traders_day и olr_traders_night
-- По идее сейчас всё должно работать корректно как и у оснвного биндера еды
function upd_cond_foods_serv()
    local current_level = level.name()
    local foods = {}
    local sim = alife()
    local TIME_COND_LOST_PER_SECOND = 100 / 120 / 24 / 100 / 60 * 100 * 295
    
    -- Объединенные таблицы из первой функции
    local trader_sections = {
        m_trader = true,
        m_barman = true,
        stalker_sakharov = true
    }
    
    local food_sections = {
        kolbasa = true, bread = true, conserva = true,
        rat_food = true, rat_food_coocked = true,
        crow_food = true, crow_food_coocked = true,
        mutant_flesh_eye = true, mutant_flesh_eye_coocked = true,
        mutant_boar_leg = true, mutant_boar_leg_coocked = true,
        mutant_dog_tail = true, mutant_dog_tail_coocked = true,
        mutant_psevdodog_tail = true, mutant_psevdodog_tail_coocked = true,
        mutant_krovosos_jaw = true, mutant_krovosos_jaw_coocked = true,
        mutant_burer_hand = true, mutant_burer_hand_coocked = true,
        mutant_zombie_hand = true, mutant_zombie_hand_coocked = true
    }
    
    local food_sections_coocked = {
        rat_food_coocked = true, crow_food_coocked = true,
        mutant_flesh_eye_coocked = true, mutant_boar_leg_coocked = true,
        mutant_dog_tail_coocked = true, mutant_psevdodog_tail_coocked = true,
        mutant_krovosos_jaw_coocked = true, mutant_burer_hand_coocked = true,
        mutant_zombie_hand_coocked = true
    }
    
    local LEVEL_CHECKS = {
        ["lvl2_garbage"] = "gar_first",
        ["lvl3_agroprom"] = "agr_first",
        ["lvl4_darkdolina"] = "dol_first",
        ["lvl5_bar"] = "bar_first",
        ["lvl6_rostok"] = "ros_first",
        ["lvl7_yantar"] = "yan_first",
        ["lvl8_swamp"] = "swp_first",
        ["lvl9_military"] = "mil_first",
        ["lvl10_radar"] = "rad_first",
        ["lvl12_radar_bunker"] = "radlab_first",
        ["lvl11_deadcity"] = "dec_first",
        ["lvl13_prip"] = "prp_first",
        ["lvl_level12"] = "lvl12_first",
        ["lvl15_sarcofag"] = "sarco_first",
        ["lvl14_stancia"] = "stan_first",
        ["lvl16_generators"] = "gen_first"
    }
    
    for id = 1, 65534 do
        local obj = sim:object(id)
        if obj and obj.level_name ~= current_level then
            local flag = LEVEL_CHECKS[obj.level_name]
            if flag and has_alife_info(flag) and food_sections[obj:section_name()] then
                table.insert(foods, obj)
            end
        end
    end

    for i = 1, #foods do
        local obj = foods[i]
        local pk = get_netpk(obj, 1)
        if pk then
            local data = pk:get()
            if data and data.condition and data.condition > 0 then
                -- Определяем коэффициент порчи в зависимости от условий
                local cond_loss_multiplier = 1.0
                
                -- Проверяем, находится ли еда у торговца
                local is_trader_item = false
				local p_obj = alife():object(obj.parent_id)
                if p_obj ~= nil and trader_sections[p_obj:section_name()] then
                    is_trader_item = true
                    cond_loss_multiplier = cond_loss_multiplier * 0.25 -- у торговцев портится в 4 раза медленнее
                end
                
                -- Проверяем, приготовленная ли это еда (только если не у торговца)
                if not is_trader_item and food_sections_coocked[obj:section_name()] then
                    cond_loss_multiplier = cond_loss_multiplier * 0.5 -- приготовленная портится в 2 раза медленнее
                end
                
                -- Применяем изменение состояния
                local new_cond = data.condition - (TIME_COND_LOST_PER_SECOND * cond_loss_multiplier)
                data.condition = new_cond > 0 and new_cond or 0
                pk:set(data)
            end
        end
    end
end

function posthuman_ending()
	--log1("sst")
	local wait_time = 0
	wait_time = time_global() + 500
	level.add_call(
		function() return time_global() > wait_time end,
		function() nick.post_suka_blyat() end
	)
end

function post_suka_blyat()
	olr.snd([[characters_voice\scenario\generators\end\ending_posthuman_1]])
	olr.kill_mon_in_radius(db.actor:position(), 150)
	local point = patrol("gen_acr_tetep")
	local look = patrol("gen_acr_tetep")
	db.actor:set_actor_position(point:point(0))
	local dir = look:point(0):sub(point:point(0))
	db.actor:set_actor_direction(-dir:getH())
	olr.disable_walk()
	level.disable_input()
	level.hide_indicators()	
	bind_stalker.hide_weapon()
	olr.hide_inv()
	level.add_pp_effector("black.ppe", 20131, false)
	level.add_cam_effector2("camera_effects\\gen_posthuman_1.anm", 90, false, "nick.posthuman_ending_2")
--	level.set_weather("1865",true)
end

function posthuman_ending_2()
	olr.snd([[characters_voice\scenario\generators\end\ending_posthuman_2]])
	olr.info("posthuman_cutscene_start")
	olr_timers.st_timer("posthuman_ending_kill_posthuman", 14, "nick.posthuman_ending_kill_posthuman()")
	level.add_cam_effector2("camera_effects\\gen_posthuman_2.anm", 90, false, "nick.posthuman_ending_3")
end

function posthuman_ending_3()
