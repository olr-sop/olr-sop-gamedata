function enemys_sms_pda_escape_mon()
	local cnt = 0
	local sim = alife()
	
	local wpntabl = {
		[clsid.wpn_ammo] = true,
		[clsid.wpn_ammo_m209] = true,
		[clsid.wpn_ammo_og7b] = true,
		[clsid.wpn_ammo_vog25] = true
	}
	
	for id = 1, 65534 do
		local obj = sim:object(id)
		if obj then
			if wpntabl[obj:clsid()] then
				if not obj.parent then
					local bol_var = math.random(1, 2)
					if bol_var == 1 then
						sim:release(obj)
					end
				end
			end
			if get_clsid(obj) == clsid.level_changer then
				local rnd = math.random(1, 3)
				if rnd == 1 then
					sim:create("m_posthuman_e", obj.position, obj.m_level_vertex_id, obj.m_game_vertex_id)
				end
			end
		end
	end
	
	news_manager.send_tip(db.actor, game.translate_string("enemys_sms_pda_escape_mon_0"), nil, "signal_lost", 25000)

	local sobj = alife():object("l10u_radar_bunker_physic_object_0075")
	if sobj then
		alife():release(sobj, true)
	end
	local sobj = alife():object("lvl12_radar_bunker_physic_object_0020")
	if sobj then
		alife():release(sobj, true)
	end
end

