	local sim = alife()
	local se_obj = sim:story_object(1209)
	if se_obj then
		sim:set_switch_offline (se_obj.id, true)
		sim:set_switch_online (se_obj.id, false)
		sim:set_interactive (se_obj.id, false)
	end
end

