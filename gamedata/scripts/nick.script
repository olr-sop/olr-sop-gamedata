-- Различные сюжетные функции
-- hi_flyer, OLR mod 2012-2024

function delete_netspawn_objects(obj_ids)
    local sim = alife()
    if type(obj_ids) == "string" then
        local obj = sim:object(obj_ids)
        if obj then
            sim:release(obj, true)
		else
			log1("! delete_netspawn_objects - "..tostring(obj_ids).." return nil")
        end
    elseif type(obj_ids) == "table" then
        for _, obj_id in ipairs(obj_ids) do
            local obj = sim:object(obj_id)
            if obj then
                sim:release(obj, true)
			else
				log1("! delete_netspawn_objects - "..tostring(obj_id).." return nil")
            end
        end
    end
end 

function reward_killers_ac()
	local bol_var = math.random(1,5)
	if bol_var == 1 then
		olr.give_item("wpn_colt1911")
	elseif bol_var == 2 then
		olr.give_item("wpn_akms")
	elseif bol_var == 3 then
		olr.give_item("wpn_aps")
	elseif bol_var == 4 then
		olr.give_item("wpn_hpsa")
	elseif bol_var == 5 then
		olr.give_item("wpn_mp5")
	end
end

function holmi_uch_spas_fail()
	if has_alife_info("otpravlaet_spat_gg_done") or has_alife_info("fobos_dead_mil") or has_alife_info("fobos_dead_mil_uchen") then
		return true
	else
		return false
	end
end

