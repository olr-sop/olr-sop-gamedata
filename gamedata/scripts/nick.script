	end

	local bsobj = sim:object("lvl16_generators_staler_undead_olr_0002")
	if bsobj then
		sim:create("wpn_shotgra", bsobj.position, bsobj.m_level_vertex_id, bsobj.m_game_vertex_id, bsobj.id)
		sim:create_ammo("ammo_bolts", bsobj.position, bsobj.m_level_vertex_id, bsobj.m_game_vertex_id, bsobj.id, 10)
		sim:create_ammo("ammo_bolts", bsobj.position, bsobj.m_level_vertex_id, bsobj.m_game_vertex_id, bsobj.id, 10)
		sim:create_ammo("ammo_bolts", bsobj.position, bsobj.m_level_vertex_id, bsobj.m_game_vertex_id, bsobj.id, 10)
		sim:create_ammo("ammo_bolts", bsobj.position, bsobj.m_level_vertex_id, bsobj.m_game_vertex_id, bsobj.id, 10)
		sim:create_ammo("ammo_bolts", bsobj.position, bsobj.m_level_vertex_id, bsobj.m_game_vertex_id, bsobj.id, 10)
		sim:create_ammo("ammo_bolts", bsobj.position, bsobj.m_level_vertex_id, bsobj.m_game_vertex_id, bsobj.id, 10)
	end

	local sobj = sim:object("lvl16_generators_physic_object_0222")
