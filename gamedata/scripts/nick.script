	delete_netspawn_objects("lvl11_deadcity_physic_object_0736")
	news_manager.send_tip(db.actor, game.translate_string("spasipo_freed"), nil, "freedom", 10000, nil, nil, true, "st_patroul_name")
end

function slizen()
	news_manager.send_tip(db.actor, game.translate_string("slizen"), nil, "unknown", 20000, nil, nil, false)
	local snd_obj = xr_sound.get_safe_sound_object([[characters_voice\scenario\darkvalley\slugs\slugs_message]])
	snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
	olr.del_by_name("lvl5_bar_staler_undead_olr_0012")
	olr_timers.st_timer("dolg_pro_slizeny", 19, "nick.dolg_pro_slizeny()")
end

function dolg_pro_slizeny()
	news_manager.send_tip(db.actor, game.translate_string("dolg_pro_slizeny_0"), nil, "dolg", 15000)
end

function poeh()
	level.add_pp_effector("duality_circle.ppe", 207131, false)
	news_manager.send_tip(db.actor, game.translate_string("poeh_0"), math.random(5000, 13000), "barman", 15000, nil, "pda_objective", true, "st_barkeep_short")
	olr_timers.st_timer("blowout_additional_timer4", 13, "olr_blowout.blowout_additional_timer5()")
end

function zaba_zovet()
	news_manager.send_tip(db.actor, game.translate_string("zaba_zovet"), nil, "trader", 10000, nil, nil, true, "escape_trader_name")
end

function zaba_sobaki_angar()
	news_manager.send_tip(db.actor, game.translate_string("zaba_sobaki_angar"), nil, "trader", 10000, nil, nil, true, "escape_trader_name")
end

function zaba_art_garb()
	olr_timers.st_timer("zaba_sobaki_angar", 15, "nick.zaba_sobaki_angar()")
	olr_timers.st_timer("sms_about_angar_art", 2500, "nick.angar_art_jaba()")
	local jaba_place = alife():object("lvl2_garbage_stalker_0012")
	if jaba_place then
		local sobj = alife():create("kanistra_benz", jaba_place.position, jaba_place.m_level_vertex_id, jaba_place.m_game_vertex_id)
	end
	news_manager.send_tip(db.actor, game.translate_string("zaba_art_garb"), nil, "trader", 10000, nil, "pda_objective", true, "escape_trader_name")
	olr.to_online("lvl2_garbage_af_compas")
end

