function zaradka_battery_exo()
	local item_in_slot_6 = db.actor:item_in_slot(6)
	if item_in_slot_6 ~= nil and item_in_slot_6:section() == "exo_outfit" then
		if not item_in_slot_6:has_exo_accum() then
			local m_where = game.translate_string("zaradka_battery_exo_0")
			db.actor:give_talk_message(""..m_where.."", "ui\\ui_iconsTotal", Frect():set(0,0,10,10), "simple_answer_item")
			return
		end
		if item_in_slot_6:has_exo_accum() then
			local m_where = game.translate_string("zaradka_battery_exo_1")
			db.actor:give_talk_message(""..m_where.."", "ui\\ui_iconsTotal", Frect():set(0,0,10,10), "simple_answer_item")
			news_manager.send_tip(db.actor, game.translate_string("zaradka_battery_exo_2"), nil, "money_lost", 39000)
			db.actor:give_money(-150)
			game_stats.money_quest_update(-150)
			item_in_slot_6:set_exo_charge(1)
			return
		end
	end
	local m_where = game.translate_string("zaradka_battery_exo_3")
	db.actor:give_talk_message(""..m_where.."", "ui\\ui_iconsTotal", Frect():set(0,0,10,10), "simple_answer_item")
end

