		esc_blokpost_soldier6 = true,
		esc_blokpost_soldier7 = true
	}

	for name in pairs(soldiers) do
		local obj = sim:object(name)
		if obj then
			local id = obj.id
			sim:set_switch_offline(id, false)
			sim:set_switch_online(id, true)
			sim:set_interactive(id, true)
		end
	end
end

function move_offline_blokpost()
	local sim = alife()
	local soldiers = {
		esc_blokpost_soldier6_0001 = true,
		esc_blokpost_commander = true,
		esc_blokpost_soldier6_0000 = true,
		esc_blokpost_soldier1 = true,
		esc_blokpost_soldier2 = true,
		esc_blokpost_soldier3 = true,
		esc_blokpost_soldier4 = true,
		esc_blokpost_soldier5 = true,
		esc_blokpost_soldier6 = true,
		esc_blokpost_soldier7 = true
	}

	for name in pairs(soldiers) do
		local obj = sim:object(name)
		if obj then
			local id = obj.id
			sim:set_switch_offline(id, true)
			sim:set_switch_online(id, false)
			sim:set_interactive(id, false)
		end
	end
end

function about_kamorka_habar()
	local sim = alife()
	local obj = sim:object("lvl1_escape_big_safe_box")
	if math.random(1,2) == 1 then
		sim:create("af_gravi_heavy",obj.position, obj.m_level_vertex_id, obj.m_game_vertex_id, obj.id)
		sim:create("af_galantine",obj.position, obj.m_level_vertex_id, obj.m_game_vertex_id, obj.id)	
		sim:create("af_galantine_pot",obj.position, obj.m_level_vertex_id, obj.m_game_vertex_id, obj.id)			
	else
		sim:create("af_gravi_heavy",obj.position, obj.m_level_vertex_id, obj.m_game_vertex_id, obj.id)
		sim:create("af_needle_heavy",obj.position, obj.m_level_vertex_id, obj.m_game_vertex_id, obj.id)
		sim:create("af_magnet",obj.position, obj.m_level_vertex_id, obj.m_game_vertex_id, obj.id)
	end
	news_manager.send_tip(db.actor, game.translate_string("about_kamorka_habar_0"), nil, "unknown", 10000)
end

