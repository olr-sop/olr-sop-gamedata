function buy_elmagnbads_action()
	local anomaly_tbl = {
		["zone_witches_galantine"] = true,
		["zone_witches_galantine_strong"] = true,
		["zone_witches_galantine_average"] = true,
		["zone_witches_galantine_weak"] = true
	}
	local sim = alife()
	local obj
	for i = 1, 65534 do
		obj = sim:object(i)
		if obj then
			if anomaly_tbl[obj:section_name()] then
				if math.random(1, 20) == 1 then
					olr.add_spot_on_map(obj.id, "alife_presentation_stalker", game.translate_string("st_nick_name_electromagnetic_anomaly"))
					--log1("elmag add")
				end
			end
		end
	end
end

