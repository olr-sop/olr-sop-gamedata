function now_iremember_delhlam()
	local iskluch_items = {
		["device_pda"] = true,
		["bolt"] = true
	}
	db.actor:iterate_inventory(
		function(_, obj)
			if ini_sys:line_exist(obj:section(), "quest_item") and ini_sys:r_bool(obj:section(), "quest_item") == true then
				return nil
			end
			if iskluch_items[obj:section()] then
				return nil
			end
			if obj then
				local pos = vector():set(1000, -100, 0)
				db.actor:drop_item_and_teleport(obj, pos)
			end
		end
	)
	olr.del_noparent_weapons()
end

