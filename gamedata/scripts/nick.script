function jaba_art_zakaz_spawn()
	if level.name() == "lvl1_escape" or level.name() == "lvl5_bar" then
		return
	end
	local lname = level.name()
	local lvtab = GetLevelVertexes(lname)
	local lvx = math.max(unpack(lvtab))
	local lv = math.random(1, lvx)
	local gvtab = GetGameVertexes(lname)
	local gv_min = math.min(unpack(gvtab))
	local gv_max = math.max(unpack(gvtab))
	local objsp = alife():create("af_artefact_ordered", level.vertex_position(lv), lv, gv_max)
	if objsp then
		local metka = alife():create("treasure_place_metka", level.vertex_position(lv), lv, gv_max)
		olr.add_spot_on_map(metka.id, "tutorial_artefact_location", game.translate_string("jaba_art_zakaz_spawn_map"))
		olr_timers.st_timer("del_rnd_zakaz_metka", 1500, "nick.del_rnd_zakaz_metka(" .. tostring(metka.id) .. ")")
	end
	if math.random(1, 2) == 1 then
		alife():create("sim_respawn_stalker_general", level.vertex_position(lv), lv, gv_max)
	end
	local text_phrase = {
		"st_zhaba_random_zakaz_0",
		"st_zhaba_random_zakaz_1",
		"st_zhaba_random_zakaz_2"
	}
	local news_text = game.translate_string(text_phrase[math.random(#text_phrase)])
	news_manager.send_tip(db.actor, news_text, 3, "trader_order", 15000, nil, "pda_objective", true, "escape_trader_name")
end

function del_rnd_zakaz_metka(id)
	local sobj = alife():object(id)
	if sobj then
		--news_manager.send_tip(db.actor, "!!!!!!!! DEL METKA ZAKAZA !!! -- "..sobj:name().."	-- "..sobj.level_name.."	", nil, "hero", 39000)
		level.map_remove_object_spot(sobj.id, "tutorial_artefact_location")
		olr.del(sobj)
	end
end

