function sky_resarch()
	if not has_alife_info("kolbat_research_knife") then
		news_manager.send_tip(db.actor, game.translate_string("sky_resarch_0"), nil, "clear_sky", 39000)
		db.actor:give_info_portion("kolbat_research_knife")
		return
	end
	if not has_alife_info("kolbat_research_rgd") then
		news_manager.send_tip(db.actor, game.translate_string("sky_resarch_1"), nil, "clear_sky", 39000)
		db.actor:give_info_portion("kolbat_research_rgd")
		return
	end
	if not has_alife_info("kolbat_research_efka") then
		news_manager.send_tip(db.actor, game.translate_string("sky_resarch_2"), nil, "clear_sky", 39000)
		db.actor:give_info_portion("kolbat_research_efka")
		return
	end
	if not has_alife_info("kolbat_research_ammo") then
		news_manager.send_tip(db.actor, game.translate_string("sky_resarch_3"), nil, "clear_sky", 39000)
		db.actor:give_info_portion("kolbat_research_ammo")
		return
	end
	news_manager.send_tip(db.actor, game.translate_string("sky_resarch_4"), nil, "clear_sky", 39000)
end

