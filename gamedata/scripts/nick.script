		npc=t2
	end
	dialogs.relocate_money(npc,15000,"out")
	olr_timers.st_timer("braindok_navodka_timer_patnashka", 11000, "nick.braindok_navodka_timer_patnashka()")
end

function give_bablo_braindok_navodka(t1,t2)
