	elseif rnd == 2 then
		olr.snd([[actor\sneeze_2]])
	end	
end

-- вывести custom static сообщение на худ
function hud_tip(sender, text, timeout, actor_musli) -- отправитель, текст, время вывода на экран, мюсли мессира
	if actor_musli ~= true then
		if text == nil then
			return
		end
		if sender == nil then
			sender = game.translate_string("st_tip")
		end
		if timeout == nil then
			timeout = 5
		end
		local text_all = ""..sender.." "..text..""
		local hud = get_hud()
		local custom_static = hud:GetCustomStatic("custom_sms_text")
		hud:AddCustomStatic("custom_sms_text", true)
		hud:GetCustomStatic("custom_sms_text"):wnd():SetTextST(tostring(text_all))
		hud:GetCustomStatic("custom_sms_text").m_endTime = time_global()/1000 + timeout
	else
		if text == nil then
			return
		end
		if timeout == nil then
			timeout = 5
		end
		local text_all = ""..text..""
		local hud = get_hud()
		local custom_static = hud:GetCustomStatic("custom_sms_text_actor")
		hud:AddCustomStatic("custom_sms_text_actor", true)
		hud:GetCustomStatic("custom_sms_text_actor"):wnd():SetTextST(tostring(text_all))
		hud:GetCustomStatic("custom_sms_text_actor").m_endTime = time_global()/1000 + timeout
		olr.snd([[device\pda\contact_1]])
	end
end

function hud_tip_fatal(text) -- текст
	if text == nil then
		return
	end
	local text_all = ""..text..""
	local hud = get_hud()
	local custom_static = hud:GetCustomStatic("custom_sms_text_fatal")
	hud:AddCustomStatic("custom_sms_text_fatal", true)
	hud:GetCustomStatic("custom_sms_text_fatal"):wnd():SetTextST(tostring(text_all))
	hud:GetCustomStatic("custom_sms_text_fatal").m_endTime = time_global()/1000 + 15
	olr.snd([[device\pda\pda_sos]])
end

-- добавить мапспот
function add_spot(obj, spot, text)
	if obj == nil then
		return
	end
	if spot == nil then
		spot = "blue_location"
	end
    	if text == nil then 
		text = obj:name()
	end
    level.map_add_object_spot_ser(obj, spot, text)
end

-- отчистить от рестрикторов
function clear_restrictors(obj)
local pk = get_netpk(obj,1)
	if pk:isOk() then
		local data = pk:get()
		if data then
			if #data.dynamic_in_restrictions > 0 then
				data.dynamic_in_restrictions = {}
				pk:set( data )
				--log1("clear restrictor - "..obj:name().."")
			end
		end
	end 
end

