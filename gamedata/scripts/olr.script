------ Создать объект на позиции объекта (!объект родитель должен быть на аи-сетке!)
------ olr.spawn_on_obj("wpn_pm", "escape_trader_0000") - создаём ПМ на позиции Жабы
------ olr.spawn_on_obj("wpn_pm", "escape_trader_0000", 5) - создаём 5 ПМ на позиции Жабы
function spawn_on_obj(obj, objpos, count)
    if not alife() then
        return
    end
    if not obj then
        return
    end
    if not objpos then
        return
    end
    
    -- Устанавливаем количество по умолчанию 1, если не указано
    count = count or 1
    
    local sobjpos = alife():object(objpos)
    if sobjpos then
        --log1("spawn_on_obj")
        local base_dir = vector():set(sobjpos.position.x, sobjpos.position.y, sobjpos.position.z)
        local spawned_objects = {}
        
        for i = 1, count do
            local sobj = alife():create(obj, base_dir, sobjpos.m_level_vertex_id, sobjpos.m_game_vertex_id)
            clear_useful_for_ai(sobj)
            table.insert(spawned_objects, sobj)
            --olr.add_spot_on_map(sobj.id, "jaba_spotmap", sobj:name())
        end
        
        -- Возвращаем таблицу созданных объектов, если count > 1
        -- Или одиночный объект, если count == 1
        if count > 1 then
            return spawned_objects
        else
            return spawned_objects[1]
        end
    end
end

-- убить нпс по имени в оффлайне или онлайне, похуй, проверяем по level.object_by_id что у нас онлайн или оффлайн
function kill_by_name(name_to_kill)
	local se_obj = alife():object(name_to_kill)
	if se_obj and (IsStalker(se_obj) or IsMonster(se_obj)) then
		local obj_id = level.object_by_id(se_obj.id)
		if obj_id then
			obj_id:kill(obj_id) -- убиваем онлайнового непеся, так как obj_id нам вернул не nil (в данном случае он в онлайне)
		else 					-- иначе пытаемся убить оффлайного через редактирование нет-пакета непеся
			kill_offline_stalker(se_obj)
		end
	end
end

local dbg_delete_obj = true

-- удалить объект по имени
function del_by_name(name_to_del)
	delete_object(name_to_del)
end

-- удалить объект
function del(obj)
	delete_object(obj)
end

-- удаляет корректно объекты, нпс и мутантов сначала убивает, потом удаляем
function delete_object(obj)
    if not obj then
        return
    end

    -- Если таблица без .id — раскладываем как массив
    if type(obj) == "table" and not obj.id then
        for _, v in ipairs(obj) do
            delete_object(v)
        end
        return
    end

    -- Дальше — только одиночный объект
    local se_obj

    if type(obj) == "string" then
        se_obj = alife():object(obj)
    elseif type(obj) == "number" then
        se_obj = alife():object(obj)
    elseif type(obj) == "table" then
        if type(obj.id) == "number" then
            se_obj = obj
        elseif type(obj.id) == "function" then
            se_obj = alife():object(obj:id())
        end
    elseif type(obj) == "userdata" then
        se_obj = alife():object(obj:id())
    end

    if not se_obj then
        log1("! delete_object - " .. ((pcall(tostring, obj) and tostring(obj)) or type(obj)) .. " return nil")
        return
    end
	
	if IsStalker(se_obj) or IsMonster(se_obj) then
		-- Проверяем, онлайн ли объект сейчас
		local cl_obj = level.object_by_id(se_obj.id)
		if cl_obj then
			-- Отправляем его в оффлайн и вызываем level.add_call
			se_obj.force_offline = true -- сделано на манер огсе
			level.add_call(
				function()
					return not level.object_by_id(se_obj.id) -- Переодическая проверка на онлайн, как только будет тру то сработает удаление
				end,
				function()
					if dbg_delete_obj then log1("delete_object: " .. se_obj:name() .. " (id=" .. se_obj.id .. ") from " .. se_obj.level_name) end
					alife():release(se_obj, true) -- Ушёл в оффлайн, можно удалить
				end
			)
		else
			if dbg_delete_obj then log1("delete_object: " .. se_obj:name() .. " (id=" .. se_obj.id .. ") from " .. se_obj.level_name) end
			alife():release(se_obj, true) -- Он уже оффлайновый, удаляем
		end
	else
		if dbg_delete_obj then log1("delete_object: " .. se_obj:name() .. " (id=" .. se_obj.id .. ") from " .. se_obj.level_name) end
		alife():release(se_obj, true) -- Это не сталкер и мутант, поэтому удаляем сразу
	end
end

-- объект в онлайн (по имени)
function to_online(obj)
	if obj then
		local sim = alife()
		local sobj = sim:object(obj)
		if sobj then
			local id = sobj.id
			sim:set_switch_offline (id, false)
			sim:set_switch_online (id, true)
			sim:set_interactive (id, true)
		end
	end
end

-- объект в офлайн (по имени)
function to_offline(obj)
	if obj then
		local sim = alife()
		local sobj = sim:object(obj)
		if sobj then
			local id = sobj.id
			sim:set_switch_offline(id, true)
			sim:set_switch_online(id, false)
			sim:set_interactive(id, false)
		end
	end
end

