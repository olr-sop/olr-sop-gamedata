--/Actor callbacks end-----------------------------------------------------------------------
function upd200()
	if time_global() > tup200 then
		tup200 = time_global() + tmerup200
		olr_gameplay_update.update()
	end
end

function upd10000()
	if time_global() > tup10000 then
		tup10000 = time_global() + tmerup10000

		local srnd = math.random(1, 6)
		if srnd == 1 or srnd == 5 then
			olr_rnd_sounds.play_rnd_snd()
		end

		if db.actor:alive() and db.actor.thirst < 0.15 and srnd == 3 then
			olr.hud_tip("", game.translate_string("st_olr_suffering_from_thirst"), 5, true)
		end

		if alife() and nick.is_pda_dead() then
			olr.show_minimap(false)
		end

		ogse_mental_fix.check_freezers()

		db.actor:iterate_inventory(
			function(_, obj)
				if obj then
					--news_manager.send_tip(db.actor, game.translate_string("upd10000_0"), nil, "default", 39000)
				local id_str = tostring(obj:id())
				local e_food = xvars.foods[id_str]
				if e_food and e_food.sec == obj:section() and e_food.rad then
					db.actor.radiation = 0.0115
				end
				local e_wpn = xvars.weapons[id_str]
				if e_wpn and e_wpn.sec == obj:section() and e_wpn.rad then
					db.actor.radiation = 0.0155
				end
					if db.actor.radiation > 0.2 then
						if not has_alife_info("radiation_inv_podskazka_one") and has_alife_info("tutor_radiat_jornl") then
							olr.info("radiation_inv_podskazka_one")
							--news_manager.send_tip(db.actor, game.translate_string("upd10000_3"), nil, "hero", 99000)
							olr.hud_tip("", game.translate_string("upd10000_3"), 3, true)
						end
					end
				end
			end
		)
	end
end

function upd25000()
	if time_global() > tup25000 then
		tup25000 = time_global() + tmerup25000
		if db.actor and alife() then
			nick.dead_naparnik_sms()
			if has_alife_info("start_olr_mod") then
				local func = loadstring("olr.check_time()")
				if func then
					pcall(func)
				else
					log1("!!! ERROR LUA olr.check_time() PCALL")
				end
			end
			if db.actor then
				if db.actor:alive() then
					if db.actor.sleep < 0.15 then
						local rnd = math.random(1, 2)
						if rnd == 1 then
							level.add_pp_effector("total_recall.ppe", 231, false)
							olr.hud_tip("", game.translate_string("st_olr_need_sleep"), 5, true)
						end
					end
				end
			end
			olr.check_memory()
			local rndgta = math.random(1, 11)
			if rndgta == 1 then
				olr.gta_actor_car()
			elseif rndgta == 5 then
				--xrs_trade.on_item_drop()
				local func = loadstring("xrs_trade.on_item_drop()")
				if func then
					pcall(func)
				else
					log1("!!! ERROR LUA xrs_trade.on_item_drop() PCALL")
				end
			end
		end
	end
end

