	if cam then
      	cam.yaw = math.random(0.1,0.9) 
      	cam.pitch = math.random(0.1,0.9)
    end 
end 

function horror_snd()
	local sound_obj_right = xr_sound.get_safe_sound_object([[ambient\rnd_outdoor\rnd_horror_1]])
	local sound_obj_left = xr_sound.get_safe_sound_object([[ambient\rnd_outdoor\rnd_horror_1]])
	if not sound_obj_left:playing() then
		local i = math.random(1, 4)
		if i == 1 then
			sound_obj_left = xr_sound.get_safe_sound_object([[ambient\rnd_outdoor\rnd_horror_1]])
		elseif i == 2 then
			sound_obj_left = xr_sound.get_safe_sound_object([[ambient\rnd_outdoor\rnd_horror_2]])
		elseif i == 3 then
			sound_obj_left = xr_sound.get_safe_sound_object([[ambient\rnd_outdoor\rnd_horror_3]])
		elseif i == 4 then
			sound_obj_left = xr_sound.get_safe_sound_object([[ambient\rnd_outdoor\rnd_horror_4]])
		end
		sound_obj_left:play_at_pos(db.actor, vector():set(1, 0, 1), 0, sound_object.s2d)
	end
	if not sound_obj_right:playing() then
		local j = math.random(1, 4)
		if j == 1 then
			sound_obj_right = xr_sound.get_safe_sound_object([[ambient\rnd_outdoor\rnd_horror_1]])
		elseif j == 2 then
			sound_obj_right = xr_sound.get_safe_sound_object([[ambient\rnd_outdoor\rnd_horror_2]])
		elseif j == 3 then
			sound_obj_right = xr_sound.get_safe_sound_object([[ambient\rnd_outdoor\rnd_horror_3]])
		elseif j == 4 then
			sound_obj_right = xr_sound.get_safe_sound_object([[ambient\rnd_outdoor\rnd_horror_4]])
		end
		sound_obj_right:play_at_pos(db.actor, vector():set(-1, 0, 1), 0, sound_object.s2d)
	end
end

function is_monsters_around(radius)
    if radius == nil then
        radius = 50
    end
    for k, v in pairs(db.storage) do
        local stalker = level.object_by_id(k)
        if stalker and stalker:is_monster() and stalker:alive() then
            if stalker:position():distance_to(db.actor:position()) < radius then
                return true
            end
        end
    end
end

function npc_healing_sms(namenpc)
	local name = tostring(namenpc)
	if name then
		local text_phrase = {game.translate_string("st_olr_need_healing_1"), 
		game.translate_string("st_olr_need_healing_2"), 
		game.translate_string("st_olr_need_healing_3"), 
		game.translate_string("st_olr_need_healing_4"), 
		game.translate_string("st_olr_need_healing_5")}
		local news_text = game.translate_string(text_phrase[math.random(#text_phrase)])
		news_manager.send_tip(db.actor, news_text, 1, "sos", 15000, nil, nil, true, namenpc)
	end
end

function actor_in_lab()
	if xr_conditions.actor_in_zone(nil,nil,{"lvl4_darkdolina_space_restrictor_0012"})  
