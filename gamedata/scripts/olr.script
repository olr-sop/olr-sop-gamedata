-- Дать актору предмет
-- при выдаче еды или оружия выставляем флаг что оно не заражено
function give_item(obj)
	local item = alife():create(obj, db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
	if item then
		level.client_spawn_manager():add(item.id, 0,
			function(id, obj)
				if obj and g_food_table[obj:section()] then
					xvars.foods[tostring(obj:id())] = {sec = obj:section(), rad = false}
					obj:set_condition(0.99) -- Для еды что бы была в идеале сразу
				elseif obj and g_weapon_table[obj:section()] then
					xvars.weapons[tostring(obj:id())] = {sec = obj:section(), rad = false}
				end
			end
		)
		news_manager.relocate_item(db.actor, "in", item:section_name())
		return item
	end
end

-- add spot on map
function add_spot_on_map(obj_id,type,text)
	if obj_id then
		if text==nil then text=" " end
		level.map_add_object_spot_ser(obj_id, type, text)
	end
end

-- Убить сталкера в оффлайне
function kill_offline_stalker(kill)
	if kill == nil then return end
	local se_obj = alife():object(kill.id)
	if se_obj then
		if IsStalker(se_obj) or IsMonster(se_obj) then
			local pk = get_netpk(se_obj, 1)
			if pk:isOk() then
				local data = pk:get()
				data.health = 0
				data.updhealth = 0
				pk:set(data)
				smart_terrain.on_death(kill.id)
				xvars.dead_in_offline[kill:name()] = true
			end
		end
	end
end

-- Стреляем из оружия ГГ
function emu_shoot()
	local active_item = db.actor:active_item()
	if active_item and active_item:is_weapon() then
		local wpn_ak = engine_object(active_item:id())
		if wpn_ak then
			wpn_ak:start_fire()
		end
	end
end

function polter_throw_wpn(obj)
	if obj and obj:is_weapon_magazined() then
		local impulse = device().cam_dir:mul(obj:mass()*131)
		local ps = obj:get_physics_shell()
		if ps then
			ps:apply_force(impulse.x, impulse.y, impulse.z)
			obj:set_const_force(vector():set(device().cam_dir), obj:mass()*40,  200)
			--log1("forse")
		end	
	end
end

