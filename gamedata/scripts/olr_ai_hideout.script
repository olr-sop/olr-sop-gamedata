--[[------------------------------------------------------------------
olr_ai_hideout — AI-схема укрытия сталкеров во время выброса.

Список зон берётся ГОТОВЫМ у surge_manager (self.covers / self.count /
cover_allowed) — он сам собирает его на load() и на start() и пересобирает,
так что гонки со spawn рестрикторов здесь нет.

Гейт: olr_blowout_phase_1 / _2 / _3. Выход — когда ни одной нет, то есть
olr_blowout_phase_0 (он гасит 1/2/3).

Осознанные решения, проверенные по движку:

  * НИКАКИХ add_restrictions / remove_all_restrictions.
      - CSpaceRestrictor::net_Spawn не регистрирует рестриктор с типом
        "NOT A restrictor", после чего CSpaceRestriction::accessible()
        fail-open отдаёт true -> ограничения нет. Молча, без лога, без abort.
      - remove_all_restrictions() сносит ВСЕ динамические рестрикторы NPC,
        включая навешенные xrs_ladder и olr_npc_first_upd.script.

  * НИКАКОГО is_obj_outdoors — гейт только по зонам укрытия.

  * Одно свойство-режим (ev_hideout) + одно действие. Планировщик держит
    действие выбранным весь выброс, ветвление внутри execute().
    Состояние живёт в st (db.storage[id]) — самочистится в net_destroy.
  * Взгляд в укрытии отдан движку (look.danger = eSightTypeCover),
    как в OGSM/OGSE. Точку задаём только при наличии entrance.
    Никакого рандома и перенаводки: иначе direction_turn снова
    крутит корпус. Подробнее — у hold_hide и entrance_point.

  * Вершины внутри зоны собираются ОДИН раз (zone_verts) и кэшируются:
    чешем сеткой описанную сферу (center=zone:center(), radius=zone.radius)
    и берём всё, что zone:inside(vertex_position(v)). Так работают и
    СОСТАВНЫЕ зоны (несколько сшитых боксов), где center() вообще вне
    фигуры, и зоны, чей position() (угол трансформа) вне AI-сетки.
    Список отсортирован «от центра наружу»: NPC берёт САМОЕ ГЛУБОКОЕ
    свободное место, а не первое попавшееся у входа.

  * npc:accessible_nearest НЕ используем: он обходит ГРАНИЦУ рестрикторов
    NPC (space_restriction_bridge_inline.h:24-70) и у свободно ходящего
    сталкера возвращает мусорный id. level.vertex_id используем только
    как пробу по сетке, результат всегда проверяем через zone:inside.

  * seat_tol = cover_tol = 0.0 — только СТРОГО внутри зоны, без допусков.
    zone:inside(pos) без аргумента даёт EPS_L = 1 мм (vector.h:48), поэтому
    передаём явный 0.0.

  * Прибытие ловим ещё и по ПРОГРЕССУ к цели: npc:accessible() проверяет
    только рестрикторы, а не наличие пути, поэтому физически недостижимая
    вершина может выглядеть «доступной». Нет приближения за progress_timeout
    -> перевыбор, зона уходит в skip.
  * Остановка — ТОЛЬКО по точному совпадению вершины
    (npc:level_vertex_id() == st.vid), как во всех референсах: NLC7
    blowout_scheme:403, AMK 1.4.1:416, utAMK:444, SIMBION-SHOC/CS,
    OGSM ogsm_hideout:222, OGSE:712. Тест «я внутри зоны» у них только
    переключает действие, но НЕ сажает. Таймаута «не дошёл — сядь где
    стоишь» нет ни у кого: именно он сажал наших NPC у входа.
------------------------------------------------------------------]]

local debug = true

-- Идентификаторы ОБЪЯВЛЕНЫ ГЛОБАЛЬНО (без local): на них ссылаются
-- xr_motivator.script и остальные схемы как olr_ai_hideout.olr_hideout_prop.
-- Так же: NLC7 evid_blowout=18572, OGSM property_base=12221,
-- SIMBION-SHOC evid_ai_blowout, SIMBION-CS evid_blowout=18572.
olr_hideout_prop     = 26861   -- свойство "нужно в укрытие"
olr_hideout_operator = 26871   -- оператор

local ev_hideout  = olr_hideout_prop
local act_hideout = olr_hideout_operator

local BADV = 4294967295                        -- u32(-1)

-- Настройки. Правятся здесь, в файле.
local enabled       = true    -- общий выключатель схемы
local search_radius = 150.0   -- м, максимальный радиус поиска зоны укрытия
local seat_tol      = 0.0     -- м, допуск zone:inside: 0 = СТРОГО внутри зоны
local cover_tol     = 0.0     -- м, допуск zone:inside при проверке "я укрыт"
local recheck       = 3.0     -- сек между проверками достижимости маршрута
local scan_period   = 0.4     -- сек, как часто полный скан зон на NPC
local cover_retry   = 10.0    -- сек между попытками найти укрытие, если не вышло
local kill_unhided  = false   -- ВАРИАНТ 2: убивать не укрывшихся на фазе 3
local kill_power    = 5.0     -- мощность взрыва при kill_unhided
local default_max_npc = 0      -- 0 = без лимита; переопределяется ключом max_npc
local cover_attempts  = 3      -- сколько зон перебрать, если не нашлось точки стояния
local allow_overfill  = true   -- true: всё занято -> идти в ближайшее разрешённое всё равно
local progress_timeout   = 8.0   -- сек без приближения к цели -> перевыбор
local arrive_near         = 2.0   -- м, считаем "пришёл" вплотную к своему месту
local zone_scan_min_step = 2.0   -- м, минимальный шаг сетки при сборе вершин внутри зоны
local dump_covers_on_prep  = true  -- печатать дамп всех укрытий при первой подготовке списка

-- Необязательные per-zone ключи в misc\surge_manager.ltx, читаются если есть:
--   [<имя зоны>] npc_list    = false    -- зона только для игрока, NPC её игнорируют
--   [<имя зоны>] entrance    = <vid>    -- level_vertex_id, куда NPC смотрит из укрытия
--   [<имя зоны>] max_npc     = <N>      -- лимит NPC в зоне (0 или нет ключа = без лимита)
--   [<имя зоны>] allowed_community    = a, b -- в зону могут ТОЛЬКО эти группировки
--   [<имя зоны>] disallowed_community = a, b -- в зону могут ВСЕ, КРОМЕ этих
-- Если заданы оба community-ключа — применяются оба условия (AND).
-- Имена группировок — как в npc:character_community(): stalker, bandit,
-- dolg, freedom, military, killer, monolith, ecolog, zombied, trader,
-- neutral, sin, sky, iskateli, lastday, deads, voenstals, sliznyaki.
-- Без entrance направление взгляда выбирает движок (look.danger).

-- ==================================================================
-- Диагностика
-- ==================================================================

local function dbg(fmt, ...)
	if not debug then return end
	if select("#", ...) > 0 then
		log1("[olr_hideout] " .. string.format(fmt, ...))
	else
		log1("[olr_hideout] " .. fmt)
	end
end

-- Троттлинг: та же строка не чаще чем раз в period мс.
local dbg_last = {}

local function dbg_throttled(period, fmt, ...)
	if not debug then return end
	local key = tostring(fmt)
	local now = time_global()
	if dbg_last[key] ~= nil and (now - dbg_last[key]) < period then return end
	dbg_last[key] = now
	dbg(fmt, ...)
end

-- ==================================================================
-- Зоны укрытия: список и доступность от surge_manager
-- ==================================================================

local st_claims       = {}   -- [level_vertex_id] = npc:id(), чтобы не слипались
local zone_verts_cache = {}  -- [имя зоны] = { vid, ... } — AI-вершины СТРОГО внутри
local entrance_cache  = {}   -- [имя зоны] = vid или 0
local zone_skip_cache = {}   -- [имя зоны] = true, если npc_list = false
local zone_comm_cache = {}   -- [имя зоны] = { allowed = set|nil, disallowed = set|nil }
local zone_cap_cache  = {}   -- [имя зоны] = max_npc (0 = без лимита)
local zone_claims     = {}   -- [имя зоны] = { [npc_id] = true } — кто идёт/сидит
local npc_claim       = {}   -- [npc_id]   = имя зоны

-- surge_manager.covers[i] = {id = <vid зоны>, zone = <объект>, condlist = ...}
local function get_mgr()
	local m = surge_manager.get_surge_manager()
	if m == nil then return nil end
	return m
end

-- Необязательные per-zone ключи читаем из того же ini, что и surge_manager.
local function zone_flag(name, key)
	local m = get_mgr()
	if m == nil or m.ini == nil then return nil end
	if not m.ini:line_exist(name, key) then return nil end
	if key == "npc_list" then return m.ini:r_bool(name, key) end
	local v = tonumber(m.ini:r_string(name, key)) or 0
	if v < 0 then v = 0 end
	return v
end

local function zone_npc_ok(c)
	local name = c.zone and c.zone:name() or nil
	if name == nil then return false end
	local cached = zone_skip_cache[name]
	if cached ~= nil then return not cached end
	local v = zone_flag(name, "npc_list")
	local skip = (v == false)
	zone_skip_cache[name] = skip
	return not skip
end

-- Вершина пригодна к использованию. Отсекаем u32(-1) и мусор от нативных
-- вызовов ДО level.vertex_position: иначе он читает память за графом.
local function valid_vid(v)
	return type(v) == "number" and v >= 0 and v < 2147483647
end

local function zone_entrance(c)
	local name = c.zone and c.zone:name() or nil
	if name == nil then return 0 end
	local cached = entrance_cache[name]
	if cached ~= nil then return cached end
	local v = zone_flag(name, "entrance") or 0
	entrance_cache[name] = v
	return v
end

-- ==================================================================
-- Per-zone настройки из misc\surge_manager.ltx (прогреваются prep_covers)
-- ==================================================================

-- Строковое значение ключа (nil, если ключа нет).
local function zone_flag_str(name, key)
	local m = get_mgr()
	if m == nil or m.ini == nil then return nil end
	if not m.ini:line_exist(name, key) then return nil end
	return m.ini:r_string(name, key)
end

-- "a, b, c" / "a b c" -> { a=true, b=true, c=true }; nil если пусто.
-- gmatch сам съедает запятые и пробелы, а лишний ';' (неотрезанный
-- комментарий из ltx) в множество не попадает.
local function parse_set(s)
	if s == nil then return nil end
	local t = nil
	for w in s:gmatch("[^,%s;]+") do
		t = t or {}
		t[w] = true
	end
	return t
end

local function zone_comm(name)
	local e = zone_comm_cache[name]
	if e == nil then
		e = {
			allowed    = parse_set(zone_flag_str(name, "allowed_community")),
			disallowed = parse_set(zone_flag_str(name, "disallowed_community")),
		}
		zone_comm_cache[name] = e
	end
	return e
end

local function zone_max_npc(name)
	local v = zone_cap_cache[name]
	if v == nil then
		v = tonumber(zone_flag_str(name, "max_npc") or "") or default_max_npc
		if v < 0 then v = 0 end
		zone_cap_cache[name] = v
	end
	return v
end

-- ==================================================================
-- Занятость укрытий (вместимость). Считаем и тех, кто ещё бежит.
-- ==================================================================

local function claims_reset()
	zone_claims = {}
	npc_claim   = {}
end

local function release_claim(npc_id)
	local name = npc_claim[npc_id]
	if name == nil then return end
	local t = zone_claims[name]
	if t ~= nil then
		t[npc_id] = nil
		if next(t) == nil then zone_claims[name] = nil end
	end
	npc_claim[npc_id] = nil
end

local function claim_zone(c, npc_id)
	local name = c.zone:name()
	if npc_claim[npc_id] == name then return end
	release_claim(npc_id)
	local t = zone_claims[name]
	if t == nil then t = {}; zone_claims[name] = t end
	t[npc_id] = true
	npc_claim[npc_id] = name
end

-- Самоочищение: выкидываем записи, где NPC уже нацелен на другую зону или
-- чей storage пропал (умер/уничтожен). Так утечка от оффлайна и смерти
-- не съедает вместимость навсегда.
local function claims_purge(name)
	local t = zone_claims[name]
	if t == nil then return nil end
	for id in pairs(t) do
		if npc_claim[id] ~= name or db.storage[id] == nil then
			t[id] = nil
			if npc_claim[id] == name then npc_claim[id] = nil end
		end
	end
	if next(t) == nil then
		zone_claims[name] = nil
		return nil
	end
	return t
end

local function zone_has_room(c, npc_id)
	local cap = zone_max_npc(c.zone:name())
	if cap == 0 then return true end
	local t = claims_purge(c.zone:name())
	if t == nil then return true end
	local n = 0
	for id in pairs(t) do
		if id ~= npc_id then n = n + 1 end
	end
	return n < cap
end

-- ==================================================================
-- Предзаполнение настроек по ВСЕМ зонам сразу
-- ==================================================================

-- Заполняем кэши на весь список укрытий, а не по одной зоне в горячем
-- пути. Пересборка списка в surge_manager (init_surge_covers делает
-- self.covers = {}) ловится по идентичности таблицы m.covers.
local zone_prep_ref = nil

local function prep_covers(m)
	if m == nil or m.covers == nil then return end
	if zone_prep_ref == m.covers then return end
	zone_prep_ref = m.covers

	-- список зон мог измениться -> кэши пересобираем целиком
	zone_skip_cache   = {}
	entrance_cache    = {}
	zone_comm_cache   = {}
	zone_cap_cache    = {}
	zone_verts_cache  = {}

	local n_comm, n_cap = 0, 0
	for i = 1, (m.count or 0) do
		local c = m.covers[i]
		local name = c and c.zone and c.zone:name() or nil
		if name ~= nil and zone_comm_cache[name] == nil then
			local e = zone_comm(name)
			if e.allowed ~= nil or e.disallowed ~= nil then n_comm = n_comm + 1 end
			if zone_max_npc(name) > 0 then n_cap = n_cap + 1 end
			zone_skip_cache[name] = (zone_flag(name, "npc_list") == false)
			entrance_cache[name]  = zone_flag(name, "entrance") or 0
		end
	end

	dbg("зоны подготовлены: %d, с фильтром группировок %d, с лимитом %d",
	    m.count or 0, n_comm, n_cap)
	if debug and dump_covers_on_prep then dump_covers() end
end

-- Общая проверка зоны для NPC: npc_list, condlist, community.
-- Вместимость здесь НАМЕРЕННО не проверяется: иначе уже сидящий NPC
-- считал бы себя лишним и выселялся. Вместимость — только в nearest_cover.
local function zone_ok(m, c, npc)
	if c == nil or c.zone == nil then return false end
	if not zone_npc_ok(c) then return false end
	if not m:cover_allowed(c) then return false end

	local e = zone_comm(c.zone:name())
	if e.allowed ~= nil or e.disallowed ~= nil then
		local cc = npc:character_community()
		if e.allowed    ~= nil and not e.allowed[cc]  then return false end
		if e.disallowed ~= nil and     e.disallowed[cc] then return false end
	end
	return true
end

-- Частый вызов. Сначала проверяем только текущую зону NPC (один нативный
-- inside), полный скан не чаще scan_period на NPC.
local function covered_by(npc, st)
	local m = get_mgr()
	if m == nil or m.count == nil or m.count == 0 then return nil end
	prep_covers(m)

	local p = npc:position()
	local t = st and st.target
	if t ~= nil and t.zone ~= nil and t.zone:inside(p, cover_tol) and zone_ok(m, t, npc) then
		st.scan_t = time_global()
		return t
	end

	local now = time_global()
	if st and st.scan_t and (now - st.scan_t) < scan_period then return nil end
	if st then st.scan_t = now end

	for i = 1, m.count do
		local c = m.covers[i]
		if c ~= nil and c.zone ~= nil and c.zone:inside(p, cover_tol) and zone_ok(m, c, npc) then
			if st then st.target = c end
			return c
		end
	end
	return nil
end

-- Ближайшая зона-кандидат.
--   with_room = true -> только там, где есть свободное место (zone_has_room)
--   skip -> таблица [имя зоны]=true для уже проваленных попыток
local function nearest_cover(npc, with_room, skip)
	local m = get_mgr()
	if m == nil then
		dbg("nearest_cover: НЕТ surge_manager")
		return nil
	end
	if m.count == nil or m.count == 0 then
		dbg("nearest_cover: surge_manager.count = 0 (список укрытий пуст)")
		return nil
	end
	prep_covers(m)

	local p    = npc:position()
	local r2   = search_radius * search_radius
	local id   = npc:id()
	local best, best_d = nil, nil

	for i = 1, m.count do
		local c = m.covers[i]
		if c ~= nil and c.zone ~= nil then
			local name = c.zone:name()
			if (skip == nil or skip[name] ~= true) and zone_ok(m, c, npc) then
				local d = p:distance_to_sqr(c.zone:center())
				if d <= r2 and (best_d == nil or d < best_d)
				   and (not with_room or zone_has_room(c, id)) then
					best, best_d = c, d
				end
			end
		end
	end
	return best
end

-- Пометить зону как отработанную в этом выбросе (нет мест / недостижима).
local function skip_zone(st, c)
	if c ~= nil and c.zone ~= nil then
		st.skip_zone = st.skip_zone or {}
		st.skip_zone[c.zone:name()] = true
	end
end
-- ==================================================================
-- Вершины внутри зоны: собираем ОДИН раз и кэшируем по имени зоны
-- ==================================================================

-- level.vertex_id(pos) ищет вершину по ЯЧЕЙКЕ XZ (level_graph.cpp:209-223)
-- и отдаёт u32(-1), если в ячейке нет AI-вершины. Поэтому одной удачной
-- вершины в центре не хватает: у части зон центр вне сетки (по логу 15501
-- отказ), а зона бывает СОСТАВНОЙ (несколько сшитых боксов), где center()
-- вообще лежит вне фигуры. Поэтому чешем сеткой ВСЮ описанную сферу зоны
-- и запоминаем все AI-вершины СТРОГО ВНУТРИ. Дальше NPC просто берут
-- любое свободное место — без спиралей и поиска «той самой» вершины.
local function zone_verts(c)
	local zone = c.zone
	local name = zone:name()
	local cached = zone_verts_cache[name]
	if cached ~= nil then return cached end

	local list, seen = {}, {}
	local center = zone:center()
	local radius = zone.radius or 0
	if radius <= 0 then radius = 10.0 end

	-- сначала грубая сетка; если ничего не нашла — тонкая
	local fine = math.max(zone_scan_min_step, radius / 16)
	local steps = { fine }
	if fine > zone_scan_min_step + 0.01 then steps[#steps + 1] = zone_scan_min_step end

	for s = 1, #steps do
		local step = steps[s]
		local x = center.x - radius
		while x <= center.x + radius do
			local z = center.z - radius
			while z <= center.z + radius do
				local v = level.vertex_id(vector():set(x, center.y, z))
				if valid_vid(v) and not seen[v] then
					if zone:inside(level.vertex_position(v), seat_tol) then
						seen[v] = true
						list[#list + 1] = v
					end
				end
				z = z + step
			end
			x = x + step
		end
		if #list > 0 then break end
	end

	-- СОРТИРУЕМ "от центра наружу": NPC идут в самое глубокое свободное
	-- место, а не встают у входа. Центр — центроид собранных вершин, для
	-- составных зон (сшитых боксов) он надёжнее zone:center(), который
	-- у них лежит вне фигуры.
	local cx, cy, cz = 0, 0, 0
	for i = 1, #list do
		local vp = level.vertex_position(list[i])
		cx, cy, cz = cx + vp.x, cy + vp.y, cz + vp.z
	end
	if #list > 0 then
		local ref = vector():set(cx / #list, cy / #list, cz / #list)
		local dref = {}
		for i = 1, #list do
			dref[list[i]] = level.vertex_position(list[i]):distance_to_sqr(ref)
		end
		table.sort(list, function(a, b) return dref[a] < dref[b] end)
	end

	zone_verts_cache[name] = list
	dbg("зона %s: радиус=%.0f, вершин строго внутри %d", name, radius, #list)
	return list
end

-- Точка стояния: ЛЮБОЕ свободное место СТРОГО ВНУТРИ зоны.
-- allow_crowded=false -> если свободных нет, вернуть nil, чтобы drive_to
-- попробовал СЛЕДУЮЩУЮ зону (иначе все липнут в одну).
local function seat_in_zone(npc, c, claim_id, avoid, allow_crowded)
	local list = zone_verts(c)
	local n = #list
	if n == 0 then return nil, "no_vertex" end

	-- список отсортирован "от центра наружу": первое свободное = самое глубокое
	for k = 1, n do
		local v = list[k]
		if v ~= avoid and npc:accessible(v)
		   and (st_claims[v] == nil or st_claims[v] == claim_id) then
			st_claims[v] = claim_id
			return v, "free"
		end
	end

	if allow_crowded then
		local v = list[1]
		st_claims[v] = claim_id
		dbg("%s: в %s все %d мест заняты, сажусь в самое глубокое", npc:name(), c.zone:name(), n)
		return v, "crowded"
	end
	return nil, "busy"
end

-- Единственная точка взгляда, которую мы вообще задаём, — entrance из
-- misc\surge_manager.ltx (необязательный ключ у секции зоны). Если её
-- нет, цель не передаётся вовсе, и направление выбирает движок.
-- Так же в OGSM/OGSE: они вообще не задают look_position для hide_na.
local function entrance_point(c)
	local e = zone_entrance(c)
	if e > 0 and e ~= BADV then
		local p = level.vertex_position(e)
		if p ~= nil then return p end
	end
	return nil
end

-- state_mgr.set_state пишет в лог на КАЖДЫЙ вызов -> не спамим, когда
-- состояние уже то же. Для hide_na есть отдельный hold_hide.
local function set_state(npc, name)
	if state_mgr.get_state(npc) == name then return end
	state_mgr.set_state(npc, name)
end

-- Присесть в укрытии. Точку взгляда задаём ТОЛЬКО при наличии entrance
-- у зоны, иначе target = nil -> look.danger -> eSightTypeCover: движок
-- сам выбирает наименее прикрытое направление. Так сделано в OGSM/OGSE.
-- Рандома и перенаводки нет: каждый set_state с новой look_position
-- заставляет act_state_mgr_direction_turn снова крутить корпус
-- (state_mgr_direction.script:101-104) — это и давало вращение на месте.
local function hold_hide(npc, pt)
	if pt ~= nil then
		state_mgr.set_state(npc, "hide_na", nil, nil,
		                    {look_position = pt}, nil, nil, {yaw_delta = 0.2})
	else
		state_mgr.set_state(npc, "hide_na")
	end
end

-- ==================================================================
-- Фаза выброса: три has_alife_info раз в 500 мс вместо трёх на NPC за тик
-- ==================================================================

local phase_cache, phase_t = 0, -1

local function surge_phase()
	local now = time_global()
	if phase_t >= 0 and (now - phase_t) < 500 then return phase_cache end
	phase_t = now

	local prev = phase_cache
	if has_alife_info("olr_blowout_phase_3") then
		phase_cache = 3
	elseif has_alife_info("olr_blowout_phase_2") then
		phase_cache = 2
	elseif has_alife_info("olr_blowout_phase_1") then
		phase_cache = 1
	else
		phase_cache = 0
	end

	-- Выброс кончился: снимаем занятость укрытий. Оффлайн-NPC не вызовут
	-- finalize, поэтому чистим таблицы целиком, а не по одному.
	if phase_cache == 0 and prev > 0 then
		claims_reset()
		dbg("выброс кончился: занятость укрытий сброшена")
	end

	return phase_cache
end

-- ==================================================================
-- Действие
-- ==================================================================

class "action_olr_hideout" (action_base)

function action_olr_hideout:__init(st)
	super(nil, "action_olr_hideout")
	self.st = st
end

function action_olr_hideout:initialize()
	action_base.initialize(self)

	local npc, st = self.object, self.st
	dbg("%s: ДЕЙСТВИЕ ВЫБРАНО планировщиком, фаза %d", npc:name(), surge_phase())

	npc:disable_talk()
	npc:clear_animations()
	npc:set_desired_position()
	npc:set_desired_direction()
	npc:set_detail_path_type(move.line)
	npc:set_path_type(game_object.level_path)
	npc:set_body_state(move.standing)
	npc:movement_enabled(true)

	if st.saved_mental == nil then st.saved_mental = npc:mental_state() end
	npc:set_mental_state(anim.danger)

	st.holding, st.hold_zone = false, nil
	st.retry_t, st.stall_t   = time_global(), time_global()
	st.scan_t               = 0
	st.last_pos             = npc:position()
	st.killed               = false
	st.giveup_t             = 0
	st.best_d, st.best_t     = nil, nil
	st.seat_t, st.seat_give  = time_global(), false
	st.skip_zone             = {}

	local ok, why = self:drive_to(nil, "initialize"); if not ok then self:panic_here(why or "не удалось выбрать укрытие") end
end

-- Отправить NPC в укрытие. c == nil -> выбрать зону.
-- who — источник вызова, только для лога.
function action_olr_hideout:drive_to(c, who)
	local npc, st = self.object, self.st
	local id = npc:id()
	local vid, how
	who = who or "?"

	if c == nil then
		-- Фаза A: до cover_attempts попыток взять ближайшую зону, где ЕСТЬ
		-- свободное место. Всё, что уже отбраковано в этом выбросе, лежит в
		-- st.skip_zone и пропускается.
		st.skip_zone = st.skip_zone or {}
		for _ = 1, cover_attempts do
			local cand = nearest_cover(npc, true, st.skip_zone)
			if cand == nil then break end
			vid, how = seat_in_zone(npc, cand, id, nil, false)
			if vid ~= nil then c = cand; break end
			skip_zone(st, cand)
			dbg("%s [%s]: в %s нет точки стояния, пробую дальше", npc:name(), who, cand.zone:name())
		end

		-- Фаза B (крайний случай): все укрытия заполнены -> идём в ближайшее
		-- разрешённое всё равно, иначе NPC будет стоять на улице.
		if c == nil and allow_overfill then
			local cand = nearest_cover(npc, false, nil)
			if cand ~= nil then
				local v2, h2 = seat_in_zone(npc, cand, id, nil, true)
				if v2 ~= nil then
					c, vid, how = cand, v2, h2
					dbg("%s [%s]: всё занято, иду в %s (переполнение)", npc:name(), who, cand.zone:name())
				end
			end
		end

		if c == nil then
			st.target, st.vid = nil, nil
			local m = get_mgr()
			dbg("%s (%s) [%s]: нет подходящей зоны, всего зон %d",
			    npc:name(), npc:character_community(), who, m and m.count or -1)
			return false, "нет подходящей зоны укрытия"
		end
	else
		vid, how = seat_in_zone(npc, c, id, nil, false)
		if vid == nil then
			st.target, st.vid = c, nil
			dbg("%s [%s]: в %s нет точки стояния", npc:name(), who, c.zone:name())
			return false, "нет точки стояния в зоне " .. c.zone:name()
		end
	end

	local old_vid = st.vid
	if old_vid ~= nil and old_vid ~= vid then st_claims[old_vid] = nil end

	st.target, st.vid = c, vid
	st.seat_t, st.seat_give = time_global(), false
	claim_zone(c, id)

	npc:set_dest_level_vertex_id(vid)
	npc:set_desired_position(level.vertex_position(vid))
	npc:set_detail_path_type(move.line)
	npc:set_path_type(game_object.level_path)
	npc:set_movement_type(move.run)
	set_state(npc, "assault")

	st.last_pos = npc:position()
	st.stall_t  = time_global()

	do
		local vz = level.vertex_position(vid)
		st.best_d = st.last_pos:distance_to(vz)
		st.best_t = st.stall_t
		dbg("%s [%s] -> %s, vid=%d (%s), vert=(%.0f,%.0f,%.0f) dist_center=%.1f dist_npc=%.1f",
		    npc:name(), who, c.zone:name(), vid, how,
		    vz.x, vz.y, vz.z,
		    vz:distance_to(c.zone:center()), st.best_d)
	end
	return true
end

-- Укрытия нет: замирает на месте. Опционально — умирает на фазе 3.
-- Логирует ВСЕГДА, это главный диагностический путь.
function action_olr_hideout:panic_here(why)
	local npc, st = self.object, self.st

	set_state(npc, "psycho_pain")
	npc:set_desired_position()
	npc:set_movement_type(move.stand)

	if why ~= nil then
		st.giveup_t = time_global()
		dbg("%s остаётся на месте: %s", npc:name(), why)
	end

	if kill_unhided and not st.killed and surge_phase() >= 3 then
		st.killed = true
		local h = hit()
		h.type      = hit.explosion
		h.power     = kill_power
		h.impulse   = 0
		h.direction = vector():set(0, 0, 1)
		h.draftsman = npc
		npc:hit(h)
		dbg("%s убит (kill_unhided)", npc:name())
	end
end

function action_olr_hideout:execute()
	action_base.execute(self)

	local npc, st = self.object, self.st
	local now = time_global()
	local p   = npc:position()
	local id  = npc:id()

	-- "Пришли" = СТРОГО внутри СВОЕЙ целевой зоны, либо уже вплотную к своему
	-- месту. Тест "внутри любой зоны" не годится: NPC мог просто пробегать
	-- через чужое укрытие по пути.
	local in_shelter = (st.target ~= nil and st.target.zone ~= nil
	                    and st.target.zone:inside(p, cover_tol))
	local at_seat    = (st.vid ~= nil
	                    and p:distance_to(level.vertex_position(st.vid)) <= arrive_near)

	-- =================== ЕЩЁ ИДЁМ: НИКАКИХ ПЕРЕВЫБОРОВ ===================
	-- Решаем только по прибытии. Единственное исключение — цель вообще
	-- отпала (зону сняли/запретили или вершина стала недоступной).
	if st.vid ~= nil and not in_shelter and not at_seat then
		st.holding, st.hold_zone = false, nil

		if now - st.retry_t > recheck then
			st.retry_t = now
			local m = get_mgr()
			if (m ~= nil and st.target ~= nil and not zone_ok(m, st.target, npc))
			   or not npc:accessible(st.vid) then
				skip_zone(st, st.target)
				dbg("%s [%s]: цель отпала, беру другое укрытие", npc:name(),
				    st.target and st.target.zone:name() or "?")
				local ok, why = self:drive_to(nil, "цель отпала"); if not ok then self:panic_here(why or "нет подходящего укрытия") end
				return
			end
		end

		npc:set_dest_level_vertex_id(st.vid)
		npc:set_desired_position(level.vertex_position(st.vid))
		npc:set_movement_type(move.run)
		set_state(npc, "assault")
		return
	end

	-- =================== ПРИШЛИ: ищем место ЗДЕСЬ ===================
	local c = st.target
	if c == nil then
		-- цели нет вообще
		st.holding, st.hold_zone = false, nil
		if now - st.giveup_t > cover_retry then
			local ok, why = self:drive_to(nil, "нет цели"); if not ok then self:panic_here(why or "подобрать укрытие не вышло") end
		end
		if st.target == nil then self:panic_here() end
		return
	end

	-- своего места нет или его перехватили -> берём свободное ЗДЕСЬ
	if st.vid ~= nil then
		local owner = st_claims[st.vid]
		if owner ~= nil and owner ~= id then st.vid = nil end
	end
	if st.vid == nil then
		st.holding, st.hold_zone = false, nil
		st.vid = seat_in_zone(npc, c, id, nil, false)
		if st.vid ~= nil then
			st.seat_t, st.seat_give = now, false
		else
			-- свободных мест в этом укрытии нет -> помечаем его и идём в другое
			skip_zone(st, c)
			dbg("%s: в %s нет свободных мест, ищу другое укрытие", npc:name(), c.zone:name())
			local ok, why = self:drive_to(nil, "зона заполнена"); if not ok then self:panic_here(why or "нет свободных укрытий") end
			return
		end
	end

	-- доходим до своего места (никуда из зоны не уходя), но не бесконечно
	if not st.seat_give
	   and p:distance_to(level.vertex_position(st.vid)) > arrive_near then
		st.holding, st.hold_zone = false, nil
		if now - st.seat_t > progress_timeout then
			st.seat_give = true
			dbg("%s: до места в %s не дотянулся за %.0f с, сажусь где стою",
			    npc:name(), c.zone:name(), progress_timeout)
		else
			npc:set_dest_level_vertex_id(st.vid)
			npc:set_desired_position(level.vertex_position(st.vid))
			npc:set_movement_type(move.run)
			set_state(npc, "assault")
			return
		end
	end

	-- садимся. hold_hide зовём ОДИН раз на входе (или если состояние
	-- перебили) — state_mgr пишет лог на каждый вызов и перепланирует.
	if not st.holding then
		st.holding, st.hold_zone = true, c
		st.look_pos = entrance_point(c)
		claim_zone(c, id)
		hold_hide(npc, st.look_pos)
		npc:set_desired_position()
		npc:set_movement_type(move.stand)
		dbg("%s спрятался в %s | pos=(%.0f,%.0f,%.0f) vid=%s inside=%s",
		    npc:name(), c.zone:name(), p.x, p.y, p.z, tostring(st.vid),
		    tostring(c.zone:inside(p, cover_tol)))
	elseif state_mgr.get_state(npc) ~= "hide_na" then
		hold_hide(npc, st.look_pos)
		dbg("%s: вернул hide_na", npc:name())
	end
end

function action_olr_hideout:finalize()
	action_base.finalize(self)

	local npc, st = self.object, self.st
	if npc == nil then return end

	if st.vid ~= nil then st_claims[st.vid] = nil end
	release_claim(npc:id())

	npc:set_desired_position()
	npc:set_desired_direction()
	npc:set_movement_type(move.stand)
	npc:clear_animations()
	npc:enable_talk()

	if db.storage[npc:id()] ~= nil
	and st.saved_mental ~= nil
	and npc:mental_state() == anim.danger then
		npc:set_mental_state(st.saved_mental)
	end

	st.saved_mental          = nil
	st.holding, st.hold_zone = false, nil
	st.target, st.vid        = nil, nil
	st.last_pos, st.scan_t   = nil, 0
	st.retry_t, st.stall_t   = nil, nil
	st.killed               = false
	st.look_pos              = nil
	st.giveup_t              = 0
	st.best_d, st.best_t     = nil, nil
	st.seat_t, st.seat_give  = nil, false
	st.skip_zone             = {}

	-- Состояние НЕ восстанавливаем: act_state_mgr_to_idle вернёт "idle"
	-- сам, как только мы снимем гейт state_mgr+1/+2 на следующем цикле
	-- планировщика. Не дёргаем set_state сами — не спорим с state_mgr.
end

-- ==================================================================
-- Эвалюатор
-- ==================================================================

class "evaluator_olr_hideout" (property_evaluator)

function evaluator_olr_hideout:__init(st)
	super(nil, "evaluator_olr_hideout")
	self.st = st
end

function evaluator_olr_hideout:evaluate()
	local st = self.st
	if st == nil or not st.enabled or not enabled then return false end

	-- самый дешёвый ранний выход: вне выброса стоит одно чтение поля
	local m = get_mgr()
	if m == nil then return false end
	if m.started ~= true then
		dbg_throttled(2000, "ждём выброса: started=%s, укрытий в реестре %d",
			tostring(m.started), m.count or -1)
		return false
	end

	if surge_manager.no_blow_levels[level.name()] then return false end
	if surge_phase() < 1 then return false end

	local npc = self.object
	if olr_protected.is_no_offline_alife_obj(npc:name()) then return false end

	if debug then
		local now = time_global()
		if st.say_t == nil or (now - st.say_t) > 2000 then
			st.say_t = now
			dbg("%s бежит в укрытие (фаза %d)", npc:name(), surge_phase())
		end
	end
	return true
end

-- ==================================================================
-- Привязка к планировщику
-- ==================================================================

-- Враг не должен удерживать NPC в бою, пока идёт выброс.
-- Механизм из NLC7 blowout_scheme.script (функция ecall) и
-- SIMBION-SHOC m_ai_blowout.script:600-616.
-- Вне выброса ведём себя как обычно, поэтому гейт по surge_phase.
-- Цепочка к combat_ignore обязательна: xr_combat_ignore.script:94
-- тоже ставит set_enemy_callback и перетрёт наш.
local forget_dist = 130.0    -- м, дальше этого расстояния враг забывается

local function enemy_callback(_, npc, enemy)
	local st = db.storage[npc:id()]
	if st ~= nil and surge_phase() >= 1 then
		if npc:position():distance_to(enemy:position()) > forget_dist then
			npc:enable_memory_object(enemy, false)
			return false
		end
	end
	if st ~= nil and st.combat_ignore ~= nil and st.combat_ignore.action ~= nil
	and st.combat_ignore.action.enemy_callback ~= nil then
		return st.combat_ignore.action:enemy_callback(npc, enemy)
	end
	return true
end
-- ==================================================================
-- ОТЛАДКА: пройтись по ВСЕМ укрытиям и проверить их вершины.
-- Вызов из консоли игры:  run_string olr_ai_hideout.dump_covers()
-- ==================================================================
function dump_covers()
	local m = get_mgr()
	if m == nil or m.count == nil then
		log1("[olr_hideout] dump_covers: нет surge_manager")
		return
	end

	zone_verts_cache = {}   -- собираем всё заново
	local no_vert = 0
	log1("[olr_hideout] ==== dump_covers: зон " .. tostring(m.count) .. " ====")

	for i = 1, m.count do
		local c = m.covers[i]
		if c ~= nil and c.zone ~= nil then
			local zone = c.zone
			local name = zone:name()
			local pos  = zone:position()
			local ctr  = zone:center()
			local rad  = zone.radius or 0
			local list = zone_verts(c)
			if #list == 0 then no_vert = no_vert + 1 end

			-- сколько найденных мест сейчас занято
			local busy = 0
			for k = 1, #list do
				if st_claims[list[k]] ~= nil then busy = busy + 1 end
			end

			log1(string.format(
				"[olr_hideout] %-28s pos=(%.0f,%.0f,%.0f) center=(%.0f,%.0f,%.0f) r=%.0f вершин=%d занято=%d",
				name, pos.x, pos.y, pos.z, ctr.x, ctr.y, ctr.z, rad, #list, busy))
		end
	end

	log1(string.format("[olr_hideout] ==== dump_covers: зон без вершин внутри: %d ====", no_vert))
end

function add_to_binder(object, char_ini, scheme, section, st)
	local manager = object:motivation_action_manager()

	manager:add_evaluator(ev_hideout, evaluator_olr_hideout(st))

	local action = action_olr_hideout(st)
	-- property_enemy / danger / anomaly НАМЕРЕННО НЕ выставлены: действие
	-- "бежать в укрытие" обязано выигрывать у боя, иначе NPC с врагом
	-- вообще не выберется. Так же в NLC7 action_runtohide и SIMBION-SHOC
	-- ac_runtohide. Запрет на бой есть только на действии "сидеть в укрытии"
	-- (ветка zone ~= nil внутри execute).
	--
	-- add_effect НИЖЕ ОБЯЗАТЕЛЕН. Планировщик сталкера - GOAP, не список
	-- приоритетов: action_planner_inline.h:65 solve() -> A*, цель
	-- {PuzzleSolved=true} (stalker_planner.cpp:67), её даёт только alife_planner
	-- (stalker_planner.cpp:160), а он закрыт нами через ev_hideout == false.
	-- Оператор без эффектов - петля сама на себя, A* её не берёт, и
	-- solution().front() никогда не станет act_hideout. Эффект снимает блокер
	-- в СИМУЛЯЦИИ, план становится
	-- [act_hideout -> (combat/danger/anomaly) -> alife_planner],
	-- и первым шагом идём мы. Вне симуляции значение всегда даёт evaluator,
	-- поэтому ev_hideout == true весь выброс (см. evaluator_olr_hideout).
	-- Так же NLC7 blowout_scheme.script:638-640 и OGSM/OGSE/SHOC.
	action:add_precondition(world_property(stalker_ids.property_alive,   true))
	action:add_precondition(world_property(xr_evaluators_id.sidor_wounded_base, false))
	action:add_precondition(world_property(ev_hideout, true))
	action:add_effect(world_property(ev_hideout, false))
	manager:add_action(act_hideout, action)

	-- Глушим чужие операторы.
	-- state_mgr+1/+2 критичны: act_state_mgr_to_idle сбрасывает наш hide
	-- в "idle" каждый цикл планировщика, если их не запереть.
	-- Проверка на nil потому, что state_mgr биндится в xr_motivator:reinit
	-- (строка 48) отрабатывает до net_spawn -> configure_schemes, так что
	-- 162/163 обычно уже на месте, но на всякий случай не падаем.

	local gated = 0
	local operator = manager:action(stalker_ids.action_alife_planner)
	if operator then operator:add_precondition(world_property(ev_hideout, false)); gated = gated + 1 end

	operator = manager:action(stalker_ids.action_combat_planner)
	if operator then operator:add_precondition(world_property(ev_hideout, false)); gated = gated + 1 end

	operator = manager:action(stalker_ids.action_anomaly_planner)
	if operator then operator:add_precondition(world_property(ev_hideout, false)); gated = gated + 1 end

	operator = manager:action(stalker_ids.action_danger_planner)
	if operator then operator:add_precondition(world_property(ev_hideout, false)); gated = gated + 1 end

	operator = manager:action(xr_actions_id.state_mgr + 1)
	if operator then operator:add_precondition(world_property(ev_hideout, false)); gated = gated + 1 end

	operator = manager:action(xr_actions_id.state_mgr + 2)
	if operator then operator:add_precondition(world_property(ev_hideout, false)); gated = gated + 1 end

	object:set_enemy_callback(enemy_callback, nil)

	if db.storage[object:id()].olr_hideout ~= nil and db.storage[object:id()].olr_hideout.bound == nil then
		db.storage[object:id()].olr_hideout.bound = true
		dbg("%s: бинд схемы, закрыто операторов: %d", object:name(), gated)
	end
end

-- ==================================================================
-- Регистрация
-- ==================================================================

function init()
	dbg("модуль загружен, схема olr_hideout, ev=%d act=%d", ev_hideout, act_hideout)
	core.ac("load_scheme", xrs_load_scheme)
	core.ac("logic_enable_schemes", set_scheme)
	core.ac("logic_disable_schemes", disable_scheme)
end

function xrs_load_scheme()
	load_scheme("olr_ai_hideout", "olr_hideout", modules.stype_stalker)
	dbg("схема зарегистрирована")
end

function set_scheme(ini, object, scheme, section)
	local first = db.storage[object:id()].olr_hideout == nil
	local st = xr_logic.assign_storage_and_bind(object, ini, "olr_hideout", "olr_hideout")
	st.enabled = true
	if first then dbg("%s: set_scheme, первый bind", object:name()) end
end

function disable_scheme(npc, scheme)
	local s  = db.storage[npc:id()]
	local st = s and s["olr_hideout"]
	if st then st.enabled = false end
end
