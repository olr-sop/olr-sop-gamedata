-- !! в этих прекондишенах ещё добавить проверку например на колво денег (второстепенные квесты)
-- !! это проверка на то, можем ли мы идти по пути

function precondition_find_himself(obj)
    if obj:rank() >= 3150 then
        return true
    end
end

function precondition_tourism(obj)
    if obj:rank() >= 1650 and has_alife_info("bun_antenna_off") then
        return true
    end
end

function precondition_cash(obj)
    if xvars.cash_need_summa_has[obj:name()] == true then
        return true
    end
end

function precondition_find_monolot(obj)
    if obj:rank() >= 250 and has_alife_info("bun_antenna_off") then
        return true
    end
end

function precondition_reason_zone(obj)
    -- условие: если мы в симуляции нашли какой нибудь документ
    --if xvars.npcs_who_find_docs_id and xvars.npcs_who_find_docs_id[obj:name()] and xvars.npcs_who_find_docs_id[obj:name()] == obj.id then
    --printf("we find docs and can walk to generators "..obj:name().."")
    if IsStalker(obj) and obj:rank() >= 200 and has_alife_info("bun_antenna_off") then
        return true
    end
    --end
end

function precondition_revenge_is_dead(obj)
    local targetkill = xvars.npcs_tasks_revenge_targets[obj:name()]
    if targetkill then
        local se_obj = alife():object(targetkill)
        if se_obj and not se_obj:alive() then
            return true
        end
        return false
    end
end

local walker_tasks = { cash = true, tourism = true, revenge = true, find_himself = true }

function set_walkers_rndways()
    if not (xvars and xvars.npcs_tasks) then
        return
    end
    local cnt = 0
    local sim = alife()
    for npc_name, task in pairs(xvars.npcs_tasks(true)) do
        if walker_tasks[task] then
            local kill = sim:object(npc_name)
            if kill and IsStalker(kill) and kill:alive() then
                cnt = cnt + 1
                local rndway = math.random(#global_task_rnd_way)
                local rnd_task_way = global_task_rnd_way[rndway].name
                xvars.npcs_tasks_rndway[npc_name] = rnd_task_way
                local rnd = math.random(1, 2)
                if rnd == 1 then
                    xvars.npcs_tasks_rndway[npc_name] = nil
                end
            end
        end
    end
    printf("olr_ai_tasks.set_walkers_rndways count = " .. tostring(cnt) .. "")
end


function dump_tasks()
    if not (xvars and xvars.npcs_tasks) then
        log1("[olr_ai_tasks][DUMP] xvars.npcs_tasks is nil")
        return
    end
    local sim = alife()
    local total, active, offline = 0, 0, 0
    local lines = {}

    for name, task in pairs(xvars.npcs_tasks(true)) do
        total = total + 1
        local sobj = sim and sim:object(name) or nil
        local cobj = sobj and level.object_by_id(sobj.id) or nil
        local obj  = cobj or sobj

        local lvl   = obj and obj.level_name or "?"
        local alive = (obj and obj:alive()) and "alive" or "dead"
        local poss  = "?"
        local p = (cobj and cobj.position) or (sobj and sobj.position)
        if p then poss = string.format("%.0f,%.0f,%.0f", p.x, p.y, p.z) end

        local rndway = tostring(xvars.npcs_tasks_rndway and xvars.npcs_tasks_rndway[name])
        local rev    = tostring(xvars.npcs_tasks_revenge_targets[name])
        local cash   = xvars.cash_need_summa_has[name] and "cash+" or ""
        local rank   = "-"
        if cobj then
            local ok, r = pcall(function() return cobj:rank() end)
            if ok and r then rank = tostring(r) end
        end

        local has, walk = "no", "-"
        if obj then
            local okh, h = pcall(function() return has_task(obj) end)
            if okh and h then
                has = "yes"; active = active + 1
                local okw, w = pcall(function() return get_task_walk(obj) end)
                if okw and w then walk = tostring(w) end
            end
        end

        local sm_id = sobj and tostring(sobj:smart_terrain_id()) or "?"
        table.insert(lines, string.format(
            "%02d) %-32s task=%-12s way=%-40s walk=%-28s lvl=%-14s pos=[%s] %s %s smart=%s rank=%s %s%s",
            total, name, tostring(task), rndway, walk, lvl, poss,
            cobj and "ON" or "off", alive, sm_id, rank,
            has == "yes" and "TASK " or "", cash))
    end

    for _, o in ipairs(olr_offline_walk.tabst) do if o then offline = offline + 1 end end

    log1(string.format(
        "[olr_ai_tasks][DUMP] assigned=%d active=%d offline_walkers=%d\n%s",
        total, active, offline, table.concat(lines, "\n")))
end