end

function away_from_zone_revenge(obj)
    if obj and obj.level_name == "l01_escape" then
        local yan_pos = vector():set(147, 0, -13)
        if obj.position:distance_to(yan_pos) < 20 then
            local wait_time = 0
            wait_time = time_global() + 200
            level.add_call(
                function()
                    return time_global() > wait_time
                end,
                function()
                    olr.to_offline(obj:name())
                end
            )
            local pk = get_netpk(obj, 1)
            if pk:isOk() then
                local data = pk:get()
                local name = data.character_name
                data.health = 0
                data.updhealth = 0
                pk:set(data)
                smart_terrain.on_death(obj.id)
                news_manager.send_tip(db.actor,"" .. name .. " " .. game.translate_string("st_olr_ai_tasks_revenger"),nil,"unknown",39000)
                news_manager.send_tip(db.actor,game.translate_string("st_olr_ai_tasks_revenger_2") .." " .. name .. " " .. game.translate_string("st_olr_ai_tasks_revenger_3"),5,"default",15000)
            end
        end
    end
end

function away_from_zone(obj)
    if obj and obj.level_name == "l01_escape" then
        local yan_pos = vector():set(147, 0, -13)
        if obj.position:distance_to(yan_pos) < 20 then
            local wait_time = 0
            wait_time = time_global() + 200
            level.add_call(
                function()
                    return time_global() > wait_time
                end,
                function()
                    olr.to_offline(obj:name())
                end
            )
            local pk = get_netpk(obj, 1)
            if pk:isOk() then
                local data = pk:get()
                local name = data.character_name
                data.health = 0
                data.updhealth = 0
                pk:set(data)
                smart_terrain.on_death(obj.id)
                news_manager.send_tip(db.actor, game.translate_string("st_olr_ai_tasks_leave_zone_1").." "..name.." "..game.translate_string("st_olr_ai_tasks_leave_zone_2"),nil, "news", 15000)
                news_manager.send_tip(db.actor, game.translate_string("st_olr_ai_tasks_leave_zone_3").." "..name.." "..game.translate_string("st_olr_ai_tasks_leave_zone_4"), 5, "news", 15000)
            end
        end
    end
end

function set_maintask_substates(obj, rnd_quest)
	-- месть сталкеру
	if xvars.npcs_tasks[obj:name()] == "revenge" then
		local places = {}
		for _, kill in ipairs(olr_offline_walk.tabst) do
			if kill then
				if IsStalker(kill) then
					if kill:alive() and (kill.level_name == "l01_escape" or kill.level_name == "l02_garbage" or kill.level_name == "l03_agroprom" or kill.level_name == "l04_darkvalley") then
						if not olr_protected.is_no_offline_alife_obj(kill:name()) then
							table.insert(places, kill)
						end
					end
				end
			end
		end
		if #places > 0 then
			local rand_kill = places[math.random(#places)]
			xvars.npcs_tasks_revenge_targets[obj:name()] = rand_kill:name()
		end
	--printf("revenge "..obj:name().." - set revenge target "..rand_kill:name().." ")
	end
end

