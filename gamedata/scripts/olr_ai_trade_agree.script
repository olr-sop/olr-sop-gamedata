----------------------------------------------------------------------------------------------------------------------
-- olr_ai_trade_agree.script
-- Схема приветствия и торговли: NPC приветствует игрока, включает торговлю, через заданное время возвращается к обычной логике.
----------------------------------------------------------------------------------------------------------------------
local state_waiting = 0
local anim_time = 600000 -- 30 минут, пока так, поебать	  -- время ожидания (мс)

-- Уникальные ID для evaluator и action
local ev_trade_agree = stalker_ids.property_script + 1000
local act_shake_hand = stalker_ids.action_script + 1000

----------------------------------------------------------------------------------------------------------------------
-- Включение схемы
----------------------------------------------------------------------------------------------------------------------

-- init module
function init()
	core.ac("load_scheme", xrs_load_scheme)
end

-- load scheme
function xrs_load_scheme()
	load_scheme("olr_ai_trade_agree", "trade_agree", modules.stype_stalker)
end

function enable_scheme(npc, ini, scheme, section)
	local st = xr_logic.assign_storage_and_bind(npc, ini, "trade_agree", "trade_agree")
	st.enabled = true
end

----------------------------------------------------------------------------------------------------------------------
-- Отключение схемы
----------------------------------------------------------------------------------------------------------------------

function disable_scheme(npc, scheme)
	local st = db.storage[npc:id()]["trade_agree"]
	if st then
		st.enabled = false
	end
end

----------------------------------------------------------------------------------------------------------------------
-- EVALUATOR
----------------------------------------------------------------------------------------------------------------------

class "trade_evaluator" (property_evaluator)
function trade_evaluator:__init(name, storage)
	super(nil, "trade_evaluator")
	self.storage = storage
end

function trade_evaluator:evaluate()
	return self.storage.enabled == true
end

----------------------------------------------------------------------------------------------------------------------
-- ACTION
----------------------------------------------------------------------------------------------------------------------

class "shake_hand" (action_base)
function shake_hand:__init(npc_name, action_name, storage)
	super(nil, "shake_hand")
	self.storage = storage
	self.timer = nil
	self.state = nil
end

function shake_hand:initialize()
	action_base.initialize(self)
	local npc = self.object
	log1(string.format("trade_agree: shake_hand:initialize for npc %s", npc:name()))

	npc:set_desired_position()
	npc:set_desired_direction()
	npc:clear_animations()
	utils.send_to_nearest_accessible_vertex(npc, npc:level_vertex_id())

	if (npc:item_in_slot(1) or npc:item_in_slot(2)) and npc:active_item() then
		state_mgr.set_state(npc, "hello_wpn", nil, nil, { look_object = db.actor }, { animation = true })
	else
		state_mgr.set_state(npc, "hello", nil, nil, { look_object = db.actor }, { animation = true })
	end

	local spot_text = game.translate_string("st_olr_ai_agree_trade_lets").." "..npc:character_name()..""
	olr.add_spot_on_map(npc:id(), "alife_combat_fight", spot_text)
	
	npc:enable_talk()
	npc:enable_trade()

	local timer_name = "trade_agree_remove_spot_" .. tostring(npc:id())
	olr_timers.st_timer_real(timer_name, 600, "olr_ai_trade_agree.remove_spot_timer(" .. tostring(npc:id()) .. ")") -- пол часа реального времени ПОКА ЧТО
	self.storage.timer_name = timer_name

	self.state = state_waiting
	self.timer = time_global() + anim_time
	log1(string.format("trade_agree: timer set to %d (current %d)", self.timer, time_global()))
end

function shake_hand:execute()
	action_base.execute(self)
	local npc = self.object
	local cur_time = time_global()
	--log1(string.format("trade_agree: execute, cur_time=%d, self.timer=%s", cur_time, tostring(self.timer)))
	--if self.timer then
	--	  log1(string.format("	timer condition: %d <= %d = %s", self.timer, cur_time, tostring(self.timer <= cur_time)))
	--end

	if not db.actor:alive() then
	--	  log1("trade_agree: actor dead, disabling scheme")
		disable_scheme(npc, "trade_agree")
		return
	end

	if npc:position():distance_to(db.actor:position()) < 6 then
		level.map_remove_object_spot(npc:id(), "alife_combat_fight")
		if self.storage and self.storage.timer_name then
			olr_timers.del_timer(self.storage.timer_name)
			self.storage.timer_name = nil
		end
	end

	if self.timer and self.timer <= cur_time then
		log1("trade_agree: timer expired, disabling scheme")
		disable_scheme(npc, "trade_agree")
	end
end

-- Вызывается при переключении схемы через switch_to_section
function shake_hand:deactivate()
	log1("trade_agree: deactivate called")
	self:cleanup()
end

-- Вызывается при удалении действия из планировщика
function shake_hand:finalize()
	log1("trade_agree: finalize called")
	self:cleanup()
	action_base.finalize(self)
end

-- Общая функция очистки ресурсов
function shake_hand:cleanup()
	log1("trade_agree: cleanup")
	local npc = self.object
	if not npc then return end

	level.map_remove_object_spot(npc:id(), "alife_combat_fight")

	if self.storage and self.storage.timer_name then
		olr_timers.del_timer(self.storage.timer_name)
		self.storage.timer_name = nil
	end

	npc:disable_trade()
	npc:clear_animations()

	self.storage = nil
	self.timer = nil
	self.state = nil
end

----------------------------------------------------------------------------------------------------------------------
-- Обработчик таймера (удаление спота)
----------------------------------------------------------------------------------------------------------------------

function remove_spot_timer(id)
	log1(string.format("trade_agree: remove_spot_timer for id %d", id))
	local sobj = alife():object(id)
	if sobj then
		level.map_remove_object_spot(sobj.id, "alife_combat_fight")
	end
end

----------------------------------------------------------------------------------------------------------------------
-- СОХРАНЕНИЕ / ЗАГРУЗКА (Не активны, не работают, код закоменчен наглуха)
----------------------------------------------------------------------------------------------------------------------

function npc_load(p, obj)
	if xr_logic.pstor_retrieve(obj, "active_npc_ids", false) == true then
		local gulag = xr_gulag.get_npc_gulag(obj)
		if gulag ~= nil then
			gulag:load_obj(p, obj:id())
		end
		enable_scheme(obj, nil, "trade_agree")
	end
end

function npc_save(p, obj)
	if xr_logic.pstor_retrieve(obj, "active_npc_ids", false) == true then
		local gulag = xr_gulag.get_npc_gulag(obj)
		if gulag ~= nil then
			gulag:save_obj(p, obj:id())
		end
	end
end

----------------------------------------------------------------------------------------------------------------------
-- BINDER
----------------------------------------------------------------------------------------------------------------------

function add_to_binder(npc, ini, scheme, section, storage)
	log1(string.format("trade_agree: add_to_binder for npc %s", npc:name()))
	local manager = npc:motivation_action_manager()

	manager:add_evaluator(ev_trade_agree, trade_evaluator("trade_evaluator", storage))

	local action = shake_hand("shake_hand", storage)
	action:add_precondition(world_property(stalker_ids.property_alive, true))
	action:add_precondition(world_property(stalker_ids.property_enemy, false))
	action:add_precondition(world_property(stalker_ids.property_danger, false))
	action:add_precondition(world_property(ev_trade_agree, true))
	action:add_effect(world_property(ev_trade_agree, false))
	manager:add_action(act_shake_hand, action)

	xr_logic.subscribe_action_for_events(npc, storage, action)

	local alife_action = manager:action(xr_actions_id.alife)
	alife_action:add_precondition(world_property(ev_trade_agree, false))
end