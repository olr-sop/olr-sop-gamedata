----------------------------------------------------------------------------------------------------------------------
-- olr_ai_trade_agree.script
-- Схема приветствия и торговли: NPC приветствует игрока, включает торговлю, через заданное время возвращается к обычной логике.
----------------------------------------------------------------------------------------------------------------------
local state_waiting = 0
local anim_time = 600000 -- 30 минут, пока так, поебать	  -- время ожидания (мс)

-- Уникальные ID для evaluator и action.
-- Держим их в отдельном высоком диапазоне (как olr_ai_trade.script = 21860), чтобы
-- гарантированно не пересечься с базами из xr_actions_id.script / xr_evaluators_id.script.
-- Раньше здесь было stalker_ids.property_script + 1000 = 1044, а это ровно
-- xr_evaluators_id.stohe_tradeseller_base - одноимённый id у чужой схемы.
local base_id_trade_agree = 22860
local ev_trade_agree = base_id_trade_agree + 1
local act_shake_hand = base_id_trade_agree + 1

----------------------------------------------------------------------------------------------------------------------
-- Включение схемы
----------------------------------------------------------------------------------------------------------------------

-- init module
function init()
	core.ac("load_scheme", xrs_load_scheme)
end

-- load scheme
function xrs_load_scheme()
	load_scheme("olr_ai_trade_agree", "trade_agree", modules.stype_stalker)
end

function enable_scheme(npc, ini, scheme, section)
	local st = xr_logic.assign_storage_and_bind(npc, ini, "trade_agree", "trade_agree")
	st.enabled = true
end

----------------------------------------------------------------------------------------------------------------------
-- ХРАНИЛИЩЕ СХЕМЫ И ГЛОБАЛЬНЫЙ ФЛАГ
----------------------------------------------------------------------------------------------------------------------

-- storage схемы для NPC (nil, если схема ещё ни разу не включалась).
-- Флаг живёт в db.storage[npc:id()].trade_agree.enabled - это то самое "глобальное"
-- состояние, по которому и схема, и диалоги понимают, что NPC уже ждёт нас на торг.
function scheme_storage(npc)
	if npc == nil then return nil end
	local st = db.storage[npc:id()]
	if st == nil then return nil end
	return st["trade_agree"]
end

function is_active(npc)
	local st = scheme_storage(npc)
	return st ~= nil and st.enabled == true
end

----------------------------------------------------------------------------------------------------------------------
-- Отключение схемы
----------------------------------------------------------------------------------------------------------------------

function disable_scheme(npc, scheme)
	local st = scheme_storage(npc)
	if st then
		st.enabled = false
	end
end

----------------------------------------------------------------------------------------------------------------------
-- ПРЕДУСЛОВИЕ ДИАЛОГА
-- Пока NPC уже идёт торговать с нами, повторное предложение торговли в списке
-- доступных диалогов показываться не должно.
----------------------------------------------------------------------------------------------------------------------

function precond_not_active(first_speaker, second_speaker)
	local npc = second_speaker
	if db.actor ~= nil and npc ~= nil and db.actor:id() == npc:id() then
		npc = first_speaker
	end
	if npc == nil then return true end
	return not is_active(npc)
end

----------------------------------------------------------------------------------------------------------------------
-- EVALUATOR
----------------------------------------------------------------------------------------------------------------------

class "trade_evaluator" (property_evaluator)
function trade_evaluator:__init(name, storage)
	super(nil, "trade_evaluator")
	self.storage = storage
end

function trade_evaluator:evaluate()
	return self.storage.enabled == true
end

----------------------------------------------------------------------------------------------------------------------
-- ACTION
----------------------------------------------------------------------------------------------------------------------

class "shake_hand" (action_base)
function shake_hand:__init(npc_name, action_name, storage)
	super(nil, "shake_hand")
	self.storage = storage
	self.timer = nil
	self.state = nil
end

function shake_hand:initialize()
	action_base.initialize(self)
	local npc = self.object

	-- Экшен переживает finalize, поэтому storage должен остаться живым.
	-- Раньше cleanup() обнулял его, и второй запуск схемы на том же NPC падал
	-- в nil-индекс на self.storage.timer_name. На всякий случай перечитываем.
	if self.storage == nil then
		self.storage = scheme_storage(npc)
	end
	if self.storage == nil then
		return
	end

	npc:set_desired_position()
	npc:set_desired_direction()
	npc:clear_animations()
	utils.send_to_nearest_accessible_vertex(npc, npc:level_vertex_id())

	if (npc:item_in_slot(1) or npc:item_in_slot(2)) and npc:active_item() then
		state_mgr.set_state(npc, "hello_wpn", nil, nil, { look_object = db.actor }, { animation = true })
	else
		state_mgr.set_state(npc, "hello", nil, nil, { look_object = db.actor }, { animation = true })
	end

	local spot_text = game.translate_string("st_olr_ai_agree_trade_lets").." "..get_npc_real_name(npc)..""
	olr.add_spot_on_map(npc:id(), "alife_combat_fight", spot_text)

	-- enable_talk() тут намеренно НЕ отключается на финише: он снимает тот самый
	-- случайный шанс, что NPC откажется с нами разговаривать. В cleanup() только
	-- disable_trade() - торг закрывается, разговор остаётся доступным.
	npc:enable_talk()
	npc:enable_trade()

	local timer_name = "trade_agree_remove_spot_" .. tostring(npc:id())
	olr_timers.st_timer_real(timer_name, 600, "olr_ai_trade_agree.remove_spot_timer(" .. tostring(npc:id()) .. ")") -- пол часа реального времени ПОКА ЧТО
	self.storage.timer_name = timer_name

	self.state = state_waiting
	self.timer = time_global() + anim_time
	log1(string.format("trade_agree: '%s' включена, ждём до %d", npc:name(), self.timer))
end

function shake_hand:execute()
	action_base.execute(self)
	local npc = self.object
	local cur_time = time_global()

	if db.actor == nil or not db.actor:alive() then
		disable_scheme(npc, "trade_agree")
		return
	end

	if npc:position():distance_to(db.actor:position()) < 6 then
		level.map_remove_object_spot(npc:id(), "alife_combat_fight")
		if self.storage and self.storage.timer_name then
			olr_timers.del_timer(self.storage.timer_name)
			self.storage.timer_name = nil
		end
	end

	if self.timer and self.timer <= cur_time then
		disable_scheme(npc, "trade_agree")
	end
end

-- C++ дергает у скриптовых экшенов только initialize/execute/finalize.
-- deactivate приходит лишь из xr_logic.switch_to_section для активной схемы,
-- а trade_agree активной схемой не является - оставляем как страховку.
function shake_hand:deactivate()
	self:stop()
end

-- Вызывается движком при ЛЮБОЙ смене действия в планировщике: бой, опасность,
-- аномалия и т.д. Схему выключаем всегда, иначе она молча взводится заново
-- с новым таймером и новой меткой, как только бой закончится.
function shake_hand:finalize()
	self:stop()
	action_base.finalize(self)
end

-- Единая точка финиша: снимаем флаг, отдаём таймер и метку, закрываем ТОЛЬКО торговлю.
function shake_hand:stop()
	local npc = self.object
	if npc == nil then return end

	if self.storage ~= nil then
		if self.storage.timer_name ~= nil then
			olr_timers.del_timer(self.storage.timer_name)
			self.storage.timer_name = nil
		end
		self.storage.enabled = false
	end

	level.map_remove_object_spot(npc:id(), "alife_combat_fight")

	npc:disable_trade()
	npc:clear_animations()
	-- npc:disable_talk() намеренно НЕ вызываем - см. комментарий в initialize().

	self.timer = nil
	self.state = nil
end

----------------------------------------------------------------------------------------------------------------------
-- Обработчик таймера (удаление спота)
----------------------------------------------------------------------------------------------------------------------

function remove_spot_timer(id)
	local sobj = alife():object(id)
	if sobj then
		level.map_remove_object_spot(sobj.id, "alife_combat_fight")
	end
end

----------------------------------------------------------------------------------------------------------------------
-- СОХРАНЕНИЕ / ЗАГРУЗКА
-- Схема намеренно НЕ сохраняется в сейв. Она аддитивная и короткоживущая: после
-- загрузки NPC просто продолжает свою обычную логику. Старые npc_load/npc_save,
-- которые опирались на pstor-ключ "active_npc_ids" (его больше никто не пишет),
-- удалены - они были мёртвым кодом.
----------------------------------------------------------------------------------------------------------------------

----------------------------------------------------------------------------------------------------------------------
-- BINDER
----------------------------------------------------------------------------------------------------------------------

function add_to_binder(npc, ini, scheme, section, storage)
	local manager = npc:motivation_action_manager()

	manager:add_evaluator(ev_trade_agree, trade_evaluator("trade_evaluator", storage))

	local action = shake_hand("shake_hand", storage)
	action:add_precondition(world_property(stalker_ids.property_alive, true))
	action:add_precondition(world_property(stalker_ids.property_enemy, false))
	action:add_precondition(world_property(stalker_ids.property_danger, false))
	action:add_precondition(world_property(ev_trade_agree, true))
	action:add_effect(world_property(ev_trade_agree, false))
	manager:add_action(act_shake_hand, action)

	xr_logic.subscribe_action_for_events(npc, storage, action)

	local alife_action = manager:action(xr_actions_id.alife)
	alife_action:add_precondition(world_property(ev_trade_agree, false))
end