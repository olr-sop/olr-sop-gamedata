function on_spawn()
    if not db.actor or not xvars or not xvars.rnd_anoms_count then
        return
    end
    
    local level_name = level.name()
    local level_data = level_spawn_data[level_name]
    
    if level_data and not has_alife_info(level_data.info_portion) then
        db.actor:give_info_portion(level_data.info_portion)
        spawn_anomalies(level_data)
    end
end

function spawn_anomalies(level_data)
    if xvars.rnd_anoms_count > max_rnd_anoms then
        return
    end
    
    local count = math.random(level_data.count[1], level_data.count[2])
    local spawned_count = 0
    local attempts = 0
    local max_attempts = count * 3
    
    local lname = level.name()
    local lvtab = GetLevelVertexes(lname)
    local lvx = math.max(unpack(lvtab))
    local gvtab = GetGameVertexes(lname)
    local gv_max = math.max(unpack(gvtab))
    
    while spawned_count < count and attempts < max_attempts do
        attempts = attempts + 1
        
        local lv = math.random(1, lvx)
        local vl_pos = level.vertex_position(lv)
        
        -- Проверяем, находится ли позиция в запретной зоне
        local is_forbidden = false
        for _, zone in ipairs(level_data.forbidden_zones) do
            if vl_pos:distance_to_xz(zone.center) < zone.radius then
                is_forbidden = true
                break
            end
        end
        
        -- Если позиция разрешена - спавним аномалию
        if not is_forbidden then
            local section = level_data.sections[math.random(#level_data.sections)]
            local obj = olr_anoms_spawn.spawn_anom(section, level_data.radius, vl_pos, lv, gv_max, level_data.power, bit_not(0))
            
            if obj then
                spawned_count = spawned_count + 1
                xvars.rnd_anoms_count = xvars.rnd_anoms_count + 1
            end
        end
    end
    
    -- Логирование для отладки
    -- printf("Spawned %d/%d anomalies on %s", spawned_count, count, level.name())
end

-- Старые функции для обратной совместимости (можно удалить после тестирования)
function spawn_esc() spawn_anomalies(level_spawn_data.l01_escape) end
function spawn_garbage() spawn_anomalies(level_spawn_data.l02_garbage) end
function spawn_agro() spawn_anomalies(level_spawn_data.l03_agroprom) end
function spawn_dolina() spawn_anomalies(level_spawn_data.l04_darkvalley) end
function spawn_bar() spawn_anomalies(level_spawn_data.l05_bar) end
function spawn_yantar() spawn_anomalies(level_spawn_data.l07_yantar) end
function spawn_military() spawn_anomalies(level_spawn_data.l09_military) end
function spawn_radar() spawn_anomalies(level_spawn_data.l10_radar) end
function spawn_dead() spawn_anomalies(level_spawn_data.l11_deadcity) end

