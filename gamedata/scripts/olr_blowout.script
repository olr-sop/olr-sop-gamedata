function blowout_ending_set()
	if not no_blow_levels[level.name()] then
		olr.spawn_crows(20, 90)
	end

	local bc = xvars.blow_count
	bc = bc + 1
	xvars.blow_count = bc
	--news_manager.send_tip(db.actor, "Пережито "..bc.." выбросов...", nil, "dolg", 6000)

	all_blowend_funcs()

	db.actor:disable_info_portion("spawn_anoms_esc")
	db.actor:disable_info_portion("spawn_anoms_gar")
	db.actor:disable_info_portion("spawn_anoms_agr")
	db.actor:disable_info_portion("spawn_anoms_dol")
	db.actor:disable_info_portion("spawn_anoms_bar")
	db.actor:disable_info_portion("spawn_anoms_yan")
	db.actor:disable_info_portion("spawn_anoms_mil")
	db.actor:disable_info_portion("spawn_anoms_rad")
	db.actor:disable_info_portion("spawn_anoms_ded")
end

function all_blowend_funcs()
	-- на вс¤кий случай

	del_vidrosovie_arts() -- удаляет "af_mercury_ball" "af_junk_bolt" "af_magnet" "af_junk_debris" с локаций с шансом у каждого артефакта 1 к 35
	blow_info_count() -- выдаёт поршень про выбросы по условиям что мы на кордоне и притащили какой то ящик поршень medyasik_2_done, сам поршень что выдаётся высылает мессагу от жабы который спрашивает мессера мол ты живой
	set_arts_cond_after_blowout() -- проходится по онлайновым артефактам, список в функции, с шансом 50 на 50 меняет состояние артефакта на матч.рандом чёто там, если состояние ниже 0.01 удаляет артефакт
	spawen_arts_random() -- тупой спавен тупово гавна, ой артефактов в аномалиях, тупа рандомная хуйня, вырезать удалить написать нормальный, надо Рому
						 -- работает так, есть пачка аномалий, и пачка артефактов, списки в функции, идём по всем объектам, находим аномалию, далее с шансом 1 к 180 на позиции данной аномалии заспавнится рандомный артефакт из таблицы
	spawen_pseudohuman() -- лежало внутри функции выше, если пережили более 7 выбросов, то в радиоактивных зонах с шансом 1 к 580 спавнит мутанта там (кроме локации бар), список мутантов внутри функции
	spawn_esc_mil_group() -- спавн военных научных групп, спавнятся если пережили не менее 5 и не более 8 выбросов, потом не менее 12 и не более 16, потом уже не менее 25 выбросов надо пережить и спавн будет после каждого выброса
	remove_onl_anoms() -- проходится по нескольким clsid аномалий и включает их принудительно, список клсид в функции. Но это касается только онлайновых объектов, лол.

	olr_timers.st_timer("clear_dead_monsters", 12, "olr_blowout.clear_dead_monsters()") -- удаляет трупы монстров по условиям, если монстр не живой и не под защитой olr_protected и если не умерший в оффлайне и не на том же уровне на котором мы
	olr_timers.st_timer("xrs_trade_trading", 13, "xrs_trade.on_item_drop()") -- предложение поторговать, принудительно дёргает
	olr_timers.st_timer("spawen_radhlam_random", 16, "olr_blowout.spawen_radhlam_random()") -- обход по всем объектам, ищет радиоактивные зоны, с шансом 1 к 60 спавнит мусорные артефакты, список в функции
	olr_timers.st_timer("spawen_rtut_shars_random", 18, "olr_blowout.spawen_rtut_shars_random()") -- обход по всем объектам, ищет zone_mincer, с шансом 1 к 65 спавнит ртутный шар
	olr_timers.st_timer("spawen_rtut_shars", 20, "olr_blowout.spawen_rtut_shars()") -- пиздец... шанс 3 к 22, спавн ртутного шара на определенных координатах на кордоне и на свалке, 
																					-- точнее так, делаем два рандома, 1-22, если уровень кордон и выпал 1 то первые координаты, если 2 то вторые, если 3 то третьи, на свалке аналогично. главное находится там актору...
	olr_timers.st_timer("bar_alcos", 33, "olr_blowout.bar_alcos()") -- срабатывает только если актора нет в баре. Выводит в оффлайн и выводит из онлайна пьяниц фейковых что сидят в баре
																	-- сначала всех в оффлайн, потом с шансом 50 на 50 выгоняет в онлайн, всё работает по конкретному списку
																	-- потом еще добавляет бабок бармену и петренке от 1000 до 4500
	olr_timers.st_timer("clear_bolts", 44, "olr_blowout.clear_bolts()") -- с шансом 50 на 50 вызов удаления всего оружия без парента, потом если пережили более 6 выбросов
																		-- вызывает del_rnd_anoms, clear_deadinoffline_wars, потом проход по всем объектам, удаляет физ мусор, скелеты, m_pseudohuman_e мёртвых, zone_witches_galantine_banka, дезинтеграторную аномалию
																		-- (кстати надо это убрать и удалять по иному, это может вызвать проблемы), 
																		-- функция clear_deadinoffline_wars чистит всех кто помечен был мёртвым в оффлайне
																		-- функция del_rnd_anoms удаляет радиоактивные зоны, колючки, с шансом 50 на 50 но не на том уровне где мы находимся
	olr_timers.st_timer("fix_escape_restrs", 4, "olr_blowout.fix_escape_restrs()") -- если более 2 выбросов пережили, проходит по всем объектам, если это сталкер или мутант очищает у них dynamic_in_restrictions в нет-пакетах
	olr_timers.st_timer("clear_trash_wars", 59, "olr_blowout.clear_trash_wars()") -- чистит xvars foods, weapons, arts
	olr_timers.st_timer("clear_afterblow_deadnpc", 79, "olr_blowout.clear_afterblow_deadnpc()") -- если пережито более 6 выбросов проход по всем объектам, если это сталкер, не живой и не под защитой olr_protected то записываем в xvars.npc_del_afterblow
																								-- потом уборщик трупов осмотрит их инвентари и если там ничего важного нет то удалит, хуйня кароче очередная
	olr_timers.st_timer("set_walkers_rndways", 74, "olr_ai_tasks.set_walkers_rndways()") -- вызывает принудительную перетасовку смартов куда отправляются сталкеры которым выдан глобальный квест
																						 -- с шансом 50% снимает с них квест (вроде как, ну нилит npcs_tasks_rndway), я так понял потом smart_terrain если ему из квеста пришёл false тот уже сам выберет куда ему идти

	if has_alife_info("rad_first") and not has_alife_info("gen_first") then -- если были на радаре, но еще не были на генераторах, то после каждого выброса
																			-- вызываем 4 нахуй раза spawen_endgame_zombies
																			-- которая работает так
																			-- обход по всем объектам, ищет clsid.respawn везде кроме бара, там спавнит мутантов по таблице см. функцию, и вписывает их в свои охуительные костыли
		olr_blowout.spawen_endgame_zombies()
		olr_timers.st_timer("spawen_endgame_zombies1", 19, "olr_blowout.spawen_endgame_zombies()")
		olr_timers.st_timer("spawen_endgame_zombies2", 29, "olr_blowout.spawen_endgame_zombies()")
		olr_timers.st_timer("spawen_endgame_zombies3", 39, "olr_blowout.spawen_endgame_zombies()")
	end

	if xvars.blow_count > 6 and not has_alife_info("gen_first") then -- если пережили более 6 выбросов и не были на генераторах
																	 -- то проверяем что мы уже были в баре по поршню bar_dolg_propusk_done
																	 -- обходим все объекты и всех живых сталкеров, если у них есть свой смарт (т.е это не свободногуляющие где смарт ноне) strn_id ~= 65535 то записываем
																	 -- если их более 50 то не вызываем принудительный респавн, а если менее то вызываем принудительный респавн по всем респавнерам
																	 -- но я там еще добавил что шанс срабатывания принудительного респавна 1 к 15 будет у каждого респавнера
		olr_timers.st_timer("respawn_now", 79, "olr_blowout.respawn_now()")
	end

	if has_alife_info("monolit_na_kordone") then -- если мы получили поршень monolit_na_kordone то начинаем вызывать еще и эту хуету
		olr_timers.st_timer("spawen_endgame_posthuman", 39, "olr_blowout.spawen_endgame_posthuman()") -- спавнит мутантов по таблице в зонах респавна, химеры да постхуманы, проверяем валидность вертекс айди
																									  -- есть еще рандом 1 к 15 на каждый респавн что бы не слишком дохуя наспавнило
	end

	if has_alife_info("docent_zamer_vibros_done_pogo") then -- это квест с замером выброса от учёных в говне мочёных
		if not has_alife_info("docent_zamer_vibros_daem") then
			olr.info("docent_zamer_vibros_daem")
			news_manager.send_tip(db.actor, game.translate_string("all_blowend_funcs_0"), 15, "ecolog", 39000, nil, nil, true, "st_sim_test_033_name")
		end
	end
end

