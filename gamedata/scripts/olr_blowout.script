function spawen_rtut_shars()
	local sim = alife()
	local level_name = level.name()
	local noobposition = db.actor:position()
	local bol_var = math.random(1, 22)
	local bol_var2 = math.random(1, 22)
	if level_name == "l01_escape" then
		if bol_var == 1 then
			local bloodbridge = vector():set(-73.76, 2.13, 82.00)
			sim:create("af_mercury_ball", bloodbridge, db.actor:level_vertex_id(), db.actor:game_vertex_id())
			if bol_var == 2 then
				local bloodafterbridge = vector():set(137.47, 2.00, 66.03)
				sim:create("af_mercury_ball", bloodafterbridge, db.actor:level_vertex_id(), db.actor:game_vertex_id())
				if bol_var == 3 then
					local fracunderbridge = vector():set(25.91, 2.00, 316.13)
					sim:create("af_mercury_ball", fracunderbridge, db.actor:level_vertex_id(), db.actor:game_vertex_id())
				end
			end
		end
	end
	if level_name == "l02_garbage" then
		if bol_var2 == 1 then
			local bloodbridge1 = vector():set(15.54, 19.13, -321.68)
			sim:create("af_mercury_ball", bloodbridge1, db.actor:level_vertex_id(), db.actor:game_vertex_id())
			if bol_var2 == 2 then
				local bloodafterbridg1e = vector():set(8.55, 3.00, 368.84)
				sim:create("af_mercury_ball", bloodafterbridge1, db.actor:level_vertex_id(), db.actor:game_vertex_id())
			end
		end
	end
end
