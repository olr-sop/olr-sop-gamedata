function bar_alcos()
	local sim = alife()
	if level.name() == "l05_bar" then
		return
	end

	local bars_alcos = {
		"lvl5_bar_physic_object_1382",
		"lvl5_bar_physic_object_1349",
		"lvl5_bar_physic_object_0446",
		"lvl5_bar_physic_object_1350",
		"lvl5_bar_physic_object_1348",
		"lvl5_bar_physic_object_1380",
		"lvl5_bar_physic_object_0376",
		"lvl5_bar_physic_object_1382",
		"lvl5_bar_physic_object_1381"
	}

	for _, val in ipairs(bars_alcos) do
		local sobj = sim:object(val)
		if sobj then
			local id = sobj.id
			sim:set_switch_offline(id, true)
			sim:set_switch_online(id, false)
			sim:set_interactive(id, false)
		--log1("ofl")
		end
	end

	for _, val in ipairs(bars_alcos) do
		local sobj = sim:object(val)
		if sobj then
			local id = sobj.id
			if math.random(1, 2) == 1 then
				sim:set_switch_offline(id, false)
				sim:set_switch_online(id, true)
				sim:set_interactive(id, true)
			--log1("onl")
			end
		end
	end

	local bars = {
		--"lvl9_military_m_trader",
		"bar_barman",
		"bar_dolg_petrenko"
	}

	for _, val in ipairs(bars) do
		local sobj = sim:object(val)
		if sobj then
			local pk = get_netpk(sobj)
			if pk:isOk() then
				local data = pk:get()
				local sd = data.money
				data.money = sd + math.random(1000, 4500)
				pk:set(data)
			--log1("barman money - "..sd.." --- "..data.money.."")
			end
		end
	end
end

