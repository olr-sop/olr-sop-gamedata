function blowout_additional_timer()
	--log1("blowout_additional_timer ADD CAM EFFECTOR 2004")
	level.add_cam_effector("camera_effects\\shell_shock.anm", 2004, false, "")
	local snd_obj = xr_sound.get_safe_sound_object([[ambient\weather\blowout_wave_1]])
	snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
	olr_timers.st_timer("blowout_additional_timer", 10, "olr_blowout.blowout_additional_timer2()")
end

