function update_hit()
	local current_time = time_global()
	if current_time <= time_apdeyta_hit then
		return
	end
	time_apdeyta_hit = current_time + math.random(1000, 1500)

	local actor = db.actor
	if not actor:alive() then
		return
	end

	if not actor:has_info("olr_blowout_phase_2") then
		return
	end

	-- Кэшируем часто используемые значения
	local level_name = level.name()
	if no_blow_levels[level_name] then
		return
	end

	if not actor:is_actor_outdoors() then
		return
	end

	-- Проверка наличия прибора
	local iblocitm = actor:object("pribor_antivibros")
	if iblocitm then
		local new_cond = iblocitm:condition() - 0.0039
		iblocitm:set_condition(new_cond)
		if new_cond <= 0.01 then
			olr.del(iblocitm)
		end
		return
	end

	-- Проверка всех зон одним вызовом
	if xr_conditions.actor_in_zone(nil, nil, safe_zones) then
		return
	end

	-- Применение урона, если все проверки пройдены
	actor.health = -0.05
	actor.radiation = 0.065
	actor.psy_health = -0.105
	level.add_cam_effector("camera_effects\\shell_shock.anm", 1976, false, "")
end

