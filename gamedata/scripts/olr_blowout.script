function Kill_Monsters(gulag1)
	if gulag1 ~= nil then
		for k, v in pairs(gulag1.Object) do
			if level.object_by_id(k) ~= nil then
				obj = level.object_by_id(k)
				if obj:is_monster() then
					obj:kill(obj)
				end
			end
		end
	end
end
