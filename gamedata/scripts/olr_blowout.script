----------------------------------------------

function get_blow_timer()
	return xvars.blowout_timer
end

function set_blow_timer(val)
	xvars.blowout_timer = val
end

function add_blow_timer(a)
	xvars.blowout_timer = xvars.blowout_timer + a
end

function min_blow_timer(a)
	xvars.blowout_timer = xvars.blowout_timer - a
end
---------------------------------------------

function set_blow_timer_agroblow()
	if xvars.blowout_timer > 60 then
		xvars.blowout_timer = 80
	end
end

-------------------------------------------------

function on_game_load()
	if xvars.blowout_timer then
		if has_alife_info("olr_blowout_phase_0") then
			--log1("on_game_load REMOVE CAM EFFECTOR 1974")
			level.remove_cam_effector(1974)
			level.remove_cam_effector(19744)
			--log1("on_game_load REMOVE CAM EFFECTOR 1975")
			level.remove_cam_effector(1975)
			--log1("on_game_load REMOVE CAM EFFECTOR 1976")
			level.remove_cam_effector(1976)
			--log1("on_game_load REMOVE PP EFFECTOR 1974")
			level.remove_pp_effector(1974)
			--log1("on_game_load REMOVE PP EFFECTOR 2299")
			level.remove_pp_effector(2299)
			--log1("on_game_load REMOVE CAM EFFECTOR 12002")
			level.remove_cam_effector(12002)
			--log1("on_game_load REMOVE CAM EFFECTOR 22002")
			level.remove_cam_effector(22002)
			--log1("on_game_load REMOVE CAM EFFECTOR 32002")
			level.remove_cam_effector(32002)
			--log1("on_game_load REMOVE CAM EFFECTOR 42002")
			level.remove_cam_effector(42002)
			--log1("on_game_load REMOVE CAM EFFECTOR 52002")
			level.remove_cam_effector(52002)
			--news_manager.send_tip(db.actor, "афтер лоад 0", nil, "freedom", 9000)
		end

		----------

		if xvars.blowout_timer <= 60 and xvars.blowout_timer >= 40 then
			if no_blow_levels[level.name()] then
				return
			end

			if has_alife_info("sr_cutscene_start_info") then
				return
			end

			if has_alife_info("olr_blowout_ended") then
				return
			end

			level.set_weather_fx("surge")
			--log1("on_game_load ADD CAM EFFECTOR 1974")
			level.add_cam_effector("camera_effects\\earthquake.anm", 1974, true, "")
			--log1("on_game_load ADD PP EFFECTOR 1974")
			level.add_pp_effector("vibros.ppe", 1974, true)
			blowout_snd_go()

			if level.get_weather() ~= "stancia" then
				level.set_weather("levels\\stancia", true)
				--news_manager.send_tip(db.actor, game.translate_string("on_game_load_1"), nil, "freedom", 9000)
			end
		end
		----------

		if xvars.blowout_timer <= 40 and xvars.blowout_timer >= 20 then
			if has_alife_info("sr_cutscene_start_info") then
				return
			end

			if no_blow_levels[level.name()] then
				return
			end

			if has_alife_info("olr_blowout_ended") then
				return
			end

			level.set_weather_fx("surge")
			--log1("on_game_load ADD CAM EFFECTOR 1974")
			level.add_cam_effector("camera_effects\\earthquake.anm", 1974, true, "")
			--log1("on_game_load ADD PP EFFECTOR 1974")
			level.add_pp_effector("vibros.ppe", 1974, true)
			blowout_snd_go()

			if level.get_weather() ~= "stancia" then
				level.set_weather("levels\\stancia", true)
			end
			level.set_weather_fx("surge")
			--log1("on_game_load ADD CAM EFFECTOR 1974")
			level.add_cam_effector("camera_effects\\earthquake.anm", 19744, true, "")
			--news_manager.send_tip(db.actor, game.translate_string("on_game_load_2"), nil, "freedom", 9000)
		end
	end
	----------

	if xvars.blowout_timer and xvars.blowout_timer <= 20 then
		if no_blow_levels[level.name()] then
			return
		end

		if has_alife_info("sr_cutscene_start_info") then
			return
		end

		if has_alife_info("olr_blowout_ended") then
			return
		end

		level.set_weather("levels\\stancia", true)
		level.set_weather_fx("surge")
		--log1("on_game_load ADD PP EFFECTOR 1974")
		level.add_pp_effector("vibros.ppe", 1974, true)
		blowout_snd_go()
		--news_manager.send_tip(db.actor, game.translate_string("on_game_load_3"), nil, "freedom", 9000)
	end
end