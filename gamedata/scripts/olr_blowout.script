-----------------------------------------------
function set_arts_cond_after_blowout()
	local valid_sections = {
		af_bublik = true,
		af_electrosphere = true,
		af_knot = true,
		af_black_drops = true,
		af_rusty_hair = true,
		af_toadeye = true,
		af_dummy_double = true,
		af_bublik_glass = true,
		af_magnet = true,
		af_transpsphere = true,
		af_zuda = true,
		af_gravi_heavy = true,
		af_gravi_weak = true,
		af_gravi_med = true
	}
	
	for i = 1, 65534 do
		local obj = level.object_by_id(i)
		if obj ~= nil and valid_sections[obj:section()] then
			local par_var = math.random(1, 2)
			if par_var == 1 then
				obj:set_condition(obj:condition() - deletor())
				if obj:condition() <= 0.01 then
					olr.del(obj)
				end
			end
		end
	end
end

function deletor()
	return math.random(5, 85) / 100
end
