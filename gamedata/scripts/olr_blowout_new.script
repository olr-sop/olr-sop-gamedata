-- Глобальные переменные времени
local time_update = 0
local time_update_hit = 0
local timer_add_base = 1000 -- выброс займет примерно 1.5 минуты т.е 90 тиков
local blow_max = 25920 -- прмиерно 3 игровых дня

-- Таблица состояний выброса
BLOWOUT_STATES = {
	NONE = 0,		   -- Выброса нет (ничего не делается вообще)
	WARNING = 1,	   -- Фаза предупреждения (120-100 сек) (выдаются только первые звуки гула, информационные сообщения, уничтожается артефакт, записываем какая погода у нас была на уровне и храним в переменной curwweth)
	PREPARE = 2,	   -- Подготовка (100-90 сек) -- начинает меняться погода, звук начала выброса, звуки молний, первые толчки земли (shell_shock либо earthquake но сильно ослабленный), пост-эффект на экране как мир начинает становится черно-белым и слишком ярким
	MAIN = 3,		  -- Основная фаза (90-30 сек) -- землетрясение на постоянной основе (earthquake но на 75% мощности), погода уже изменена, играемся со вспышками молний, звуки выброса и молний вместе и поочередно, мир уже черно-белый, тут на репите играет отдельный пост-эффект с лупом
	ENDING = 4,		   -- Конец выброса, пиковый удар и тишина (30-10 сек) -- сильный удар (earthquake на 100-150% мощности), звуки грозы и громкие звуки пика выброса, пост эффект максимально закручивает яркость всего, в конце за 5 секунд активируем потемнение в глазах.
	FINISHED = 5	   -- Выброс завершен (10-0 сек) -- тут проигрываем звук гула и пустоты, будто бы ничего и не было, активируем функции конца таймера
}

-- Основной апдейт
function update()
	if db.actor and level.present() then
		update_val()
		update_hit()
	end
end

-- Обновление таймера выброса
function update_val()
	if not alife() then return end
	
	local current_time = time_global()
	if current_time > time_update then
		time_update = current_time + timer_add_base
		
		-- Обновление таймера выброса
		xvars.blowout_timer = xvars.blowout_timer - 1
		
		-- Ограничение и сброс таймера
		if xvars.blowout_timer > blow_max then
			xvars.blowout_timer = blow_max
		elseif xvars.blowout_timer < 1 then
			xvars.blowout_timer = blow_max
			xvars.blowout_state = BLOWOUT_STATES.NONE
		end
		
		-- Апдейт выброса
		process_blowout()
	end
end

-- Обработка урона во время выброса
function update_hit()
	if not alife() then return end
	
	local current_time = time_global()
	if current_time <= time_update_hit then return end
	time_update_hit = current_time + math.random(1000, 1500)

	local actor = db.actor
	if not actor:alive() then return end

	-- Проверяем состояние выброса
	if xvars.blowout_state < BLOWOUT_STATES.MAIN then
		return
	end

	-- Проверка локации
	local level_name = level.name()
	if no_blow_levels[level_name] then return end
	if not actor:is_actor_outdoors() then return end
	
	-- Проверка безопасных зон
	if xr_conditions.actor_in_zone(nil, nil, safe_zones) then
		return
	end	

	-- Проверка девайсом учёных с Янтаря
	local device = actor:object("pribor_antivibros")
	if device then
		local new_cond = device:condition() - 0.0039
		device:set_condition(new_cond)
		if new_cond <= 0.01 then
			olr.del(device)
		end
		return
	end

	-- Применение урона
	actor.health = -0.05
	actor.radiation = 0.065
	actor.psy_health = -0.105
	level.add_cam_effector("camera_effects\\shell_shock.anm", 11119999, false, "")
end

-- Основная функция обработки выброса
function process_blowout()

	-- Проверка условий отмены
	if no_blow_levels[level.name()] or has_alife_info("sr_cutscene_start_info") then 
		if xvars.blowout_state ~= BLOWOUT_STATES.NONE then
			xvars.blowout_state = BLOWOUT_STATES.NONE			-- переводим выброс в пустоту, хрен с катсценами
			xvars.blowout_timer = xvars.blowout_timer + 2500	-- заранее сдвигаем на всякий случай
			cleanup_blowout()
		end
		return
	end

	-- Проверка для квестовой части
	if xvars.blowout_timer >= 1200  and has_alife_info("monolit_na_kordone") and not has_alife_info("start_freeplay_olr_start") then
		olr_blowout.set_blow_timer(600)
		return
	end

	-- Определение нового состояния по таймеру
	local new_state
	
	if xvars.blowout_timer >= 120 then
		new_state = BLOWOUT_STATES.WARNING
	elseif xvars.blowout_timer >= 100 then
		new_state = BLOWOUT_STATES.PREPARE
	elseif xvars.blowout_timer >= 90 then
		new_state = BLOWOUT_STATES.MAIN
	elseif xvars.blowout_timer >= 30 then
		new_state = BLOWOUT_STATES.ENDING
	elseif xvars.blowout_timer >= 10 then
		new_state = BLOWOUT_STATES.FINISHED
	end

	-- Обработка изменения состояния
	if new_state ~= xvars.blowout_state then
		if new_state == BLOWOUT_STATES.WARNING then
			start_warning_phase()
		elseif new_state == BLOWOUT_STATES.PREPARE then
			start_prepare_phase()
		elseif new_state == BLOWOUT_STATES.MAIN then
			start_main_phase()
		elseif new_state == BLOWOUT_STATES.ENDING then
			start_ending_phase()
		elseif new_state == BLOWOUT_STATES.FINISHED then
			finish_blowout()
		end
		xvars.blowout_state = new_state
	end
end

