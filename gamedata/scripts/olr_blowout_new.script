-- Функции влияющие на ГГ

function lomka_pda() -- добавить учёт укрытия (условного)
	local slom_var = math.random(1, 3)
	if slom_var == 1 then
		local STbron = db.actor:object("device_pda")
		if STbron then
			STbron:set_condition(0.02)
		end
	end
end

function golod_gg() -- возможно убрать, фича с детей зоны
	if db.actor:alive() then
		db.actor.satiety = -db.actor.satiety / math.random(1, 5)
	end
end

function psy_gg() -- оставим пока что
	if db.actor:alive() then
		if db.actor:is_actor_outdoors() == false then
			return
		end
		db.actor.psy_health = -db.actor.psy_health / math.random(1, 5)
	end
end

--------------------------------------------------------
-- Функции отыгрыша партиклов
-- Перенести непосредственно туда где им место?
-- Рандомизировать позицию относительно ГГ!!!

function blowout_particle_start()
	if db.actor:is_actor_outdoors() == false then
		return
	end
	local pos = db.actor:position()
	local x, y, z = pos.x, pos.y, pos.z
	particles_object([[nature\vortex_01]]):play_at_pos(vector():set(x, y, z))
end

function blowout_particle_start2()
	if db.actor:is_actor_outdoors() == false then
		return
	end
	local pos = db.actor:position()
	local x, y, z = pos.x, pos.y, pos.z
	particles_object([[nature\fog_stormy_04]]):play_at_pos(vector():set(x, y, z))
end

function blowout_particle_blow()
	if db.actor:is_actor_outdoors() == false then
		return
	end
	local pos = db.actor:position()
	local x, y, z = pos.x, pos.y, pos.z
	particles_object([[nature\fog_stormy_05]]):play_at_pos(vector():set(x, y, z))
end

function blowout_particle_norm()
	if db.actor:is_actor_outdoors() == false then
		return
	end
	local pos = db.actor:position()
	local x, y, z = pos.x, pos.y, pos.z
	particles_object([[nature\tornado_01]]):play_at_pos(vector():set(x, y, z))
end

-- Функция для обработки загрузки игры
function on_game_load()
	-- Если выброс не активен - ничего не делаем
	if xvars.blowout_state == BLOWOUT_STATES.NONE then
		return
	end

	-- Не восстанавливаем выброс в подземках
	if no_blow_levels[level.name()] then
		cleanup_blowout() -- очищаем эффекты если таковы были
		return
	end
	
	-- Восстановление по фазам
	if xvars.blowout_state == BLOWOUT_STATES.WARNING then
		-- TODO Возможно повторить сообщение. Ворнинг идёт 20 секунд
		play_sound("ambient\\weather\\blowout_begin", 0.65)
	elseif xvars.blowout_state == BLOWOUT_STATES.PREPARE then
		level.set_weather("stancia", true)
		level.set_weather_fx("surge")
	elseif xvars.blowout_state == BLOWOUT_STATES.MAIN then
		level.set_weather("stancia", true)
		level.set_weather_fx("surge")
	elseif xvars.blowout_state == BLOWOUT_STATES.ENDING then
		level.set_weather("stancia", true)
		level.set_weather_fx("surge")
	end
end

----------------------------------------
-- Технические функции
----------------------------------------

function get_blow_timer()
	return xvars.blowout_timer
end

function get_blow_state()
	return xvars.blowout_state
end

function set_blow_timer(val)
	xvars.blowout_timer = val
end

function add_blow_timer(a)
	xvars.blowout_timer = xvars.blowout_timer + a
end

function min_blow_timer(a)
	xvars.blowout_timer = xvars.blowout_timer - a
end

-- Очистка эффектов
function cleanup_blowout()
	-- Камерные эффекты
	level.remove_cam_effector(11119999)
	
	-- Пост-эффекты
	level.remove_pp_effector(2299)
	
end