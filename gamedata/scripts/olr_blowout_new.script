-- Всё что вызывается из функции выше

function del_vidrosovie_arts()
	local count = 0
	local sim = alife()
	for id = 1, 65534 do
		local obj = sim:object(id)
		if obj then
			local sect = obj:section_name()
			if sect == "af_ameba_mica" or sect == "af_ameba_slime" or sect == "af_night_star" or sect == "af_ameba_slug" then
				local bol_var = math.random(1, 35)
				if bol_var == 1 then
					sim:release(obj)
					count = count + 1
				end
			end
		end
	end
	--news_manager.send_tip(db.actor,"выброс удалено " .. count .. " выбросовых артов",nil,"freedom",9000)
end

function blow_info_count()
	local level_1name = level.name()
	if level_1name == "lvl1_escape" then
		if not has_alife_info("olr_blowout_first") and has_alife_info("medyasik_2_done") then
			db.actor:give_info_portion("olr_blowout_first")
		end
	end
end

function set_arts_cond_after_blowout()
	local valid_sections = {
		af_medusa = true,
		af_electra_moonlight = true,
		af_electra_sparkler = true,
		af_soul = true,
		af_mincer_meat = true,
		af_blood = true,
		af_cristall = true,
		af_cristall_flower = true,
		af_night_star = true,
		af_fireball = true,
		af_drops = true,
		af_gold_fish = true,
		af_vyvert = true,
		af_gravi = true
	}
	
	for i = 1, 65534 do
		local obj = level.object_by_id(i)
		if obj ~= nil and valid_sections[obj:section()] then
			local par_var = math.random(1, 2)
			if par_var == 1 then
				obj:set_condition(obj:condition() - deletor())
				if obj:condition() <= 0.01 then
					olr.del(obj)
				end
			end
		end
	end
end

function deletor()
	return math.random(5, 85) / 100
end

