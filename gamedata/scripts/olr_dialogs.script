-- OLR: переработка диалога «об этом месте» (sim_dialog_about_level).
-- Тексты вариантов ответа лежат в config/text/<язык>/ui_st_about_level.xml.
-- Конвенция ID: st_sim_dialog_about_level_<локация>_<ранг>_<номер>.
-- Варианты пишутся с номера 1 и строго подряд; отсутствие строки = конец списка.
-- Если для текущей локации и ранга NPC вариантов нет — движок выберет фоллбэк «не знаю».
-- Дополнительно есть шанс rude_chance%, что NPC грубо откажется говорить,
-- и шанс ignore_chance%, что он ответит «ничего не знаю» даже при наличии текстов.
-- NPC отвечает по существу только ОДИН раз (любой исход — инфо/грубо/«не знаю» — сжигает
-- попытку). Флаг «уже спросили» хранится в db.storage[npc:id()].about_level.told и
-- сбрасывается при загрузке сейва/респавне объекта — это ожидаемое поведение.
-- На повторный вопрос отвечает пул about_level_again (st_sim_dialog_about_level_again_N).
--
-- ВАЖНО: при загрузке сейва внутри сессии движок пересоздаёт Lua-стейт (скрипты
-- переинициализируются), но C++-граф диалога живёт до выгрузки DLL и init_func
-- повторно не вызывается. Поэтому состояние (списки ID/вариантов) должно уметь
-- восстанавливаться без объекта диалога — см. rebuild_about_level_state.
-- Основной путь: вызов olr_dialogs.about_level_ensure_state() из _g.script
-- start_game_callback (по аналогии с dialog_manager.fill_phrase_table).
-- Ленивые вызовы ensure_state в экшене/прекондишенах — дешёвая подстраховка.
-- Строение состояния:
--   about_level_req            [phrase_id] = {level, rank} — для прекондишена вариантов
--   about_level_variants       [level][rank] = true — для структурного фоллбэка
--   about_level_info_list / _rude_list / _unknown_list / _again_list — списки для сборки графа

local levels = {
	"l01_escape",
	"l02_garbage",
	"l03_agroprom",
	"l04_darkvalley",
	"l04u_warlab",
	"l05_bar",
	"l06_rostok",
	"l07_yantar",
	"l08_swamp",
	"l09_military",
	"l10_radar",
	"l10u_bunker",
	"l11_deadcity",
	"l12_barrow_downs",
	"l13_pripyat",
	"l14_stancia",
	"l14u_sarcofag",
	"l15_generators"
}

local ranks_order = { "novice", "experienced", "veteran", "master" }

local max_rank_variants = 8
local max_unknown_variants = 3
local max_rude_variants = 4
local max_again_variants = 3
local rude_chance = 20
local ignore_chance = 20

local about_level_req = nil
local about_level_variants = nil
local about_level_mode = nil
local about_level_rude_count = 0
local about_level_unknown_count = 0
local about_level_again_count = 0
local about_level_info_list = nil
local about_level_rude_list = nil
local about_level_unknown_list = nil
local about_level_again_list = nil

local function add_about_level_phrase(dlg, str_id, phrase_id, precondition)
	local phr = dlg:AddPhrase(str_id, phrase_id, "0", -10000)
	if phr ~= nil then
		phr:GetPhraseScript():AddPrecondition(precondition)
	end
	return phr
end

local function about_level_mode_of(npc)
	if about_level_mode == nil or npc == nil then
		return nil
	end
	return about_level_mode[npc:id()]
end

-- Флаг «этот NPC уже отвечал про локацию» (сессионный, db.storage).
local function about_level_told(npc)
	if npc == nil then
		return false
	end
	local st = db.storage[npc:id()]
	if st == nil or st.about_level == nil then
		return false
	end
	return st.about_level.told == true
end

local function about_level_mark_told(npc)
	if npc == nil then
		return
	end
	local st = db.storage[npc:id()]
	if st == nil then
		return
	end
	if st.about_level == nil then
		st.about_level = {}
	end
	st.about_level.told = true
end

-- Сбор состояния по строковым таблицам (проба game.translate_string).
-- Не требует объекта диалога: вызывается и при построении графа, и после реинициализации Lua.
local function rebuild_about_level_state()
	about_level_req = {}
	about_level_variants = {}
	about_level_info_list = {}
	about_level_rude_list = {}
	about_level_unknown_list = {}
	about_level_again_list = {}

	local built = 0
	for _, lv in ipairs(levels) do
		for _, rk in ipairs(ranks_order) do
			for n = 1, max_rank_variants do
				local str_id = string.format("st_sim_dialog_about_level_%s_%s_%d", lv, rk, n)
				if game.translate_string(str_id) == str_id then
					break
				end
				local phrase_id = string.format("about_%s_%s_%d", lv, rk, n)
				about_level_req[phrase_id] = { level = lv, rank = rk }
				if about_level_variants[lv] == nil then
					about_level_variants[lv] = {}
				end
				about_level_variants[lv][rk] = true
				about_level_info_list[#about_level_info_list + 1] = { phrase_id = phrase_id, str_id = str_id }
				built = built + 1
			end
		end
	end

	local unknown = 0
	for n = 1, max_unknown_variants do
		local str_id = string.format("st_sim_dialog_about_level_unknown_%d", n)
		if game.translate_string(str_id) == str_id then
			break
		end
		about_level_unknown_list[#about_level_unknown_list + 1] = { phrase_id = "about_unknown_"..n, str_id = str_id }
		unknown = unknown + 1
	end
	about_level_unknown_count = unknown

	local rude = 0
	for n = 1, max_rude_variants do
		local str_id = string.format("st_sim_dialog_about_level_rude_%d", n)
		if game.translate_string(str_id) == str_id then
			break
		end
		about_level_rude_list[#about_level_rude_list + 1] = { phrase_id = "about_rude_"..n, str_id = str_id }
		rude = rude + 1
	end
	about_level_rude_count = rude

	local again = 0
	for n = 1, max_again_variants do
		local str_id = string.format("st_sim_dialog_about_level_again_%d", n)
		if game.translate_string(str_id) == str_id then
			break
		end
		about_level_again_list[#about_level_again_list + 1] = { phrase_id = "about_again_"..n, str_id = str_id }
		again = again + 1
	end
	about_level_again_count = again

	if about_level_mode == nil then
		about_level_mode = {}
	end

	return built, unknown, rude, again
end

-- Восстановление состояния после переинициализации Lua (вызывается из _g.script
-- start_game_callback, а также лениво из экшена/прекондишенов как подстраховка).
function about_level_ensure_state()
	if about_level_req == nil then
		rebuild_about_level_state()
		log1("[olr_dialogs] about_level state rebuilt")
	end
end

-- Генератор динамического графа диалога. Вызывается движком один раз на процесс
-- (shared-данные диалога), поэтому текущую локацию здесь использовать НЕЛЬЗЯ —
-- добавляются сразу все уровни, фильтрация идёт в прекондишенах в рантайме.
function init_about_level_dialog(dlg)
	local built, unknown, rude, again = rebuild_about_level_state()

	local question = dlg:AddPhrase("st_sim_dialog_about_level_q", "0", "", -10000)
	if question ~= nil then
		question:GetPhraseScript():AddAction("olr_dialogs.about_level_open")
	end

	-- Инфо/грубо/«не знаю» — любой сказанный ответ сжигает попытку NPC.
	for _, v in ipairs(about_level_info_list) do
		local phr = add_about_level_phrase(dlg, v.str_id, v.phrase_id, "olr_dialogs.about_level_precondition")
		if phr ~= nil then
			phr:GetPhraseScript():AddAction("olr_dialogs.about_level_answered")
		end
	end
	for _, v in ipairs(about_level_unknown_list) do
		local phr = add_about_level_phrase(dlg, v.str_id, v.phrase_id, "olr_dialogs.about_level_fallback")
		if phr ~= nil then
			phr:GetPhraseScript():AddAction("olr_dialogs.about_level_answered")
		end
	end
	for _, v in ipairs(about_level_rude_list) do
		local phr = add_about_level_phrase(dlg, v.str_id, v.phrase_id, "olr_dialogs.about_level_rude_precondition")
		if phr ~= nil then
			phr:GetPhraseScript():AddAction("olr_dialogs.about_level_answered")
		end
	end

	-- Пул повторного вопроса — попытку не трогает.
	for _, v in ipairs(about_level_again_list) do
		add_about_level_phrase(dlg, v.str_id, v.phrase_id, "olr_dialogs.about_level_again_precondition")
	end

	log1(string.format("[olr_dialogs] about_level phrases built: %d, unknown variants: %d, rude variants: %d, again variants: %d", built, unknown, rude, again))
end

-- Экшен фразы 0: движок вызывает его при каждом открытии диалога и ДО построения
-- списка ответов, поэтому здесь бросаем «настроение» на один разговор.
-- Если NPC уже отвечал (db.storage) — только «уже говорил».
-- Иначе порядок розыгрыша: сначала грубый отказ, затем «ничего не знаю», иначе — информация.
function about_level_open(first_speaker, second_speaker, dialog_id, phrase_id)
	about_level_ensure_state()
	if about_level_mode == nil then
		about_level_mode = {}
	end
	local npc = dialogs.who_is_npc(first_speaker, second_speaker)
	if npc == nil then
		return
	end

	local mode = nil
	if about_level_told(npc) and about_level_again_count > 0 then
		mode = "again"
	else
		local roll = math.random(100)
		local threshold = 0

		if about_level_rude_count > 0 then
			threshold = threshold + rude_chance
			if roll <= threshold then
				mode = "rude"
			end
		end

		if mode == nil and about_level_unknown_count > 0 then
			threshold = threshold + ignore_chance
			if roll <= threshold then
				mode = "ignore"
			end
		end
	end

	about_level_mode[npc:id()] = mode
end

-- Экшен фразы-ответа: любой исход (инфо/грубо/«не знаю») сжигает единственную попытку NPC.
function about_level_answered(first_speaker, second_speaker, dialog_id, phrase_id)
	local npc = dialogs.who_is_npc(first_speaker, second_speaker)
	about_level_mark_told(npc)
end

-- Прекондишен фразы-варианта: сверяем локацию и ранговый тир NPC по ID фразы.
function about_level_precondition(first_speaker, second_speaker, dialog_id, prev_phrase_id, next_phrase_id)
	about_level_ensure_state()
	local npc = dialogs.who_is_npc(first_speaker, second_speaker)
	if npc == nil then
		return false
	end
	if about_level_mode_of(npc) ~= nil then
		return false
	end
	local req = about_level_req and about_level_req[next_phrase_id]
	if req == nil then
		return false
	end
	return level.name() == req.level and ranks.get_obj_rank_name(npc) == req.rank
end

-- Прекондишен грубого ответа: действует, только если на этот разговор выпал отказ.
function about_level_rude_precondition(first_speaker, second_speaker, dialog_id, prev_phrase_id, next_phrase_id)
	about_level_ensure_state()
	local npc = dialogs.who_is_npc(first_speaker, second_speaker)
	if npc == nil then
		return false
	end
	return about_level_mode_of(npc) == "rude"
end

-- Прекондишен ответа «уже говорил»: только когда попытка уже потрачена.
function about_level_again_precondition(first_speaker, second_speaker, dialog_id, prev_phrase_id, next_phrase_id)
	about_level_ensure_state()
	local npc = dialogs.who_is_npc(first_speaker, second_speaker)
	if npc == nil then
		return false
	end
	return about_level_mode_of(npc) == "again"
end

-- Фоллбэк «ничего не знаю»: срабатывает по шансу ignore_chance (см. about_level_open)
-- либо если для локации/ранга NPC реальных вариантов нет.
function about_level_fallback(first_speaker, second_speaker, dialog_id, prev_phrase_id, next_phrase_id)
	about_level_ensure_state()
	if about_level_variants == nil then
		return false
	end
	local npc = dialogs.who_is_npc(first_speaker, second_speaker)
	if npc == nil then
		return false
	end
	local mode = about_level_mode_of(npc)
	if mode == "rude" or mode == "again" then
		return false
	end
	if mode == "ignore" then
		return true
	end
	local variants = about_level_variants[level.name()]
	return variants == nil or variants[ranks.get_obj_rank_name(npc)] == nil
end
