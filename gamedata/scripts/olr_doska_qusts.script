-- hi_flyer 21.03.16

function on_use()
    local level_name = level.name()

    if level_name == "l01_escape" then
        on_use_escape()
    end

    if level_name == "l09_military" then
        on_use_military()
    end

    if level_name == "l05_bar" then
        on_use_bar()
    end

    if level_name == "l07_yantar" then
        on_use_yantar()
    end
end

function on_use_escape()
    if not has_alife_info("kv_4_done") then
        news_manager.send_tip_new(game.translate_string("on_use_escape_0"), nil, "info")
        return
    end
    if not has_alife_info("first_doska_use_start") then
        db.actor:give_info_portion("first_doska_use_start")
        bind_stalker.hide_weapon()
        level.disable_input()
        level.add_cam_effector2("camera_effects\\scenario_cam\\escape\\esc_use_board_first_time.anm", 30, false, "")
        return
    end
    if has_alife_info("first_doska_use_start") then
        level.start_stop_menu(olr_doska_escape.ui_quests_table(), true)
    end
end

-- тут смысла нет пускать камеру, сразу меню
function on_use_bar()
    level.start_stop_menu(olr_doska_bar.ui_quests_table(), true)
end

function on_use_military()
    level.start_stop_menu(olr_doska_escape.ui_quests_table(), true)
end

function on_use_yantar()
    level.start_stop_menu(olr_doska_yan.ui_quests_table(), true)
end

----------------------------------------------------------------------------------------------------------------------------
-- Общие функции досок объявлений
----------------------------------------------------------------------------------------------------------------------------

-- подставляет $1 в переведённую строку
function translate_format(id, ...)
	local args = {...}
	local text = game.translate_string(id)
	return (string.gsub(text, "%$(%d)", function(n)
		local v = args[tonumber(n)]
		return v ~= nil and tostring(v) or ""
	end))
end

-- серверный объект цели по имени (nil если имени нет или объект удалён)
function get_target(name)
	if name == nil or name == "" then
		return nil
	end
	return alife():object(name)
end

-- имя НПС для текста
function target_name(sobj)
	if not sobj then
		return ""
	end
	return news_main.get_npc_name(sobj) or ""
end

-- описание местоположения серверного объекта
function target_pos(sobj)
	if not sobj then
		return ""
	end
	local lname = alife():level_name(game_graph():vertex(sobj.m_game_vertex_id):level_id())
	return news_main.get_point_description(lname, vector():set(sobj.position.x, sobj.position.y, sobj.position.z)) or ""
end

-- запустить таймер, если такого ещё нет
function start_timer_once(name, delay, action)
	if not olr_timers.has_timer(name) then
		olr_timers.st_timer(name, delay, action)
	end
end

-- перезапустить таймер игрового времени
function restart_game_timer(name, delay, action)
	olr_timers.del_timer(name)
	olr_timers.st_timer_game(name, delay, action)
end

-- инфопоршень "есть задание с доски" для диалогов сдачи
function update_taken_info(info, working_one, working_two)
	if has_alife_info(working_one) or has_alife_info(working_two) then
		db.actor:give_info_portion(info)
	else
		db.actor:disable_info_portion(info)
	end
end