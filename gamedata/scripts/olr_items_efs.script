-- ДВИЖКОВЫЕ ФУНКЦИИ
-- ВЫЗЫВАЮТСЯ ИЗ ДВИЖКА НЕ ТРОГАТЬ НАХ

function quick_hud_tip(item)

	local tip_text = game.translate_string("st_item_used")..": "..item:get_name()..""
	
	local hud = get_hud()
	hud:AddCustomStatic("item_used", true)
	hud:GetCustomStatic("item_used"):wnd():SetTextST(tostring(tip_text))
	hud:GetCustomStatic("item_used").m_endTime = time_global()/1000 + 3
	
	local snd = xr_sound.get_safe_sound_object([[interface\inv_slot]])
	snd:play_at_pos(db.actor, vector():set(0,0,0), 0, sound_object.s2d)
	
end

function on_quick_bandage()
	if has_alife_info("ui_inventory") then return end
	local inv_window = level.main_input_receiver()
	if inv_window and inv_window:IsShown() then
		return
	end
	local bandage = db.actor:object("bandage")
	if bandage ~= nil then
		db.actor:eat(bandage)
		quick_hud_tip(bandage)
	end
end

function on_quick_medkit()
	if has_alife_info("ui_inventory") then return end
	
	local inv_window = level.main_input_receiver()
	if inv_window and inv_window:IsShown() then
		return
	end
	
	local medkit = db.actor:object("medkit")
	if medkit ~= nil then
		db.actor:eat(medkit)
		quick_hud_tip(medkit)
	end
end