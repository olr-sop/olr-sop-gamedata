function af_grav()
    local snd_obj = xr_sound.get_safe_sound_object([[anomaly\mosquito_bald_idle]])
    snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
end


function af_elec()
    local snd_obj = xr_sound.get_safe_sound_object([[anomaly\electra_hit]])
    snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
end

