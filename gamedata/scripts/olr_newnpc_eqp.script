local skip_npc_names = {
    bar_barman = true,
	lvl1_escape_stalker_0030 = true,
}

-- функция для получения первого класса патронов
local function get_ammo_class(weapon_section)
	local weapon_ammo_class = utils.cfg_get_string(ini_sys, weapon_section, "ammo_class", weapon_section, false, "", "")
	if not weapon_ammo_class or weapon_ammo_class == "" then return nil end
	local ammo_section = amk.str_explode(",", weapon_ammo_class)
	return ammo_section[1]	
end

-- таблица соответствия группировок
local faction_groups = {
    deads = "bandit", 
	sin = "bandit", 
	lastday = "bandit",
    stranger = "stalker", 
	neutral = "stalker", 
	zombied = "stalker",
    sky = "ecologs", 
	iskateli = "ecologs", 
	voenstals = "military",
    bandit = "bandit", 
	stalker = "stalker", 
	ecolog = "ecologs", 
    military = "military", 
	sliznyaki = "sliznyaki", 
	dolg = "dolg",
    freedom = "freedom", 
	killer = "killer", 
	monolith = "monolith"
}

local function get_main_faction(community)
    return faction_groups[community] or "stalker"
end

local function get_rank_key(rank)
    if rank <= 300 then return "novice"
    elseif rank <= 600 then return "experienced"
    elseif rank <= 900 then return "veteran"
    else return "master" end
end

local function select_weapon(weapons)
    if not weapons or #weapons == 0 then return nil end
    if #weapons == 1 then return weapons[1].section end
    
    local rand = math.random()
    for i = 1, #weapons do
        if rand < weapons[i].prob then
            return weapons[i].section
        end
        rand = rand - weapons[i].prob
    end
    return weapons[1].section
end

-- Основная функция
function on_spawn(obj)
    if not obj then return end
	
	if skip_npc_names[obj:name()] then
		log1("### [INFO] olr_newnpc_eqp: skip npc - "..tostring(obj:name()).."")
		return
	end
	
	log1("### [INFO] olr_newnpc_eqp: Called euqip: name - "..tostring(obj:name())..", faction - "..tostring(obj:community())..", rank - "..tostring(get_rank_key(obj:rank())).."")
    
    local main_faction = get_main_faction(obj:community())
    local weapons = weapon_tables[main_faction] or weapon_tables.stalker
    weapons = weapons[get_rank_key(obj:rank())]
    if not weapons then return end
    
    -- Выдача оружия
    local function give_weapon(weapon_list)
        if not weapon_list or #weapon_list == 0 then return end
        local weapon_section = select_weapon(weapon_list)
        if not weapon_section then return end
        log1("### [INFO] olr_newnpc_eqp: Create weapon - "..tostring(weapon_section).."")
        alife():create(weapon_section, obj.position, obj.m_level_vertex_id, obj.m_game_vertex_id, obj.id)
        local ammo_class = get_ammo_class(weapon_section)
        if ammo_class then
			log1("### [INFO] olr_newnpc_eqp: Create ammo "..tostring(ammo_class).." for "..tostring(weapon_section).."")
            alife():create(ammo_class, obj.position, obj.m_level_vertex_id, obj.m_game_vertex_id, obj.id)
        end
    end
    
    give_weapon(weapons.first)
    give_weapon(weapons.second)
end