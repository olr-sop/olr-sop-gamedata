function ecologs_neutral_task_select()
	if db.actor then
		--log1("! ecologs_neutral_task_select: function called")
		local montabl = {
			[clsid.script_stalker] = true
		}

		local sim = alife()
		--log1("! ecologs_neutral_task_select: alife() called, sim = " .. tostring(sim))
		
		for id = 1, 65534 do
			--log1("! ecologs_neutral_task_select: processing id = " .. tostring(id))
			local kill = sim:object(id)
			
			if kill then
				--log1("! ecologs_neutral_task_select: found object with id = " .. tostring(id) .. ", clsid = " .. tostring(kill:clsid()))
				
				if montabl[kill:clsid()] then
					--log1("! ecologs_neutral_task_select: object is a stalker")
					
					if not kill.online then
						--log1("! ecologs_neutral_task_select: object is offline")
						
						if kill:alive() then
							--log1("! ecologs_neutral_task_select: object is alive")
							
							if kill:community() == "ecolog" then
								--log1("! ecologs_neutral_task_select: object has community 'ecolog'")
								local strn_id = kill:smart_terrain_id()
								
								if strn_id ~= 65535 then
									--log1("! ecologs_neutral_task_select: object has smart_terrain_id = " .. tostring(strn_id))
									local rnd = math.random(1, 2)
									--log1("! ecologs_neutral_task_select: random roll = " .. tostring(rnd))
									
									if rnd == 1 then
										--log1("! ecologs_neutral_task_select: found object with id = " .. tostring(id) .. ", clsid = " .. tostring(kill:clsid()))
										--log1("! ecologs_neutral_task_select: selected for migration")
										local params = amk.read_stalker_params(kill)
										params.custom = ""
										amk.write_stalker_params(params, kill)
										--log1("! ecologs_neutral_task_select: cleared custom params")
										
										smart_terrain.unregister_npc(kill)
										--log1("! ecologs_neutral_task_select: unregistered from smart terrain")
										
										--log1("! ecologs_neutral_task_select: try to set can_choose_alife_tasks")
										--if kill:brain():can_choose_alife_tasks() then log1("! ecologs_neutral_task_select: can_choose_alife_tasks return true") else log1("! ecologs_neutral_task_select: return false") end
										kill:brain():can_choose_alife_tasks(true)
										--log1("! ecologs_neutral_task_select: try update brain")

										--log1("! stalkers_neutral_task_select: try update brain")
										run_safely(
											function() kill:brain():update() end,
											"! olr_offline_task Error in brain update"
										)
										--log1("! stalkers_neutral_task_select: updated brain")

										--log1("! ecologs_neutral_task_select: updated brain")
										--log1("! ecologs_neutral_task_select: try clear restrictors")
										olr.clear_restrictors(kill)
										--log1("! ecologs_neutral_task_select: cleared restrictors")
										
										local params = amk.read_stalker_params(kill)
										local rand_kill = ecologs_smarts[math.random(#ecologs_smarts)]
										local rand_ki = game.translate_string(rand_kill)
										--log1("! ecologs_neutral_task_select: selected smart terrain - " .. rand_ki)
										
										local b = "\n[smart_terrains]\n" .. rand_ki .. " = true\n"
										local stng_full = game.translate_string(b)
										params.custom = stng_full
										amk.write_stalker_params(params, kill)
										--log1("! ecologs_neutral_task_select: updated custom params with new smart terrain")
										
										local params = amk.read_stalker_params(kill)
										local a = params.custom
										--log1("! ecologs_neutral_task_select: final custom data for " .. kill:name() .. " --- " .. a)
									else
										--log1("! ecologs_neutral_task_select: random roll != 1, skipping")
									end
								else
									--log1("! ecologs_neutral_task_select: smart_terrain_id == 65535, skipping")
								end
							else
								--log1("! ecologs_neutral_task_select: community is not 'ecolog', skipping")
							end
						else
							--log1("! ecologs_neutral_task_select: object is not alive, skipping")
						end
					else
						--log1("! ecologs_neutral_task_select: object is online, skipping")
					end
				else
					--log1("! ecologs_neutral_task_select: object is not a stalker, skipping")
				end
			else
				--log1("! ecologs_neutral_task_select: no object with id = " .. tostring(id))
			end
		end
	else
		--log1("! ecologs_neutral_task_select: db.actor not found, exiting")
	end
end

