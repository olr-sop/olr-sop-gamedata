			"lvl5_bar_smart_terrain_0034",
			"lvl5_bar_smart_terrain_0035",
			"lvl5_bar_smart_terrain_0036"
		}

		local montabl = {
			[clsid.zombie_s] = true,
			[clsid.zombie] = true
		}

		local sim = alife()
		--log1("! zombies_task_select: alife() called, sim = " .. tostring(sim))
		
		for id = 1, 65534 do
			--log1("! zombies_task_select: processing id = " .. tostring(id))
			local kill = sim:object(id)
			
			if kill then
				--log1("! zombies_task_select: found object with id = " .. tostring(id) .. ", clsid = " .. tostring(kill:clsid()))
				
				if montabl[kill:clsid()] then
					--log1("! zombies_task_select: object is a zombie")
					
					if not kill.online then
						--log1("! zombies_task_select: object is offline")
						
						if kill:alive() then
							--log1("! zombies_task_select: object is alive")
							local strn_id = kill:smart_terrain_id()
							
							if strn_id ~= 65535 then
								--log1("! zombies_task_select: object has smart_terrain_id = " .. tostring(strn_id))
								local rnd = math.random(1, 2)
								--log1("! zombies_task_select: random roll = " .. tostring(rnd))
								
								if rnd == 1 then
									--log1("! zombies_task_select: selected for migration")
									smart_terrain.unregister_npc(kill)
									--log1("! zombies_task_select: unregistered from smart terrain")
									
									kill:brain():can_choose_alife_tasks(true)
									--log1("! zombies_task_select: enabled alife tasks")
									
									olr.clear_restrictors(kill)
									--log1("! zombies_task_select: cleared restrictors")
									
									local pk = xs_netpk.monster(kill)
									if pk:isOk() then
										--log1("! zombies_task_select: xs_netpk is OK")
										local data = pk:get()
										local cd = data.custom_data:getTable()
										cd.smart_terrains = {["zombies_smarts[math.random(#zombies_smarts)]"] = "true"}
										data.custom_data:set(cd)
										pk:set(data)
										--log1("! zombies_task_select: updated custom data")
									else
										--log1("! zombies_task_select: xs_netpk is not OK")
									end
								else
									--log1("! zombies_task_select: random roll != 1, skipping")
								end
							else
								--log1("! zombies_task_select: smart_terrain_id == 65535, skipping")
							end
						else
							--log1("! zombies_task_select: object is not alive, skipping")
						end
					else
						--log1("! zombies_task_select: object is online, skipping")
					end
				else
					--log1("! zombies_task_select: object is not a zombie, skipping")
				end
			else
				--log1("! zombies_task_select: no object with id = " .. tostring(id))
			end
		end
	else
		--log1("! zombies_task_select: db.actor not found, exiting")
	end
end

function dolgs_task_select()
	if db.actor then
		--log1("! dolgs_task_select: function called")
		if bind_stalker.actor_in_sleep == true then
			--log1("! dolgs_task_select: actor is sleeping, exiting")
			return
		end

		local dolgs_smarts = {
			"lvl1_escape_smart_terrain_0037",
			"lvl2_garbage_smart_terrain_0034",
			"lvl3_agroprom_smart_terrain_0025",
			"lvl4_darkdolina_smart_terrain_0016",
			"bar_dolg_bunker",
			"lvl5_bar_smart_terrain_united_dolg_stalkers_0000",
			"lvl5_bar_smart_terrain_united_dolg_stalkers"
		}

		local montabl = {
			[clsid.script_stalker] = true
		}

		local sim = alife()
		--log1("! dolgs_task_select: alife() called, sim = " .. tostring(sim))
		
		for id = 1, 65534 do
			--log1("! dolgs_task_select: processing id = " .. tostring(id))
			local kill = sim:object(id)
			
			if kill then
				--log1("! dolgs_task_select: found object with id = " .. tostring(id) .. ", clsid = " .. tostring(kill:clsid()))
				
				if montabl[kill:clsid()] then
					--log1("! dolgs_task_select: object is a stalker")
					
					if not kill.online then
						--log1("! dolgs_task_select: object is offline")
						
						if kill:alive() then
							--log1("! dolgs_task_select: object is alive")
							
							if kill:community() == "dolg" then
								--log1("! dolgs_task_select: object has community 'dolg'")
								local strn_id = kill:smart_terrain_id()
								
								if strn_id ~= 65535 then
									--log1("! dolgs_task_select: object has smart_terrain_id = " .. tostring(strn_id))
									local rnd = math.random(1, 2)
									--log1("! dolgs_task_select: random roll = " .. tostring(rnd))
									
									if rnd == 1 then
										--log1("! dolgs_task_select: selected for migration")
										local params = amk.read_stalker_params(kill)
										params.custom = ""
										amk.write_stalker_params(params, kill)
										--log1("! dolgs_task_select: cleared custom params")
										
										smart_terrain.unregister_npc(kill)
										--log1("! dolgs_task_select: unregistered from smart terrain")
										
										kill:brain():can_choose_alife_tasks(true)
										
										run_safely(
											function() kill:brain():update() end,
											"! olr_offline_task Error in brain update"
										)
										--log1("! dolgs_task_select: updated brain")
										
										olr.clear_restrictors(kill)
										--log1("! dolgs_task_select: cleared restrictors")
										
										local params = amk.read_stalker_params(kill)
										local rand_kill = dolgs_smarts[math.random(#dolgs_smarts)]
										local rand_ki = game.translate_string(rand_kill)
										--log1("! dolgs_task_select: selected smart terrain - " .. rand_ki)
										
										local b = "\n[smart_terrains]\n" .. rand_ki .. " = true\n"
										local stng_full = game.translate_string(b)
										params.custom = stng_full
										amk.write_stalker_params(params, kill)
										--log1("! dolgs_task_select: updated custom params with new smart terrain")
									else
										--log1("! dolgs_task_select: random roll != 1, skipping")
									end
								else
									--log1("! dolgs_task_select: smart_terrain_id == 65535, skipping")
								end
							else
								--log1("! dolgs_task_select: community is not 'dolg', skipping")
							end
						else
							--log1("! dolgs_task_select: object is not alive, skipping")
						end
					else
						--log1("! dolgs_task_select: object is online, skipping")
					end
				else
					--log1("! dolgs_task_select: object is not a stalker, skipping")
				end
			else
				--log1("! dolgs_task_select: no object with id = " .. tostring(id))
			end
		end
	else
		--log1("! dolgs_task_select: db.actor not found, exiting")
	end
end