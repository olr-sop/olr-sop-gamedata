-- Функция для обработки людей (сталкеров)
local function process_human_migration(community, smart_terrains_table)
    if not db.actor or db.actor:is_actor_sleeping() then
        return
    end

    local sim = alife()
    
    for id = 1, 65534 do
        local npc = sim:object(id)
        
        if npc and npc:clsid() == clsid.script_stalker and not npc.online and npc:alive() then
            if community and npc:community() ~= community then
                -- Пропускаем если сообщество не совпадает
            else
                local strn_id = npc:smart_terrain_id()
                if strn_id ~= 65535 and math.random(1, 2) == 1 then
                    -- Обработка сталкеров
					--log1("~ olr_offline_task stalkers start")
                    local params = amk.read_stalker_params(npc)
					--log1("~ olr_offline_task get custom from stalker - "..tostring(params.custom).."")
                    params.custom = ""
                    amk.write_stalker_params(params, npc)
                    
                    smart_terrain.unregister_npc(npc)
                    npc:brain():can_choose_alife_tasks(true)
                    
					if npc and npc:brain() then
						npc:brain():update()
					else
						log1("~ [WARN] npc brain is nil, skipping update")
					end
                    
                    olr.clear_restrictors(npc)
                    
                    local rand_smart = smart_terrains_table[math.random(#smart_terrains_table)]
                    local custom_data = "\n[smart_terrains]\n" .. rand_smart .. " = true\n"
                    
                    params = amk.read_stalker_params(npc)
                    params.custom = custom_data
                    amk.write_stalker_params(params, npc)
					
					params = amk.read_stalker_params(npc)
					--log1("~ olr_offline_task get custom from stalker after editing - "..tostring(params.custom).."")
					
					--log1("~ olr_offline_task end")
                end
            end
        end
    end
end

-- Функция для обработки монстров (собаки и зомби)
local function process_monster_migration(monster_type, smart_terrains_table, extra_condition)
    if not db.actor or db.actor:is_actor_sleeping() then
        return
    end

    local class_ids = {}
    if monster_type == "dog" then
        class_ids[clsid.dog_s] = true
    elseif monster_type == "zombie" then
        class_ids[clsid.zombie_s] = true
        class_ids[clsid.zombie] = true
    end

    local sim = alife()
    
    for id = 1, 65534 do
        local npc = sim:object(id)
        
        if npc and class_ids[npc:clsid()] and not npc.online and npc:alive() then
            -- Проверка дополнительных условий
            if extra_condition and not extra_condition(npc) then
                -- Пропускаем если условие не выполняется
            else
                local strn_id = npc:smart_terrain_id()
                if strn_id ~= 65535 and math.random(1, 2) == 1 then
                    --log1("~ olr_offline_task mutants start")
                    -- Обработка монстров
                    smart_terrain.unregister_npc(npc)
                    npc:brain():can_choose_alife_tasks(true)
                    olr.clear_restrictors(npc)
                    
                    local pk = get_netpk(npc, 1)
                    if pk:isOk() then
                        local data = pk:get()
                        local cd = data.custom_data:getTable()
                        --local cd_strng = data.custom_data:getString()
                        
                        --log1("~ olr_offline_task get custom from mutant:")
                        --log1("~ Full custom_data table: " .. table_to_string(cd))
                        --log1("~ smart_terrains value: \n" .. table_to_string(cd.smart_terrains or {}))
                        
                        local rand_smart = smart_terrains_table[math.random(#smart_terrains_table)]
                        cd.smart_terrains = { [rand_smart] = "true" }
                        data.custom_data:set(cd)
                        pk:set(data)
                        
                        --local cd_strng_after = data.custom_data:getTable()
                        --log1("~ olr_offline_task get custom from mutant after editing:")
                        --log1("~ Updated smart_terrains: \n" .. table_to_string(cd_strng_after.smart_terrains or {}))
                    end
                    
                    --log1("~ olr_offline_task mutants end")
                end
            end
        end
    end
end

-- Функции для каждого типа NPC
function ecologs_neutral_task_select()
    process_human_migration("ecolog", ecologs_smarts)
end

function bandits_neutral_task_select()
    process_human_migration("bandit", bandits_smarts)
end

function stalkers_neutral_task_select()
    process_human_migration("stalker", neutral_smarts)
end

function dolgs_task_select()
    process_human_migration("dolg", dolgs_smarts)
end

function dogs_task_select()
    local function dog_condition(npc)
        return npc.level_name ~= "lvl5_bar"
    end
    process_monster_migration("dog", dog_smarts, dog_condition)
end

function zombies_task_select()
    process_monster_migration("zombie", zombies_smarts)
end