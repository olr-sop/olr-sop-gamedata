		 [1] = {name = "wpn_lr300",                ammo = "ammo_5.56x45_ap"},
		 [2] = {name = "wpn_mp5", 		   ammo = "ammo_5.56x45_ap"},

		 [3] = {name = "wpn_akms", 	   ammo = "ammo_5.45x39_ap"},

		 [4] = {name = "wpn_groza", 	   ammo = "ammo_9x39_ap"},

		 [5] = {name = "wpn_wincheaster1300", 	   ammo = "ammo_12x76_dart"},
		 [6] = {name = "wpn_toz34", 	   	ammo = "ammo_12x76_dart"},

		 [7] = {name = "wpn_svd", 	   	ammo = "ammo_7.62x54_7h14"},
		 [8] = {name = "wpn_svu", 	   	ammo = "ammo_7.62x54_7h14"},
		 [9] = {name = "wpn_val", 	   	ammo = "ammo_9x39_ap"},
		 [10] = {name = "wpn_vintorez", 	   	ammo = "ammo_9x39_ap"},

		 [11] = {name = "wpn_fn2000", 	   	ammo = "ammo_5.56x45_ap"},
		 [12] = {name = "wpn_g36", 	   	ammo = "ammo_5.56x45_ap"},
