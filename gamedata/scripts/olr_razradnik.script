-- Юзаем разрядник
-- hi_flyer 11.06.15 

local excluded_sections = {
	["zone_flame_small"] = true,
	["zone_rusty_hair"] = true,
	["zone_burning_fuzz"] = true,
	["zone_burning_fuzz_weak"] = true,
	["zone_burning_fuzz_average"] = true,
	["zone_burning_fuzz_strong"] = true
}

local dist = 10

function on_use()
	local actor_pos = db.actor:position()
	local tab_anoms = {}
	
	for i = 1, 65534 do
		local anom = level.object_by_id(i)
		if anom and anom:is_anomaly() then
			-- Проверка исключенных секций через таблицу
			if not excluded_sections[anom:section()] then
				if anom:position():distance_to(actor_pos) < dist then
					table.insert(tab_anoms, anom)
				end
			end
			
			-- Специальная обработка для конкретной аномалии
			if anom:name() == "lvl1_escape_zone_mosquito_bald_weak_noart" and 
			   db.actor:has_info("esc_trader_about_anomalies_razradit") then
				db.actor:give_info_portion("esc_trader_about_anomalies_razradit_disable")
				olr.del_by_name("lvl1_escape_zone_mosquito_bald_weak_noart")
			end
		end
	end

	-- Обработка найденных аномалий
	for _, o in ipairs(tab_anoms) do
		if o then
			level.add_pp_effector("blink.ppe", 20131, false)
			o:disable_anomaly()
			-- log1("disable - "..o:name().."")
		end
	end
end