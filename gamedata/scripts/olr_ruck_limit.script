-- hi_flyer 09/04/16

local drop_cur = 0
cur_amount = 0
max_item_amount = bind_stalker.GetBaseWeight()
local ini = system_ini()

local tup10000 = 0
local tmerup10000 = 1250

tab_objs_on_slots = {}
tab_objs_on_ruck = {}

local cur_outfit = -1

function take_item(obj)
end

function tmr_drop______old(obj)
	if obj == nil then
		return
	end
	local wait_time = 0
	wait_time = time_global() + 200
	level.add_call(
		function()
			return time_global() > wait_time
		end,
		function()
			db.actor:drop_item(obj)
		end
	)
	if has_alife_info("ui_car_body") then
		local inv_window = level.main_input_receiver()
		if inv_window and inv_window:IsShown() then
			level.start_stop_menu(inv_window, true)
		end
	end
end

function tmr_drop(obj)
	if obj == nil then
		return
	end
	if xvars.pos_x == 0 then
		xvars.pos_x = db.actor:position().x
	end
	if xvars.pos_y == 0 then
		xvars.pos_y = db.actor:position().y
	end
	if xvars.pos_z == 0 then
		xvars.pos_z = db.actor:position().z
	end
	xvars.item_drop_inv[obj:name()] = true
end

local artefact_classes_table = {
	[clsid.artefact] = true,
	[clsid.art_gravi] = true,
	[clsid.art_galantine] = true,
	[clsid.art_rusty_hair] = true,
	[clsid.art_electric_ball] = true,
	[clsid.art_faded_ball] = true,
	[clsid.art_thorn] = true,
	[clsid.art_zuda] = true,
	[clsid.art_dummy] = true,
	[clsid.art_gravi_black] = true,
	[clsid.art_bast_artefact] = true,
	[clsid.art_needles] = true,
	[clsid.art_black_drops] = true,
	[clsid.art_mercury_ball] = true
}

function isArtefact(item)
	return artefact_classes_table[item:clsid()]
end

function upd_drop()
	if not alife() then
		return
	end
	if time_global() > tup10000 then
		tup10000 = time_global() + tmerup10000
		if db.actor == nil then
			return
		end
		db.actor:iterate_inventory(
			function(_, obj)
				if obj then
					if xvars.item_drop_inv[obj:name()] == true then
						local pos = vector():set(xvars.pos_x, xvars.pos_y, xvars.pos_z)
						local dist = db.actor:position():distance_to_sqr(pos)
						if (get_actor_obj().state.walk or get_actor_obj().state.run) and dist > 2 and cur_amount > max_item_amount then
							xvars.item_drop_inv[obj:name()] = nil
							xvars.pos_x = 0
							xvars.pos_y = 0
							xvars.pos_z = 0
							local item_name = obj:get_name()
							if isArtefact(obj) and system_ini():line_exist(obj:section(), "known_info") then
								-- свойства
								local known_inf = system_ini():r_string(obj:section(), "known_info")
								if not has_alife_info(known_inf) then
									item_name = game.translate_string("ui_st_unknown_art_name")
								end
							end
							if tab_objs_on_slots[tostring(obj:id())] == nil then
								news_manager.send_tip(db.actor, game.translate_string("olr_ruck_limit_not_enough_space_for").." "..item_name..".", nil, "act", 3000)
								db.actor:drop_item(obj)
							end
							if has_alife_info("ui_car_body") then
								local inv_window = level.main_input_receiver()
								if inv_window and inv_window:IsShown() then
									level.start_stop_menu(inv_window, true)
								end
							end
						end
					end
				end
			end
		)
	end
end

function on_netspawn()
	local wait_time = 0
	wait_time = time_global() + 900
	level.add_call(
		function()
			return time_global() > wait_time
		end,
		function()
			olr_ruck_limit.recheck_limit()
		end
	)
end

function recheck_limit()
	local outfit = db.actor:get_current_outfit()
	if outfit then
		cur_outfit = outfit:id()
		--log1("current cur_outfit id - "..cur_outfit.." ")
		local val_add = ini:line_exist(outfit:section(), "item_amount_add") and ini:r_float(outfit:section(), "item_amount_add") or 0
		max_item_amount = max_item_amount + val_add
	end
	--log1("пересчитывем всё по норме")
	local all_amount = 0
	local slot_belt_amount = 0
	db.actor:iterate_inventory(
		function(actor, obj)
			if obj then
				local val = ini:line_exist(obj:section(), "item_amount") and ini:r_float(obj:section(), "item_amount") or 0
				all_amount = all_amount + val
			end
			if obj and db.actor:is_on_belt(obj) or db.actor:is_in_slot(obj) then
				local val = ini:line_exist(obj:section(), "item_amount") and ini:r_float(obj:section(), "item_amount") or 0
				slot_belt_amount = slot_belt_amount + val
				if tab_objs_on_slots[tostring(obj:id())] == nil then
					tab_objs_on_slots[tostring(obj:id())] = true
					--log1("добавляем с таблицу в СЛОТЕ ПОЯС нетспавн "..obj:name().."")
				end
			end
			if obj and tab_objs_on_slots[tostring(obj:id())] == nil then -- заполняем таблицу предметов в рюкзаке проверяя по отсутствию онных на поясе или слотах
				if tab_objs_on_ruck[tostring(obj:id())] == nil then
					tab_objs_on_ruck[tostring(obj:id())] = true
				end
			end
		end
	)
	local ruck_amount = all_amount - slot_belt_amount
	cur_amount = ruck_amount
	--log1("полный объем - "..all_amount.." ")
	--log1("объем в слотах - "..slot_belt_amount.." ")
	--log1("объем в рюкзаке - "..ruck_amount.." ")
end

function drop_item_on_inv(obj)
	--log1("called drop_item_on_inv")
	if db.actor.health == 0 then
		return
	end
	if device().precache_frame > 1 then
		return
	end
	if obj ~= nil then
		if ini:line_exist(obj:section(), "item_amount") then
			local val = ini:r_float(obj:section(), "item_amount") or 0
			if tab_objs_on_slots[tostring(obj:id())] == true then
				--log1("drop_item_on_inv кидаем со слота - не уменьшаем объем cur_amount")
				forced_drop_outfit(obj) -- доп проверка на дроп костюма со слота
			else
				--log1("drop_item_on_inv кидаем с рюкзака УМЕНЬШАЕМ ОБЪЕМ cur_amount")
				cur_amount = cur_amount - val
				if cur_amount < 0 then
					--cur_amount = 0
				end
			end
		end
	end
	if tab_objs_on_slots[tostring(obj:id())] ~= nil then
		tab_objs_on_slots[tostring(obj:id())] = nil
		--log1("drop_item_on_inv удаляем с таблицы В СЛОТЕ")
	end
	if tab_objs_on_ruck[tostring(obj:id())] ~= nil then
		tab_objs_on_ruck[tostring(obj:id())] = nil
		--log1("drop_item_on_inv удаляем с таблицы В РЮКЗАКЕ")
	end
	--log1("end drop_item_on_inv")
	olr_ui_inv_acinfo.repaint()
end


function obj_to_ruck(obj)
	--log1("called obj_to_ruck")
	if db.actor.health == 0 then
		return
	end
	if device().precache_frame > 1 then
		return
	end
	if obj then
		--log1("obj_to_ruck add - "..obj:name().."")
		if ini:line_exist(obj:section(), "item_amount") then
			local val = ini:r_float(obj:section(), "item_amount") or 0
			if tab_objs_on_slots[tostring(obj:id())] == true then
				--log1("obj_to_ruck ложим со слота в рюкзак уменьшаем объем")
				cur_amount = cur_amount + val
				if cur_amount > max_item_amount then
					if not db.actor:is_talking() then
						drop_cur = string.format("%1.0f", cur_amount)
						if device().precache_frame > 1 then
							return
						end

						olr_ruck_limit.tmr_drop(obj)
					end
				end
			else
				--log1("obj_to_ruck ложим с земли в рюкзак")
				cur_amount = cur_amount + val
				if cur_amount > max_item_amount then
					if not db.actor:is_talking() then
						drop_cur = string.format("%1.0f", cur_amount)
						if device().precache_frame > 1 then
							return
						end

						olr_ruck_limit.tmr_drop(obj, true)
						local item_name = obj:get_name()
						if isArtefact(obj) and system_ini():line_exist(obj:section(), "known_info") then
							-- свойства
							local known_inf = system_ini():r_string(obj:section(), "known_info")
							if not has_alife_info(known_inf) then
								item_name = game.translate_string("ui_st_unknown_art_name")
							end
						end
						olr.hud_tip("",game.translate_string("st_olr_ruck_limit_not_enough_space").." "..item_name..game.translate_string("st_olr_ruck_limit_not_enough_space_2").." "..drop_cur.." / "..tostring(max_item_amount).."", 6)
					end
				end
			end
		end
	end

	if obj:id() == cur_outfit then
		cur_outfit = -1
		--log1("obj_to_ruck сняли броню ")
		local val_add = ini:line_exist(obj:section(), "item_amount_add") and ini:r_float(obj:section(), "item_amount_add") or 0
		max_item_amount = max_item_amount - val_add
	end
	
	if tab_objs_on_slots[tostring(obj:id())] ~= nil then
		tab_objs_on_slots[tostring(obj:id())] = nil
		--log1("obj_to_ruck удаляем с таблицы В СЛОТЕ")
	end
	
	if tab_objs_on_ruck[tostring(obj:id())] == nil then
		tab_objs_on_ruck[tostring(obj:id())] = true -- добавляем в таблицу рюкзака предмет
		--log1("obj_to_ruck добавляем в таблицу В РЮКЗАК")
	end	

	olr_ui_inv_acinfo.repaint()
end

-- кладём в ящик
function on_to_box(obj)
	--log1("called on_to_box")
	if obj:id() == cur_outfit then
		cur_outfit = -1
		--log1("on_to_box сняли броню ")
		local val_add = ini:line_exist(obj:section(), "item_amount_add") and ini:r_float(obj:section(), "item_amount_add") or 0
		max_item_amount = max_item_amount - val_add
	end
	olr_ui_inv_acinfo.repaint()
end

function take_item_on_belt(obj)
	--log1("called take_item_on_belt")
	if db.actor.health == 0 then
		return
	end
	if device().precache_frame > 1 then
		return
	end
	if tab_objs_on_slots[tostring(obj:id())] == nil then
		tab_objs_on_slots[tostring(obj:id())] = true
		--log1("take_item_on_belt добавляем в таблицу в слоте")
	end
	if tab_objs_on_ruck[tostring(obj:id())] ~= nil then
		tab_objs_on_ruck[tostring(obj:id())] = nil
		--log1("take_item_on_belt удаляем с таблицы рюкзака, перенесли в слот")
	end		
	if obj ~= nil then
		if ini:line_exist(obj:section(), "item_amount") then
			local val = ini:r_float(obj:section(), "item_amount") or 0
			cur_amount = cur_amount - val
			if cur_amount < 0 then
				--cur_amount = 0
			end
			--news_manager.send_tip(db.actor, "текущий объём "..cur_amount.." сейчас.", nil, "default", 9000)
		end
	end
	olr_ui_inv_acinfo.repaint()
end

function take_item_on_slot(obj)
	--log1("called take_item_on_slot")
	if db.actor.health == 0 then
		return
	end
	if device().precache_frame > 1 then
		return
	end

	if tab_objs_on_slots[tostring(obj:id())] == nil then
		tab_objs_on_slots[tostring(obj:id())] = true
		--log1("take_item_on_slot добавляем в таблицу в СЛОТЕ "..obj:name().."")
	end

	if obj ~= nil and tab_objs_on_ruck[tostring(obj:id())] ~= nil then -- теперь если предмет имеется в таблице рюкзака то мы вычитаем объем предмета
																	   -- если же предмета нет в этой таблице т.е оно вернёт нам nil то мы пропускает этот момент и думаем что мы подняли предмет с земли
																	   -- просто так надо ибо мы не можем сказать откуда предмет перешёл в пояс, с земли или с рюкзака
		tab_objs_on_ruck[tostring(obj:id())] = nil -- занилим в таблице рюкзака данный предмет так как мы его перенесли С РЮКЗАКА на пояс
		--log1("take_item_on_slot удаляем с таблицы рюкзака, перенесли в слот "..obj:name().."")
		if ini:line_exist(obj:section(), "item_amount") then
			local val = ini:r_float(obj:section(), "item_amount") or 0
			cur_amount = cur_amount - val
			if cur_amount < 0 then
				--cur_amount = 0
			end
			--news_manager.send_tip(db.actor, "текущий объём "..cur_amount.." сейчас.", nil, "default", 9000)
		end
	end
	
	if obj:is_outfit() then
		cur_outfit = obj:id()
		--log1("take_item_on_slot надели броню ")
		local val_add = ini:line_exist(obj:section(), "item_amount_add") and ini:r_float(obj:section(), "item_amount_add") or 0
		max_item_amount = max_item_amount + val_add
	end
	olr_ui_inv_acinfo.repaint()
end

-- костыль
function forced_drop_outfit(obj)
	--log1("called forced_drop_outfit")
	if obj:id() == cur_outfit then
		cur_outfit = -1
		printf(" С нас принудительно снята броня ")
		local val_add = ini:line_exist(obj:section(), "item_amount_add") and ini:r_float(obj:section(), "item_amount_add") or 0
		max_item_amount = max_item_amount - val_add
	end
	olr_ui_inv_acinfo.repaint()
end

function dump_info()
	log1("called dump_info")
	log1("объем в рюкзаке (cur_amount) - "..cur_amount.." ")
	log1("Содержимое tab_objs_on_slots:")
	for obj_id, exists in pairs(tab_objs_on_slots) do
		if exists then
			log1("  Объект " .. obj_id .. " присутствует")
		else
			-- (эта ветка вряд ли выполнится, т.к. nil-значения не попадают в pairs)
			log1("  Объект " .. obj_id .. " отсутствует")
		end
	end
	log1("Содержимое tab_objs_on_ruck:")
	for obj_id, exists in pairs(tab_objs_on_ruck) do
		if exists then
			log1("  Объект " .. obj_id .. " присутствует")
		else
			-- (эта ветка вряд ли выполнится, т.к. nil-значения не попадают в pairs)
			log1("  Объект " .. obj_id .. " отсутствует")
		end
	end
end