function blow_sleep_timer_low(scale)
	local tec = olr_blowout.get_blow_timer()
	if tec < 420 then
		return
	end
	local tmr = 50 + scale * 20
	olr_blowout.min_blow_timer(tmr)
end


function yan_dead_call()
	if level.name() == "lvl7_yantar" then
		if not xr_conditions.is_day() then
			if not has_alife_info("radar_de_done") then
				news_manager.send_tip(db.actor, game.translate_string("yan_dead_call_0"), nil, "unknown", 5000)
				news_manager.send_tip(db.actor, game.translate_string("yan_dead_call_1"), 5, "unknown", 5000)
				news_manager.send_tip(db.actor, game.translate_string("yan_dead_call_2"), 15, "unknown", 5000)
				news_manager.send_tip(db.actor, game.translate_string("yan_dead_call_3"), 25, "unknown", 5000)
				news_manager.send_tip(db.actor, game.translate_string("yan_dead_call_4"), 35, "unknown", 5000)
			end
		end
	end
end

