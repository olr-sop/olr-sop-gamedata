-- рандомное ограбление актора во сне (если пьян, или не в укрытии)
-- hi_flyer 01.12.16
-- hrusteckiy/theysani 22.11.25

local iskluch_items = {
	["device_pda"] = true,
	["device_torch"] = true,
	["bolt"] = true,
	["ecolog_outfit"] = true,
	["ammo_og-7b"] = true
}

-- Вероятности в процентах (0-100) для разных типов предметов
local probabilities = {
	artefact = 10,	 -- 10%
	ammo = 30,		 -- 30%
	weapon = 50,	 -- 50%
	outfit = 5,	 	 -- 5%
	food = 70		 -- 70%
}

function sleep_rob()
	local mrandom = math.random
	if db.actor:is_actor_outdoors() == false then
		return
	end
	if db.actor.alcohol == 0 then
		return
	end

	-- Находим ближайшего сталкера
	local nearby_stalker = nil
	local actor_pos = db.actor:position()
	
	for k, v in pairs(db.storage) do
		local stalker = level.object_by_id(k)
		if stalker and (get_clsid(stalker) == clsid.script_stalker) and stalker:alive() then
			if stalker:position():distance_to(actor_pos) < 45 then
				nearby_stalker = stalker
				break
			end
		end
	end

	if not nearby_stalker then
		return
	end

	-- Собираем предметы для кражи
	local items_to_steal = {}
	
	db.actor:iterate_inventory(function(actor, obj)
		-- Проверяем исключенные предметы
		if iskluch_items[obj:section()] then
			return
		end
		
		-- Проверка по сюжетным предметам
		if olr.bad_items[obj:section()] then
			return
		end
		
		-- Проверяем квестовые предметы
		if ini_sys:line_exist(obj:section(), "quest_item") and ini_sys:r_bool(obj:section(), "quest_item") == true then
			return
		end

		-- Для каждого типа предмета генерируем свой случайный процент
		if obj:is_artefact() then
			if mrandom(1, 100) <= probabilities.artefact then
				items_to_steal[#items_to_steal+1] = obj
			end
		elseif obj:is_ammo() then
			if mrandom(1, 100) <= probabilities.ammo then
				items_to_steal[#items_to_steal+1] = obj
			end
		elseif obj:is_weapon() then
			if mrandom(1, 100) <= probabilities.weapon then
				items_to_steal[#items_to_steal+1] = obj
			end
		elseif obj:is_outfit() and not db.actor:is_in_slot(obj) then
			if mrandom(1, 100) <= probabilities.outfit then
				items_to_steal[#items_to_steal+1] = obj
			end
		elseif obj:is_food_item() then
			if mrandom(1, 100) <= probabilities.food then
				items_to_steal[#items_to_steal+1] = obj
			end
		end
	end, db.actor)

	-- Если есть что красть - передаем предметы и отправляем сообщение
	if #items_to_steal > 0 then
		-- Передаем все предметы сталкеру
		for _, item in ipairs(items_to_steal) do
			db.actor:transfer_item(item, nearby_stalker)
		end
		
		-- Подготавливаем и отправляем сообщение
		local stalker_name = nearby_stalker:character_name()
		local stalker_comm = nearby_stalker:character_community()
		local sender_icon = news_manager.tips_icons[stalker_comm] and stalker_comm or "unknown"
		
		if not olr_timers.has_timer("actor_robbered_timer") then
			local action = string.format("olr_sleep_robers.actor_robbered_timer_sms(%q, %q)", stalker_name, sender_icon)
			local tmr = mrandom(600, 3600) -- через 10 минут - 1 час (игровой)
			olr_timers.st_timer_game("actor_robbered_timer", tmr, action)
		end
	end
end

function actor_robbered_timer_sms(stalker_name, sender_icon)
	news_manager.send_tip(db.actor, "actor_robbered_timer_sms_0", nil, sender_icon, 10000, nil, "pda_tips", true, stalker_name)
end