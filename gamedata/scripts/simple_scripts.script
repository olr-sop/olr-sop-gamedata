	return first_speaker:object("af_electrosphere") ~= nil and has_alife_info("encyclopedy_zone_artifact_af-electrosphere")
end 
function has_106(first_speaker, second_speaker) 
	return first_speaker:object("af_mercury_ball") ~= nil and has_alife_info("encyclopedy_zone_artifact_af-mercury-ball")
end 
function has_107(first_speaker, second_speaker) 
	return first_speaker:object("af_sponge") ~= nil and has_alife_info("encyclopedy_zone_artifact_af-sponge")
end 
function has_108(first_speaker, second_speaker) 
	return first_speaker:object("af_dummy_simple") ~= nil and has_alife_info("encyclopedy_zone_artifact_af-dummy-simple")
end 
function has_109(first_speaker, second_speaker) 
	return first_speaker:object("af_deadhead") ~= nil and has_alife_info("encyclopedy_zone_artifact_af-deadhead")
end 
function has_110(first_speaker, second_speaker) 
	return first_speaker:object("af_needle") ~= nil and has_alife_info("encyclopedy_zone_artifact_af-needle")
end 
function has_111(first_speaker, second_speaker) 
	return first_speaker:object("af_needle_heavy") ~= nil and has_alife_info("encyclopedy_zone_artifact_af-needle-heavy")
end 

