function sto_money_from_gg_to_npc(t1,t2)
local npc=t1
if npc:id()==db.actor:id() then
npc=t2
end
dialogs.relocate_money(npc,100,"out")
end


function actor_has_bred(first_speaker, second_speaker) 
   return nik_dialog.item_much("bread",1) ~= false 
end
function actor_has_kolbasa(first_speaker, second_speaker) 
   return nik_dialog.item_much("kolbasa",1) ~= false 
end 
function actor_has_conserva(first_speaker, second_speaker) 
   return nik_dialog.item_much("conserva",1) ~= false 
end


function give_bred_to_npc(first_speaker, second_speaker) 
   nik_dialog.out_item_much("bread",1) 
end 
function give_kolbasa_to_npc(first_speaker, second_speaker) 
   nik_dialog.out_item_much("kolbasa",1)
end 
function give_conserva_to_npc(first_speaker, second_speaker) 
   nik_dialog.out_item_much("conserva",1) 
end 

function medic_help()
  if db.actor then
     db.actor.health = db.actor.health + 1
  end
end

function actor_isnt_health()
 if db.actor.health <= 0.95 then
 return true
 end
return false
end

function actor_is_health()
 if db.actor.health > 0.95 then
 return true
end
return false
end

function mh_has_capsule(first_speaker, second_speaker) 
	return first_speaker:object("energy_drink") ~= nil 
end

function has_any_af_for_professor(first_speaker, second_speaker)
	return has_101(first_speaker, second_speaker) or has_102(first_speaker, second_speaker)
	or has_103(first_speaker, second_speaker) or has_104(first_speaker, second_speaker)
	or has_105(first_speaker, second_speaker) or has_106(first_speaker, second_speaker)
	or has_107(first_speaker, second_speaker) or has_108(first_speaker, second_speaker)
	or has_109(first_speaker, second_speaker) or has_110(first_speaker, second_speaker)
	or has_111(first_speaker, second_speaker)
end

function has_101(first_speaker, second_speaker)
	return first_speaker:object("af_magnet") ~= nil and has_alife_info("encyclopedy_zone_artifact_af-magnet")
end 
function has_102(first_speaker, second_speaker) 
	return first_speaker:object("af_gravi_heavy") ~= nil and has_alife_info("encyclopedy_zone_artifact_af-gravi-heavy")
end 
function has_103(first_speaker, second_speaker) 
	return first_speaker:object("af_dummy_double") ~= nil and has_alife_info("encyclopedy_zone_artifact_af-dummy-double")
end 
function has_104(first_speaker, second_speaker) 
	return first_speaker:object("af_black_drops") ~= nil and has_alife_info("encyclopedy_zone_artifact_af-black-drops") 
end 
