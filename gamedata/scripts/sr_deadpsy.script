local state_nowhere = 0 -- схема только что включилась
local state_inside = 1 -- актер внутри
local state_outside = 2 -- актер снаружи

local snd_psy = xr_sound.get_safe_sound_object([[ambient\special\psy_voices]]) -- звук шума

class "action_deadpsy"

function action_deadpsy:__init( obj, storage )
	self.object = obj
	self.st = storage
	self.pp_effector_active = false
end

function action_deadpsy:reset_scheme()
	self.state = state_nowhere -- еще неясно, в зоне он, или нет
	self:switch_state(db.actor)
end

function action_deadpsy:deactivate()
	self:remove_effects()
end

function action_deadpsy:update( delta )
	local actor = db.actor

	if xr_logic.try_switch_to_another_section( self.object, self.st, actor ) then
		return
	end
	
	self:switch_state( actor )
	
	if self.state == state_inside then
		local iblocitm = db.actor:object("psy_blocerator")
		if iblocitm then
			if self.pp_effector_active then
				self:remove_effects()
			end
			iblocitm:set_condition(iblocitm:condition() - 0.00005)
			local cond = iblocitm:condition()
			if cond == 0.50 then
				news_manager.send_tip(db.actor, game.translate_string("action_deadpsyupdate_0"), nil, "default", 49000, nil, nil, true, "st_psy_blocker_name")
			elseif cond == 0.10 then
				news_manager.send_tip(db.actor, game.translate_string("action_deadpsyupdate_1"), nil, "default", 49000, nil, nil, true, "st_psy_blocker_name")
			end
			if cond <= 0.01 then
				news_manager.send_tip(db.actor, game.translate_string("action_deadpsyupdate_2"), nil, "default", 49000, nil, nil, true, "st_psy_blocker_name")
				olr.del(iblocitm)
			end
		end

		if not iblocitm then
			db.actor.psy_health = -0.01
			if not self.pp_effector_active then
				snd_psy:play_at_pos(db.actor, vector():set(0, 0, 0), 0, sound_object.s2d + sound_object.looped)
				level.add_pp_effector("dead_zone.ppe", 971974, true)
				self.pp_effector_active = true
			end			
		end
	end
end

function action_deadpsy:switch_state( actor )
	local state = self.state
	
	if state == state_outside or state == state_nowhere then
		if self.object:inside( actor:center() ) then
			self:zone_enter()
			return
		end
	end
	
	if state == state_inside or state == state_nowhere then
		if not self.object:inside( actor:center() ) then
			self:zone_leave()
			return
		end
	end
end

function action_deadpsy:zone_enter()
	self.state = state_inside
	
	local iblocitm = db.actor:object("psy_blocerator")
	if not iblocitm then
		-- Включаем эффекты только если их нет и у актера нет блокератора
		if not self.pp_effector_active then
			snd_psy:play_at_pos(db.actor, vector():set(0, 0, 0), 0, sound_object.s2d + sound_object.looped)	
			level.add_pp_effector("dead_zone.ppe", 971974, true)
			self.pp_effector_active = true
		end
	else
		-- Если есть блокератор - убедимся что эффекты выключены
		self:remove_effects()
	end
end

function action_deadpsy:zone_leave()
	self.state = state_outside
	self:remove_effects()
end

function action_deadpsy:remove_effects()
	if self.pp_effector_active then
		if snd_psy:playing() then
			snd_psy:stop()
		end
		level.remove_pp_effector(971974)
		self.pp_effector_active = false
	end
end

---------------------------------------------------------------------------------------------------------------------
function add_to_binder(npc, ini, scheme, section, storage)
	printf("DEBUG: add_to_binder: scheme='%s', section='%s'", scheme, section)

	local new_action = action_deadpsy(npc, storage)

	-- Зарегистрировать все actions, в которых должен быть вызван метод reset_scheme при изменении настроек схемы:
	xr_logic.subscribe_action_for_events(npc, storage, new_action)
end

function set_scheme(npc, ini, scheme, section, gulag_name)
	local st = xr_logic.assign_storage_and_bind(npc, ini, scheme, section)
	st.logic = xr_logic.cfg_get_switch_conditions(ini, section, npc)
end