[logic]
active = sr_deadspori
 
[sr_deadspori]
]]
local state_nowhere = 0 -- схема только что включилась
local state_inside = 1 -- актер внутри
local state_outside = 2 -- актер снаружи

local vaild_outfits = {
	["ecolog_outfit"] = true,
	["scientific_outfit"] = true,
	["outfit_antirad"] = true
}

class "action_deadspori"

function action_deadspori:__init(obj, storage)
	self.object = obj
	self.st = storage
	self.hit_timer = 0
	self.pp_effector_active = false
	self.warn_shown = false
end

function action_deadspori:reset_scheme()
	self.state = state_nowhere
	self.warn_shown = false
	self:switch_state(db.actor)
end

function action_deadspori:update(delta)
	local actor = db.actor

	if xr_logic.try_switch_to_another_section(self.object, self.st, actor) then
		return
	end

	self:switch_state(actor)

	if self.state == state_inside then
		local currout = db.actor:item_in_slot(6)
		local has_valid_outfit = currout and vaild_outfits[currout:section()] and currout:condition() >= 0.75
		local has_art = db.actor:object("af_studen_m1") and db.actor:is_on_belt(db.actor:object("af_studen_m1"))

		-- 1. Проверяем наличие подходящего костюма в хорошем состоянии
		if not has_valid_outfit then
			-- 2. Если костюма нет/не подходит/поврежден - проверяем артефакт
			if not has_art then
				-- 3. Если артефакта тоже нет - применяем все эффекты
				if not self.pp_effector_active then
					level.add_pp_effector("dead_zone.ppe", 714433974, true)
					self.pp_effector_active = true
				end

				db.actor.health = -0.0015
				--bind_monster.zarazjenie_parazitom() -- пока уберём

				-- сильно реже, заёбывает
				if math.random(1, 100) == 1 then
					local snd_obj = xr_sound.get_safe_sound_object("actor\\cough_3")
					if not snd_obj:playing() then
						snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
					end
				end

				-- Предупреждение о повреждении костюма (только если костюм есть но поврежден)
				if currout and currout:condition() < 0.75 and not self.warn_shown then
					self.warn_shown = true
					news_manager.send_tip(db.actor, game.translate_string("action_deadsporiupdate_1"), nil, "info", 25000)
				end
			else
				-- 4. Если артефакт есть - выключаем все эффекты
				if self.pp_effector_active then
					level.remove_pp_effector(714433974)
					self.pp_effector_active = false
				end
				self.warn_shown = false
			end
		else
			-- 5. Если костюм в порядке - выключаем все эффекты
			if self.pp_effector_active then
				level.remove_pp_effector(714433974)
				self.pp_effector_active = false
			end
			self.warn_shown = false
		end
	end
end

function action_deadspori:switch_state(actor)
	local state = self.state

	if state == state_outside or state == state_nowhere then
		if self.object:inside(actor:center()) then
			self:zone_enter()
			return
		end
	end

	if state == state_inside or state == state_nowhere then
		if not self.object:inside(actor:center()) then
			self:zone_leave()
			return
		end
	end
end

function action_deadspori:zone_enter()
	self.state = state_inside
	self.warn_shown = false -- Сбрасываем флаг предупреждения при входе в зону
end

function action_deadspori:zone_leave()
	self.state = state_outside
	if self.pp_effector_active then
		level.remove_pp_effector(714433974)
		self.pp_effector_active = false
	end
	self.warn_shown = false
end

---------------------------------------------------------------------------------------------------------------------
function add_to_binder(npc, ini, scheme, section, storage)
	printf("DEBUG: add_to_binder: scheme='%s', section='%s'", scheme, section)

	local new_action = action_deadspori(npc, storage)

	-- Зарегистрировать все actions, в которых должен быть вызван метод reset_scheme при изменении настроек схемы:
	xr_logic.subscribe_action_for_events(npc, storage, new_action)
end

function set_scheme(npc, ini, scheme, section, gulag_name)
	local st = xr_logic.assign_storage_and_bind(npc, ini, scheme, section)
	st.logic = xr_logic.cfg_get_switch_conditions(ini, section, npc)
end