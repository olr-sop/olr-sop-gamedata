local surge_manager = nil
-- ================================================================================================
-- Менеджер выброса (surge): тайминги, эффекты, укрытия, состояние.
--
-- Лента событий (реальные секунды от старта выброса, при tf=10):
--   0        задача: погода "surge" + поршень task_given
--   5-20     сообщение: tip + olr_blowout_first_hideouts + phase_1 + blowout_begin + автосейв
--   10-20    старт гула blowout_rumble
--   35-45    старт землетрясения (cam + звук), максимум к 65с
--   45-50    attack ppe (нарастающий, ~16с), при завершении включается loop
--   65-75    первый удар (gain ppe + shell_shock + phase_2), импульс через 3с
--   +6-20    второй/третий/четвёртый удары; t4 = 83-135с
--   t4+3     kill_all_unhided + phase_3
--   t4+5     loop -> release (затухающий ppe)
--   t4..+10  гул и землетрясение затухают до нуля
--   t4+20    surge_end_sound + end_surge (пост-выбросовые функции)
--
-- Расписание случайное, но детерминированное: seed = секунды inited_time, генератор surge_rng.
-- После save/load тайминги восстанавливаются один в один без записи в сейв-пакет.
-- Подробный лог шагов включается переменной debug (ниже).
-- ================================================================================================

local earthquake_cam_eff = 2
local sleep_cam_eff = 3
local sleep_fade_pp_eff = 4
local shell_shock_cam_eff = 21 -- cam-эффектор shell_shock (тряска при запуске ppe удара)

-- id пост-эффектов выброса (attack -> loop -> gain -> release)
local surge_attack_pp_eff = 5
local surge_loop_pp_eff = 6
local surge_release_pp_eff = 8
-- у каждого удара свой id gain-эффекта: одинаковый id движок заменяет, а не накладывает
local SURGE_GAIN_PP_EFFS = {71, 72, 73, 74}

local SURGE_ATTACK_RAMP = 10
local SURGE_ATTACK_MIN_FACTOR = 0.001

-- Тайминг выброса (реальные секунды от старта); случайные окна генерируются в build_schedule()
local SURGE_MESSAGE_MIN = 5 -- сообщение о начале выброса
local SURGE_MESSAGE_MAX = 20
local SURGE_RUMBLE_MIN = 10 -- гул выброса
local SURGE_RUMBLE_MAX = 20
local SURGE_QUAKE_MIN = 35 -- землетрясение
local SURGE_QUAKE_MAX = 45
local SURGE_QUAKE_PEAK = 65 -- к этой секунде тряска на максимуме
local SURGE_ATTACK_MIN = 45 -- attack ppe
local SURGE_ATTACK_MAX = 50
local SURGE_HIT_FIRST_MIN = 65 -- первый удар
local SURGE_HIT_FIRST_MAX = 75
local SURGE_HIT_GAP_MIN = 6 -- промежуток между ударами: 6 гарантированно + 0-14 случайных
local SURGE_HIT_GAP_RAND = 14
local SURGE_HIT_COUNT = 4
local SURGE_RELEASE_DELAY = 5 -- через сколько секунд после 4-го удара loop -> release
local SURGE_FADE_TIME = 10 -- затухание гула и землетрясения после 4-го удара
local SURGE_END_DELAY = 20 -- через сколько секунд после 4-го удара звучит конец и выброс завершается
local SURGE_HIT_SOUNDS = {"surge_hit_sound_1", "surge_hit_sound_2", "surge_hit_sound_3", "surge_hit_sound_4"}
local SURGE_HIT_CAM_IDS = {17, 18, 19, 20} -- уникальные id cam-эффекторов ударов (anm наслаиваются, а не перекрываются)
local SURGE_HIT_IMPACT_DELAY = 3 -- через сколько секунд после ppe наносится удар (урон + звук + anm)
local SURGE_DAMAGE_WINDOW = 10 -- сколько секунд после удара идёт урон
local SURGE_PSY_HIT_DAMAGE = 0.3 -- мгновенный съём пси-здоровья за удар
local SURGE_PSY_TICK_BASE = 0.005 -- базовый урон в секунду в окне удара
local SURGE_PSY_TICK_GROW = 0.00005 -- прирост урона за каждую секунду выброса
local ANTIVIBROS_HIT_COND = 0.1 -- износ pribor_antivibros за мгновенный удар
local ANTIVIBROS_TICK_COND = 0.01 -- износ pribor_antivibros за секунду урона
-- Громкости звуков выброса (крутить тут, 1 = как в файле)
local SURGE_SOUND_VOL = {start = 0.66, moan = 0.6, hits = {1, 1, 1, 1}, finish = 1, quake = 1}

-- Время задаётся игровое
-- Первый выброс через 2-3 дня
-- Последующие через 2-5 дней
local START_MIN_SURGE_TIME = 259200 -- Время в секундах
local START_MAX_SURGE_TIME = 345600
local MIN_SURGE_TIME = 172800
local MAX_SURGE_TIME = 432000
local prev_sec = 0

-- Подробный поэтапный лог выброса (для тестов; false — тихий режим)
local debug = true

local function dbg(fmt, ...)
	if not debug then return end
	if select("#", ...) > 0 then
		log1("[surge_manager] " .. string.format(fmt, ...))
	else
		log1("[surge_manager] " .. fmt)
	end
end

-- Детерминированный генератор расписания выброса (Park-Miller LCG).
-- Seed — время старта: после save/load расписание восстанавливается 1:1.
local function surge_rng(seed)
	local s = math.floor(seed) % 2147483647
	if (s <= 0) then
		s = s + 2147483646
	end
	return function(lo, hi)
		s = (s * 16807) % 2147483647
		return lo + math.floor(s / 2147483647 * (hi - lo + 1))
	end
end



no_blow_levels = {
	["l04u_warlab"] = true,
	["l10u_bunker"] = true,
	["l12_barrow_downs"] = true,
	["l14_stancia"] = true,
	["l14u_sarcofag"] = true,
	["l15_generators"] = true
}

class "CSurgeManager"
function CSurgeManager:__init()
end

function CSurgeManager:initialize()
	self.ini = ini_file("misc\\surge_manager.ltx")

	self.started = false
	self.finished = true
	self.time_forwarded = false
	self.skip_message = false

	self.task_given = false
	self.effector_set = false
	self.second_message_given = false
	self.ui_disabled = false
	self.blowout_sound = false

	self.surge_time = 160 -- пересчитывается в build_schedule() на старте/загрузке
	self.inited_time = game.CTime()
	self.last_surge_time = game.get_game_time()
	self._delta = math.random(START_MIN_SURGE_TIME, START_MAX_SURGE_TIME)

	self.count = 0
	self.covers = {}

	self.rumble_time = nil
	self.quake_time = nil
	self.attack_start = nil
	self.first_hit = nil
	self.hit_times = {}
	self.rumble_t0 = nil
	self.fade_t0 = nil
	self.fade_done = false
	self.release_started = false
	self.attack_pending = false
	self.attack_len = 0
	self.asleep_surge_pending = false
	self.moan_played = false
	self.start_fx_played = false
	self.hits_fired = 0
	self.quake_t0 = nil
	self.message_given = false
	self.message_time = nil
	self.damage_until = nil
	self.hit_impact_at = nil
	self.hit_impact_index = nil
	self.shock_t0 = nil

	self.condlist = {}
	self.survive = {}

	local ini = self.ini
	local cond_string = "true"
	if (ini:line_exist("settings", "condlist")) then
		cond_string = ini:r_string("settings", "condlist")
	end
	self.condlist = xr_logic.parse_condlist(nil, "surge_manager", "condlist", cond_string)

	cond_string = "false"
	if (ini:line_exist("settings", "survive")) then
		cond_string = ini:r_string("settings", "survive")
	end
	self.survive = xr_logic.parse_condlist(nil, "surge_manager", "survive_condlist", cond_string)

	self.need_reinit_covers = true

	self.loaded = false
end

function CSurgeManager:init_surge_covers()
	self.count = 0
	self.covers = {}

	local ini = self.ini
	if not ini:section_exist("list") then
		return
	end

	for i = 0, ini:line_count("list") - 1 do
		local _, id, _ = ini:r_line("list", i, "", "")
		local zone = db.zone_by_name[id]

		if zone ~= nil then
			self.count = self.count + 1
			self.covers[self.count] = {id = zone:id(), zone = zone, condlist = nil}

			if (ini:line_exist(id, "condlist")) then
				self.covers[self.count].condlist = xr_logic.parse_condlist(nil, id, "condlist", ini:r_string(id, "condlist"))
			end
		end
	end
end

function CSurgeManager:cover_allowed(cover)
	if (cover == nil) or (cover.zone == nil) then
		return false
	end

	if (cover.condlist == nil) then
		return true
	end

	local sect = xr_logic.pick_section_from_condlist(db.actor, nil, cover.condlist)
	return (sect == "true")
end

function CSurgeManager:actor_cover()
	if not db.actor:is_actor_outdoors() then
		dbg("cover: actor indoors")
		return true
	end

	local actor_pos = db.actor:position()
	for i = 1, self.count do
		local cover = self.covers[i]
		if (cover ~= nil) and self:cover_allowed(cover) then
			local obj = cover.zone
			if obj:inside(actor_pos) then
				dbg("cover: actor inside cover zone")
				return true
			end
		end
	end

	dbg("cover: actor out of cover")
	return false
end

function CSurgeManager:get_nearest_cover()
	local actor_pos = db.actor:position()
	local nearest_cover_id = nil
	local nearest_cover_dist = math.huge

	for i = 1, self.count do
		local cover = self.covers[i]
		if (cover ~= nil) and self:cover_allowed(cover) then
			local obj = cover.zone
			if obj:inside(actor_pos) then
				return obj.id
			end

			local dist = obj:position():distance_to(actor_pos)
			if (dist < nearest_cover_dist) then
				nearest_cover_dist = dist
				nearest_cover_id = obj.id
			end
		end
	end

	return nearest_cover_id
end

function CSurgeManager:get_nearest_cover_task()
	local actor_pos = db.actor:position()
	local nearest_cover = nil
	local nearest_cover_dist = math.huge

	for i = 1, self.count do
		local cover = self.covers[i]
		if (cover ~= nil) and self:cover_allowed(cover) then
			local obj = cover.zone
			if obj:inside(actor_pos) then
				return obj
			end

			local dist = obj:position():distance_to(actor_pos)
			if (dist < nearest_cover_dist) then
				nearest_cover_dist = dist
				nearest_cover = obj
			end
		end
	end

	return nearest_cover
end

function CSurgeManager:get_attack_len()
	if (self.attack_len == 0) then
		self.attack_len = level.get_pp_effector_length("event\\surge_fade_attack.ppe")
	end
	return self.attack_len
end

function CSurgeManager:surge_fade_progress()
	if (self.fade_t0 == nil) then
		return 0
	end
	local fade = (time_global() - self.fade_t0) / (SURGE_FADE_TIME * 1000)
	if (fade > 1) then
		fade = 1
	elseif (fade < 0) then
		fade = 0
	end
	return fade
end

function CSurgeManager:remove_gain_pp_effectors()
	for i = 1, #SURGE_GAIN_PP_EFFS do
		level.remove_pp_effector(SURGE_GAIN_PP_EFFS[i])
	end
end

-- Расписание выброса детерминировано: seed — время старта, поэтому save/load
-- не сбивает тайминги и формат сейв-пакета не меняется
function CSurgeManager:build_schedule()
	local Y, M, D, h, m, s, ms = 0, 0, 0, 0, 0, 0, 0
	Y, M, D, h, m, s, ms = self.inited_time:get(Y, M, D, h, m, s, ms)
	local seed = ((D * 24 + h) * 60 + m) * 60 + s
	local rnd = surge_rng(seed)

	-- Окна подводки: сообщение, гул, землетрясение, attack ppe
	self.message_time = rnd(SURGE_MESSAGE_MIN, SURGE_MESSAGE_MAX)
	self.rumble_time = rnd(SURGE_RUMBLE_MIN, SURGE_RUMBLE_MAX)
	self.quake_time = rnd(SURGE_QUAKE_MIN, SURGE_QUAKE_MAX)
	self.attack_start = rnd(SURGE_ATTACK_MIN, SURGE_ATTACK_MAX)

	-- Удары: первый 65-75с, далее промежутки 6-20с (6 гарантировано + 0-14 случайных)
	self.hit_times = {}
	local t = rnd(SURGE_HIT_FIRST_MIN, SURGE_HIT_FIRST_MAX)
	for i = 1, SURGE_HIT_COUNT do
		self.hit_times[i] = t
		t = t + rnd(SURGE_HIT_GAP_MIN, SURGE_HIT_GAP_MIN + SURGE_HIT_GAP_RAND)
	end

	-- Производные: конец выброса = t4 + SURGE_END_DELAY
	self.first_hit = self.hit_times[1]
	self.surge_time = self.hit_times[SURGE_HIT_COUNT] + SURGE_END_DELAY

	self.fade_t0 = nil
	self.fade_done = false
	self.release_started = false
	self.rumble_t0 = nil

	dbg("schedule (seed=%d): message=%d rumble=%d quake=%d attack=%d hits=%d/%d/%d/%d end=%d",
		seed, self.message_time, self.rumble_time, self.quake_time, self.attack_start,
		self.hit_times[1], self.hit_times[2], self.hit_times[3], self.hit_times[4], self.surge_time)
end

function CSurgeManager:start_surge_loop()
	if (not self.started) or (self.effector_set) then
		return
	end

	level.remove_pp_effector(surge_attack_pp_eff)
	level.add_pp_effector("event\\surge_loop.ppe", surge_loop_pp_eff, true)
	self.effector_set = true
	self.attack_pending = false
	dbg("loop started")
end

function CSurgeManager:update()
	if (device().precache_frame > 1) then
		return
	end

	if self.need_reinit_covers then
		self:init_surge_covers()
		dbg("reinit covers after load, count=%d", self.count)
		self.need_reinit_covers = false
	end

	if self.need_weather_restore then
		local game_diff = math.ceil(game.get_game_time():diffSec(self.inited_time))
		level.start_weather_fx_from_time("surge", game_diff)
		dbg("restored weather_fx after loading %d", game_diff)
		self.need_weather_restore = false
	end

	if not (self.started) then
		self.loaded = false

		local g_time = game.get_game_time()

		if (self.time_forwarded) then
			log1("---> surge: delta = "..tostring(self._delta))
			log1("---> surge: diffSec = "..tostring(g_time:diffSec(self.last_surge_time)))
			local diff = math.abs(self._delta - g_time:diffSec(self.last_surge_time))
			log1("---> surge: diff = "..tostring(diff))
			if (diff < 3600) then
				self._delta = 3 * 3600 + g_time:diffSec(self.last_surge_time)
			end
			self.time_forwarded = false
		end

		local elapsed = g_time:diffSec(self.last_surge_time)

		if (elapsed < self._delta) then
			return
		end

		if (time_global() < (self.start_check_time or 0)) then
			return
		end
		self.start_check_time = time_global() + 1000

		if (xr_logic.pick_section_from_condlist(db.actor, nil, self.condlist) ~= "true") then
			log1("---> surge: actor condlist ~= true")
			return
		end

		if not (self:get_nearest_cover()) then
			log1("---> surge: failed to get nearest cover")
			return
		end

		self:start(true)
		return
	end

	-- ==== покадровая логика (не раз в секунду) ====
	if (self.attack_pending) then
		local attack_elapsed = time_global() - self.attack_t0
		local progress = attack_elapsed / (SURGE_ATTACK_RAMP * 1000)
		if (progress > 1) then
			progress = 1
		elseif (progress < SURGE_ATTACK_MIN_FACTOR) then
			progress = SURGE_ATTACK_MIN_FACTOR
		end
		level.set_pp_effector_factor(surge_attack_pp_eff, progress)

		if not level.is_pp_effector_active(surge_attack_pp_eff) then
			self:start_surge_loop()
		end
	end

	-- Громкость гула: разгон до максимума к t4, затем затухание от t4 к t4+10
	if (self.blowout_sound) then
		local up = 1
		if (self.rumble_t0 ~= nil) then
			up = (time_global() - self.rumble_t0) / ((self.hit_times[SURGE_HIT_COUNT] - self.rumble_time) * 1000)
			if (up > 1) then
				up = 1
			elseif (up < 0.05) then
				up = 0.05
			end
		end
		xr_sound_cop.set_volume_sound_looped(db.actor:id(), "blowout_rumble", up * (1 - self:surge_fade_progress()))
	end

	-- Тряска: разгон к 65с, затухание вместе с гулом после t4
	if (self.second_message_given) then
		local quake_progress = (time_global() - (self.quake_t0 or time_global())) / ((SURGE_QUAKE_PEAK - self.quake_time) * 1000)
		if (quake_progress > 1) then
			quake_progress = 1
		elseif (quake_progress < 0) then
			quake_progress = 0
		end
		quake_progress = quake_progress * (1 - self:surge_fade_progress())
		level.set_cam_effector_factor(earthquake_cam_eff, quake_progress)
		xr_sound_cop.set_volume_sound_looped(db.actor:id(), "surge_earthquake_sound_looped", quake_progress)
	end

	-- Полное затухание: гасим петли и снимаем cam один раз
	if (self:surge_fade_progress() >= 1) and not (self.fade_done) and (self.second_message_given or self.blowout_sound) then
		self.fade_done = true
		if (self.blowout_sound) then
			xr_sound_cop.stop_sound_looped(db.actor:id(), "blowout_rumble")
		end
		if (self.second_message_given) then
			xr_sound_cop.stop_sound_looped(db.actor:id(), "surge_earthquake_sound_looped")
			level.remove_cam_effector(earthquake_cam_eff)
		end
		dbg("rumble/quake faded out")
	end

	if (self.shock_t0) then
		local shock_t = (time_global() - self.shock_t0) / 1000
		if (shock_t >= 8) then
			level.remove_cam_effector(shell_shock_cam_eff)
			self.shock_t0 = nil
		elseif (shock_t <= 4) then
			level.set_cam_effector_factor(shell_shock_cam_eff, shock_t / 4)
		else
			level.set_cam_effector_factor(shell_shock_cam_eff, 1 - (shock_t - 4) / 4)
		end
	end

	-- ==== посекундная логика ====
	local diff_sec = math.ceil(game.get_game_time():diffSec(self.inited_time) / level.get_time_factor())

	if (prev_sec ~= diff_sec) then
		prev_sec = diff_sec
		dbg("diff_sec = %d", diff_sec)

		local level_name = level.name()
		if no_blow_levels[level_name] then
			log1("---> surge: stopped because of level!")
			self:end_surge()
			return
		end

		if (diff_sec >= self.surge_time) then
			self:end_surge()
		else
			if (self.loaded) then
				dbg("re-apply after load: diff=%d, task=%s, effector=%s, quake=%s, rumble=%s, ui=%s",
					diff_sec, tostring(self.task_given), tostring(self.effector_set),
					tostring(self.second_message_given), tostring(self.blowout_sound), tostring(self.ui_disabled))
				if (self.blowout_sound) and (diff_sec < self.hit_times[SURGE_HIT_COUNT] + SURGE_FADE_TIME) then
					xr_sound_cop.play_sound_looped(db.actor:id(), "blowout_rumble")
					self.rumble_t0 = time_global() - math.max(0, diff_sec - self.rumble_time) * 1000
				end
				if (self.effector_set) then
					if (diff_sec < self.hit_times[SURGE_HIT_COUNT] + SURGE_RELEASE_DELAY) then
						level.add_pp_effector("event\\surge_loop.ppe", surge_loop_pp_eff, true)
					else
						level.add_pp_effector("event\\surge_fade_release.ppe", surge_release_pp_eff, false)
						self.release_started = true
					end
				elseif (self.task_given and diff_sec >= self.attack_start) then
					if (diff_sec >= self.attack_start + self:get_attack_len()) then
						self:start_surge_loop()
					else
						level.add_pp_effector("event\\surge_fade_attack.ppe", surge_attack_pp_eff, false)
						level.set_pp_effector_factor(surge_attack_pp_eff, SURGE_ATTACK_MIN_FACTOR)
						self.attack_pending = true
						self.attack_t0 = time_global()
					end
				end
				if (self.second_message_given) and (diff_sec < self.hit_times[SURGE_HIT_COUNT] + SURGE_FADE_TIME) then
					xr_sound_cop.play_sound_looped(db.actor:id(), "surge_earthquake_sound_looped")
					level.add_cam_effector_lerp("camera_effects\\earthquake.anm", earthquake_cam_eff, true)
					self.quake_t0 = time_global() - math.max(0, diff_sec - self.quake_time) * 1000
				end
				local hits_n = 0
				for i = 1, SURGE_HIT_COUNT do
					if (diff_sec >= self.hit_times[i]) then
						hits_n = i
					end
				end
				self.hits_fired = hits_n
				if (hits_n > 0) then
					local impact_at = self.hit_times[hits_n] + SURGE_HIT_IMPACT_DELAY
					if (diff_sec < impact_at) then
						self.hit_impact_at = impact_at
						self.hit_impact_index = hits_n
					elseif (hits_n < SURGE_HIT_COUNT) then
						self.damage_until = impact_at + SURGE_DAMAGE_WINDOW
					end
				end
				if (diff_sec >= self.hit_times[SURGE_HIT_COUNT]) then
					local fade_elapsed = diff_sec - self.hit_times[SURGE_HIT_COUNT]
					if (fade_elapsed > SURGE_FADE_TIME) then
						fade_elapsed = SURGE_FADE_TIME
					end
					self.fade_t0 = time_global() - fade_elapsed * 1000
				end
				dbg("re-apply done: hits_fired=%d", self.hits_fired)
				self.loaded = false
			end

			-- Удары выброса: запускаем ppe, урон/звук/anm — через SURGE_HIT_IMPACT_DELAY секунд
			while (self.hits_fired < SURGE_HIT_COUNT) and (diff_sec >= self.hit_times[self.hits_fired + 1]) do
				self.hits_fired = self.hits_fired + 1
				self.hit_impact_at = self.hit_times[self.hits_fired] + SURGE_HIT_IMPACT_DELAY
				self.hit_impact_index = self.hits_fired
				dbg("hit %d/%d: ppe at diff=%d, gain id=%d, impact at %d",
					self.hits_fired, SURGE_HIT_COUNT, diff_sec, SURGE_GAIN_PP_EFFS[self.hits_fired], self.hit_impact_at)
				level.add_pp_effector("event\\surge_gain.ppe", SURGE_GAIN_PP_EFFS[self.hits_fired], false)
				level.add_cam_effector_lerp("camera_effects\\shell_shock.anm", shell_shock_cam_eff, true)
				level.set_cam_effector_factor(shell_shock_cam_eff, 0)
				self.shock_t0 = time_global()
				if (self.hits_fired == 1) then
					db.actor:give_info_portion("olr_blowout_phase_2")
					dbg("hit 1: phase_2 given")
				end
				if (self.hits_fired == SURGE_HIT_COUNT) then
					self.fade_t0 = time_global()
				end
			end

			-- Момент удара: урон + звук + cam-anm (в укрытии или с защитой — fatigue, иначе drunk)
			if (self.hit_impact_at) and (diff_sec >= self.hit_impact_at) then
				local hit_i = self.hit_impact_index
				local impact_at = self.hit_impact_at
				self.hit_impact_at = nil
				self.hit_impact_index = nil
				dbg("hit %d impact: sound=%s", hit_i, SURGE_HIT_SOUNDS[hit_i])

				xr_sound_cop.set_sound_play(db.actor:id(), SURGE_HIT_SOUNDS[hit_i], SURGE_SOUND_VOL.hits[hit_i])

				if (not self:actor_cover()) then
					dbg("hit %d impact: OUT of cover, psy dmg=%.2f, stamina drop", hit_i, SURGE_PSY_HIT_DAMAGE)
					self:apply_psy_damage(SURGE_PSY_HIT_DAMAGE, ANTIVIBROS_HIT_COND)
					local stam_to = math.random(10, 20) / 100
					if (db.actor.power > stam_to) then
						db.actor.power = stam_to
					end
				else
					dbg("hit %d impact: in cover, no psy damage", hit_i)
				end

				if (hit_i < SURGE_HIT_COUNT) then
					self.damage_until = impact_at + SURGE_DAMAGE_WINDOW
				end

				local cam_path = "camera_effects\\drunk.anm"
				if (self:actor_cover()) or (self:has_protection()) then
					cam_path = "camera_effects\\fatigue.anm"
				end
				dbg("hit %d impact: cam=%s", hit_i, cam_path)
				level.add_cam_effector(cam_path, SURGE_HIT_CAM_IDS[hit_i], false, "")
			end

			-- Сообщение о начале выброса: текст, одноразовая инфа про укрытия, phase_1, звук начала и автосейв
			if (not self.message_given) and (diff_sec >= self.message_time) then
				local text_phrase = {
					"st_olr_blowout_warning_1",
					"st_olr_blowout_warning_2",
					"st_olr_blowout_warning_3",
					"st_olr_blowout_warning_4"
				}
				news_manager.send_tip(db.actor, game.translate_string(text_phrase[math.random(#text_phrase)]), math.random(1000, 3000), "info", 15000)
				if not has_alife_info("olr_blowout_first_hideouts") then
					db.actor:give_info_portion("olr_blowout_first_hideouts")
					olr_timers.st_timer_game("olr_blowout_first_hideouts", math.random(120, 720), "nick.olr_blowout_first_hideouts()") -- Через 120-720 секунд (2 минуты - 12 минут) Жаба напишет что бы искал укрытие
				end
				db.actor:give_info_portion("olr_blowout_phase_1")
				xr_sound_cop.set_sound_play(db.actor:id(), "blowout_begin")
				self.message_given = true
				if not olr_sleep.check_actor_sleep() then
					save_manager.create_named_save("st_save_uni_surge_start")
					dbg("autosave on blowout message")
				end
				dbg("message fired at diff=%d (phase_1 + first_hideouts + blowout_begin)", diff_sec)
			end
			if (diff_sec < (self.damage_until or 0)) and not self.ui_disabled and not self:actor_cover() then
				local tick_damage = SURGE_PSY_TICK_BASE + diff_sec * SURGE_PSY_TICK_GROW
				dbg("psy tick at diff=%d: dmg=%.4f", diff_sec, tick_damage)
				self:apply_psy_damage(tick_damage, ANTIVIBROS_TICK_COND)
			end

			-- Посекундные триггеры фаз (независимые if — события могут прийтись на одну секунду)
			-- Задача выброса: погода и поршень
			if (diff_sec >= 0) and not (self.task_given) then
				level.set_weather_fx("surge")
				-- Таски тоже отключаю для вас, нужны правки в движке на откат стадий тасков типа как в ЗП (стекольщик сказал нахуй надо, поэтому увы...)
				-- xvars.quests_all_ids = xvars.quests_all_ids + 1
				-- self:give_surge_hide_task()
				self.task_given = true
				dbg("weather fx 'surge' started at diff=%d", diff_sec)
			end

			-- Стартовый звук и стон
			if (diff_sec >= 5) and (diff_sec < 15) and not (self.start_fx_played) then
				xr_sound_cop.set_sound_play(db.actor:id(), "surge_start_sound", SURGE_SOUND_VOL.start)
				self.start_fx_played = true
				dbg("start sound at diff=%d", diff_sec)
			end
			if (diff_sec >= 27) and (diff_sec < 37) and not (self.moan_played) then
				xr_sound_cop.set_sound_play(db.actor:id(), "surge_moan_sound", SURGE_SOUND_VOL.moan)
				self.moan_played = true
				dbg("moan sound at diff=%d", diff_sec)
			end

			-- Гул выброса
			if (diff_sec >= self.rumble_time) and not (self.blowout_sound) then
				xr_sound_cop.play_sound_looped(db.actor:id(), "blowout_rumble")
				xr_sound_cop.set_volume_sound_looped(db.actor:id(), "blowout_rumble", 0.25)
				self.rumble_t0 = time_global()
				self.blowout_sound = true
				dbg("rumble started at diff=%d (volume up to t4=%d)", diff_sec, self.hit_times[SURGE_HIT_COUNT])
			end

			-- Землетрясение
			if (diff_sec >= self.quake_time) and not (self.second_message_given) then
				xr_sound_cop.play_sound_looped(db.actor:id(), "surge_earthquake_sound_looped")
				xr_sound_cop.set_volume_sound_looped(db.actor:id(), "surge_earthquake_sound_looped", SURGE_SOUND_VOL.quake)
				level.add_cam_effector_lerp("camera_effects\\earthquake.anm", earthquake_cam_eff, true)
				self.quake_t0 = time_global() - math.max(0, diff_sec - self.quake_time) * 1000
				self.second_message_given = true
				dbg("earthquake started at diff=%d, peak at %d", diff_sec, SURGE_QUAKE_PEAK)
			end

			-- Нарастающий ppe -> loop
			if (self.task_given) and (diff_sec >= self.attack_start) and not (self.attack_pending) and not (self.effector_set) then
				if (diff_sec >= self.attack_start + self:get_attack_len()) then
					self:start_surge_loop()
				else
					level.add_pp_effector("event\\surge_fade_attack.ppe", surge_attack_pp_eff, false)
					level.set_pp_effector_factor(surge_attack_pp_eff, SURGE_ATTACK_MIN_FACTOR)
					self.attack_pending = true
					self.attack_t0 = time_global()
					dbg("attack ppe started at diff=%d, len=%d", diff_sec, self:get_attack_len())
				end
			end

			-- После четвёртого удара: loop -> release
			if (self.effector_set) and (diff_sec >= self.hit_times[SURGE_HIT_COUNT] + SURGE_RELEASE_DELAY) and not (self.release_started) then
				self.release_started = true
				level.remove_pp_effector(surge_loop_pp_eff)
				level.add_pp_effector("event\\surge_fade_release.ppe", surge_release_pp_eff, false)
				dbg("loop -> release at diff=%d", diff_sec)
			end

			-- Финальный вердикт: укрытие / защита (прибор или condlist) / смерть — в секунду импульса финального удара
			if (diff_sec >= self.hit_times[SURGE_HIT_COUNT] + SURGE_HIT_IMPACT_DELAY) and not (self.ui_disabled) then
				self:kill_all_unhided()
				dbg("final verdict at diff=%d", diff_sec)
				self.ui_disabled = true
				db.actor:give_info_portion("olr_blowout_phase_3")
				dbg("phase_3 given")
			end
		end
	end
end

function CSurgeManager:start(manual)
	local Y, M, D, h, m, s, ms = 0, 0, 0, 0, 0, 0, 0
	Y, M, D, h, m, s, ms = self.last_surge_time:get(Y, M, D, h, m, s, ms)

	if (manual) then
		self.inited_time = game.get_game_time()
	else
		self.inited_time:set(Y, M, D, h, m, s + self._delta, ms)
	end
	self:build_schedule()

	diff_sec = math.ceil(game.get_game_time():diffSec(self.inited_time) / level.get_time_factor())
	dbg("start: manual=%s, level=%s, delta=%d, diff_sec=%d", tostring(manual), level.name(), self._delta, diff_sec)

	local level_name = level.name()
	if no_blow_levels[level_name] then
		log1("---> surge: skipped because of level!")
		self.skip_message = true
		self:skip_surge()
		return
	end

	level.remove_pp_effector(surge_attack_pp_eff)
	level.remove_pp_effector(surge_loop_pp_eff)
	self:remove_gain_pp_effectors()
	level.remove_pp_effector(surge_release_pp_eff)

	if olr_sleep.check_actor_sleep() == true then
		log1("---> surge: skipped while time forwarding!")
		self:skip_surge()
	else
		self.started = true
		self.finished = false
		dbg("started")
	end
end

function CSurgeManager:skip_surge()
	local Y, M, D, h, m, s, ms = 0, 0, 0, 0, 0, 0, 0
	Y, M, D, h, m, s, ms = self.inited_time:get(Y, M, D, h, m, s, ms)
	self.last_surge_time:set(Y, M, D, h, m, s + self.surge_time, ms)

	dbg("skip_surge: surge_time=%d, last_surge advanced", self.surge_time)
	self.started = false
	self.finished = true
	self._delta = math.random(MIN_SURGE_TIME, MAX_SURGE_TIME)
	self.task_given = false

	self.effector_set = false
	self.second_message_given = false
	self.ui_disabled = false
	self.blowout_sound = false
	self.attack_pending = false
	self.hits_fired = 0
	self.start_fx_played = false
	self.moan_played = false
	self.quake_t0 = nil
	self.hit_impact_at = nil
	self.hit_impact_index = nil
	self.shock_t0 = nil
	self.message_given = false
	self.message_time = nil
	self.damage_until = nil
	self.fade_t0 = nil
	self.fade_done = false
	self.release_started = false
	self.rumble_t0 = nil
	prev_sec = 0

	-- Тут можно выдавать всякие таймеры и очки в статистику за скип выброса (выброса не было - мы его скипнули сном или анабиотиком)
	-- xr_statistic.inc_surges_counter()

	db.actor:give_info_portion("olr_blowout_phase_0")

	-- Захуячил сюда для совместимости, хз лучше переделать по нормальному
	olr_blowout.blowout_ending_set()

	if (not self.skip_message) then
		log1("---> surge: while asleep")
		if (olr_sleep.check_actor_sleep()) then
			self.asleep_surge_pending = true
		else
			news_manager.send_tip(db.actor, "st_surge_while_asleep", 1, "info", 9000)
		end
		self.skip_message = true
	end
end

function CSurgeManager:end_surge(manual)
	dbg("end_surge: manual=%s, time_forwarded=%s", tostring(manual), tostring(self.time_forwarded))
	self.started = false
	self.finished = true
	self.last_surge_time = game.get_game_time()
	self._delta = math.random(MIN_SURGE_TIME, MAX_SURGE_TIME)
	self.task_given = false

	if (self.blowout_sound) then
		xr_sound_cop.stop_sound_looped(db.actor:id(), "blowout_rumble")
	end
	if (self.second_message_given) then
		xr_sound_cop.stop_sound_looped(db.actor:id(), "surge_earthquake_sound_looped")
	end
	xr_sound_cop.set_sound_play(db.actor:id(), "surge_end_sound", SURGE_SOUND_VOL.finish)
	level.remove_pp_effector(surge_attack_pp_eff)
	level.remove_pp_effector(surge_loop_pp_eff)
	self:remove_gain_pp_effectors()
	if not level.is_pp_effector_active(surge_release_pp_eff) then
		level.add_pp_effector("event\\surge_fade_release.ppe", surge_release_pp_eff, false)
		dbg("release added at surge end")
	else
		dbg("release already active at surge end")
	end
	level.remove_cam_effector(earthquake_cam_eff)
	level.remove_cam_effector(shell_shock_cam_eff)

	if (manual or self.time_forwarded) then
		level.stop_weather_fx()
	end

	self.effector_set = false
	self.second_message_given = false
	self.ui_disabled = false
	self.blowout_sound = false
	self.attack_pending = false
	self.hits_fired = 0
	self.start_fx_played = false
	self.moan_played = false
	self.quake_t0 = nil
	self.hit_impact_at = nil
	self.hit_impact_index = nil
	self.shock_t0 = nil
	self.message_given = false
	self.message_time = nil
	self.damage_until = nil
	self.fade_t0 = nil
	self.fade_done = false
	self.release_started = false
	self.rumble_t0 = nil
	prev_sec = 0

	-- Тут можно выдавать всякие таймеры и очки в статистику за окончание выброса (выброс был - мы его пережили)
	-- xr_statistic.inc_surges_counter()

	db.actor:give_info_portion("olr_blowout_phase_0")

	-- Захуячил сюда для совместимости, хз лучше переделать по нормальному
	olr_blowout.blowout_ending_set()

	olr_blowout.lomka_pda()
	olr_blowout.golod_gg()
	olr_blowout.psy_gg()
	dbg("post-surge functions done")
	-- рождение артефактов в аномалиях после выброса ( artefacts_after_surge )
	local spawned_artefacts = 0
	if (alife().spawn_artefacts_after_surge) then
		spawned_artefacts = alife():spawn_artefacts_after_surge()
	end
	if (spawned_artefacts and spawned_artefacts > 0) then
		log1(string.format("[OLR-SURGE] artefacts spawned in anomalies after the surge: %d", spawned_artefacts))
	end
end

function CSurgeManager:give_surge_hide_task()
	local hideout_object = level.object_by_id(self:get_nearest_cover_task():id()):get_alife_object()
	local surge_task = CGameTask()
	local task_id = string.format(xvars.quests_all_ids)
	surge_task:load(task_id, "hide_from_surge")
	surge_task:set_title("hide_from_surge_name_1")

	local SubTask = SGameTaskObjective(surge_task, 1)
	SubTask:set_description("hide_from_surge_name_1")
	SubTask:set_map_hint("surge_common_hide")
	SubTask:set_map_location("defend_lager_location")
	SubTask:set_object_id(hideout_object.id)
	SubTask:add_complete_func("surge_manager.actor_in_cover")
	surge_task:add_objective(SubTask)

	local SubTask2 = SGameTaskObjective(surge_task, 2)
	SubTask2:set_description("hide_from_surge_name_2")
	surge_task:add_objective(SubTask2)
	db.actor:give_task(surge_task, false)
end

function CSurgeManager:has_protection()
	local item = nil
	if (db.actor) then
		item = db.actor:object("pribor_antivibros")
	end
	if (item) and (item:condition() > 0.01) then
		return true
	end

	return (xr_logic.pick_section_from_condlist(db.actor, nil, self.survive) == "true")
end

function CSurgeManager:antivibros_absorb(amount)
	local item = nil
	if (db.actor) then
		item = db.actor:object("pribor_antivibros")
	end
	if (item == nil) then
		return false
	end

	local cond = item:condition()
	if (cond <= 0.01) then
		return false
	end

	local new_cond = cond - amount
	if (new_cond <= 0.01) then
		item:set_condition(0)
		olr.del(item)
	else
		item:set_condition(new_cond)
	end
	dbg("antivibros absorbs %.2f, cond -> %.2f", amount, new_cond)
	return true
end

function CSurgeManager:apply_psy_damage(amount, absorb_cost)
	if (self:antivibros_absorb(absorb_cost)) then
		return
	end

	if (xr_logic.pick_section_from_condlist(db.actor, nil, self.survive) == "true" and db.actor.psy_health - amount < 0.05) then
		amount = db.actor.psy_health - 0.05
		if (amount < 0) then
			amount = 0
		end
	end

	db.actor.psy_health = -amount
end

function CSurgeManager:kill_all_unhided()
	if (db.actor and db.actor:alive()) then
		if not self:actor_cover() then
			if (self:antivibros_absorb(1.0) or (xr_logic.pick_section_from_condlist(db.actor, nil, self.survive) == "true")) then
				log1("---> surge: actor survived on protection!")
				xr_effects.disable_ui(db.actor, nil)
				level.add_cam_effector("camera_effects\\surge_02.anm", sleep_cam_eff, false, "surge_manager.surge_callback")
				level.add_pp_effector("event\\deprecated\\surge_fade.ppe", sleep_fade_pp_eff, false)
			else
				db.actor:kill(db.actor)
				log1("---> surge: actor killed by surge!")
			end
		end
	end
end

function surge_callback()
	level.add_cam_effector("camera_effects\\surge_01.anm", sleep_cam_eff, false, "surge_manager.surge_callback2")
end

function surge_callback2()
	xr_effects.enable_ui(db.actor, nil)
end

function CSurgeManager:save(packet)
	set_save_marker(packet, "save", false, "SurgeHide")
	packet:w_bool(self.finished)
	packet:w_bool(self.started)
	utils.w_CTime(packet, self.last_surge_time)

	if (self.started) then
		utils.w_CTime(packet, self.inited_time)

		packet:w_bool(self.task_given)
		packet:w_bool(self.effector_set)
		packet:w_bool(self.second_message_given)
		packet:w_bool(self.ui_disabled)
		packet:w_bool(self.blowout_sound)
	end

	packet:w_u32(self._delta)
	dbg("save: started=%s, task=%s, effector=%s, second=%s, ui=%s, rumble=%s, delta=%d",
		tostring(self.started), tostring(self.task_given), tostring(self.effector_set),
		tostring(self.second_message_given), tostring(self.ui_disabled), tostring(self.blowout_sound), self._delta)
	set_save_marker(packet, "save", true, "SurgeHide")
end

function CSurgeManager:load(packet)
	set_save_marker(packet, "load", false, "SurgeHide")
	self:initialize()

	self.finished = packet:r_bool()
	self.started = packet:r_bool()
	self.last_surge_time = utils.r_CTime(packet)

	if (self.started) then
		self.inited_time = utils.r_CTime(packet)

		self.task_given = packet:r_bool()
		self.effector_set = packet:r_bool()
		self.second_message_given = packet:r_bool()
		self.ui_disabled = packet:r_bool()
		self.blowout_sound = packet:r_bool()

		self.need_weather_restore = self.task_given
	else
		self.need_reinit_covers = true
	end

	self._delta = packet:r_u32()
	dbg("load: started=%s, delta=%d", tostring(self.started), self._delta)
	self.loaded = true

	if (self.started) then
		self:build_schedule()
		local diff = math.ceil(game.get_game_time():diffSec(self.inited_time) / level.get_time_factor())
		self.message_given = (diff > self.message_time)
		dbg("load: diff=%d, message_given=%s", diff, tostring(self.message_given))
	end

	set_save_marker(packet, "load", true, "SurgeHide")
end

function get_surge_manager()
	if surge_manager == nil then
		surge_manager = CSurgeManager()
	end
	return surge_manager
end

function start_surge(p)
	local m = get_surge_manager()
	if (m:get_nearest_cover()) then
		m:start(true)
	else
		log1("---> surge: covers are not set!")
	end
end

function actor_in_cover()
	local m = get_surge_manager()
	return m:actor_cover()
end

function stop_surge()
	local m = get_surge_manager()
	if (m.started) then
		m:end_surge(true)
	end
end

function get_task_target()
	local m = get_surge_manager()
	if (actor_in_cover()) then
		return nil
	end
	return m:get_nearest_cover()
end

function is_started()
	local m = get_surge_manager()
	return m.started
end

function is_killing_all()
	local m = get_surge_manager()
	if (m.started and m.ui_disabled) then
		return true
	end
	return false
end

function is_finished()
	local m = get_surge_manager()
	return m.finished == true
end

function resurrect_skip_message()
	local m = get_surge_manager()
	m.skip_message = false
	m.asleep_surge_pending = false
end

function sound_started()
	local m = get_surge_manager()
	return m.started and m.blowout_sound
end

-- ѕолучаем сообщение о времени до следующего выброса в игровых часах (сделал дл¤ себ¤, у вас нигде не используетс¤)
function get_time_until_next_surge_hours()
	local m = get_surge_manager()
	if m.started then return nil end
	local diff_time = game.get_game_time():diffSec(m.last_surge_time)
	return (m._delta - diff_time) / 3600
end

function is_surge_active()
	local m = get_surge_manager()
	return m.started == true
end

function get_time_until_next_surge()
	local m = get_surge_manager()
	local diff_time = game.get_game_time():diffSec(m.last_surge_time)
	local diff = math.floor((m._delta - diff_time) / 3600)
	if diff >= 1 then
		news_manager.send_tip(db.actor, game.translate_string("until_next_surge").." "..diff.." "..game.translate_string("ui_st_hours"), nil, "saharov", 5000)
	else
		news_manager.send_tip(db.actor, game.translate_string("until_next_surge_soon"), nil, "saharov", 5000)
	end
end

function get_time_until_next_surge_minutes()
	local m = get_surge_manager()
	if m.started then return nil end
	local diff_time = game.get_game_time():diffSec(m.last_surge_time)
	return (m._delta - diff_time) / 60
end

function add_time_until_next_surge(minutes)
	if not minutes then return end
	local m = get_surge_manager()
	m._delta = m._delta + minutes * 60
end

function sub_time_until_next_surge(minutes)
	if not minutes then return end
	local m = get_surge_manager()
	m._delta = m._delta - minutes * 60
end

-- Тихо пропускает выброс: без новостей и без пост-выбросовых функций, только пересчёт времени до выброса
function skip_surge_silent()
	local m = get_surge_manager()
	dbg("skip_surge_silent: started=%s", tostring(m.started))

	if (m.started) then
		xr_sound_cop.stop_sound_looped(db.actor:id(), "blowout_rumble")
		xr_sound_cop.stop_sound_looped(db.actor:id(), "surge_earthquake_sound_looped")
		level.remove_pp_effector(surge_attack_pp_eff)
		level.remove_pp_effector(surge_loop_pp_eff)
		m:remove_gain_pp_effectors()
		level.remove_pp_effector(surge_release_pp_eff)
		level.remove_cam_effector(earthquake_cam_eff)
		if (m.task_given) then
			level.stop_weather_fx()
		end
		db.actor:give_info_portion("olr_blowout_phase_0")
	end

	m.started = false
	m.finished = true
	m.last_surge_time = game.get_game_time()
	m._delta = math.random(MIN_SURGE_TIME, MAX_SURGE_TIME)
	m.task_given = false
	m.effector_set = false
	m.second_message_given = false
	m.ui_disabled = false
	m.blowout_sound = false
	m.attack_pending = false
	m.hits_fired = 0
	m.start_fx_played = false
	m.moan_played = false
	m.quake_t0 = nil
	m.hit_impact_at = nil
	m.hit_impact_index = nil
	m.shock_t0 = nil
	m.message_given = false
	m.message_time = nil
	m.damage_until = nil
	m.fade_t0 = nil
	m.fade_done = false
	m.release_started = false
	m.rumble_t0 = nil
	m.time_forwarded = false
	prev_sec = 0
end

-- Сообщение о выбросе, прошедшем во сне (показывается при пробуждении)
function notify_wake()
	local m = get_surge_manager()
	if (m.asleep_surge_pending) then
		m.asleep_surge_pending = false
		news_manager.send_tip(db.actor, "st_surge_while_asleep", 1, "info", 9000)
	end
end