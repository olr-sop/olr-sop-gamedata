class "opt_gameplay" (CUIWindow)

function opt_gameplay:__init() super()
end

function opt_gameplay:__finalize()

end

-- одна строка настроек: контейнер templ_item, в него кладутся подпись и контрол.
-- высота строки и порядок задаются в XML (tab_gameplay:templ_item) и скроллом,
-- вручную координаты y больше не нужны.
function opt_gameplay:AddRow(xml)
	local row = xml:InitStatic("tab_gameplay:templ_item", nil)
	self.scroll:AddWindow(row, true)
	return row
end

function opt_gameplay:InitControls(x, y, xml, handler)

	self:Init(x,y, 738, 416)
	self:SetAutoDelete(true)

	self.bk = xml:InitFrame("frame_gameplay", self)
	self.scroll = xml:InitScrollView("tab_gameplay:scroll_v", self)

	local row

	row = self:AddRow(xml)
	xml:InitStatic("tab_gameplay:cap_difficulty",		row)
	xml:InitComboBox("tab_gameplay:list_difficulty",	row)

	row = self:AddRow(xml)
	xml:InitStatic("tab_gameplay:cap_language",			row)
	xml:InitComboBox("tab_gameplay:list_language",		row)

	row = self:AddRow(xml)
	xml:InitStatic("tab_gameplay:cap_hud_type",			row)
	xml:InitComboBox("tab_gameplay:list_hud_type",		row)

	row = self:AddRow(xml)
	xml:InitStatic("tab_gameplay:cap_pda_type",			row)
	xml:InitComboBox("tab_gameplay:list_pda_type",		row)

	row = self:AddRow(xml)
	handler.check_crosshair = xml:InitCheck("tab_gameplay:check_crosshair",	row)
	handler:Register														(handler.check_crosshair, "check_crosshair")

	row = self:AddRow(xml)
	handler.check_dyn_crosshair = xml:InitCheck("tab_gameplay:check_dyn_crosshair", row)

	row = self:AddRow(xml)
	xml:InitCheck("tab_gameplay:check_show_weapon",		row)

	row = self:AddRow(xml)
	xml:InitCheck("tab_gameplay:check_dist",			row)

	row = self:AddRow(xml)
	handler.check_hud_info = xml:InitCheck("tab_gameplay:check_hud_info",	row)

	row = self:AddRow(xml)
	xml:InitCheck("tab_gameplay:check_buildobobbing",	row)

	row = self:AddRow(xml)
	handler.check_crosshair_cross = xml:InitCheck("tab_gameplay:check_crosshair_cross", row)
end
