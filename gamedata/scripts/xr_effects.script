-- ----------------------------------------------------------------------------------------------------
-- Функции для Янтаря
-- ----------------------------------------------------------------------------------------------------
function use_drink_yan()
	if xvars.yan_use_drink_yan == false then
			news_manager.send_tip(db.actor, game.translate_string("use_drink_yan_0"), nil, "info", 9000)
	return
	end
	local ustalost = db.actor.thirst
	if ustalost>0.80 then
		news_manager.send_tip(db.actor, game.translate_string("use_drink_yan_1"), nil, "info", 9000)
		return 
	end
	db.actor:change_actor_thirst(1)
	xvars.yan_use_drink_yan = false
	olr_timers.st_timer("use_drink_yan", 950, "xr_effects.yan_use_drink_yan_on()")
end

function yan_use_drink_yan_on()
	xvars.yan_use_drink_yan = true
end

function yan_poltrs_spawn_ph()
	olr.snd([[ambient\special\yantar_poltergeists_spawn]])
	olr.spawn_on_obj("m_poltergeist_e", "lvl7_yantar_space_restrictor_0004")
	olr.spawn_on_obj("m_poltergeist_e", "lvl7_yantar_space_restrictor_0004")
	olr.del_by_name("lvl7_yantar_space_restrictor_0004")
end

function yan_attack_heli_dead()
	xr_effects.kill_actor()
	db.actor.health = -1
	local snd_obj = xr_sound.get_safe_sound_object([[weapons\svu\shoot]])
	if not snd_obj:playing() then 
		snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)	
	end
end

function del_final_bun_spasen_end()
	olr.del_by_name("lvl7_yantar_stalker_0058")
end

function use_yan_tru_otkl()
	olr.del_by_name("lvl7_yantar_physic_object_0134")
	olr.info("pre_radar_de_done")
end

function use_meatdevice_yan()  -- lvl7_yantar_physic_object_0760 
	if not has_alife_info("yan_biolab_start_quest_done_talked") then
		news_manager.send_tip(db.actor, game.translate_string("use_meatdevice_yan_0"), nil, "hero", 39000)
		return
	end
	local STbronb = db.actor:object("rat_food")
	if STbronb then
		xvars.meat_money = xvars.meat_money + 80
		news_manager.send_tip(db.actor, game.translate_string("st_xr_effects_item_transfered")..STbronb:get_name().." ", nil, "default", 9000)
		olr.del(STbronb)
		return
	end
	local STbronb = db.actor:object("crow_food")
	if STbronb then
		xvars.meat_money = xvars.meat_money + 95
