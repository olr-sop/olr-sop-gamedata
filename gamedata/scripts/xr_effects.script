function use_yanprib_hata()
	if not has_alife_info("prof_uletel_gde_laborant_start_talked") then
		--news_manager.send_tip(db.actor, game.translate_string("use_yanprib_hata_0"), nil, "default", 30000)
		olr.hud_tip("", game.translate_string("use_yanprib_hata_0"), 3, true)
		return
	end
	if not has_alife_info("yan_dot_start_zamery") then
		news_manager.send_tip(db.actor, game.translate_string("st_xr_effects_psi_measurer_1").." "..xvars.yan_phase_zam_quest.." "..game.translate_string("st_xr_effects_psi_measurer_2"), nil, "info", 5000, nil, nil, true, "st_xr_effects_psi_measurer")
		db.actor:give_info_portion("yan_dot_start_zamery")
		xvars.yan_phase_zam_quest_flag = false
		olr_timers.st_timer("omsffsss3", 25, "xr_effects.yan_phase_zam_quest_on()")
		if not has_alife_info("yan_dot_start_zamery_done") then
			olr_timers.st_timer("yan_zam_zombies_rush", 8, "nick.yan_zam_zombies_rush_spawen()")
		end
		return
	end
	if xvars.yan_phase_zam_quest_flag == true then
		xvars.yan_phase_zam_quest = xvars.yan_phase_zam_quest + 1
		if xvars.yan_phase_zam_quest < 5 then
			olr_timers.st_timer("omsffsss3", 25, "xr_effects.yan_phase_zam_quest_on()")
		end
		xvars.yan_phase_zam_quest_flag = false
		
		news_manager.send_tip(db.actor, game.translate_string("use_yanprib_hata_1"), nil, "info", 5000, nil, nil, true, "st_xr_effects_psi_measurer")
		if xvars.yan_phase_zam_quest >= 5 then
			db.actor:give_info_portion("yan_dot_start_zamery_done")
			news_manager.send_tip(db.actor, game.translate_string("use_yanprib_hata_2"), nil, "info", 5000, nil, nil, true, "st_xr_effects_psi_measurer")
		end
	end
end

function yan_phase_zam_quest_on()
	if xvars.yan_phase_zam_quest < 5 then
		news_manager.send_tip(db.actor, game.translate_string("yan_phase_zam_quest_on_0"))
		xvars.yan_phase_zam_quest_flag = true
		olr_timers.st_timer("omsffsss3", 5, "xr_effects.yan_phase_zam_quest_off()")
	end
end

function yan_phase_zam_quest_off()
	if xvars.yan_phase_zam_quest < 5 then
		news_manager.send_tip(db.actor, game.translate_string("st_xr_effects_psi_measurer_3")..xvars.yan_phase_zam_quest.." "..game.translate_string("st_xr_effects_psi_measurer_4"), nil, "info", nil, nil, true, "st_xr_effects_psi_measurer")
		xvars.yan_phase_zam_quest_flag = false
		olr_timers.st_timer("omsffsss3", math.random(35,90), "xr_effects.yan_phase_zam_quest_on()")
	end
end

