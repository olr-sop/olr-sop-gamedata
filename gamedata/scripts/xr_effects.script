-- ----------------------------------------------------------------------------------------------------
-- Функции для сна
-- ----------------------------------------------------------------------------------------------------
-- Основная функция для проверок, используется во всех местах сна
function sleep_check()
	-- проверка на выброс
	if has_alife_info("olr_blowout_phase_1") or has_alife_info("olr_blowout_phase_2") or has_alife_info("olr_blowout_phase_3") then
		news_manager.send_tip(db.actor, game.translate_string("st_sleep_blowout"), nil, "info")
		return false
	end

	-- фром кок, проверки на ранение и радиацию
	local bleeding = db.actor.bleeding > 0
	local radiation = db.actor.radiation > 0

	if (bleeding or radiation) then
		if (bleeding and radiation) then
			news_manager.send_tip(db.actor, game.translate_string("st_sleep_bleeding_radiation"), nil, "info")
		elseif (bleeding) then
			news_manager.send_tip(db.actor, game.translate_string("st_sleep_bleeding"), nil, "info")
		elseif (radiation) then
			news_manager.send_tip(db.actor, game.translate_string("st_sleep_radiation"), nil, "info")
		end
		return false
	end	
	
	-- проверка что на улице ночь
	if not has_alife_info("olr_traders_day") then
		return true
	end
	-- если день то проверяем нашу сониловость
	local sleep_level = db.actor.sleep
	-- при сонливости менее 0.5 идём спать, иначе не спать
	if sleep_level <= 0.5 then
		return true
	else
		news_manager.send_tip(db.actor, game.translate_string("st_sleep_not_tired"), nil, "info", 30000)
		return false
	end
	return false
end

-- Янтарь, бункер учёных
function use_spat_hata_yan()
	-- Оставлю пока старый код, ибо я запутался нах
	--[[
	if not has_alife_info("laborant_otpravlaet_spat_gg_finished") then
		news_manager.send_tip(db.actor, game.translate_string("use_spat_hata_yan_0"), nil, "info", 30000)
		return
	end
	if has_alife_info("otpravlaet_spat_gg_done") then
		return
	end
	olr_sleep.sleep_main(6)
	db.actor:change_actor_sleep(1)
	olr_timers.st_timer("dedsmert", 10, "nick.ded_pomeraet_yan()")
	--]]
	if has_alife_info("laborant_otpravlaet_spat_gg_finished") and not has_alife_info("otpravlaet_spat_gg_done") then -- Если у нас есть поршень что нас отправили поспать и нет поршня что поспали
		olr_sleep.sleep_main(1,0,true) -- Основная функция сна
		olr_timers.st_timer_game("dedsmert", 1, "nick.ded_pomeraet_yan()") -- Запускаем самоубийство деда через 1 игровую секунду, ну не сразу короче (пока оставим так)
		return -- уходим отсюда сразу, проверок не делаем
	end
	if sleep_check() then
		olr_sleep.sleep_main(0,0,true) -- Основная функция сна
	end	
end

-- Бар, в школе
function use_spat_hata()
    if has_alife_info("lonewolf_bar_spawn") and not has_alife_info("sleeped_in_shlkola_done") then -- проверяем на поршни спавна одинокого волка в баре и что мы не поспали в школе
        db.actor:give_info_portion("sleeped_in_shlkola_done")
		olr_sleep.sleep_main(0,0,true) -- Основная функция сна
		return -- уходим отсюда сразу, проверок не делаем
    end
	if sleep_check() then
		olr_sleep.sleep_main(0,0,true) -- Основная функция сна
	end
end

