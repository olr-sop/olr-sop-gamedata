function use_tip_press_button_gar()
	if not has_alife_info("now_use_tip_press_button_gar") then
		db.actor:give_info_portion("now_use_tip_press_button_gar")
		local snd_obj = xr_sound.get_safe_sound_object([[ambient\special\garbage_open_door]])
		if not snd_obj:playing() then 
			snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
		end
		local bloodbridge = vector():set(-46.5, 6.4, 261.37)
		alife():create("kanistra_benz", bloodbridge,db.actor:level_vertex_id(),	db.actor:game_vertex_id())
		olr.spawn_on_obj("kanistra_benz", "lvl2_garbage_physic_object_0017")
		olr.del_by_name("lvl2_garbage_physic_object_0110")
	end
end

function take_gar_deathlamp()
	if has_alife_info("garbage_can_take_lamp") then
		olr.del_by_name("lvl2_garbage_physic_object_0114")
		olr.give_item("af_lamp")
		olr.horror_snd()
  		level.add_call(
    		function() return time_global() > time_global() + 5000 end,
    		function() olr.hud_tip("", game.translate_string("take_gar_deathlamp_0"), 5, true) end
  		)
  		level.add_call(
    		function() return time_global() > time_global() + 10000 end,
    		function() olr.hud_tip("", game.translate_string("take_gar_deathlamp_1"), 5, true) end
  		)
  		level.add_call(
    		function() return time_global() > time_global() + 15000 end,
    		function() olr.hud_tip("", game.translate_string("take_gar_deathlamp_2"), 5, true) end
  		)					
	end
end

