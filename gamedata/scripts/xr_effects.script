function phantsam_hitted()
	if math.random(1, 25) == 2 then
		nick.phantasms_zombies()
		olr.horror_snd()
	end

	local effect_for_wpn = {
		["wpn_rg-6"] = true,
		["wpn_rg6_m1"] = true,
		["wpn_rpg7"] = true
	}

	local cur_weapon = db.actor:active_item()
	if cur_weapon ~= nil then
		local cur_weapon_sec = cur_weapon:section()
		if effect_for_wpn[cur_weapon_sec] ~= nil then
			db.actor.health = -0.06
			level.add_pp_effector("dead_zone.ppe", 971974, false)
			--level.add_cam_effector("camera_effects\\fatigue.anm", 19749, true, "")
			local song_start = xr_sound.get_safe_sound_object([[ambient\special\heartbeat_fast]])
			song_start:play_at_pos(db.actor, db.actor:position(), sound_object.s3d)
			db.actor.psy_health = -0.1
			nick.phantasms_zombies()
			nick.rnd_ppe_eff()
			phatstm_telep()
		end
	end
end

function phatstm_telep()
	-- Получаем объект фантома напрямую
	local phantom = alife():object("lvl8_swamp_phantasm")
	if not phantom then return end

	-- Таблица возможных позиций для телепортации
	local teleport_positions = {
		vector():set(-3, 3, -213),	 -- позиция 1
		vector():set(127, 2, -179),	  -- позиция 2
		vector():set(184, 3, -202),	  -- позиция 3
		vector():set(65, -6, -181),	  -- позиция 4
		vector():set(0, -6, -207)	  -- позиция 5
	}

	local new_pos = teleport_positions[math.random(1, #teleport_positions)]
	alife():teleport_object(phantom.id, db.actor:game_vertex_id(), db.actor:level_vertex_id(), new_pos)
end

