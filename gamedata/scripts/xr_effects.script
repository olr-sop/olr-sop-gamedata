function try_radbun_antenaupr()	 -- вводим код
	if not has_alife_info("jornal_1_taken") then
		news_manager.send_tip(db.actor, game.translate_string("try_radbun_antenaupr_0"), nil, "default", 15000)
		return
	end
	if not has_alife_info("jornal_3_taken") then
		news_manager.send_tip(db.actor, game.translate_string("try_radbun_antenaupr_1"), nil, "default", 15000)
		return
	end
	if not has_alife_info("spawn_doks_holmy") then
		news_manager.send_tip(db.actor, game.translate_string("try_radbun_antenaupr_2"), nil, "default", 15000)
		return
	end
	if not has_alife_info("spawn_doks_yantar") then
		news_manager.send_tip(db.actor, game.translate_string("try_radbun_antenaupr_3"), nil, "default", 15000)
		return
	end
	if not has_alife_info("spawn_doks_radar") then
		news_manager.send_tip(db.actor, game.translate_string("try_radbun_antenaupr_4"), nil, "default", 15000)
		return
	end
	if not has_alife_info("jornal_6_taken") then
		news_manager.send_tip(db.actor, game.translate_string("try_radbun_antenaupr_5"), nil, "default", 15000)
		return
	end
	if not has_alife_info("spawn_jourlalist") then
		news_manager.send_tip(db.actor, game.translate_string("try_radbun_antenaupr_6"), nil, "default", 15000)
		return
	end
	if has_alife_info("radbun_antena_bar") then
		olr.info("pre_aes_antenna_off")
		nick.set_level_choosen_zombied("lvl5_bar")
		news_manager.send_tip(db.actor, game.translate_string("try_radbun_antenaupr_7"), 50, "dolg", 35000)
		olr.del_by_name("lvl12_radar_bunker_physic_shitok_zal_0000")
		level.add_pp_effector("blink.ppe", 20131, false)
		return
	end
	if has_alife_info("radbun_antena_mg") then
		olr.info("pre_aes_antenna_off")
		nick.set_level_choosen_zombied("lvl11_deadcity")
		news_manager.send_tip(db.actor, game.translate_string("try_radbun_antenaupr_8"), 50, "freedom", 35000)
		olr.del_by_name("lvl12_radar_bunker_physic_shitok_zal_0000")
		level.add_pp_effector("blink.ppe", 20131, false)
		return
	end
	if has_alife_info("radbun_antena_yan") then
		olr.info("pre_aes_antenna_off")
		nick.set_level_choosen_zombied("lvl7_yantar")
		news_manager.send_tip(db.actor, game.translate_string("try_radbun_antenaupr_9"), 50, "ecolog", 35000)
		olr.del_by_name("lvl12_radar_bunker_physic_shitok_zal_0000")
		level.add_pp_effector("blink.ppe", 20131, false)
		return
	end
end

