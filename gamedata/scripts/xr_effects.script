function esc_prizrak_hitted()
	local mrandom = math.random

	if not has_alife_info("jaba_start_phanrom_spawen_agressive") then
		xr_effects.kill_actor()
		db.actor.health = -11
	end
	
	db.actor.health = -0.03
	level.add_pp_effector("dead_zone.ppe", 971974, false)
	local song_start = xr_sound.get_safe_sound_object([[ambient\special\heartbeat_fast]])
	song_start:play_at_pos(db.actor, db.actor:position(), sound_object.s3d)
	db.actor.psy_health = -0.05

	-- Случайные эффекты
	local rnd = mrandom(1, 5)
	if rnd == 1 then
		olr.horror_snd()
	elseif rnd == 2 then
		olr.spawen_phantoms()
	elseif rnd == 3 or rnd == 4 then
		olr.spawn_crows(2, 22)
	elseif rnd == 5 then
		for id = 1, mrandom(1, 2) do
			local sectionsa = {
				"zombie_weak",
				"zombie_normal",
				"zombie_strong",
			}
			local section = sectionsa[math.random(#sectionsa)]
			alife():create(section, db.actor:position():add(db.actor:direction():mul(-24)), db.actor:level_vertex_id(), db.actor:game_vertex_id())
		end
	end

	nick.set_norm_relation_stalkers()

	local target = alife():object("lvl1_escape_stalker_0038")
	if target then
		local level_obj = level.object_by_id(target.id)
		if level_obj then
			-- Создаем партиклы
			local boss_particle = particles_object("anomaly2\\body_tear_00")
			boss_particle:play_at_pos(level_obj:position())

			-- Случайная телепортация
			local teleport_positions = {
				vector():set(46, 3, 145),	-- позиция 1
				vector():set(64, 3, 169),	-- позиция 2
				vector():set(71, 11, 164),	-- позиция 3
				vector():set(66, 3, 150),	-- позиция 4
				vector():set(56, -0.36, 157) -- позиция 5
			}
			
			local new_pos = teleport_positions[mrandom(1, 5)]
			level_obj:set_position(new_pos)
		end
	end
end

