function mg_boloto_hitted()
	local effect_for_wpn = {
		["wpn_rg-6"] = true,
		["wpn_rg6_m1"] = true,
		["wpn_rpg7"] = true
	}

	local cur_weapon = db.actor:active_item()
	if cur_weapon == nil then return end
	
	local cur_weapon_sec = cur_weapon:section()
	if not effect_for_wpn[cur_weapon_sec] then return end

	-- Применяем эффекты к актору
	db.actor.health = -0.05
	level.add_pp_effector("dead_zone.ppe", 971974, false)
	local song_start = xr_sound.get_safe_sound_object([[ambient\special\heartbeat_fast]])
	song_start:play_at_pos(db.actor, db.actor:position(), sound_object.s3d)
	db.actor.psy_health = -0.05
	nick.rnd_ppe_eff()
	nick.phantasms_zombies()

    local observer = alife():object("lvl11_deadcity_observer")
    if not observer then return end
    
    local level_observer = level.object_by_id(observer.id)
    if not level_observer or level_observer.health <= 0 then return end

	local bez_var = math.random(1, 5)
	local teleport_effects = {
		[1] = function()
			for i = 1, 12 do
				local wait_time = time_global() + i * 1000
				level.add_call(
					function() return time_global() > wait_time end,
					function()
						local rndx = math.random(186, 195)
						local rndy = math.random(146, 165)
						level_observer:set_position(vector():set(rndx, -5, rndy))
						local snd_obj = xr_sound.get_safe_sound_object([[monsters\biting\def_0]])
						snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
					end
				)
			end
			olr.spawen_phantoms()
			xr_sound.get_safe_sound_object([[ambient\weather\earthquake]]):play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 2.0)
		end,
		[2] = function()
			level_observer:set_position(vector():set(178, -9, 186))
			olr.spawen_phantoms()
			olr.horror_snd()
			xr_sound.get_safe_sound_object([[ambient\special\heartbeat_fast]]):play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 3.0)
		end,
		[3] = function()
			level_observer:set_position(vector():set(177, -9, 127))
			olr.spawen_phantoms()
			olr.horror_snd()
			xr_sound.get_safe_sound_object([[anomaly\stancia_thunder]]):play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 4.0)
		end,
		[4] = function()
			level_observer:set_position(vector():set(165, -9, 151))
			olr.spawen_phantoms()
			olr.horror_snd()
			xr_sound.get_safe_sound_object([[actor\hit_fist]]):play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 3.0)
		end,
		[5] = function()
			level_observer:set_position(vector():set(176, -9, 151))
			olr.spawen_phantoms()
			olr.horror_snd()
		end
	}

	-- Выполняем выбранный эффект
	if teleport_effects[bez_var] then
		teleport_effects[bez_var]()
	end
end

