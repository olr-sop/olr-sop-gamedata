function take_psyhead_yan()
	local mrandom = math.random
	if has_alife_info("yan_doc_psy_start_has") then
		olr.del_by_name("lvl7_yantar_physic_object_0708")
		nik_dialog.out_item_much("proto_psy_shap",1)
		if mrandom(2) == 1 then
			db.actor.health = -db.actor.health/mrandom(2,5)
		end
		if mrandom(2) == 1 then
			db.actor.power = -db.actor.power/mrandom(2,5)
		end
		if mrandom(2) == 1 then
			db.actor.psy_health = -db.actor.psy_health/mrandom(2,5)
		end
		if mrandom(2) == 1 then
			db.actor.radiation = -db.actor.radiation/mrandom(2,5)
		end
		local snd_obj = xr_sound.get_safe_sound_object([[ambient\special\low_base]])
		if not snd_obj:playing() then 
			snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)	
		end
		alife():create("af_deadhead", db.actor:position(),db.actor:level_vertex_id(),  db.actor:game_vertex_id(),db.actor:id())
		level.add_pp_effector("radar_wake.ppe", 20131, false)
		db.actor:give_info_portion("take_psyhead_yan_have")
		--nik_dialog.out_item_much("proto_psy_shap",1)
	end
end

