#include "common.h"

struct 	v2p
{
 	float2 	tc0	: 	TEXCOORD0;	// base
	half4	c	:	COLOR0;		// diffuse
};


//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
half4 	main	( v2p I )	: COLOR
{
    half4 result = I.c * tex2D(s_base, I.tc0);
    clip(result.a - (0.01f / 255.0f));
    
    return result;
}
