#include "common.h"

struct v2p
{
	float3 fog_pos : TEXCOORD6;
	float  fog_y   : TEXCOORD7;
	float  fog	: FOG;
};

float4 main(v2p I) : COLOR
{
	float height_fog = r1a_height_fog_factor(I.fog_pos, I.fog_y);
	float density = saturate(height_fog * r1a_fog_volume_params.x);

	float3 fog_col = r1a_fog_color(I.fog_pos, I.fog, I.fog_y);
	return float4(fog_col, density);
}
