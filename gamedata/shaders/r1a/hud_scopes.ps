#include "common.h"

struct v2p
{
    float2 tc0 : TEXCOORD0;    // base
    float4 c0 : COLOR0;
};

uniform float4 c_screen_res;    // x=width, y=height, z=1/width, w=1/height
uniform float4 c_screen_params; // y = screen aspect (width/height)

//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
float4 main(v2p I) : COLOR
{
    float2 tc = I.tc0;
    
    // Получаем соотношение сторон экрана (ширина/высота)
    float screen_aspect = c_screen_params.y;
    
    // Фиксируем ширину текстуры, чтобы она не растягивалась на весь экран
    // Масштабируем только по высоте, сохраняя пропорции 1:1
    if (screen_aspect > 1.0)
    {
        // Для широкоформатных экранов (16:9, 21:9 и т.д.)
        // Сдвигаем UV-координаты, чтобы текстура оставалась квадратной
        float aspect_correction = 1.0 / screen_aspect;
        tc.x = (tc.x - 0.5) * aspect_correction + 0.5;
    }
    // Для 4:3 и других менее широких экранов оставляем как есть
    
    float4 col = tex2D(s_base, tc);
    return I.c0 * col;
}

