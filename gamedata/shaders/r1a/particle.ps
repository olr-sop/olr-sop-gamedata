#include "common.h"

struct 	v2p
{
	float2 	tc0	: 	TEXCOORD0;	// base
	float4	c	:	COLOR0;		// diffuse
	float	fog	:	FOG;
	float	fog_y	:	TEXCOORD7;
};


//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
float4 	main	( v2p I )	: COLOR
{
    float4 result = I.c * tex2D(s_base, I.tc0);
    clip(result.a - (0.01f / 255.0f));
    float fog = 1.0f - r1a_fog_factor(I.fog, I.fog_y);
    fog *= fog;
    result.rgb *= fog;
    result.a *= fog;
    
    return result;
}



