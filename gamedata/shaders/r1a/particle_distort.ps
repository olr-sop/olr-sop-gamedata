#include "common.h"

struct 	v2p
{
 	float2 	tc0	: 	TEXCOORD0;	// base
	float4	c	:	COLOR0;		// diffuse
	float	fog	:	FOG;
	float	fog_y	:	TEXCOORD7;
};


//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
uniform sampler s_distort;
float4 	main	( v2p I )	: COLOR
{
	float4	distort	= tex2D		(s_distort,I.tc0);
	float    factor	= distort.a * dot(I.c.rgb,0.33h);
	float fog = 1.0f - r1a_fog_factor(I.fog, I.fog_y);
	fog *= fog;
	return	float4	(distort.rgb * fog, factor * fog);
}


