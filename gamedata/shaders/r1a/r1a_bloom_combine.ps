#include "common.h"

struct v2p
{
	float2 tc0 : TEXCOORD0;
};

uniform sampler2D s_image;
uniform sampler2D s_bloom0;
uniform float4 c_combine_params;

float4 main(v2p I) : COLOR
{
	float3 scene = tex2D(s_image, I.tc0).rgb;
	float3 bloom = tex2D(s_bloom0, I.tc0).rgb;
	float intensity = c_combine_params.x;

	return float4(saturate(scene + bloom * intensity), 1.0f);
}
