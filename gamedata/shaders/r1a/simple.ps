#include "common.h"

struct 	v2p
{
 	float2 	tc0: 	TEXCOORD0;	// base
	float	fog:	FOG;
 		float3 fog_pos : TEXCOORD6;
 };


////////////////////////////////////////////////////////////////////////////////////////
// Pixel
float4 	main	( v2p I )	: COLOR
{
	float4 color = tex2D(s_base, I.tc0);
	color.rgb = r1a_apply_fog(color.rgb, I.fog_pos);
	return color;
}



