#include "common.h"

struct 	v2p
{
 	float2 	tc0: 	TEXCOORD0;	// base
  	float3	c0:	COLOR0;
	float	fog:	FOG;
		float3 fog_pos : TEXCOORD6;
	float	fog_y:	TEXCOORD7;
};


//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
float4 	main	( v2p I )	: COLOR
{
	float4	t_base 	= tex2D		(s_base,I.tc0);
	float3	final 	= t_base*I.c0*2;
	final			= r1a_apply_fog(final, I.fog_pos, distance(I.fog_pos, eye_position), I.fog_y);

	// out
	return  float4	(final, t_base.a);
}



