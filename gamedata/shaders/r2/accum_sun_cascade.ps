#include "common.h"
#include "lmodel.h"
#include "shadow.h"

float4 	main		( float4 tc : TEXCOORD0
					) : COLOR
{
	float4 _P		= tex2Dproj 	(s_position, 	tc);
	float4 _N		= tex2Dproj 	(s_normal,   	tc);

	// ----- light-model
	float 	gloss	= def_gloss;
# ifndef USE_R2_STATIC_SUN
			gloss 	= _P.w;
# endif
	float4	light 	= plight_infinity (gloss,_P,_N,Ldynamic_dir);

	// ----- shadow
	float4 	P4 	= float4	(_P.x,_P.y,_P.z,1.f);
	float4 	PS	= mul		(m_shadow, 	P4);
	float 	s 	= sunmask	(P4);
	s 	*= shadow_quality	(PS);

	return 		blendp		(Ldynamic_color * light * s,tc);
}
