#include "common.h"

struct 	v2p
{
 	float2 	tc0: 		TEXCOORD0;	// base
  	float4	c0:		COLOR0;	
	float3	fog_pos:	TEXCOORD1;	// world position for per-pixel fog
};

//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
float4 	main	( v2p I )	: COLOR
{
	float4	t_base 	= tex2D	(s_base,I.tc0);
	float	vis		= fog_vis(I.fog_pos);

	// Additive light planes / fire cards ignore alpha in ONE,ONE and SRCCOLOR,ONE modes.
	// Fade RGB instead; for SRCALPHA,ONE this is equivalent to the old alpha fade.
	t_base.rgb *= vis * vis;

	// out
	return  float4	(t_base.r,t_base.g,t_base.b,t_base.a * I.c0.a);
}
