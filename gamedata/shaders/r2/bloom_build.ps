#include "common.h"

uniform float4 b_params;

//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
float4 main ( p_build I ) : COLOR
{
	// hi-rgb.base-lum
	float3	s0	= tex2D(s_image, I.Tex0);
	float3	s1	= tex2D(s_image, I.Tex1);
	float3	s2	= tex2D(s_image, I.Tex2);
	float3	s3	= tex2D(s_image, I.Tex3);


	float3	avg	= ( (s0+s1) + (s2+s3) )/2;
	float	hi	= dot( avg, 1.h )-b_params.x;	// assume def_hdr equal to 3.0

	return	float4( avg, hi );
}
