#include "common.h"
#include "lmodel.h"
#include "hmodel.h"

struct         _input      {
        float4         hpos        : POSITION        ;
#ifdef        USE_VTF
          float4         tc0                : TEXCOORD0        ;        // tc.xy, tc.w = tonemap scale
#else
          float2         tc0                : TEXCOORD0        ;        // tc.xy
#endif
};

struct        _out                {
        float4        low                : COLOR0        ;
        float4        high        : COLOR1        ;
};

uniform sampler1D         fog_table        ;
_out         main                ( _input I )
{
          // Sample the buffers:
          float4 P        = tex2D         (s_position,      I.tc0);                // position.gloss (static sun: position.sun_occ)
          float4 N         = tex2D         (s_normal,        I.tc0);                // normal.hemi
          float4 D         = tex2D         (s_diffuse,       I.tc0);                // rgb.albedo, a.spec
          float4 L         = tex2D         (s_accumulator, 	I.tc0);                // rgb.diffuse_light, a.spec_light (скаляр)

#ifdef         USE_GAMMA_22
        D.rgb        =        (D.rgb*D.rgb)        ;        // pow(2.2)
#endif

        // static sun: position.w занят sun-occlusion, глосс — константа
        float	gloss	= P.w	;
#ifdef        USE_R2_STATIC_SUN
        float	sun_occ        	=       P.w*2	;
        		gloss 			= 		def_gloss	;
            L              +=       Ldynamic_color * sun_occ * plight_infinity	(def_gloss, P.xyz, N.xyz, Ldynamic_dir);
#endif

        // hemisphere
        float3       hdiffuse,hspecular;

        hmodel		(hdiffuse, hspecular, gloss, N.w, D.a, P.xyz, N.xyz);

        // спекуляр (прямой + env): один общий Шлик-множитель у grazing углов.
        // амплитуда прямого — накопленный скаляр L.w, цвет — хрома накопленного
        // диффузного света тех же источников (те же света, те же тени):
        // блик закатного солнца оранжевый, блик лампы — цвета лампы.
        // env-часть (hspecular) уже гейтована gloss² в hmodel и не тинтится.
        float          spec_luma       = dot        (L.rgb, LUMINANCE_VECTOR);
        float3         spec_tint       = L.rgb / max(spec_luma, 1e-4);
        float3         V               = -normalize(P.xyz);
        float          fresnel         = pow(1 - saturate(dot(N.xyz, V)), 5);
        float          spec_eff        = lerp(D.a, 1, fresnel*spec_params.x);
        float3         spec            = spec_eff * (L.w * spec_tint + hspecular) * spec_params.y;

        // диффуз = albedo * (прямой свет + hemi)
        float3         diffuse         = D.rgb * (L.rgb + hdiffuse);
        float3         color           = diffuse + spec;

        // here should be distance fog
        float3        	pos        		= P.xyz;
        float         	distance		= length		(pos);
        float         	fog				= saturate		(distance*fog_params.w + fog_params.x); //
                      	color			= lerp     		(color,fog_color,fog);        			//
        float        	skyblend		= saturate		(fog*fog);

#ifdef         DBG_TMAPPING
        color                        	= D.xyz;
#endif

        // final tone-mapping
#ifdef        USE_VTF
        float          	tm_scale        = I.tc0.w;                // interpolated from VS
#else
        float         	tm_scale        = tex2D        (s_tonemap,I.tc0).x;
#endif

        _out        	o;
        tonemap        	(o.low, o.high, color, tm_scale )	;
                        o.low.a         = skyblend	;
						o.high.a		= skyblend	;

		return        	o;
}
