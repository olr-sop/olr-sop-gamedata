#include "common.h"
#include "sload.h"

f_deffer 	main	( p_bumped I )
{
  f_deffer	O;

  surface_bumped 	S 	= sload 	(I);

  // Sample normal, rotate it by matrix, encode position 
  float3 Ne  = mul       (float3x3(I.M1, I.M2, I.M3), S.normal);
		Ne	= normalize	(Ne);
  float ms = S.gloss;	// нормальный режим: position.w = gloss
#ifdef USE_R2_STATIC_SUN
  ms = def_gloss;		// static sun: глосса в G-буфере нет
#endif
  O.Ne 		= float4		(Ne, S.base.w);
  O.position= float4 	(I.position.xyz + Ne*S.height*def_virtualh, ms);
  O.C		= float4		(S.base.x,S.base.y,S.base.z,S.spec);		// OUT: rgb.spec

  return O;
}
