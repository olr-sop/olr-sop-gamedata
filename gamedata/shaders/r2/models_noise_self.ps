#include "common.h"
////////////////////////////////////////////////////////
// SkyLoader: Noise shader for dynamic models
////////////////////////////////////////////////////////
struct v2p
{
 	float2 tc0		:TEXCOORD0;	
};

float rand(float2 coord)
{
    return frac( sin( dot( coord, float2( 12.9898f, 78.233f ) ) ) * 43758.5453f );
}

////////////////////////////////////////////////////////
// Pixel
float4 	main	( v2p I )	: COLOR
{
	float t		= frac( timers.z / 7001.f );
	float2 r		= float2( rand( float2( I.tc0.x, t ) ), rand( float2( t, I.tc0.y ) ) );
	float color		= rand(r*t);

	return		float4(color, color, color, 1.f);
}
