#include "common.h"

struct	v2p
{
	float4	c	: COLOR0;
	float3	fog_pos	: TEXCOORD0;	// world position for per-pixel fog
};

float4 	main	( v2p I )	: COLOR
{
	float	vis		= fog_vis(I.fog_pos);
	float3	color	= lerp(fog_color.rgb, I.c.rgb, vis);	// fog before tonemap, as in combine

	float4	result, high;
	float	scale	= tex2D(s_tonemap,float2(.5h,.5h)).x;
#ifdef USE_VTF
	result.rgb = color * scale;
#else
	tonemap(result, high, color, scale);
#endif
	result.a = vis * vis;

	return	result;
}
