#include "common.h"

struct 	v2p
{
 	half2 	tc0: 		TEXCOORD0;	// lmap
 	half2 	tc1: 		TEXCOORD1;	// hemi
	half3	c0:		COLOR0;
};

//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
half4 	main_ps_1_1	( v2p I )	: COLOR
{
	half4	t_lmap 	= tex2D		(s_lmap,I.tc0);

#if R1_FUCKUP_LEVEL == 1
	// lighting
	half3 	l_base 	= t_lmap.rgb;					// base light-map
    half3	l_vertex= I.c0;							// vertex hemi + ambient
	half  	l_sun 	= t_lmap.a;						// sun color
	half3	light	= l_base + l_vertex	;
#elif R1_FUCKUP_LEVEL == 2
	half3	t_hemi	= tex2D		(s_hemi,I.tc1);	
	// lighting
	half3 	l_base 	= (t_lmap.rgb+t_hemi)*L_hemi_color;	// base light-map
	half  	l_sun 	= t_lmap.a;							// sun color
	half3	light	= l_base + L_ambient	;
#else
	// lighting
	half3 	l_base 	= t_lmap.rgb;					// base light-map
	half3	l_hemi 	= I.c0*p_hemi(I.tc1);			// hemi
	half  	l_sun 	= t_lmap.a;						// sun color
	half3	light	= L_ambient/1.5 + l_base + l_hemi	;
#endif

	return  half4	(light,l_sun);
}
